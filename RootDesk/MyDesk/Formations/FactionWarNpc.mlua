@Component
script FactionWarNpc extends Component

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleInteractionEvent(InteractionEvent event)
        -- Only the player who pressed the interaction key asks for their own target selection, and not while the map already covers the town
        -- (an interaction event is not stopped by a UI mask).
        if event.InteractionEntity == _UserService.LocalPlayer and not _FactionWarMapUI:BlocksInteraction() then
            _FactionWarMapUI:BeginSelect()
            _FactionWarAttack:RequestSelect()
        end
    end
end
