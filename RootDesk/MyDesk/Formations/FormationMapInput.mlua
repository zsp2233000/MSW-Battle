@Component
script FormationMapInput extends Component

    property integer PreviewCount = 0
    property integer SelectionEffectSerial = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Listen only for this map's input and own private, visual-only preview entities.
        self._T.previews = {}
        self._T.previewIds = {}
        self._T.ghost = nil
        self._T.ghostRuid = ""
        self._T.ghostLegal = false
        self._T.ghostMode = ""
        self._T.hoverIndex = 0
        self._T.touch = _InputService:ConnectEvent(ScreenTouchEvent, self.HandleTouch)
        self._T.key = _InputService:ConnectEvent(KeyDownEvent, self.HandleRightClick)
        self._T.inMap = false
        self._T.selected = -1
        self._T.spectatorRequested = false
        self.SelectionEffectSerial = 0
        log("[VRF][FormationMap] map input ready")
    end

    @ExecSpace("ClientOnly")
    method boolean IsEditing()
        -- Gate shared input services to the local player's actual simulation-map membership.
        local player = _UserService.LocalPlayer
        return isvalid(player) and player.CurrentMap == self.Entity
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Render the client's current content and the mouse preview without adding AI, combat or synchronized units.
        local inMap = self:IsEditing()
        if not inMap then
            if self._T.inMap then
                self:RestoreSpectatorControl()
                self:ClearPreviews()
            end
            self._T.inMap = false
            self._T.spectatorRequested = false
            return
        end
        self._T.inMap = true
        self:LockSpectator()
        if not _FormationEditSession:HasLoadedDraft() then
            self:HideGhost()
            return
        end
        if self._T.previewStamp ~= _FormationEditSession:DraftStamp() then self:SyncPreviews() end
        local selected = _FormationEditSession.SelectedUnit
        if self._T.selected ~= selected then
            self:ClearSelectionEffect()
            self._T.selected = selected
            local entity = self._T.previews[selected]
            if isvalid(entity) then
                self.SelectionEffectSerial = _EffectService:PlayEffectAttached("619f638cdb634056bfbecf71920b6482", entity, Vector3.zero, 0, Vector3.one, true, { SortingLayer = "MapLayer0", OrderInLayer = 19 })
                log("[VRF][FormationSelection] selected=" .. tostring(selected) .. " effect=" .. tostring(self.SelectionEffectSerial))
            end
        end
        self:UpdateGhost()
        self:UpdateHover()
    end

    @ExecSpace("ClientOnly")
    method void UpdateHover()
        -- The unit under the cursor brightens and grows slightly; the cursor never reaches a unit through the UI.
        local index = 0
        if _FormationEditSession:CanEdit() and not _InputService:IsPointerOverUI() then
            local world = _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition())
            index = self:UnitAt(Vector3(world.x, world.y, 0))
        end
        self:ApplyHover(index)
    end

    @ExecSpace("ClientOnly")
    method void ApplyHover(integer index)
        -- Clicks while placing never select a unit, so every hover path must clear the selection cue.
        if _FormationEditSession:PreviewMode() == "PLACE" then index = 0 end
        local previous = self._T.hoverIndex or 0
        if previous == index then return end
        local old = self._T.previews[previous]
        if isvalid(old) then
            old.SpriteRendererComponent.Color = Color(1, 1, 1, 1)
            old.TransformComponent.Scale = Vector3(1, 1, 1)
        end
        local entity = self._T.previews[index]
        if index > 0 and isvalid(entity) then
            entity.SpriteRendererComponent.Color = Color(1, 0.92, 0.55, 1)
            entity.TransformComponent.Scale = Vector3(1.12, 1.12, 1)
            self._T.hoverIndex = index
        else
            self._T.hoverIndex = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void RestoreSpectatorControl()
        -- Restore local input after leaving the formation simulation map.
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local controller = player:GetComponent("PlayerControllerComponent")
        if isvalid(controller) then controller.Enable = true end
        local movement = player:GetComponent("MovementComponent")
        if isvalid(movement) then movement:Stop() end
        log("[VRF][FormationMap] spectator control restored")
    end

    @ExecSpace("ClientOnly")
    method void LockSpectator()
        -- Disable local input immediately and ask the server to set the authoritative position.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMap ~= self.Entity then return end
        local controller = player:GetComponent("PlayerControllerComponent")
        if isvalid(controller) then controller.Enable = false end
        local movement = player:GetComponent("MovementComponent")
        if isvalid(movement) then movement:Stop() end
        if self._T.spectatorRequested ~= true then
            self._T.spectatorRequested = true
            _FormationService:RequestSimulationSpectator()
            log("[VRF][FormationMap] spectator position request sent")
        end
    end

    @ExecSpace("ClientOnly")
    method void ClearSelectionEffect()
        -- Remove the previous looping marker before switching, rebuilding or leaving the map.
        if self.SelectionEffectSerial > 0 then
            _EffectService:RemoveEffect(self.SelectionEffectSerial)
            log("[VRF][FormationSelection] removed=" .. tostring(self.SelectionEffectSerial))
            self.SelectionEffectSerial = 0
        end
    end

    @ExecSpace("ClientOnly")
    method void SyncPreviews()
        -- Upsert local sprites at exact world positions from the client's current content.
        local draft = _FormationEditSession.Draft
        self:ClearSelectionEffect()
        -- Entities may be reused or removed below; the next frame re-applies the hover.
        self:ApplyHover(0)
        self._T.previewStamp = _FormationEditSession:DraftStamp()
        for index, unit in ipairs(draft) do
            local entity = self._T.previews[index]
            if not isvalid(entity) then
                entity = _SpawnService:SpawnByModelId("formationpreview", "FormationPreview_" .. tostring(index), Vector3(unit.x, unit.y, 0), self.Entity)
                if not isvalid(entity) then
                    self._T.previewStamp = nil
                    return
                end
                self._T.previews[index] = entity
            end
            entity.TransformComponent.Position = Vector3(unit.x, unit.y, 0)
            if self._T.previewIds[index] ~= unit.monsterId then
                local option = _FormationEditSession:Option(unit.monsterId)
                if option ~= nil then
                    entity.SpriteRendererComponent.SpriteRUID = option.standRuid
                    self._T.previewIds[index] = unit.monsterId
                end
            end
        end
        for index = #self._T.previews, #draft + 1, -1 do
            local entity = self._T.previews[index]
            if isvalid(entity) then entity:Destroy() end
            self._T.previews[index] = nil
            self._T.previewIds[index] = nil
        end
        self.PreviewCount = #draft
        self._T.selected = -1
        log("[VRF][FormationMap] previews=" .. tostring(self.PreviewCount) .. " stamp=" .. tostring(self._T.previewStamp))
    end

    @ExecSpace("ClientOnly")
    method void HideGhost()
        -- The cursor preview exists only while a legal edit target could be armed under the mouse.
        local ghost = self._T.ghost
        if isvalid(ghost) then ghost:SetEnable(false) end
        self._T.ghostMode = ""
    end

    @ExecSpace("ClientOnly")
    method void UpdateGhost()
        -- Show the armed monster at the cursor: original colour when the spot is legal, red when it is not.
        local mode = _FormationEditSession:PreviewMode()
        if mode == "" or _InputService:IsPointerOverUI() then
            self:HideGhost()
            return
        end
        local world = _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition())
        self:ShowGhost(mode, world.x, world.y)
    end

    @ExecSpace("ClientOnly")
    method any ShowGhost(string mode, number x, number y)
        -- Place the preview at a world position; the cursor path and the verification probes share this.
        -- The result is read inside the same call, so a probe never races the per-frame cursor update.
        local option = _FormationEditSession:Option(_FormationEditSession:PreviewMonsterId(mode))
        local ruid = option ~= nil and option.standRuid or nil
        if ruid == nil then
            self:HideGhost()
            return { visible = false, legal = false, mode = "" }
        end
        local legal = _FormationEditSession:CanPlaceAt(x, y)
        local ghost = self._T.ghost
        if not isvalid(ghost) then
            -- A separate entity from the placed previews, so it never counts as a unit, collider or target.
            ghost = _SpawnService:SpawnByModelId("formationpreview", "FormationGhost", Vector3(x, y, 0), self.Entity)
            if not isvalid(ghost) then return { visible = false, legal = false, mode = "" } end
            self._T.ghost = ghost
            self._T.ghostRuid = ""
            ghost.SpriteRendererComponent.OrderInLayer = 18
        end
        if self._T.ghostRuid ~= ruid then
            ghost.SpriteRendererComponent.SpriteRUID = ruid
            self._T.ghostRuid = ruid
        end
        ghost.TransformComponent.Position = Vector3(x, y, 0)
        ghost.SpriteRendererComponent.Color = legal and Color(1, 1, 1, 0.55) or Color(1, 0.25, 0.25, 0.55)
        ghost:SetEnable(true)
        self._T.ghostLegal = legal
        self._T.ghostMode = mode
        local tint = ghost.SpriteRendererComponent.Color
        return { visible = true, legal = legal, mode = mode, r = tint.r, g = tint.g, b = tint.b, a = tint.a }
    end

    @ExecSpace("ClientOnly")
    method any GhostInfo()
        -- Read-only view of the cursor preview for verification; the preview never enters the edit content.
        local ghost = self._T.ghost
        local visible = isvalid(ghost) and ghost.Enable == true and self._T.ghostMode ~= ""
        return { visible = visible, legal = self._T.ghostLegal, mode = self._T.ghostMode }
    end

    @ExecSpace("ClientOnly")
    method integer UnitAt(Vector3 position)
        -- Pick the nearest unit within a small world-space click radius.
        local nearest = 0
        local distance = 0.25
        for index, unit in ipairs(_FormationEditSession.Draft) do
            local squared = (unit.x - position.x)^2 + (unit.y - position.y)^2
            if squared <= distance then distance = squared nearest = index end
        end
        return nearest
    end

    @ExecSpace("ClientOnly")
    method void HandleWorldClick(Vector3 position)
        -- An armed preview owns the click; only without one may a click select a unit on the field.
        if not self:IsEditing() or position == nil then return end
        local lobby = _FormationLobby
        if not _FormationEditSession:CanEdit() then return end
        if _FormationEditSession:PreviewMode() ~= "" then
            if _FormationEditSession:Place(position.x, position.y) then lobby:Render() end
            return
        end
        local index = self:UnitAt(position)
        if index > 0 then
            _FormationEditSession:SelectUnit(index)
            lobby:Render()
        end
    end

    @ExecSpace("ClientOnly")
    method void HandleWorldRemoval(Vector3 position)
        -- Right-click removal applies only when no preview is armed.
        if not self:IsEditing() or position == nil then return end
        local lobby = _FormationLobby
        if not _FormationEditSession:CanEdit() or _FormationEditSession:PreviewMode() ~= "" then return end
        local index = self:UnitAt(position)
        if index < 1 then return end
        _FormationEditSession:SelectUnit(index)
        if _FormationEditSession:RemoveSelected() then lobby:Render() end
    end

    @ExecSpace("ClientOnly")
    method void HandleTouch(ScreenTouchEvent event)
        -- Convert actual screen input through the active map camera and ignore UI-covered points.
        if not self:IsEditing() or event == nil or event.TouchId ~= 1 then return end
        if _InputService:IsPointerOverUI(event.TouchId) then return end
        local world = _UILogic:ScreenToWorldPosition(event.TouchPoint)
        self:HandleWorldClick(Vector3(world.x, world.y, 0))
    end

    @ExecSpace("ClientOnly")
    method void HandleRightClick(KeyDownEvent event)
        -- Right-click only cancels an armed preview; with none armed it removes the unit under the cursor.
        if not self:IsEditing() or event == nil or event.key ~= KeyboardKey.Mouse1 then return end
        if _InputService:IsPointerOverUI() then return end
        local world = _UILogic:ScreenToWorldPosition(_InputService:GetCursorPosition())
        self:RightClick(world.x, world.y)
    end

    @ExecSpace("ClientOnly")
    method void RightClick(number x, number y)
        -- The right-click rule at a world position, shared by the real handler and the verification probes.
        local lobby = _FormationLobby
        local mode = _FormationEditSession:PreviewMode()
        if mode == "MOVE" then
            _FormationEditSession:SelectUnit(0)
            self._T.selected = 0
            self:ClearSelectionEffect()
            lobby:Render()
            log("[VRF][FormationSelection] cancelled=right-click move")
            return
        end
        if mode == "PLACE" then
            _FormationEditSession:SelectMonster("")
            lobby:Render()
            self:HideGhost()
            log("[VRF][FormationSelection] cancelled=right-click place")
            return
        end
        self:HandleWorldRemoval(Vector3(x, y, 0))
    end

    @ExecSpace("ClientOnly")
    method void ClearPreviews()
        -- Remove private visual entities on map departure and force reconstruction on re-entry.
        self:ClearSelectionEffect()
        for _, entity in ipairs(self._T.previews or {}) do if isvalid(entity) then entity:Destroy() end end
        if isvalid(self._T.ghost) then self._T.ghost:Destroy() end
        self._T.ghost = nil
        self._T.ghostRuid = ""
        self._T.ghostMode = ""
        self._T.hoverIndex = 0
        self._T.previews = {}
        self._T.previewIds = {}
        self.PreviewCount = 0
        self._T.previewStamp = nil
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release input callbacks and all local previews with this map component.
        if self._T.touch ~= nil then _InputService:DisconnectEvent(ScreenTouchEvent, self._T.touch) end
        if self._T.key ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self._T.key) end
        self:ClearPreviews()
    end
end
