@Logic
script FactionWarUI extends Logic

    property integer AttackRows = 2
    -- Widths of the strength bars in the attack panel (assets/siege/build_siege_ui.cjs): a target card's bar and the departure town's.
    property number AttackBarWidth = 380
    property number OriginBarWidth = 680
    -- Cardgame cyan; use this same highlight for runtime town names on all war UI.
    property string TownNameHighlightHex = "#4DFEE7"

    @ExecSpace("ClientOnly")
    method string HighlightedTownName(string town)
        local name = _FactionWarTownDocument.TownNames[town] or ""
        return "<color=" .. self.TownNameHighlightHex .. ">" .. name .. "</color>"
    end

    @ExecSpace("ClientOnly")
    method Entity Ui(string path)
        return _EntityService:GetEntityByPath("/ui/FactionWarGroup/" .. path)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        self._T.bindings = {}
        self._T.mapName = ""
        self._T.pending = false
        self._T.options = {}
        self._T.attackPending = false
        -- #123: the siege panel (the card at the top of a town while a war pairing owns the player) follows the board only while it shows.
        self._T.siegeState = "IDLE"
        self._T.siegeSequenceKey = ""
        self._T.siegeSequence = 0
        self._T.siegePendingAction = ""
        self._T.siegeShown = false
        self._T.siegeStrengths = nil
        self._T.siegeAsked = 0
        self._T.shownText = {}
        log("[VRF][WarUI] siege panel ready")
        self._T.panelOpen = false
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        local player = _UserService.LocalPlayer
        local entry = self:Ui("LobbyEntry")
        local choice = self:Ui("FactionChoice")
        local hud = self:Ui("TownHUD")
        if not isvalid(player) or not isvalid(entry) or not isvalid(hud) or not isvalid(choice) then return end
        if #self._T.bindings == 0 then
            self:Bind("LobbyEntry", function() self:Open() end)
            self:Bind("FactionChoice/Window/A", function() self:Request("A") end)
            self:Bind("FactionChoice/Window/B", function() self:Request("B") end)
            self:Bind("FactionChoice/Window/Close", function() if not self._T.pending then choice:SetEnable(false) end end)
            self:Bind("AttackPanel/Window/Close", function() self:CloseAttack() end)
            self:Bind("AttackPanel/Window/Row1/Option", function() self:Attack(1) end)
            self:Bind("AttackPanel/Window/Row2/Option", function() self:Attack(2) end)
            self:Bind("SiegePanel/Cancel", function() self:PressSiege() end)
            self:Bind("TeamButton", function() _FactionWarTeam:Open() end)
            self:Bind("TeamPreview/Window/Close", function() _FactionWarTeam:Close() end)
            self:Bind("LobbyClose", function() _FormationLobby:CloseTownPanel() end)
        end
        local name = player.CurrentMapName
        self:KeepAvatarVisible(player, name)
        if name ~= self._T.mapName then self:EnterMap(name, entry, choice, hud) end
        self:SyncTownPanel(name, hud)
        self:RenderSiege(name)
        _FactionWarTeam:Sync(name)
    end

    @ExecSpace("ClientOnly")
    method boolean KeepAvatarVisible(Entity player, string map)
        -- A town never hides the player's avatar (only the lobby screen and a battle room do). A hidden one was seen after a gate
        -- teleport, cause unknown: show it again and say so, so the log tells when it happens.
        if not _FactionWar:IsTown(map) or player.Visible then return false end
        player:SetVisible(true, false, false)
        log("[VRF][FactionWarUI] avatar was hidden in town=" .. map .. "; shown again")
        return true
    end

    @ExecSpace("ClientOnly")
    method void SyncTownPanel(string map, Entity hud)
        -- While the lobby screen covers the town, hide the town HUD and dialogs and offer its close button.
        local open = _FormationLobby:IsTownPanelOpen()
        if open == self._T.panelOpen then return end
        self._T.panelOpen = open
        local close = self:Ui("LobbyClose")
        if isvalid(close) then close:SetEnable(open) end
        if open then self:CloseAttack() end
        hud:SetEnable(_FactionWar:IsTown(map) and not open)
    end

    @ExecSpace("ClientOnly")
    method void EnterMap(string name, Entity entry, Entity choice, Entity hud)
        -- Show the HUD and entry button that belong to the map the local player just entered.
        self._T.mapName = name
        local inLobby = name == "formationlobby"
        entry:SetEnable(inLobby)
        if not inLobby then
            self._T.pending = false
            choice:SetEnable(false)
        end
        local inTown = _FactionWar:IsTown(name)
        hud:SetEnable(inTown)
        self._T.options = {}
        self._T.attackPending = false
        self:CloseAttack()
        if inTown then
            self:ShowTownStatus(name, "讀取中")
            self:ShowTownNotice(name, "")
            -- A notice that arrived before this map change belongs to this town; anything else is stale.
            local arrival = self._T.arrivalNotice
            if arrival ~= nil and arrival.town == name then self:ShowTownNotice(name, arrival.message) end
            self._T.arrivalNotice = nil
            _FactionWar:RequestTownStatus()
        end
    end

    @ExecSpace("ClientOnly")
    method void Bind(string path, any action)
        local entity = self:Ui(path)
        if not isvalid(entity) then return end
        table.insert(self._T.bindings, { entity = entity, key = entity:ConnectEvent(ButtonClickEvent, action) })
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.key) end
        end
    end

    @ExecSpace("ClientOnly")
    method void Open()
        local player = _UserService.LocalPlayer
        local choice = self:Ui("FactionChoice")
        if not isvalid(player) or player.CurrentMapName ~= "formationlobby" or not isvalid(choice) or self._T.pending then return end
        choice:SetEnable(true)
        self._T.canChoose = false
        self:Request("")
    end

    @ExecSpace("ClientOnly")
    method void Request(string faction)
        if self._T.pending or (faction ~= "" and not self._T.canChoose) then return end
        self._T.pending = true
        self:ShowEntryControls(faction == "" and "正在讀取國戰資料…" or "正在加入陣營…", self._T.canChoose)
        _FactionWar:RequestEntry(faction)
    end

    @ExecSpace("ClientOnly")
    method void ShowEntryResult(string result)
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMapName ~= "formationlobby" then return end
        self._T.pending = false
        self._T.canChoose = result == "CHOOSE" or result == "SAVE_FAILED"
        if result == "ENTERED" then
            self:Ui("FactionChoice"):SetEnable(false)
        elseif result == "CHOOSE" then
            self:ShowEntryControls("請選擇國戰陣營。", true)
        elseif result == "SAVE_FAILED" then
            self:ShowEntryControls("陣營儲存未確認，請再試一次。", true)
        elseif result == "BLOCKED" then
            self:ShowEntryControls("請先完成目前的配對或存檔操作。", false)
        else
            self:ShowEntryControls("暫時無法進入國戰，請關閉後重試。", false)
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowEntryControls(string message, boolean choosing)
        self:Ui("FactionChoice/Window/Status").TextGUIRendererComponent.Text = message
        for _, id in ipairs({ "A", "B" }) do
            local button = self:Ui("FactionChoice/Window/" .. id)
            button:SetEnable(choosing)
            button.ButtonComponent.Enable = not self._T.pending
        end
        self:Ui("FactionChoice/Window/Close").ButtonComponent.Enable = not self._T.pending
    end

    @ExecSpace("ClientOnly")
    method boolean IsCurrentTown(string town)
        local player = _UserService.LocalPlayer
        return isvalid(player) and player.CurrentMapName == town and _FactionWar:IsTown(town)
    end

    @ExecSpace("ClientOnly")
    method void ShowTownStatus(string town, string strength)
        if not self:IsCurrentTown(town) then return end
        local label = self:Ui("TownHUD/Strength")
        if not isvalid(label) then return end
        local capital = _FactionWarTownDocument:IsCapital(town)
        label.TextGUIRendererComponent.Text = _FactionWarTownDocument.TownNames[town] .. (capital and "（主城）" or "") .. "  ｜  兵力 " .. strength
        log("[VRF][FactionWar] hud town=" .. town .. " strength=" .. strength)
    end

    @ExecSpace("ClientOnly")
    method void ShowTownNotice(string town, string message)
        -- Wait for both map sync and EnterMap; the latter clears the old town's notice before replaying a pending one.
        if self._T.mapName ~= town or not self:IsCurrentTown(town) then
            -- A relocation notice can beat either part of arrival; keep it until the town HUD has entered the map.
            if message ~= "" then
                self._T.arrivalNotice = { town = town, message = message }
                log("[VRF][FactionWar] notice kept for arrival town=" .. town)
            end
            return
        end
        local notice = self:Ui("TownHUD/Notice")
        if not isvalid(notice) then return end
        notice.TextGUIRendererComponent.Text = message
        notice:SetEnable(message ~= "")
        log("[VRF][FactionWar] notice shown=" .. tostring(message ~= ""))
    end

    method string AttackStatusText(string status, table header, integer count)
        -- What the line under the cards says: the live answer of the server, in the player's words.
        if status == "ENGAGED" then
            local target = header ~= nil and header.target or ""
            if target ~= "" and _FactionWarTownDocument:IsTown(target) then
                return "目前正在進攻 " .. self:HighlightedTownName(target) .. "，要改變目標請先取消配對"
            end
            return "已在配對中，請先取消目前的配對"
        elseif status == "UNAVAILABLE" then
            return "暫時無法讀取國戰資料，請再試一次"
        elseif status == "NOT_OWNED" then
            return "這座城已不屬於你的陣營"
        elseif count == 0 then
            return "目前沒有可進攻的相鄰敵城"
        end
        return "選擇要進攻的城鎮"
    end

    method string StrengthText(any strength)
        -- "兵力 80 / 100"; a town the panel has no reading for shows a dash.
        if type(strength) ~= "number" then return "兵力 —" end
        return "兵力 " .. string.format("%d", strength) .. " / " .. string.format("%d", _FactionWarTownDocument.FullStrength)
    end

    method number StrengthRatio(any strength)
        -- The bar's fill, clamped to the full width.
        if type(strength) ~= "number" then return 0 end
        return math.max(0, math.min(1, strength / _FactionWarTownDocument.FullStrength))
    end

    @ExecSpace("ClientOnly")
    method void SetText(string path, string text)
        -- One text node of the panel; a missing node is skipped rather than raising in the middle of a render.
        local node = self:Ui(path)
        if isvalid(node) then node.TextGUIRendererComponent.Text = text end
    end

    @ExecSpace("ClientOnly")
    method void SetBar(string path, any strength, string owner, number width)
        -- The bar of one card: width from the strength, colour from the faction that owns the town.
        local fill = self:Ui(path .. "/Fill")
        if not isvalid(fill) then return end
        local ratio = self:StrengthRatio(strength)
        fill:SetEnable(ratio > 0)
        fill.UITransformComponent.RectSize = Vector2(width * ratio, fill.UITransformComponent.RectSize.y)
        fill.SpriteGUIRendererComponent.Color = _FactionWarMapUI:OwnerColor(owner or "")
    end

    @ExecSpace("ClientOnly")
    method void RenderAttack()
        -- Draw the whole panel from the last answer and the last pushed board: the departure town on top, one card per target.
        local state = self._T.attack
        if state == nil then return end
        local header = state.header or {}
        local ready = state.status == "READY" or state.status == "ENGAGED"
        local origin = self:Ui("AttackPanel/Window/Origin")
        if isvalid(origin) then origin:SetEnable(ready and header.town ~= nil) end
        if ready and header.town ~= nil then
            self:SetText("AttackPanel/Window/Origin/Name", self:HighlightedTownName(header.town))
            self:SetText("AttackPanel/Window/Origin/Value", self:StrengthText(header.strength))
            local capital = self:Ui("AttackPanel/Window/Origin/Capital")
            if isvalid(capital) then capital:SetEnable(header.capital == true) end
            self:SetBar("AttackPanel/Window/Origin/Bar", header.strength, header.owner, self.OriginBarWidth)
        end
        for index = 1, self.AttackRows do
            local path = "AttackPanel/Window/Row" .. tostring(index)
            local row = self:Ui(path)
            local option = state.options[index]
            if isvalid(row) then row:SetEnable(option ~= nil and ready) end
            if option ~= nil then
                self:SetText(path .. "/Name", self:HighlightedTownName(option.town))
                self:SetText(path .. "/Value", self:StrengthText(option.strength))
                self:SetText(path .. "/Note", option.capital and "打贏不扣主城兵力" or "")
                local capital = self:Ui(path .. "/Capital")
                if isvalid(capital) then capital:SetEnable(option.capital == true) end
                self:SetBar(path .. "/Bar", option.strength, option.owner, self.AttackBarWidth)
                local button = self:Ui(path .. "/Option")
                if isvalid(button) then
                    local current = state.status == "ENGAGED" and option.town == header.target
                    button.TextGUIRendererComponent.Text = current and "進攻中" or "進攻"
                    button.ButtonComponent.Enable = state.status == "READY" and not self._T.attackPending
                end
            end
        end
        self:SetText("AttackPanel/Window/Status", self._T.attackNote or self:AttackStatusText(state.status, header, #state.options))
    end

    @ExecSpace("ClientOnly")
    method void ShowAttackOptions(string town, table options, string status, table header)
        -- Open the panel with exactly the answer the server derived from live ownership: one board read for the whole answer.
        if not self:IsCurrentTown(town) then return end
        local panel = self:Ui("AttackPanel")
        if not isvalid(panel) then return end
        self._T.options = options
        self._T.attackPending = false
        self._T.attackNote = nil
        self._T.attack = { town = town, status = status, header = header, options = options }
        -- The server registered this panel for board pushes when it answered READY or ENGAGED.
        self._T.attackWatching = status == "READY" or status == "ENGAGED"
        self:RenderAttack()
        panel:SetEnable(true)
        log("[VRF][FactionWarAttack] options town=" .. town .. " count=" .. tostring(#options) .. " status=" .. status
            .. " origin=" .. tostring(header.town) .. "/" .. tostring(header.strength) .. " target=" .. tostring(header.target))
    end

    @ExecSpace("ClientOnly")
    method void ShowAttackBoard(table towns)
        -- A pushed board while the panel is open: the strengths follow at once; a changed owner needs a fresh list of targets.
        local state = self._T.attack
        if state == nil then return end
        local header, relist = state.header or {}, false
        for _, entry in ipairs(towns) do
            if entry.id == header.town then
                header.strength, header.owner = entry.strength, entry.owner
                if header.faction ~= nil and entry.owner ~= header.faction then relist = true end
            end
            for _, option in ipairs(state.options) do
                if option.town == entry.id then
                    option.strength, option.owner = entry.strength, entry.owner
                    if header.faction ~= nil and entry.owner == header.faction then relist = true end
                end
            end
        end
        log("[VRF][FactionWarAttack] panel board origin=" .. tostring(header.strength) .. " relist=" .. tostring(relist))
        if relist then
            _FactionWarAttack:RequestOptions()
        else
            self:RenderAttack()
        end
    end

    @ExecSpace("ClientOnly")
    method void CloseAttack()
        -- Hide the panel and stop the server pushing boards to it; the siege panel keeps showing any waiting match.
        local panel = self:Ui("AttackPanel")
        if isvalid(panel) then panel:SetEnable(false) end
        if self._T.attackWatching then
            self._T.attackWatching = false
            _FactionWarMap:RequestPanelClose()
        end
        self._T.attack = nil
    end

    @ExecSpace("ClientOnly")
    method void Attack(integer index)
        -- One click queues against that row's town; the panel waits for the server before accepting another.
        local option = self._T.options[index]
        if option == nil or self._T.attackPending then return end
        self._T.attackPending = true
        self._T.attackNote = "正在加入配對…"
        self:RenderAttack()
        _FactionWarAttack:RequestAttack(option.town)
    end

    @ExecSpace("ClientOnly")
    method void ShowAttackResult(string result)
        -- QUEUING hands the rest of the presentation to the siege panel; every other answer keeps the dialog open.
        self._T.attackPending = false
        if result == "QUEUING" then
            self:CloseAttack()
        elseif result == "INVALID" then
            -- Ownership moved while the dialog was open; list the towns again.
            _FactionWarAttack:RequestOptions()
        else
            self._T.attackNote = result == "ENGAGED" and "已在配對中，請先取消目前的配對" or "暫時無法配對，請再試一次"
            self:RenderAttack()
        end
    end

    @ExecSpace("ClientOnly")
    method void PressSiege()
        -- The card's one button: cancel while waiting, Stop Entry after a failed entry. Re-project at click time so an expired
        -- countdown or an accepted new snapshot cannot send a stale action.
        local player = _UserService.LocalPlayer
        local snapshot = _MatchFlowInput.Snapshot
        if not isvalid(player) or self._T.panelOpen or not self:SiegeActive(player.CurrentMapName, snapshot) then return end
        local view = self:SiegeSnapshotView(snapshot, player.CurrentMapName)
        if not view.enabled or view.action == "" then return end
        self._T.siegeSequenceKey = snapshot.sequenceKey
        self._T.siegeSequence = snapshot.sequence
        self._T.siegePendingAction = view.action
        if view.action == "RETURN" then
            _MatchFlow:RequestReturn(snapshot.attempt)
        elseif view.action == "CANCEL" then
            _MatchFlow:RequestCancel(snapshot.attempt)
        end
    end

    @ExecSpace("ClientOnly")
    method string SiegeTown(string town, any strength)
        -- One side of the card's first line: "<town> 兵力 80"; a strength not heard yet is a dash, never 0.
        local figure = type(strength) == "number" and string.format("%d", strength) or "—"
        return self:HighlightedTownName(town) .. " 兵力 " .. figure
    end

    @ExecSpace("ClientOnly")
    method table SiegeView(table snapshot, table context)
        -- The whole card from one pre-battle snapshot: both towns with their strengths on the first line, the lobby's status and
        -- button below. context = { origin, now (ms), strengths (town -> number), pendingAction }. Nothing here says who the opponent is.
        local pending = context.pendingAction or ""
        local match = _MatchFlowState:PresentMatch(snapshot, { now = context.now, pending = pending ~= "", pendingAction = pending })
        local strengths = context.strengths or {}
        return { origin = self:SiegeTown(context.origin, strengths[context.origin]), target = self:SiegeTown(snapshot.target, strengths[snapshot.target]),
            status = match.text, label = match.label, action = match.action, enabled = match.enabled }
    end

    @ExecSpace("ClientOnly")
    method table SiegeSnapshotView(table snapshot, string map)
        -- The card for the live snapshot: the departure town of the ticket (the town the player stands in while waiting), the player's
        -- own pending command, and the board heard so far.
        local sameObservation = self._T.siegeSequenceKey == snapshot.sequenceKey and self._T.siegeSequence == snapshot.sequence
        local origin = (snapshot.origin or "") ~= "" and snapshot.origin or map
        return self:SiegeView(snapshot, { origin = origin, now = DateTime.UtcNow.Elapsed, strengths = self._T.siegeStrengths,
            pendingAction = sameObservation and self._T.siegePendingAction or "" })
    end

    @ExecSpace("ClientOnly")
    method void ShowSiegeBoard(table towns)
        -- A pushed board while the card shows: the strengths follow at once. One that arrives after the card hid is stale and ignored.
        if not self._T.siegeShown then return end
        local strengths = {}
        for _, entry in ipairs(towns) do strengths[entry.id] = entry.strength end
        self._T.siegeStrengths = strengths
        log("[VRF][WarUI] siege board strengths=" .. tostring(#towns))
    end

    @ExecSpace("ClientOnly")
    method void FollowSiege(boolean shown)
        -- Ask the server for the board when the card starts to show (again every 10 s while no strength has arrived); tell it when the card hides.
        if shown then
            local now = DateTime.UtcNow.Elapsed
            if not self._T.siegeShown or (self._T.siegeStrengths == nil and now - self._T.siegeAsked >= 10000) then
                self._T.siegeShown = true
                self._T.siegeAsked = now
                _FactionWarMap:RequestSiegeOpen()
            end
        elseif self._T.siegeShown then
            self._T.siegeShown = false
            self._T.siegeStrengths = nil
            _FactionWarMap:RequestSiegeClose()
        end
    end

    @ExecSpace("ClientOnly")
    method void SetTextIfChanged(string path, string text)
        -- Write a text node only when its words changed; the card is redrawn every frame.
        if self._T.shownText[path] == text then return end
        local node = self:Ui(path)
        if not isvalid(node) then return end
        node.TextGUIRendererComponent.Text = text
        self._T.shownText[path] = text
    end

    @ExecSpace("ClientOnly")
    method boolean SiegeActive(string map, table snapshot)
        -- A war pairing owns the player in a town: the ticket names a target town and is not idle.
        return _FactionWar:IsTown(map) and (snapshot.target or "") ~= "" and snapshot.state ~= "IDLE"
    end

    @ExecSpace("ClientOnly")
    method void RenderSiege(string map)
        -- The card shows in a town while a war pairing owns the player. An accepted sequence can answer a command without changing its phase.
        local card = self:Ui("SiegePanel")
        if not isvalid(card) then return end
        local snapshot = _MatchFlowInput.Snapshot
        if self._T.siegeSequenceKey ~= snapshot.sequenceKey or self._T.siegeSequence ~= snapshot.sequence then
            self._T.siegePendingAction = ""
        end
        if snapshot.state ~= self._T.siegeState then
            if snapshot.state == "IDLE" and _FactionWar:IsTown(map) then _FactionWar:RequestTownStatus() end
            self._T.siegeState = snapshot.state
        end
        local shown = self:SiegeActive(map, snapshot) and not self._T.panelOpen
        card:SetEnable(shown)
        self:FollowSiege(shown)
        if not shown then
            self._T.shownText = {}
            return
        end
        local view = self:SiegeSnapshotView(snapshot, map)
        self:SetTextIfChanged("SiegePanel/Origin", view.origin)
        self:SetTextIfChanged("SiegePanel/Target", view.target)
        self:SetTextIfChanged("SiegePanel/Status", view.status)
        local button = self:Ui("SiegePanel/Cancel")
        if isvalid(button) then
            button:SetEnable(view.action ~= "")
            button.ButtonComponent.Enable = view.enabled
            button.TextGUIRendererComponent.Text = view.label
        end
    end
end
