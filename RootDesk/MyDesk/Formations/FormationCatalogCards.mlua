@Logic
script FormationCatalogCards extends Logic

    -- skill/40001.img/skill/400011011, number/icon1 through number/icon30.
    property table LevelIcons = {
        "fa590b89cb0c415281ab4afc4daca364", "81afe3a0ccf942f2826f140e15290ca6", "b409e39abb8d4152b988830e0f34b205",
        "0c22a447ef6e4a969edfa45d9ec31f21", "b609a4616c71495da44e4c804f43a133", "3e9125597f0a4bfaa17a9b567a63aeb9",
        "5de0886ecfea49dfb1937fbe99e9bc4e", "78b13403d87c49298c69910d73c7de18", "780340c56e6f4343b3246ca7f3298712",
        "2cb378ff0ed54e8498c29ae1f51251c4", "4444b563acf6485d8c3cb06d1e7d1e98", "708dc9afb72c49b387cbefc3c5ca3a60",
        "28ef2d6a640b40538298773d4c9b69f5", "2a0202c492744f5992c62c92e7e48c1b", "c1bf78d7214247369635b51cdca6e394",
        "a967c57f449e4bada288cc317673e461", "27871383ff8b476fa5ca9c193cf3e38b", "dc23fba14ab64965813f021d35d6cfb3",
        "e22db34372944e1da7f760e892a58739", "beb3267974ff4741a2022760a7b7511b", "c14f2bc500104683883bd0ce89d5651c",
        "9c2612e76006457ca1d60fd51c6a28bd", "169143a32ddd4dd7b27f95742adcd08d", "615c9af528194e9dbb3e8836f033b786",
        "48a4f5da72c249f5af212767fccc47b1", "75f16c5a3801471aa74f486712b61229", "76937900b8114390ad12833996df93ea",
        "063af0edbd1246f3b000afbc8d3115d4", "7490da9fc6404ccdad942572685ffdeb", "9d16fa8e416147dabc758ba9c22210a4",
    }

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Own the runtime monster cards, their hover tooltip and the intelligence panel.
        self._T.cards = {}
        self._T.hoverCard = nil
        self._T.optionsKey = ""
        self._T.levelSizes = {}
        _FormationLobby:SetEnabled("CardTooltip", false)
        log("[VRF][CatalogCards] ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- The tooltip follows the cursor and closes as soon as its card stops being usable.
        for _, card in ipairs(self._T.cards or {}) do
            if isvalid(card.entity) and card.width ~= card.entity.UITransformComponent.RectSize.x then
                self:RenderProgress(card.entity, card.option)
                card.width = card.entity.UITransformComponent.RectSize.x
            end
        end
        self:UpdateCardTooltip()
    end

    @ExecSpace("ClientOnly")
    method string KindLabel(string monsterType)
        -- One player-facing name per combat type; unknown types return an empty label.
        local kinds = { TANK = "坦克", ASSAULT = "戰士", SHOOTER = "射手" }
        return kinds[monsterType] or ""
    end

    @ExecSpace("ClientOnly")
    method void DestroyCards()
        -- Release every card's subscriptions before its entity goes away.
        for _, card in ipairs(self._T.cards or {}) do
            if isvalid(card.entity) then
                card.entity:DisconnectEvent(ButtonClickEvent, card.callback)
                card.entity:DisconnectEvent(UITouchEnterEvent, card.enterCallback)
                card.entity:DisconnectEvent(UITouchExitEvent, card.exitCallback)
                card.entity:Destroy()
            end
        end
        self._T.cards = {}
    end

    @ExecSpace("ClientOnly")
    method string ProgressLabel(table option)
        -- Keep detailed progress text for tooltips and unavailable-state hints.
        if option == nil or option.level == nil then
            return _FormationEditSession.Snapshot.levelLoadState == "ERROR" and "等級讀取失敗" or "等級讀取中"
        end
        local experience = option.level == 30 and "MAX" or (tostring(option.experience) .. "/" .. tostring(option.level))
        return "Lv." .. tostring(option.level) .. " " .. experience
    end

    @ExecSpace("ClientOnly")
    method void RenderProgress(Entity target, table option)
        -- Skill digits have off-image pivots; size the rect from native dimensions without preserving that pivot.
        local badge = target:GetChildByName("LevelBadge")
        local bar = target:GetChildByName("ExperienceBar")
        local ready = option ~= nil and option.level ~= nil
        badge:SetEnable(ready)
        bar:SetEnable(ready)
        if not ready then return end
        local ruid = self.LevelIcons[option.level]
        local size = self._T.levelSizes[option.level]
        if size == nil then
            local sprite = _ResourceService:LoadSpriteAndWait(ruid)
            size = Vector2(sprite.Width, sprite.Height)
            self._T.levelSizes[option.level] = size
        end
        badge.SpriteGUIRendererComponent.ImageRUID = DataRef(ruid)
        local height = badge.UITransformComponent.RectSize.y
        badge.UITransformComponent.RectSize = Vector2(height * size.x / size.y, height)
        local ratio = option.level == 30 and 1 or math.max(0, math.min(1, option.experience / option.level))
        local barSize = bar.UITransformComponent.RectSize
        if isvalid(target:GetChildByName("Identity")) then
            barSize = Vector2(target.UITransformComponent.RectSize.x - 24, barSize.y)
            bar.UITransformComponent.RectSize = barSize
        end
        local track = bar:GetChildByName("Track")
        local fill = track:GetChildByName("Fill")
        -- Explicit sizes prevent cloned stretch children from rendering their 100x100 authoring defaults.
        track.UITransformComponent.RectSize = Vector2(barSize.x - 6, barSize.y - 4)
        fill.UITransformComponent.RectSize = Vector2((barSize.x - 6) * ratio, barSize.y - 4)
        fill:SetEnable(ratio > 0)
        local value = bar:GetChildByName("Value")
        if isvalid(value) then
            value.TextGUIRendererComponent.Text = option.level == 30 and "MAX" or tostring(option.experience) .. "/" .. tostring(option.level)
        end
    end

    @ExecSpace("ClientOnly")
    method void BuildOptions(table options)
        -- Rebuild catalog cards only when server-published identity, art or intelligence changes.
        local parts = {}
        for _, option in ipairs(options) do
            table.insert(parts, table.concat({ option.monsterId, option.monsterName, option.standRuid, option.monsterType,
                tostring(option.maxHp), tostring(option.attackDamageMin), tostring(option.attackDamageMax),
                tostring(option.attackInterval), tostring(option.attackRange), self:ProgressLabel(option) }, "|"))
        end
        local key = table.concat(parts, "\n")
        if key == self._T.optionsKey then return end
        self._T.hoverCard = nil
        _FormationLobby:SetEnabled("CardTooltip", false)
        local template = _FormationLobby:Ui("Editor/Catalog/Template")
        if not isvalid(template) then return end
        self._T.optionsKey = key
        _FormationEditSession:EnsureMonsterSelected(options)
        self:DestroyCards()
        for index, option in ipairs(options) do
            local monsterId = option.monsterId
            local card = template:Clone("Monster" .. tostring(index))
            local name = card:GetChildByName("MonsterName", true)
            if isvalid(name) then
                local label = name:GetComponent("TextGUIRendererComponent")
                if isvalid(label) then label.Text = option.monsterName end
                local labelSprite = name:GetComponent("SpriteGUIRendererComponent")
                if isvalid(labelSprite) then labelSprite.RaycastTarget = false end
            end
            local portrait = card:GetChildByName("Portrait", true)
            if isvalid(portrait) then
                portrait.SpriteGUIRendererComponent.ImageRUID = DataRef("thumbnail://" .. option.standRuid)
                portrait.SpriteGUIRendererComponent.Color = Color.white
                portrait.SpriteGUIRendererComponent.RaycastTarget = false
            end
            -- The authored template owns both frame looks; Render only switches which one is shown.
            local frame = card:GetChildByName("SelectedFrame", true)
            local glow = card:GetChildByName("SelectedGlow", true)
            if isvalid(frame) then frame.SpriteGUIRendererComponent.RaycastTarget = false end
            if isvalid(glow) then
                local check = glow:GetChildByName("Check", true)
                if isvalid(check) then check.SpriteGUIRendererComponent.RaycastTarget = false end
            end
            local identity = card:GetChildByName("Identity")
            identity.TextGUIRendererComponent.Text = option.level ~= nil and self:KindLabel(option.monsterType) or self:ProgressLabel(option)
            self:RenderProgress(card, option)
            -- Selection follows MonsterId; hovering only previews and never selects.
            local callback = card:ConnectEvent(ButtonClickEvent, function()
                _FormationEditSession:SelectMonster(monsterId)
                _FormationLobby:Render()
            end)
            local enterCallback = card:ConnectEvent(UITouchEnterEvent, function()
                self._T.hoverCard = card
                self:RenderMonsterInfo("CardTooltip", option)
                self:UpdateCardTooltip()
            end)
            local exitCallback = card:ConnectEvent(UITouchExitEvent, function()
                if self._T.hoverCard == card then
                    self._T.hoverCard = nil
                    _FormationLobby:SetEnabled("CardTooltip", false)
                end
            end)
            table.insert(self._T.cards, { entity = card, callback = callback, enterCallback = enterCallback,
                exitCallback = exitCallback, monsterId = monsterId, glow = glow, frame = frame, option = option })
            card:SetEnable(true)
        end
        local catalog = _FormationLobby:Ui("Editor/Catalog")
        if isvalid(catalog) then
            local layout = catalog:GetComponent("ScrollLayoutGroupComponent")
            if isvalid(layout) then layout:ResetScrollPosition(UITransformAxis.Vertical) end
        end
        log("[VRF][FormationUI] cards=" .. tostring(#options) .. " scroll=vertical progress=number-art/exp-bar")
    end

    @ExecSpace("ClientOnly")
    method void Render(table view)
        -- Cards are usable only while editing is, and their frames follow the selected MonsterId.
        for _, card in ipairs(self._T.cards or {}) do
            local selected = card.monsterId == _FormationEditSession.SelectedMonsterId
            if isvalid(card.entity) then card.entity.ButtonComponent.Enable = view.canEdit or (view.writable and not view.busy) end
            if isvalid(card.frame) then card.frame:SetEnable(selected) end
            if isvalid(card.glow) then card.glow:SetEnable(selected) end
        end
    end

    @ExecSpace("ClientOnly")
    method void RenderIntel()
        -- A selected world unit takes precedence over the placement card; statistics never enter save commands.
        local unit = _FormationEditSession:SelectedDraftUnit()
        local monsterId = unit ~= nil and unit.monsterId or _FormationEditSession.SelectedMonsterId
        self:RenderMonsterInfo("Editor/Intel", _FormationEditSession:Option(monsterId))
        _FormationLobby:SetText("Editor/Units/Detail", "MonsterId：" .. monsterId .. (unit ~= nil and string.format("\n相對站位 (%.2f, %.2f)", unit.x, unit.y) or "\n尚未選取場上單位"))
    end

    @ExecSpace("ClientOnly")
    method void RenderMonsterInfo(string target, table option)
        -- Share the same catalog values between selected intelligence and hover previews.
        _FormationLobby:SetText(target .. "/Name", option ~= nil and option.monsterName or "等待怪物目錄")
        local kind = option ~= nil and self:KindLabel(option.monsterType) or ""
        _FormationLobby:SetText(target .. "/Kind", option ~= nil and option.level ~= nil and kind or self:ProgressLabel(option))
        self:RenderProgress(_FormationLobby:Ui(target), option)
        local stats = {
            { "Health", "maxHp", "" },
            { "Damage", nil, "" },
            { "Interval", "attackInterval", " 秒" },
            { "Range", "attackRange", "" },
        }
        for _, stat in ipairs(stats) do
            local path = target .. "/Stats/" .. stat[1]
            _FormationLobby:SetEnabled(path, option ~= nil)
            local value = ""
            if option ~= nil and stat[1] == "Damage" then
                value = option.level ~= nil and string.format("%d～%d", option.attackDamageMin, option.attackDamageMax) or "—"
            elseif option ~= nil then
                value = option[stat[2]] ~= nil and (tostring(option[stat[2]]) .. stat[3]) or "—"
            end
            _FormationLobby:SetText(path .. "/Value", value)
        end
        _FormationLobby:SetText(target .. "/Stats", option == nil and "正在載入怪物資料…" or "")
    end

    @ExecSpace("ClientOnly")
    method void UpdateCardTooltip()
        -- Follow the cursor while keeping the authored popup inside the reference canvas.
        local card = self._T.hoverCard
        local player = _UserService.LocalPlayer
        if not isvalid(card) or not card.EnabledInHierarchy or not isvalid(player)
            or player.CurrentMapName ~= "formationsim" or _FormationEditorSlide.Collapsed
            or _FormationEditSession.ConfirmKind ~= "" or _FormationEditSession.Snapshot.pending then
            self._T.hoverCard = nil
            _FormationLobby:SetEnabled("CardTooltip", false)
            return
        end
        local popup = _FormationLobby:Ui("CardTooltip")
        if not isvalid(popup) then return end
        local cursor = _UILogic:ScreenToUIPosition(_InputService:GetCursorPosition())
        local size = popup.UITransformComponent.RectSize
        local canvas = _FormationLobby.root.UITransformComponent.RectSize
        local halfWidth, halfHeight = canvas.x / 2, canvas.y / 2
        local x, y = cursor.x + 24, cursor.y - 24
        if x + size.x > halfWidth - 12 then x = cursor.x - size.x - 24 end
        if y - size.y < -halfHeight + 12 then y = cursor.y + size.y + 24 end
        popup.UITransformComponent.anchoredPosition = Vector2(
            math.max(-halfWidth + 12, math.min(x, halfWidth - size.x - 12)),
            math.max(-halfHeight + size.y + 12, math.min(y, halfHeight - 12)))
        popup:SetEnable(true)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release cloned card subscriptions and the tooltip at world session shutdown.
        self._T.hoverCard = nil
        _FormationLobby:SetEnabled("CardTooltip", false)
        self:DestroyCards()
    end
end
