@Logic
script FormationMapLayout extends Logic

    property string ReferenceMapName = "template"
    property number MinimumSeparation = 0.3

    method any ReferenceTiles()
        -- Instance rooms use their template-verified battlefield when the static template is unavailable.
        local map = _EntityService:GetEntityByPath("/maps/" .. self.ReferenceMapName)
        if not isvalid(map) then map = _EntityService:GetEntityByPath("/maps/matchprobe") end
        if not isvalid(map) then return nil end
        local entity = map:GetChildByName("RectTileMap", true)
        if not isvalid(entity) then return nil end
        return entity.RectTileMapComponent
    end

    method any Bounds()
        -- The combat rectangle excludes outer walls and the spectator area on every map.
        return { minX = -15, maxX = 15, minY = -8, maxY = 8 }
    end

    method boolean Contains(number x, number y)
        -- Keep continuous formation positions within the standard map footprint.
        local bounds = self:Bounds()
        return type(x) == "number" and type(y) == "number" and bounds ~= nil
            and x >= bounds.minX and x < bounds.maxX and y >= bounds.minY and y < bounds.maxY
    end

    method boolean IsWalkable(number x, number y)
        -- Validate saved positions against the common template coordinate system.
        return self:IsWalkableOn(self:ReferenceTiles(), x, y)
    end

    method boolean IsWalkableOn(any tiles, number x, number y)
        -- Reject walls and missing terrain without snapping the submitted fractional coordinates.
        if not self:Contains(x, y) or not isvalid(tiles) then return false end
        local tile = tiles:GetTile(tiles:ToCellPosition(Vector3(x, y, 0)))
        return tile ~= nil and not tile.IsCollidable
    end

    method boolean CanDeploy(number x, number y)
        -- Validate both sides of the battlefield's horizontal center at x=0.5.
        return self:Contains(x, y) and x < 0.5
            and self:IsWalkable(x, y) and self:IsWalkable(self:MirrorX(x), y)
    end

    method boolean IsTooClose(number x, number y, number otherX, number otherY)
        -- Allow the minimum distance despite Vector3 float32 rounding in the battlefield.
        local dx, dy = x - otherX, y - otherY
        return dx * dx + dy * dy + 0.000001 < self.MinimumSeparation * self.MinimumSeparation
    end

    method number MirrorX(number x)
        -- Share the same x=0.5 reflection for admission, validation and client presentation.
        return 1 - x
    end

    method any BattlePosition(number x, number y, boolean away)
        -- Preserve exact saved coordinates and reflect the opponent about x=0.5.
        if not self:CanDeploy(x, y) then return nil end
        return Vector3(away and self:MirrorX(x) or x, y, 0)
    end
end
