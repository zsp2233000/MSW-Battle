@Component
script FormationCardLayout extends Component

    -- Change this in Catalog's inspector; 1 is the authored size, 0.85 is 85%.
    property number CardScale = 1

    @ExecSpace("ClientOnly")
    method void Apply()
        -- Keep the authored geometry as a baseline so rebuilding cards never compounds the scale.
        local template = self.Entity:GetChildByName("Template")
        if not isvalid(template) then return end
        if self._T.size == nil then
            self._T.size = template.UITransformComponent.RectSize
            self._T.parts = {}
            for _, child in ipairs(template.Children:ToTable()) do
                local transform = child.UITransformComponent
                table.insert(self._T.parts, { name = child.Name, pos = transform.anchoredPosition, scale = transform.UIScale })
            end
        end
        local scale = math.max(0.5, math.min(1, self.CardScale))
        local size = self._T.size
        self.Entity.ScrollLayoutGroupComponent.CellSize = Vector2(size.x * scale, size.y * scale)
        for _, card in ipairs(self.Entity.Children:ToTable()) do
            for _, part in ipairs(self._T.parts) do
                local child = card:GetChildByName(part.name)
                if isvalid(child) then
                    child.UITransformComponent.anchoredPosition = Vector2(part.pos.x * scale, part.pos.y * scale)
                    child.UITransformComponent.UIScale = Vector3(part.scale.x * scale, part.scale.y * scale, part.scale.z)
                end
            end
        end
        log("[VRF][CardScale] scale=" .. tostring(scale) .. " cell=" .. tostring(size.x * scale) .. "x" .. tostring(size.y * scale))
    end
end
