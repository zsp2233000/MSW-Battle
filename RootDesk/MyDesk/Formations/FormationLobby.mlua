@Logic
script FormationLobby extends Logic

    property Entity root = "e4b13887-3a93-4ded-8a7e-c5793ab473c0"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Wait for the local player and authored UI before wiring all five formation selectors once.
        self._T.bound = false
        self._T.bindings = {}
        self._T.mapName = ""
        self._T.lastLobbySlot = 0
        self._T.lastLobbyClick = 0
        self._T.editWhenSelected = 0
        self._T.showUnits = false
        self._T.savingNoticeText = ""
        for _, path in ipairs({ "Lobby", "Editor", "EditorControls", "Editor/Catalog/Template", "SavingNotice" }) do
            self:SetEnabled(path, false)
        end
        log("[VRF][FormationUI] authoring preview hidden for play")
    end

    @ExecSpace("ClientOnly")
    method Entity Ui(string path)
        -- Keep all presentation lookups under this screen's unique group.
        return _EntityService:GetEntityByPath("/ui/FormationGroup/" .. path)
    end

    @ExecSpace("ClientOnly")
    method void Bind(string path, any action)
        -- Own each connected button callback so teardown cannot leak across Play sessions.
        local entity = self:Ui(path)
        if not isvalid(entity) then return end
        local callback = entity:ConnectEvent(ButtonClickEvent, action)
        table.insert(self._T.bindings, { entity = entity, callback = callback })
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Follow actual map transitions without polling storage or resetting confirmed content.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(self.root) then return end
        local matchLocked = not _MatchFlowInput:AllowsFormationActions()
        if matchLocked then self._T.editWhenSelected = 0 end
        if self._T.matchLocked ~= matchLocked then
            self._T.matchLocked = matchLocked
            self:Render()
            log("[VRF][FormationUI] matchLocked=" .. tostring(matchLocked))
        end
        if player.CurrentMapName ~= "formationlobby" or _UtilLogic.ElapsedSeconds - self._T.lastLobbyClick > 5 then
            self._T.editWhenSelected = 0
        end
        self:Run(_FormationEditSession:Tick(delta))
        if player.CurrentMapName == "matchprobe" then
            self.root:SetEnable(false)
            return
        end
        self.root:SetEnable(true)
        if not self._T.bound then
            self._T.bound = true
            self:Bind("Lobby/Edit", function()
                local slotId = self._T.lastLobbySlot > 0 and self._T.lastLobbySlot or (_FormationEditSession.Snapshot.editSlot or 1)
                self:SelectLobbySlot(slotId, true)
            end)
            self:Bind("Lobby/Legacy", function() self:Travel("template") end)
            self:Bind("Editor/Back", function() self:Run(_FormationEditSession:RequestReturnToLobby()) end)
            self:Bind("ReturnLobby", function() self:Run(_FormationEditSession:RequestReturnToLobby()) end)
            self:Bind("EditorControls/Toggle", function()
                _FormationEditorSlide:Toggle()
                self:Render()
            end)
            self:Bind("ExitConfirm/Window/SaveAndReturn", function() self:Run(_FormationEditSession:ConfirmSave()) end)
            self:Bind("ExitConfirm/Window/ReturnWithoutSave", function() self:Run(_FormationEditSession:ConfirmDiscard()) end)
            self:Bind("ExitConfirm/Window/ContinueEditing", function() self:Run(_FormationEditSession:ContinueEditing()) end)
            self:Bind("Retry", function() self:Run(_FormationEditSession:RequestReconcile()) end)
            self:Bind("EditorControls/Retry", function() self:Run(_FormationEditSession:RequestReconcile()) end)
            self:Bind("Editor/Save", function() self:Run(_FormationEditSession:RequestSaveCurrent()) end)
            self:Bind("Editor/Activate", function() self:Run(_FormationEditSession:RequestActivate()) end)
            self:Bind("Editor/ToggleUnits", function() self._T.showUnits = not self._T.showUnits self:Render() end)
            for index = 1, 5 do
                local slotId = index
                self:Bind("Lobby/Slots/Slot" .. tostring(index), function() self:SelectLobbySlot(slotId, false) end)
                self:Bind("Editor/Slots/Slot" .. tostring(index), function() self:Run(_FormationEditSession:RequestSwitchSlot(slotId)) end)
            end
            for index = 1, 6 do
                local unitIndex = index
                self:Bind("Editor/Units/Unit" .. tostring(index), function()
                    _FormationEditSession:SelectUnit(unitIndex)
                    self:Render()
                end)
            end
            _FormationService:RequestOpen()
            log("[VRF][FormationUI] connected lobby and five-slot editor")
        end
        local mapName = player.CurrentMapName
        if mapName ~= self._T.mapName then
            self._T.mapName = mapName
            self._T.lastLobbySlot = 0
            self._T.lastLobbyClick = 0
            self._T.editWhenSelected = 0
            _FormationEditorSlide:Expand()
            _FormationEditSession:ResetForMap()
            self:Render()
        end
    end

    @ExecSpace("ClientOnly")
    method void Travel(string destination)
        -- Let the server choose the traveller; the client never supplies another player's identity.
        if not _MatchFlowInput:AllowsFormationActions() or _FormationEditSession:Busy() or _FormationEditSession:Unconfirmed() or _FormationEditSession.ConfirmKind ~= "" then return end
        _FormationService:RequestTravel(destination)
    end

    @ExecSpace("ClientOnly")
    method void SelectLobbySlot(integer slotId, boolean openEditor)
        -- Single clicks select; a second click on the same slot opens only after server selection acknowledgement.
        local state = _FormationEditSession.Snapshot
        if not _MatchFlowInput:AllowsFormationActions() or _FormationEditSession:Busy() or _FormationEditSession:Unconfirmed() or _FormationEditSession.ConfirmKind ~= "" then return end
        if self._T.mapName ~= "formationlobby" or state.pending
            or not _FormationSchema:IsLoadConfirmed(state.loadState) then return end
        local now = _UtilLogic.ElapsedSeconds
        local doubleClick = self._T.lastLobbySlot == slotId and now - self._T.lastLobbyClick <= 0.35
        self._T.lastLobbySlot = slotId
        self._T.lastLobbyClick = now
        self._T.editWhenSelected = (openEditor or doubleClick) and slotId or 0
        _FormationService:RequestSelectSlot(slotId)
    end

    @ExecSpace("ClientOnly")
    method void Observe(table snapshot, integer sequence)
        -- The edit session ignores out-of-order replies (nil); this screen then rebuilds cards and redraws.
        local commands = _FormationEditSession:Observe(snapshot, sequence)
        if commands == nil then return end
        _FormationCatalogCards:BuildOptions(snapshot.options or {})
        self:Run(commands)
        local player = _UserService.LocalPlayer
        if _MatchFlowInput:AllowsFormationActions() and self._T.editWhenSelected == snapshot.editSlot and isvalid(player) and player.CurrentMapName == "formationlobby"
            and _UtilLogic.ElapsedSeconds - self._T.lastLobbyClick <= 5
            and not snapshot.pending and _FormationSchema:IsLoadConfirmed(snapshot.loadState) then
            self._T.editWhenSelected = 0
            self:Travel("formationsim")
            log("[VRF][LobbyEdit] opening selected slot=" .. tostring(snapshot.editSlot))
        end
    end

    @ExecSpace("ClientOnly")
    method void Run(any commands)
        -- Carry out what the edit session asked for, then redraw; nil means the input was ignored.
        if commands == nil then return end
        local notices = {}
        for _, command in ipairs(commands) do
            if command.kind == "SAVE" then
                _FormationService:RequestSave(command.units, command.slotId, command.revision, command.requestId)
            elseif command.kind == "SELECT_SLOT" then
                _FormationService:RequestSelectSlot(command.slotId)
            elseif command.kind == "ACTIVATE" then
                _FormationService:RequestActivate(command.slotId, command.revision)
            elseif command.kind == "RELOAD" then
                _FormationService:RequestRetryLoad()
            elseif command.kind == "TRAVEL" then
                self:Travel(command.destination)
            elseif command.kind == "NOTICE" then
                table.insert(notices, command.text)
            end
        end
        self:Render()
        -- A notice explains why an input did nothing, so it must outlast the redraw's own status line.
        for _, text in ipairs(notices) do self:SetStatus(text) end
    end

    @ExecSpace("ClientOnly")
    method void SetText(string path, string value)
        -- Update authored labels without allocating runtime UI entities.
        local entity = self:Ui(path)
        if isvalid(entity) then entity.TextGUIRendererComponent.Text = value end
    end

    @ExecSpace("ClientOnly")
    method void SetEnabled(string path, boolean value)
        -- Toggle a whole authored subtree, including its input receivers.
        local entity = self:Ui(path)
        if isvalid(entity) then entity:SetEnable(value) end
    end

    @ExecSpace("ClientOnly")
    method void SetButton(string path, boolean enabled)
        -- Native button states own the look; only the enabled flag changes here.
        local entity = self:Ui(path)
        if isvalid(entity) then entity.ButtonComponent.Enable = enabled end
    end

    @ExecSpace("ClientOnly")
    method void SetStatus(string value)
        -- Each screen owns its authored status layout while sharing the same state message.
        self:SetText("Status", value)
        self:SetText("EditorControls/Status", value)
    end

    @ExecSpace("ClientOnly")
    method void RenderConfirmation(table view)
        -- Describe the pending switch or return and which of its three choices are currently possible.
        local state = _FormationEditSession.Snapshot
        local slotId = state.editSlot or 1
        local awaiting = view.awaiting
        local switching = view.confirmKind == "SWITCH"
        local reason = view.saveReason
        if awaiting then
            self:SetText("ExitConfirm/Window/Title", "儲存中…")
            self:SetText("ExitConfirm/Window/Message", "正在等待第 " .. tostring(slotId) .. " 組的儲存確認，完成前無法切換或離開。")
        else
            self:SetText("ExitConfirm/Window/Title", "要儲存變更嗎？")
            local message = "第 " .. tostring(slotId) .. " 組有尚未儲存的變更。"
            if reason ~= "" then message = message .. "\n" .. reason end
            message = message .. (switching and ("\n選擇「不儲存切換」會捨棄這些變更，改看第 " .. tostring(view.confirmTarget) .. " 組。")
                or "\n選擇「不儲存返回」會捨棄這些變更。")
            self:SetText("ExitConfirm/Window/Message", message)
        end
        self:SetText("ExitConfirm/Window/SaveAndReturn", switching and "儲存並切換" or "儲存並返回")
        self:SetText("ExitConfirm/Window/ReturnWithoutSave", switching and "不儲存切換" or "不儲存返回")
        self:SetText("ExitConfirm/Window/ContinueEditing", "繼續編輯")
        self:SetButton("ExitConfirm/Window/SaveAndReturn", not awaiting and reason == "")
        self:SetButton("ExitConfirm/Window/ReturnWithoutSave", not view.busy)
        self:SetButton("ExitConfirm/Window/ContinueEditing", not awaiting)
    end

    @ExecSpace("ClientOnly")
    method void RenderSavingNotice(table view)
        -- A plain save blocks the screen with a small notice whose window hugs its text; confirmations keep their own modal.
        local show = view.saving and view.confirmKind == ""
        self:SetEnabled("SavingNotice", show)
        if not show then return end
        local message = "儲存中…"
        if self._T.savingNoticeText == message then return end
        local label = self:Ui("SavingNotice/Window/Message")
        local window = self:Ui("SavingNotice/Window")
        if not isvalid(label) or not isvalid(window) then return end
        -- Size from the rendered text so a font or wording change never needs a layout edit.
        local text = label.TextGUIRendererComponent
        text.Text = message
        local width = text:GetPreferredWidth(message) + 4
        local height = text:GetPreferredHeight(message, width)
        label.UITransformComponent.RectSize = Vector2(width, height)
        window.UITransformComponent.RectSize = Vector2(width + 96, height + 64)
        self._T.savingNoticeText = message
        log("[VRF][SavingNotice] sized text=" .. string.format("%.0fx%.0f", width, height))
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Present unsaved content, confirmed content and save state in both lobby and editor.
        if not isvalid(self.root) then return end
        local view = _FormationEditSession:View()
        local mapName = self._T.mapName
        local inLobby = mapName == "formationlobby"
        local inEditor = mapName == "formationsim"
        self:SetEnabled("ExitConfirm", view.confirmKind ~= "")
        self:RenderSavingNotice(view)
        self:SetEnabled("Lobby", inLobby)
        self:SetEnabled("Editor", inEditor and _FormationEditorSlide:PanelsVisible())
        self:SetEnabled("EditorControls", inEditor)
        self:SetEnabled("Editor/Units", inEditor and self._T.showUnits)
        if inEditor then
            -- Maker can retain import order after a layout refresh; keep the panel fills below existing controls.
            for _, path in ipairs({ "Editor/Header", "Editor/CatalogDock", "Editor/Intel" }) do
                local panel = self:Ui(path)
                if isvalid(panel) then _UILogic:SetSiblingIndex(panel.UITransformComponent, 0) end
            end
            local details = self:Ui("Editor/Units")
            if isvalid(details) then _UILogic:SetSiblingIndex(details.UITransformComponent, #details.Parent.Children:ToTable()) end
        end
        self:SetEnabled("ReturnLobby", not inLobby and not inEditor)
        self:SetText("EditorControls/Toggle", _FormationEditorSlide.Collapsed and "展開面板" or "收合面板")
        self:SetEnabled("Status", inLobby)
        local state = _FormationEditSession.Snapshot
        local load = view.loadState
        local writable = view.writable
        local busy = view.busy
        local dirty = view.dirty
        local edit = self:Ui("Lobby/Edit")
        if isvalid(edit) then edit.ButtonComponent.Enable = writable and not busy and view.confirmKind == "" end
        self:SetButton("Lobby/Legacy", writable and not busy and view.confirmKind == "")
        local needsRetry = view.needsRetry
        local retryLabel = view.unconfirmed and "確認結果" or "重新讀取"
        self:SetEnabled("Retry", inLobby and needsRetry)
        self:SetEnabled("EditorControls/Retry", inEditor and needsRetry)
        for _, path in ipairs({ "Retry", "EditorControls/Retry" }) do
            self:SetText(path, retryLabel)
            self:SetButton(path, not state.pending)
        end
        local saveReason = view.saveReason
        local activateReason = view.activateReason
        local text = "已儲存"
        if load == "LOADING" or load == "NOT_LOADED" then text = "讀取中" end
        if needsRetry then text = "需確認" end
        if load == "NEW" then text = "首次使用" end
        if dirty then text = "有尚未儲存的變更" end
        if busy then text = "儲存中…" end
        local note = state.message or "正在讀取個人隊伍"
        -- Surface why the primary save is unavailable whenever it matters; "no change" needs no explanation.
        if inEditor and saveReason ~= "" and saveReason ~= "沒有變更" and (dirty or needsRetry or load ~= "READY") then note = saveReason end
        if not _MatchFlowInput:AllowsFormationActions() then note = "配對處理中；取消完成或返回大廳後可繼續整備" end
        self:SetStatus(text .. "    " .. note)
        self:RenderConfirmation(view)
        local units = _FormationEditSession.Draft
        local saved = state.saved
        local editSlot = state.editSlot or 1
        local summary = "尚未儲存任何隊伍"
        if saved ~= nil then
            summary = "第 " .. tostring(editSlot) .. " 組 · 已儲存 " .. tostring(#saved.slots[tostring(editSlot)].units) .. " / 6"
                .. "    出戰隊伍：" .. (saved.activeSlot > 0 and ("第 " .. tostring(saved.activeSlot) .. " 組") or "尚未選定")
        end
        _FormationLobbyPreview:Render()
        self:SetText("Editor/Summary", summary)
        for index = 1, 5 do
            local key = tostring(index)
            local slot = saved and saved.slots[key] or nil
            local info = state.slots and state.slots[key] or nil
            local label = "第 " .. key .. " 組"
            if slot == nil then
                label = label .. "\n讀取中"
            else
                label = label .. (#slot.units == 0 and "\n空隊伍" or ("\n" .. tostring(#slot.units) .. " / 6"))
                if info ~= nil and #slot.units > 0 and not info.savedValid then label = label .. " / 需修正" end
                if state.pending and state.pendingSlot == index then label = label .. (state.pendingKind == "SAVE" and " / 儲存中" or " / 出戰確認中") end
            end
            local isCurrent = index == editSlot
            local isActive = saved ~= nil and saved.activeSlot == index
            for _, screen in ipairs({ "Lobby", "Editor" }) do
                local base = screen .. "/Slots/Slot" .. key
                self:SetText(base, label)
                local button = self:Ui(base)
                if isvalid(button) then button.SpriteGUIRendererComponent.Color = isCurrent and Color(1, 0.86, 0.5, 1) or Color(1, 1, 1, 1) end
                self:SetEnabled(base .. "/ActiveBadge", isActive)
            end
            -- Clicks are already ignored while a request is pending; disabling here only swaps the sprite and flashes the row.
            self:SetButton("Lobby/Slots/Slot" .. key, writable)
            self:SetButton("Editor/Slots/Slot" .. key, writable)
        end
        _FormationCatalogCards:RenderIntel()
        self:SetText("Editor/Roster", "隊伍 " .. tostring(#units) .. " / 6 · 可重複部署")
        for index = 1, 6 do
            local entry = units[index]
            local label = tostring(index) .. ". 空位"
            if entry ~= nil then label = tostring(index) .. ". " .. _FormationEditSession:MonsterName(entry.monsterId) .. string.format("  (%.2f, %.2f)", entry.x, entry.y) end
            if _FormationEditSession.SelectedUnit == index then label = "> " .. label end
            self:SetText("Editor/Units/Unit" .. tostring(index), label)
            self:SetButton("Editor/Units/Unit" .. tostring(index), view.canEdit and entry ~= nil)
        end
        self:SetText("Editor/Save", view.saving and "儲存中…" or "儲存隊伍")
        self:SetText("Editor/Activate", "設為出戰")
        local canSave = saveReason == "" and view.confirmKind == ""
        self:SetButton("Editor/Save", canSave)
        -- Usable save is gold; the native sprite swap still supplies hover, pressed and disabled looks.
        local saveButton = self:Ui("Editor/Save")
        if isvalid(saveButton) then saveButton.SpriteGUIRendererComponent.Color = canSave and Color(1, 0.86, 0.5, 1) or Color(1, 1, 1, 1) end
        -- 圖片由 Maker 調整，只切換顯示，不覆寫素材、大小或位置。
        self:SetEnabled("Editor/Save/SaveHint", canSave)
        self:SetButton("Editor/Activate", activateReason == "" and view.confirmKind == "")
        _FormationCatalogCards:Render(view)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release authored button subscriptions at world session shutdown.
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.callback) end
        end
    end
end
