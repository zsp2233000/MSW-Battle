@Logic
script FormationLobby extends Logic

    property Entity root = "e4b13887-3a93-4ded-8a7e-c5793ab473c0"
    property table Snapshot = {}
    property integer ObservedSequence = -1
    property string SelectedMonsterId = ""
    property integer SelectedUnit = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Wait for the local player and authored UI before wiring all five formation selectors once.
        self._T.bound = false
        self._T.bindings = {}
        self._T.cards = {}
        self._T.optionsKey = ""
        self._T.mapName = ""
        self._T.showUnits = false
        self.ObservedSequence = -1
    end

    @ExecSpace("ClientOnly")
    method Entity Ui(string path)
        -- Keep all presentation lookups under this screen's unique group.
        return _EntityService:GetEntityByPath("/ui/FormationGroup/" .. path)
    end

    @ExecSpace("ClientOnly")
    method void Bind(string path, any action)
        -- Own each connected button callback so teardown cannot leak across Play sessions.
        local entity = self:Ui(path)
        if not isvalid(entity) then return end
        local callback = entity:ConnectEvent(ButtonClickEvent, action)
        table.insert(self._T.bindings, { entity = entity, callback = callback })
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Follow actual map transitions without polling storage or resetting login drafts.
        local player = _UserService.LocalPlayer
        if not isvalid(player) or not isvalid(self.root) then return end
        if player.CurrentMapName == "matchprobe" then
            self.root:SetEnable(false)
            return
        end
        self.root:SetEnable(true)
        if not self._T.bound then
            self._T.bound = true
            self:Bind("Lobby/Edit", function() self:Travel("formationsim") end)
            self:Bind("Lobby/Legacy", function() self:Travel("map01") end)
            self:Bind("Editor/Back", function() self:Travel("formationlobby") end)
            self:Bind("ReturnLobby", function() self:Travel("formationlobby") end)
            self:Bind("Retry", function() _FormationService:RequestRetryLoad() end)
            self:Bind("Editor/Save", function() _FormationService:RequestSave(self.Snapshot.draftVersion or 0, self.Snapshot.editSlot or 1) end)
            self:Bind("Editor/Activate", function()
                local state = self.Snapshot
                if state.saved == nil then return end
                _FormationService:RequestActivate(state.editSlot, state.saved.slots[tostring(state.editSlot)].revision)
            end)
            self:Bind("Editor/Remove", function() self:RemoveSelected() end)
            self:Bind("Editor/AddMode", function() self.SelectedUnit = 0 self:Render() end)
            self:Bind("Editor/ToggleUnits", function() self._T.showUnits = not self._T.showUnits self:Render() end)
            for index = 1, 5 do
                local slotId = index
                self:Bind("Lobby/Slots/Slot" .. tostring(index), function() _FormationService:RequestSelectSlot(slotId) end)
                self:Bind("Editor/Slots/Slot" .. tostring(index), function() _FormationService:RequestSelectSlot(slotId) end)
            end
            for index = 1, 6 do
                local unitIndex = index
                self:Bind("Editor/Units/Unit" .. tostring(index), function()
                    self.SelectedUnit = unitIndex
                    self:Render()
                end)
            end
            _FormationService:RequestOpen()
            self:Travel("formationlobby")
            log("[VRF][FormationUI] connected lobby and five-slot editor")
        end
        local mapName = player.CurrentMapName
        if mapName ~= self._T.mapName then
            self._T.mapName = mapName
            self:Render()
        end
    end

    @ExecSpace("ClientOnly")
    method void Travel(string destination)
        -- Let the server choose the traveller; the client never supplies another player's identity.
        _FormationService:RequestTravel(destination)
    end

    @ExecSpace("ClientOnly")
    method void Observe(table snapshot, integer sequence)
        -- Ignore out-of-order replies and keep edits made during a save visibly unsaved.
        if sequence <= self.ObservedSequence then return end
        self.ObservedSequence = sequence
        if snapshot.editSlot ~= self.Snapshot.editSlot then self.SelectedUnit = 0 end
        self.Snapshot = snapshot
        self:BuildOptions(snapshot.options or {})
        if self.SelectedUnit > #(snapshot.draft or {}) then self.SelectedUnit = 0 end
        self:Render()
        log("[VRF][FormationUI] slot=" .. tostring(snapshot.editSlot) .. " load=" .. snapshot.loadState .. " save=" .. snapshot.saveState .. " draft=" .. tostring(snapshot.draftVersion) .. " confirmed=" .. tostring(snapshot.savedDraftVersion))
    end

    @ExecSpace("ClientOnly")
    method void BuildOptions(table options)
        -- Clone the same five-column battle cards when the formal catalog changes.
        local parts = {}
        for _, option in ipairs(options) do table.insert(parts, option[1] .. "|" .. option[2] .. "|" .. option[3]) end
        local key = table.concat(parts, "\n")
        if key == self._T.optionsKey then return end
        self._T.optionsKey = key
        for _, card in ipairs(self._T.cards) do
            if isvalid(card.entity) then
                card.entity:DisconnectEvent(ButtonClickEvent, card.callback)
                card.entity:Destroy()
            end
        end
        self._T.cards = {}
        local template = self:Ui("Editor/Catalog/Template")
        if not isvalid(template) then return end
        for index, option in ipairs(options) do
            local monsterId = option[1]
            local card = template:Clone("Monster" .. tostring(index))
            local name = card:GetChildByName("MonsterName", true)
            if isvalid(name) then
                local label = name:GetComponent("TextGUIRendererComponent")
                if isvalid(label) then label.Text = option[2] end
                local labelSprite = name:GetComponent("SpriteGUIRendererComponent")
                if isvalid(labelSprite) then labelSprite.RaycastTarget = false end
            end
            local portrait = card:GetChildByName("Portrait", true)
            if isvalid(portrait) then
                portrait.SpriteGUIRendererComponent.ImageRUID = DataRef("thumbnail://" .. option[3])
                portrait.SpriteGUIRendererComponent.Color = Color.white
                portrait.SpriteGUIRendererComponent.RaycastTarget = false
            end
            local glow = card:GetChildByName("SelectedGlow", true)
            if isvalid(glow) then
                glow:SetEnable(self.SelectedMonsterId == monsterId)
                local border = glow:GetChildByName("Border", true)
                local check = glow:GetChildByName("Check", true)
                if isvalid(border) then border.SpriteGUIRendererComponent.RaycastTarget = false end
                if isvalid(check) then check.SpriteGUIRendererComponent.RaycastTarget = false end
            end
            local callback = card:ConnectEvent(ButtonClickEvent, function()
                self.SelectedMonsterId = monsterId
                self.SelectedUnit = 0
                self:Render()
            end)
            table.insert(self._T.cards, { entity = card, callback = callback, monsterId = monsterId, glow = glow })
            card:SetEnable(true)
        end
        if self.SelectedMonsterId == "" and #options > 0 then self.SelectedMonsterId = options[1][1] end
        local catalog = self:Ui("Editor/Catalog")
        if isvalid(catalog) then
            local layout = catalog:GetComponent("ScrollLayoutGroupComponent")
            if isvalid(layout) then layout:ResetScrollPosition(UITransformAxis.Vertical) end
        end
        log("[VRF][FormationUI] cards=" .. tostring(#options) .. " columns=5 scroll=vertical")
    end

    @ExecSpace("ClientOnly")
    method string MonsterName(string monsterId)
        -- Display the formal catalog name while retaining stable IDs in draft commands.
        for _, option in ipairs(self.Snapshot.options or {}) do if option[1] == monsterId then return option[2] end end
        return monsterId
    end

    @ExecSpace("ClientOnly")
    method void SetText(string path, string value)
        -- Update authored labels without allocating runtime UI entities.
        local entity = self:Ui(path)
        if isvalid(entity) then entity.TextGUIRendererComponent.Text = value end
    end

    @ExecSpace("ClientOnly")
    method void SetEnabled(string path, boolean value)
        -- Toggle a whole authored subtree, including its input receivers.
        local entity = self:Ui(path)
        if isvalid(entity) then entity:SetEnable(value) end
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Present private draft, confirmed content and save state in both lobby and simulation.
        if not isvalid(self.root) then return end
        local mapName = self._T.mapName
        local inLobby = mapName == "formationlobby"
        local inEditor = mapName == "formationsim"
        self:SetEnabled("Lobby", inLobby)
        self:SetEnabled("Editor", inEditor)
        self:SetEnabled("Editor/Units", inEditor and self._T.showUnits)
        self:SetEnabled("ReturnLobby", not inLobby and not inEditor)
        self:SetEnabled("Status", inLobby or inEditor)
        local state = self.Snapshot
        local load = state.loadState or "LOADING"
        local writable = load == "READY" or load == "NEW"
        self:SetEnabled("Retry", (inLobby or inEditor) and (load == "ERROR" or load == "CONFLICT"))
        local labels = { UNSAVED = "未保存", SAVING = "儲存中", SAVED = "保存成功", FAILED = "儲存失敗" }
        local text = labels[state.saveState] or "讀取中"
        if load == "LOADING" then text = "讀取中" end
        if load == "ERROR" or load == "CONFLICT" then text = "讀取需重試 / " .. text end
        if load == "NEW" then text = "首次使用 / " .. text end
        self:SetText("Status", text .. "    " .. (state.message or "正在讀取個人編隊"))
        local units = state.draft or {}
        local saved = state.saved
        local editSlot = state.editSlot or 1
        local summary = "尚無預存編隊"
        if saved ~= nil then
            summary = "編輯第 " .. tostring(editSlot) .. " 組 / 已保存 " .. tostring(#saved.slots[tostring(editSlot)].units) .. " / 6"
                .. "    出戰：" .. (saved.activeSlot > 0 and ("第 " .. tostring(saved.activeSlot) .. " 組") or "尚未選定")
        end
        self:SetText("Lobby/Summary", summary .. "\n草稿：" .. tostring(#units) .. " / 6（本次登入保留）")
        self:SetText("Editor/Summary", summary)
        for index = 1, 5 do
            local key = tostring(index)
            local slot = saved and saved.slots[key] or nil
            local info = state.slots and state.slots[key] or nil
            local label = "第 " .. key .. " 組"
            if index == editSlot then label = label .. " [編輯]" end
            if saved ~= nil and saved.activeSlot == index then label = label .. " [出戰]" end
            if slot == nil then
                label = label .. "\n讀取中"
            else
                label = label .. (#slot.units == 0 and "\n空欄位" or ("\n已保存 " .. tostring(#slot.units) .. "/6 v" .. tostring(slot.revision)))
                if info ~= nil and #slot.units > 0 and not info.savedValid then label = label .. " / 需修正" end
                if info ~= nil and info.dirty then label = label .. " / 有草稿" end
                if info ~= nil and info.saveState == "FAILED" then label = label .. " / 保存失敗" end
                if state.pending and state.pendingSlot == index then label = label .. (state.pendingKind == "SAVE" and " / 儲存中" or " / 出戰確認中") end
            end
            self:SetText("Lobby/Slots/Slot" .. key, label)
            self:SetText("Editor/Slots/Slot" .. key, label)
        end
        self:SetText("Editor/Selection", self.SelectedUnit > 0 and ("移動單位 " .. tostring(self.SelectedUnit) .. "：點選新站位") or ("放置：" .. self:MonsterName(self.SelectedMonsterId)))
        for index = 1, 6 do
            local entry = units[index]
            local label = tostring(index) .. ". 空位"
            if entry ~= nil then label = tostring(index) .. ". " .. self:MonsterName(entry.monsterId) .. string.format("  (%.2f, %.2f)", entry.x, entry.y) end
            if self.SelectedUnit == index then label = "> " .. label end
            self:SetText("Editor/Units/Unit" .. tostring(index), label)
        end
        local save = self:Ui("Editor/Save")
        local activate = self:Ui("Editor/Activate")
        if isvalid(save) then save.ButtonComponent.Enable = writable and not state.pending and state.draftValid == true end
        local slotInfo = state.slots and state.slots[tostring(editSlot)] or nil
        if isvalid(activate) then activate.ButtonComponent.Enable = writable and not state.pending and slotInfo ~= nil and slotInfo.savedValid == true end
        for _, card in ipairs(self._T.cards or {}) do
            local selected = card.monsterId == self.SelectedMonsterId
            if isvalid(card.glow) then card.glow:SetEnable(selected) end
            if selected and isvalid(card.entity) then
                local name = card.entity:GetChildByName("MonsterName", true)
                if isvalid(name) and isvalid(name.UITransformComponent) then
                    _UILogic:SetSiblingIndex(name.UITransformComponent, #name.Parent.Children:ToTable())
                end
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Place(number x, number y)
        -- Send only IDs and relative positions through the same public draft command used by real buttons.
        local state = self.Snapshot
        if state.draft == nil then return end
        local units = _FormationSchema:CopyUnits(state.draft)
        if self.SelectedUnit > 0 and units[self.SelectedUnit] ~= nil then
            units[self.SelectedUnit].x = x
            units[self.SelectedUnit].y = y
        elseif self.SelectedMonsterId ~= "" then
            table.insert(units, { monsterId = self.SelectedMonsterId, x = x, y = y })
        else return end
        _FormationService:RequestDraft(units, state.draftVersion, state.editSlot)
    end

    @ExecSpace("ClientOnly")
    method void RemoveSelected()
        -- Removing an editor unit modifies only the login draft until an explicit successful save.
        if self.Snapshot.draft == nil then return end
        local units = _FormationSchema:CopyUnits(self.Snapshot.draft)
        if self.SelectedUnit < 1 or self.SelectedUnit > #units then return end
        table.remove(units, self.SelectedUnit)
        self.SelectedUnit = 0
        _FormationService:RequestDraft(units, self.Snapshot.draftVersion, self.Snapshot.editSlot)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release authored and cloned button subscriptions at world session shutdown.
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.callback) end
        end
        for _, card in ipairs(self._T.cards or {}) do
            if isvalid(card.entity) then
                card.entity:DisconnectEvent(ButtonClickEvent, card.callback)
                card.entity:Destroy()
            end
        end
    end
end
