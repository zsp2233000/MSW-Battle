@Logic
script FactionWarMapUI extends Logic

    property Color RedColor = Color(0.84, 0.29, 0.24, 1)
    property Color BlueColor = Color(0.27, 0.5, 0.88, 1)
    property Color NeutralColor = Color(0.62, 0.6, 0.56, 1)
    property number DistrictAlpha = 0.55
    property number LinkThickness = 3
    property number MaxZoom = 12
    property number WheelZoomFactor = 2.4
    property string ViewPath = "Overlay/Window/Map"
    property integer LinkSlots = 3
    property number BarWidth = 280
    property integer FullStrength = 100
    property number ArrowBaseY = 60
    property table ArrowBob = { 9, 6, 3, 0 }

    @ExecSpace("ClientOnly")
    method Entity Ui(string path)
        -- Entities of the world map group, by path under /ui/WorldMapGroup.
        return _EntityService:GetEntityByPath("/ui/WorldMapGroup/" .. path)
    end

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Closed until the player opens it from a town; M toggles it like the button.
        self._T.bindings = {}
        self._T.open = false
        self._T.board = nil
        self._T.links = {}
        self._T.mapName = ""
        self._T.receivedAt = 0
        self._T.age = -1
        self._T.unavailable = false
        self._T.zoom = 0
        self._T.key = _InputService:ConnectEvent(KeyDownEvent, self.HandleKey)
        self._T.wheel = _InputService:ConnectEvent(MouseScrollEvent, self.HandleWheel)
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release service, viewport and button handlers.
        if self._T.key ~= nil then _InputService:DisconnectEvent(KeyDownEvent, self._T.key) end
        if self._T.wheel ~= nil then _InputService:DisconnectEvent(MouseScrollEvent, self._T.wheel) end
        local input = self._T.mapInput
        if isvalid(input) then
            input:DisconnectEvent(UITouchDownEvent, self._T.dragDown)
            input:DisconnectEvent(UITouchDragEvent, self._T.dragMove)
            input:DisconnectEvent(UITouchUpEvent, self._T.dragUp)
        end
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.key) end
        end
        for _, binding in ipairs(self._T.frames or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, binding.key) end
        end
    end

    @ExecSpace("ClientOnly")
    method void BindArrows()
        -- The arrow clip's frames are one image whose pivot moves down 2 px a frame; a UI sprite ignores the pivot,
        -- so the bob is replayed here by moving the arrow on every frame change (ArrowBob, in UI px, per frame).
        self._T.frames = {}
        for _, id in ipairs(_FactionWar.TownOrder) do
            local arrow = self:Ui(self.ViewPath .. "/Content/Towns/" .. id .. "/Arrow")
            if isvalid(arrow) then
                local key = arrow:ConnectEvent(SpriteGUIAnimPlayerChangeFrameEvent, function(event)
                    local lift = self.ArrowBob[(event.FrameIndex % #self.ArrowBob) + 1] or 0
                    arrow.UITransformComponent.anchoredPosition = Vector2(0, self.ArrowBaseY + lift)
                end)
                table.insert(self._T.frames, { entity = arrow, key = key })
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Bind(string path, any action)
        -- Connect a button once and keep the handler for OnEndPlay.
        local entity = self:Ui(path)
        if not isvalid(entity) then return end
        table.insert(self._T.bindings, { entity = entity, key = entity:ConnectEvent(ButtonClickEvent, action) })
    end

    @ExecSpace("ClientOnly")
    method void BindViewport()
        -- Capture input on a fixed rectangle above the moving layers.
        local input = self:Ui(self.ViewPath .. "/Input")
        local places = self:Ui(self.ViewPath .. "/Content/Places")
        if not isvalid(input) or not isvalid(places) then return end
        self._T.mapInput = input
        self._T.places = places.Children:ToTable()
        self._T.dragDown = input:ConnectEvent(UITouchDownEvent, self.BeginMapDrag)
        self._T.dragMove = input:ConnectEvent(UITouchDragEvent, self.DragMap)
        self._T.dragUp = input:ConnectEvent(UITouchUpEvent, self.EndMapDrag)
        log("[VRF][FactionWarMap] viewport ready labels=" .. tostring(#self._T.places))
    end

    @ExecSpace("ClientOnly")
    method void HandleWheel(MouseScrollEvent event)
        -- Zoom at the cursor, but only while the cursor is inside the viewport.
        if not self._T.open or event.ScrollDelta == 0 then return end
        local view = self:Ui(self.ViewPath)
        if not isvalid(view) then return end
        local cursor = _UILogic:ScreenToLocalUIPosition(_InputService:GetCursorPosition(), view.UITransformComponent)
        self:ZoomMapAt(cursor, event.ScrollDelta)
    end

    @ExecSpace("ClientOnly")
    method void ZoomMapAt(Vector2 cursor, number steps)
        -- Preserve the point under the pointer unless the artwork edge is reached.
        if not self._T.open or self._T.zoom < 1 then return end
        local rect = self:Ui(self.ViewPath).UITransformComponent.RectSize
        if math.abs(cursor.x) > rect.x / 2 or math.abs(cursor.y) > rect.y / 2 then return end
        local zoom = self._T.zoom
        local delta = math.max(-3, math.min(3, steps))
        local nextZoom = math.max(1, math.min(self.MaxZoom, zoom * self.WheelZoomFactor ^ delta))
        if nextZoom == zoom then return end
        local offset = self._T.mapOffset
        local ratio = nextZoom / zoom
        self:SetMapView(nextZoom, Vector2(cursor.x + (offset.x - cursor.x) * ratio,
                                          cursor.y + (offset.y - cursor.y) * ratio))
        if not self._T.wheelLogged then
            self._T.wheelLogged = true
            log("[VRF][FactionWarMap] wheel zoom=" .. tostring(nextZoom))
        end
    end

    @ExecSpace("ClientOnly")
    method void BeginMapDrag(UITouchDownEvent event)
        -- Capture a left click or a single finger that started on the map.
        if not self._T.open or self._T.dragId ~= nil or event.TouchId < -1 then return end
        local view = self:Ui(self.ViewPath)
        self._T.dragId = event.TouchId
        self._T.dragPoint = _UILogic:ScreenToLocalUIPosition(event.TouchPoint, view.UITransformComponent)
        self._T.dragMoved = false
    end

    @ExecSpace("ClientOnly")
    method void DragMap(UITouchDragEvent event)
        -- Measure movement in viewport pixels, independent of the zoom and actual screen resolution.
        if not self._T.open or self._T.dragId ~= event.TouchId then return end
        local view = self:Ui(self.ViewPath)
        local point = _UILogic:ScreenToLocalUIPosition(event.TouchPoint, view.UITransformComponent)
        local previous = self._T.dragPoint
        local offset = self._T.mapOffset
        self._T.dragPoint = point
        self:SetMapView(self._T.zoom, Vector2(offset.x + point.x - previous.x, offset.y + point.y - previous.y))
        self._T.dragMoved = self._T.dragMoved or offset.x ~= self._T.mapOffset.x or offset.y ~= self._T.mapOffset.y
    end

    @ExecSpace("ClientOnly")
    method void EndMapDrag(UITouchUpEvent event)
        -- Release the captured pointer, including when the pointer is outside the viewport.
        if self._T.dragId ~= event.TouchId then return end
        self._T.dragId = nil
        if self._T.dragMoved then log("[VRF][FactionWarMap] drag offset=" .. tostring(self._T.mapOffset)) end
    end

    @ExecSpace("ClientOnly")
    method void SetMapView(number zoom, Vector2 requestedOffset)
        -- Clamp to the artwork edges; at minimum zoom this restores the full-city view.
        local view = self:Ui(self.ViewPath)
        local content = self:Ui(self.ViewPath .. "/Content")
        if not isvalid(view) or not isvalid(content) then return end
        local rect = view.UITransformComponent.RectSize
        local transform = content.UITransformComponent
        local size = transform.RectSize
        local limitX = math.max(0, (size.x * zoom - rect.x) / 2)
        local limitY = math.max(0, (size.y * zoom - rect.y) / 2)
        local offset = Vector2(math.max(-limitX, math.min(limitX, requestedOffset.x)),
                               math.max(-limitY, math.min(limitY, requestedOffset.y)))
        self._T.mapOffset = offset
        transform.anchoredPosition = offset
        if self._T.zoom == zoom then return end
        self._T.zoom = zoom
        transform.UIScale = Vector3(zoom, zoom, 1)
        self:ScaleMapLabels(zoom)
        if self._T.board ~= nil then self:ShowLinks(self._T.links) end
    end

    @ExecSpace("ClientOnly")
    method void ScaleMapLabels(number zoom)
        -- Keep text legible and show the largest districts first when labels collide.
        local content = self.ViewPath .. "/Content"
        local iconScale = math.min(1, 0.12 + 0.13 * zoom)
        local detail = zoom >= 4
        local boxes = {}
        for _, id in ipairs(_FactionWar.TownOrder) do
            local path = content .. "/Towns/" .. id
            local node = self:Ui(path)
            if isvalid(node) then
                local transform = node.UITransformComponent
                local pos = transform.anchoredPosition
                transform.UIScale = Vector3(iconScale / zoom, iconScale / zoom, 1)
                local x = pos.x * zoom
                local y = pos.y * zoom
                local r = 27 * iconScale
                table.insert(boxes, { x0 = x - r, x1 = x + r, y0 = y - r, y1 = y + r })
                for _, part in ipairs({ "Name", "Strength", "Capital" }) do
                    local label = self:Ui(path .. "/" .. part)
                    if isvalid(label) then label.Visible = detail end
                end
                if detail then
                    table.insert(boxes, { x0 = x - 125 * iconScale, x1 = x - 34 * iconScale, y0 = y - r, y1 = y + 28 * iconScale })
                end
            end
        end
        local sea = self:Ui(content .. "/Sea")
        if isvalid(sea) then sea.UITransformComponent.UIScale = Vector3(1 / zoom, 1 / zoom, 1) end
        for _, label in ipairs(self._T.places or {}) do
            local transform = label.UITransformComponent
            local pos = transform.anchoredPosition
            local x = pos.x * zoom
            local y = pos.y * zoom
            local halfWidth = transform.RectSize.x / 2
            local box = { x0 = x - halfWidth, x1 = x + halfWidth, y0 = y - 13, y1 = y + 13 }
            local clear = true
            for _, used in ipairs(boxes) do
                if box.x0 < used.x1 and box.x1 > used.x0 and box.y0 < used.y1 and box.y1 > used.y0 then
                    clear = false
                    break
                end
            end
            label:SetEnable(clear)
            if clear then
                transform.UIScale = Vector3(1 / zoom, 1 / zoom, 1)
                table.insert(boxes, box)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method boolean CanOpen()
        -- The map belongs to the towns; the lobby screen drawn over a town hides it too.
        local player = _UserService.LocalPlayer
        return isvalid(player) and _FactionWar:IsTown(player.CurrentMapName) and not _FormationLobby:IsTownPanelOpen()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Show the entry button only in towns, close the map when the player leaves, and keep the "you are here" mark and the age line current.
        local player = _UserService.LocalPlayer
        local button = self:Ui("OpenButton")
        local overlay = self:Ui("Overlay")
        if not isvalid(player) or not isvalid(button) or not isvalid(overlay) then return end
        if #self._T.bindings == 0 then
            self:Bind("OpenButton", function() self:Open() end)
            self:Bind("Overlay/Window/Close", function() self:Close() end)
            self:BindArrows()
            self:BindViewport()
        end
        local available = self:CanOpen()
        if button.Enable ~= available then button:SetEnable(available) end
        if self._T.open and not available then self:Close() end
        if player.CurrentMapName ~= self._T.mapName then
            self._T.mapName = player.CurrentMapName
            if self._T.open then self:ShowHere() end
        end
        if self._T.open and self._T.board ~= nil then self:ShowAge() end
    end

    @ExecSpace("ClientOnly")
    method void HandleKey(KeyDownEvent event)
        -- M opens the map in a town and closes it anywhere.
        if event == nil or event.key ~= KeyboardKey.M then return end
        if self._T.open then
            self:Close()
        elseif self:CanOpen() then
            self:Open()
        end
    end

    @ExecSpace("ClientOnly")
    method void Open()
        -- Show the map at once with the last board (or neutral), then ask the server for the live one and to keep it coming.
        local overlay = self:Ui("Overlay")
        if self._T.open or not isvalid(overlay) or not self:CanOpen() then return end
        self._T.open = true
        overlay:SetEnable(true)
        self._T.wheelLogged = false
        self:SetMapView(1, Vector2(0, 0))
        if self._T.board == nil then self:ShowNeutral() else self:Render() end
        self:ShowHere()
        self._T.unavailable = false
        self._T.age = -1
        self:SetStatus("正在讀取戰況…")
        _FactionWarMap:RequestOpen()
        log("[VRF][FactionWarMap] ui open town=" .. self._T.mapName)
    end

    @ExecSpace("ClientOnly")
    method void Close()
        -- Hide the map and stop the server pushing to this client.
        if not self._T.open then return end
        self._T.open = false
        self._T.dragId = nil
        local overlay = self:Ui("Overlay")
        if isvalid(overlay) then overlay:SetEnable(false) end
        _FactionWarMap:RequestClose()
        log("[VRF][FactionWarMap] ui close")
    end

    @ExecSpace("ClientOnly")
    method Color OwnerColor(string owner)
        -- Faction colour shared by the districts, crests and bars.
        if owner == "RED" then return self.RedColor end
        if owner == "BLUE" then return self.BlueColor end
        return self.NeutralColor
    end

    @ExecSpace("ClientOnly")
    method string OwnerName(string owner)
        -- The faction as players read it.
        if owner == "RED" then return "紅方" end
        if owner == "BLUE" then return "藍方" end
        return "未知"
    end

    @ExecSpace("ClientOnly")
    method void ShowNeutral()
        -- Before the first board arrives every town is grey and every link hidden.
        for _, id in ipairs(_FactionWar.TownOrder) do
            self:ShowTown({ id = id, name = _FactionWar.TownNames[id], owner = "", strength = 0, capital = _FactionWarAttack:IsCapital(id) })
        end
        self:ShowLinks({})
    end

    @ExecSpace("ClientOnly")
    method void ShowBoard(table towns, table links)
        -- Paint the board the server pushed: districts, crests, rows and links. A board that lands after the map closed is kept for next time.
        self._T.board = towns
        self._T.links = links
        self._T.receivedAt = DateTime.UtcNow.Elapsed
        self._T.age = -1
        self._T.unavailable = false
        if not self._T.open then return end
        local summary = {}
        for _, town in ipairs(towns) do table.insert(summary, town.id .. "=" .. town.owner .. "/" .. tostring(town.strength)) end
        self:Render()
        self:ShowAge()
        -- The town HUD only rereads on entering a town; the pushed board keeps it in step while the map is open.
        for _, town in ipairs(towns) do
            if town.id == self._T.mapName then _FactionWarUI:ShowTownStatus(town.id, tostring(town.strength)) end
        end
        log("[VRF][FactionWarMap] ui board " .. table.concat(summary, " ") .. " links=" .. tostring(#links))
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Paint the last board received: districts, crests, rows, links and the "you are here" mark.
        for _, town in ipairs(self._T.board) do self:ShowTown(town) end
        self:ShowLinks(self._T.links)
        self:ShowHere()
    end

    @ExecSpace("ClientOnly")
    method void ShowTown(table town)
        -- One town on the map and in the side list.
        local color = self:OwnerColor(town.owner)
        local known = town.owner == "RED" or town.owner == "BLUE"
        local district = self:Ui(self.ViewPath .. "/Content/Districts/" .. town.id)
        if isvalid(district) then district.SpriteGUIRendererComponent.Color = Color(color.r, color.g, color.b, known and self.DistrictAlpha or 0.25) end
        local node = self.ViewPath .. "/Content/Towns/" .. town.id
        local crest = self:Ui(node .. "/Crest")
        if isvalid(crest) then crest.SpriteGUIRendererComponent.Color = color end
        local strength = known and (tostring(town.strength) .. "/" .. tostring(self.FullStrength)) or "—"
        local label = self:Ui(node .. "/Strength")
        if isvalid(label) then label.TextGUIRendererComponent.Text = "兵力 " .. strength end
        local capital = self:Ui(node .. "/Capital")
        if isvalid(capital) then capital:SetEnable(town.capital == true) end
        local row = "Overlay/Window/Side/Rows/" .. town.id
        local owner = self:Ui(row .. "/Owner")
        if isvalid(owner) then
            owner.TextGUIRendererComponent.Text = known and (self:OwnerName(town.owner) .. (town.capital and "・主城" or "")) or "讀取中"
            owner.TextGUIRendererComponent.FontColor = known and color or Color(0.85, 0.82, 0.76, 1)
        end
        local value = self:Ui(row .. "/Value")
        if isvalid(value) then value.TextGUIRendererComponent.Text = strength end
        local fill = self:Ui(row .. "/Bar/Fill")
        if isvalid(fill) then
            local ratio = known and math.max(0, math.min(1, town.strength / self.FullStrength)) or 0
            fill:SetEnable(ratio > 0)
            fill.UITransformComponent.RectSize = Vector2(self.BarWidth * ratio, fill.UITransformComponent.RectSize.y)
            fill.SpriteGUIRendererComponent.Color = color
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowLinks(table links)
        -- Draw each gate connection as a bar between the two crests; unused bars stay hidden.
        for slot = 1, self.LinkSlots do
            local bar = self:Ui(self.ViewPath .. "/Content/Links/Link" .. tostring(slot))
            local link = links[slot]
            if isvalid(bar) then
                local from = link ~= nil and self:Ui(self.ViewPath .. "/Content/Towns/" .. link.a) or nil
                local to = link ~= nil and self:Ui(self.ViewPath .. "/Content/Towns/" .. link.b) or nil
                if isvalid(from) and isvalid(to) then
                    local a = from.UITransformComponent.anchoredPosition
                    local b = to.UITransformComponent.anchoredPosition
                    local dx = b.x - a.x
                    local dy = b.y - a.y
                    local transform = bar.UITransformComponent
                    transform.anchoredPosition = Vector2((a.x + b.x) / 2, (a.y + b.y) / 2)
                    transform.RectSize = Vector2(math.sqrt(dx * dx + dy * dy), self.LinkThickness / math.max(1, self._T.zoom))
                    transform.ZRotation = math.deg(math.atan(dy, dx))
                    bar:SetEnable(true)
                else
                    bar:SetEnable(false)
                end
            end
        end
        if #links > self.LinkSlots then log_warning("[VRF][FactionWarMap] more links than bars: " .. tostring(#links)) end
    end

    @ExecSpace("ClientOnly")
    method void ShowHere()
        -- Mark the town the local player stands in: the arrow on the map, the line in the list.
        for _, id in ipairs(_FactionWar.TownOrder) do
            local arrow = self:Ui(self.ViewPath .. "/Content/Towns/" .. id .. "/Arrow")
            if isvalid(arrow) then arrow:SetEnable(id == self._T.mapName) end
            local mark = self:Ui("Overlay/Window/Side/Rows/" .. id .. "/Here")
            if isvalid(mark) then mark:SetEnable(id == self._T.mapName) end
        end
    end

    @ExecSpace("ClientOnly")
    method void ShowFaction(string faction)
        -- The player's own faction at the top of the side panel.
        local label = self:Ui("Overlay/Window/Side/Faction")
        if not isvalid(label) then return end
        local text = "尚未加入陣營"
        if faction == "RED" or faction == "BLUE" then text = self:OwnerName(faction)
        elseif faction == "UNREADABLE" then text = "讀取失敗" end
        label.TextGUIRendererComponent.Text = text
        label.TextGUIRendererComponent.FontColor = (faction == "RED" or faction == "BLUE") and self:OwnerColor(faction) or Color(0.93, 0.78, 0.56, 1)
        log("[VRF][FactionWarMap] ui faction=" .. faction)
    end

    @ExecSpace("ClientOnly")
    method void ShowUnavailable(string reason)
        -- Keep the last board on screen and say the live one could not be read.
        self._T.unavailable = true
        self:SetStatus(reason == "NOT_IN_TOWN" and "只能在城鎮中查看大地圖" or "暫時無法讀取國戰資料，請稍後重新開啟")
        log("[VRF][FactionWarMap] ui unavailable reason=" .. reason)
    end

    @ExecSpace("ClientOnly")
    method void ShowAge()
        -- "N seconds ago", rewritten only when the whole-second value changes.
        if self._T.unavailable then return end
        local age = math.max(0, math.floor((DateTime.UtcNow.Elapsed - self._T.receivedAt) / 1000))
        if age == self._T.age then return end
        self._T.age = age
        self:SetStatus("戰況變動時自動更新・" .. (age < 1 and "剛剛同步" or (tostring(age) .. " 秒前同步")))
    end

    @ExecSpace("ClientOnly")
    method void SetStatus(string text)
        -- The status line under the legend.
        local status = self:Ui("Overlay/Window/Side/Status")
        if isvalid(status) then status.TextGUIRendererComponent.Text = text end
    end
end
