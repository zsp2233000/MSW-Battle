@Logic
script FactionWarAttack extends Logic

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Track pending option and attack reads in this room.
        self._T.reading = {}
        log("[VRF][FactionWarAttack] ready")
    end

    @ExecSpace("ServerOnly")
    method table Targets(string origin, string faction, table towns)
        -- Enemy towns directly connected to origin by an authored gate, in map order.
        local list = {}
        if towns[origin] == nil or towns[origin].owner ~= faction then return list end
        for _, id in ipairs(_FactionWarTownDocument.TownOrder) do
            if towns[id].owner ~= faction and isvalid(_FactionWar:FindGate(origin, id)) then
                table.insert(list, { town = id, name = _FactionWarTownDocument.TownNames[id], capital = _FactionWarTownDocument:IsCapital(id) })
            end
        end
        return list
    end

    @ExecSpace("ServerOnly")
    method boolean CanTarget(string origin, string target, string faction, table towns)
        -- Only an adjacent enemy town can be attacked from the player's own town.
        for _, option in ipairs(self:Targets(origin, faction, towns)) do
            if option.town == target then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean IsEngaged(string userId)
        -- From the first queue command until the match settles and the ticket is released, the player stays put.
        return _MatchFlow:StateForUser(userId) ~= "IDLE" or _FormationHandoff:IsLockedForUser(userId)
    end

    @ExecSpace("ServerOnly")
    method void Resolve(Entity player, string userId, string town, any answer)
        -- Read the caller's faction and the live town table once, then hand both to answer.
        local profile = player.PlayerComponent.ProfileCode
        _FactionWar:ReadFaction(profile, function(faction)
            _FactionWarTownDocument:Read(function(towns)
                self._T.reading[userId] = nil
                if not _FactionWar:StillIn(player, userId, town) then
                    log("[VRF][FactionWarAttack] answer dropped user=" .. userId .. " town=" .. town .. "; the player is no longer there")
                    return
                end
                answer(faction, towns)
            end)
        end)
    end

    @ExecSpace("Server")
    method void RequestOptions()
        -- The NPC dialog asks for the caller's own options; the caller identity comes from the server.
        self:OptionsFor(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void OptionsFor(string userId)
        -- List the attackable towns for the player's current town; the dialog shows exactly this answer.
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local town = player.CurrentMapName
        if not _FactionWar:IsTown(town) or self._T.reading[userId] then return end
        self._T.reading[userId] = true
        self:Resolve(player, userId, town, function(faction, towns)
            if towns == nil or faction == nil or faction == "" then
                self:ReceiveOptions(town, {}, "UNAVAILABLE", userId)
            elseif towns[town].owner ~= faction then
                self:ReceiveOptions(town, {}, "NOT_OWNED", userId)
                -- A player standing in a town that fell is sent to their capital, whichever room delivered the news.
                _FactionWarLanding:Judge(userId, { kind = "CHECK", town = town, board = towns })
            else
                self:ReceiveOptions(town, self:Targets(town, faction, towns), self:IsEngaged(userId) and "ENGAGED" or "READY", userId)
            end
        end)
    end

    @ExecSpace("Server")
    method void RequestAttack(string target)
        -- Queue the caller against one adjacent enemy town; the caller identity comes from the server.
        self:AttackFor(senderUserId, target)
    end

    @ExecSpace("ServerOnly")
    method void AttackFor(string userId, string target)
        -- Every check repeats on the server: ownership, adjacency and that the player is not already engaged.
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then
            log("[VRF][FactionWarAttack] queue refused user=" .. userId .. " reason=NO_PLAYER")
            return
        end
        local origin = player.CurrentMapName
        if not _FactionWar:IsTown(origin) or not _FactionWar:IsTown(target) then
            log("[VRF][FactionWarAttack] queue refused user=" .. userId .. " reason=NOT_A_TOWN origin=" .. origin .. " target=" .. target)
            return
        end
        if self._T.reading[userId] then
            log("[VRF][FactionWarAttack] queue refused user=" .. userId .. " reason=READING a request of this player is still being read")
            return
        end
        self._T.reading[userId] = true
        self:Resolve(player, userId, origin, function(faction, towns)
            if self:IsEngaged(userId) then
                log("[VRF][FactionWarAttack] queue refused user=" .. userId .. " reason=ENGAGED state=" .. _MatchFlow:StateForUser(userId))
                self:ReceiveAttackResult("ENGAGED", userId)
            elseif towns == nil or faction == nil or faction == "" then
                log("[VRF][FactionWarAttack] queue refused user=" .. userId .. " reason=UNAVAILABLE faction=" .. tostring(faction) .. " towns=" .. tostring(towns ~= nil))
                self:ReceiveAttackResult("UNAVAILABLE", userId)
            elseif not self:CanTarget(origin, target, faction, towns) then
                log("[VRF][FactionWarAttack] queue refused user=" .. userId .. " reason=INVALID " .. origin .. " -> " .. target .. " faction=" .. faction)
                self:ReceiveAttackResult("INVALID", userId)
            else
                log("[VRF][FactionWarAttack] queue " .. origin .. " -> " .. target)
                self:ReceiveAttackResult("QUEUING", userId)
                _MatchFlow:QueueForWar(userId, origin, target)
            end
        end)
    end

    @ExecSpace("Client")
    method void ReceiveOptions(string town, table options, string status)
        -- Deliver the server's attack options to the caller's dialog.
        _FactionWarUI:ShowAttackOptions(town, options, status)
    end

    @ExecSpace("Client")
    method void ReceiveAttackResult(string result)
        -- Tell the caller whether the attack request was queued or why it was refused.
        _FactionWarUI:ShowAttackResult(result)
    end

    @ExecSpace("ServerOnly")
    method void Finish(string matchKey, string status, any detail, table outcome, any complete)
        -- Keep the confirmed outcome for return and publish any effects outside the town document.
        local applied = status == "SAVED" or status == "DUPLICATE" or status == "EXEMPT"
        if applied then _FactionWarLanding:RememberOutcome(matchKey, outcome) end
        log("[VRF][FactionWarAttack] settle match=" .. matchKey .. " status=" .. status .. " loser=" .. outcome.loser .. " amount=" .. tostring(outcome.amount) .. " flipped=" .. tostring(outcome.flipped) .. " owner=" .. outcome.owner .. " conflicts=" .. tostring(outcome.conflicts))
        if complete ~= nil then complete(status, detail, outcome) end
        -- A repeat announces again on purpose: the sweep is idempotent and the first announcement may have been lost.
        if applied and outcome.flipped then _FactionWar:AnnounceFall(outcome.loser, outcome.owner) end
        -- Open world maps follow the board; a repeat announces again for the same reason as the fall.
        if status == "SAVED" or status == "DUPLICATE" then _FactionWarMap:AnnounceChange() end
    end

    method any Combine(any first, any second)
        -- Both tickets of a human match carry their own stamp; the smaller count (the earlier reading) decides, and a ticket without one adds nothing.
        local home, away = nil, nil
        for _, pairing in pairs({ first = first, second = second }) do
            if type(pairing) == "table" and type(pairing.homeEpoch) == "number" and type(pairing.awayEpoch) == "number" then
                home = home == nil and pairing.homeEpoch or math.min(home, pairing.homeEpoch)
                away = away == nil and pairing.awayEpoch or math.min(away, pairing.awayEpoch)
            end
        end
        if home == nil then return nil end
        return { home = home, away = away }
    end

    method any Stamped(table matched, any snapshot)
        -- A copy of the pairing that also says how often its two towns had changed hands when it was made; the adapter's own table is never touched.
        if type(snapshot) ~= "table" then return matched end
        local copy = {}
        for key, value in pairs(matched) do copy[key] = value end
        copy.homeEpoch = snapshot.home
        copy.awayEpoch = snapshot.away
        return copy
    end

    @ExecSpace("ServerOnly")
    method any Snapshot(table matched)
        -- How often each of the pairing's two towns has changed hands right now; false for a lobby pairing or when the town table cannot be read.
        local home, away = matched.homeOrigin or "", matched.awayOrigin or ""
        if not _FactionWar:IsTown(home) or not _FactionWar:IsTown(away) then return false end
        local towns = _FactionWarLanding:ReadBoard()
        if towns == nil then
            log("[VRF][FactionWarAttack] stamp unreadable match=" .. tostring(matched.key) .. "; it is settled without a stamp")
            return false
        end
        local stamp = { home = _FactionWarTownDocument:EpochOf(towns, home), away = _FactionWarTownDocument:EpochOf(towns, away) }
        log("[VRF][FactionWarAttack] stamp match=" .. tostring(matched.key) .. " " .. home .. "=" .. tostring(stamp.home) .. " " .. away .. "=" .. tostring(stamp.away))
        return stamp
    end

    @ExecSpace("ServerOnly")
    method void Settle(string matchKey, string homeTown, string awayTown, string homeResult, string kind, any complete, any snapshot)
        -- Submit the battle result and pairing stamp; the document owns all rules and persistence.
        _FactionWarTownDocument:Settle({ matchKey = matchKey, home = homeTown, away = awayTown,
            result = homeResult, kind = kind, snapshot = snapshot }, function(status, detail, outcome)
            self:Finish(matchKey, status, detail, outcome, complete)
        end)
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        self._T.reading[event.UserId] = nil
    end
end
