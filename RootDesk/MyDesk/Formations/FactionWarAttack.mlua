@Logic
script FactionWarAttack extends Logic

    property table Capitals = { nanzih = true, yancheng = true }
    property integer HumanDeduction = 20
    property integer GuardDeduction = 10
    property integer SettleAttempts = 4
    property number SettleRetrySeconds = 1
    property integer SettleConflicts = 10
    property number ConflictRetrySeconds = 0.3
    property integer SettledHistory = 20
    property integer FullStrength = 100
    property number LandingWaitSeconds = 5
    property integer LandingReadAttempts = 2
    property number ReadWaitSeconds = 5

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Each room settles its own match results; the timers and in-flight keys never outlive the room.
        self._T.reading = {}
        self._T.settling = {}
        self._T.outcomes = {}
        self._T.timers = {}
        log("[VRF][FactionWarAttack] ready")
    end

    method boolean IsCapital(string town)
        -- A capital can be targeted but never falls and never loses strength.
        return self.Capitals[town] == true
    end

    method integer Deduction(string target, string result, any kind)
        -- Strength a win takes from the target town (a guard win takes less than a human win); a draw, a loss or a capital takes nothing.
        if result ~= "WIN" or self:IsCapital(target) then return 0 end
        return kind == "GUARD" and self.GuardDeduction or self.HumanDeduction
    end

    @ExecSpace("ServerOnly")
    method table Targets(string origin, string faction, table towns)
        -- Enemy towns directly connected to origin by an authored gate, in map order.
        local list = {}
        if towns[origin] == nil or towns[origin].owner ~= faction then return list end
        for _, id in ipairs(_FactionWar.TownOrder) do
            if towns[id].owner ~= faction and isvalid(_FactionWar:FindGate(origin, id)) then
                table.insert(list, { town = id, name = _FactionWar.TownNames[id], capital = self:IsCapital(id) })
            end
        end
        return list
    end

    @ExecSpace("ServerOnly")
    method boolean CanTarget(string origin, string target, string faction, table towns)
        -- Only an adjacent enemy town can be attacked from the player's own town.
        for _, option in ipairs(self:Targets(origin, faction, towns)) do
            if option.town == target then return true end
        end
        return false
    end

    @ExecSpace("ServerOnly")
    method boolean IsEngaged(string userId)
        -- From the first queue command until the match settles and the ticket is released, the player stays put.
        return _MatchFlow:StateForUser(userId) ~= "IDLE" or _FormationHandoff:IsLockedForUser(userId)
    end

    @ExecSpace("ServerOnly")
    method boolean StillHere(Entity player, string userId, string town)
        -- An answer may arrive after the player left the town or the server.
        return isvalid(player) and _UserService:GetUserEntityByUserId(userId) == player and player.CurrentMapName == town
    end

    @ExecSpace("ServerOnly")
    method void Resolve(Entity player, string userId, string town, any answer)
        -- Read the caller's faction and the live town table once, then hand both to answer.
        local profile = player.PlayerComponent.ProfileCode
        _FactionWar:ReadFaction(profile, function(faction)
            _FactionWar:ReadTowns(function(towns)
                self._T.reading[userId] = nil
                if not self:StillHere(player, userId, town) then return end
                answer(faction, towns)
            end)
        end)
    end

    @ExecSpace("Server")
    method void RequestOptions()
        -- The NPC dialog asks for the caller's own options; the caller identity comes from the server.
        self:OptionsFor(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void OptionsFor(string userId)
        -- List the attackable towns for the player's current town; the dialog shows exactly this answer.
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local town = player.CurrentMapName
        if not _FactionWar:IsTown(town) or self._T.reading[userId] then return end
        self._T.reading[userId] = true
        self:Resolve(player, userId, town, function(faction, towns)
            if towns == nil or faction == nil or faction == "" then
                self:ReceiveOptions(town, {}, "UNAVAILABLE", userId)
            elseif towns[town].owner ~= faction then
                self:ReceiveOptions(town, {}, "NOT_OWNED", userId)
                -- A player standing in a town that fell is sent to their capital, whichever room delivered the news.
                _FactionWar:Enforce(userId, town, towns)
            else
                self:ReceiveOptions(town, self:Targets(town, faction, towns), self:IsEngaged(userId) and "ENGAGED" or "READY", userId)
            end
        end)
    end

    @ExecSpace("Server")
    method void RequestAttack(string target)
        -- Queue the caller against one adjacent enemy town; the caller identity comes from the server.
        self:AttackFor(senderUserId, target)
    end

    @ExecSpace("ServerOnly")
    method void AttackFor(string userId, string target)
        -- Every check repeats on the server: ownership, adjacency and that the player is not already engaged.
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) or not isvalid(player.PlayerComponent) then return end
        local origin = player.CurrentMapName
        if not _FactionWar:IsTown(origin) or not _FactionWar:IsTown(target) or self._T.reading[userId] then return end
        self._T.reading[userId] = true
        self:Resolve(player, userId, origin, function(faction, towns)
            if self:IsEngaged(userId) then
                self:ReceiveAttackResult("ENGAGED", userId)
            elseif towns == nil or faction == nil or faction == "" then
                self:ReceiveAttackResult("UNAVAILABLE", userId)
            elseif not self:CanTarget(origin, target, faction, towns) then
                self:ReceiveAttackResult("INVALID", userId)
            else
                log("[VRF][FactionWarAttack] queue " .. origin .. " -> " .. target)
                self:ReceiveAttackResult("QUEUING", userId)
                _MatchFlow:QueueForWar(userId, origin, target)
            end
        end)
    end

    @ExecSpace("Client")
    method void ReceiveOptions(string town, table options, string status)
        -- Deliver the server's attack options to the caller's dialog.
        _FactionWarUI:ShowAttackOptions(town, options, status)
    end

    @ExecSpace("Client")
    method void ReceiveAttackResult(string result)
        -- Tell the caller whether the attack request was queued or why it was refused.
        _FactionWarUI:ShowAttackResult(result)
    end

    @ExecSpace("ServerOnly")
    method void Finish(table operation, string status, any detail)
        -- Settle exactly once per match; stale retries and late callbacks cannot report again.
        if operation.finished then return end
        operation.finished = true
        self._T.settling[operation.matchKey] = nil
        local outcome = { status = status, winner = operation.winner or "", loser = operation.loser, amount = operation.amount,
            strength = operation.strength or 0, flipped = operation.flipped == true, owner = operation.owner or "" }
        local applied = status == "SAVED" or status == "DUPLICATE" or status == "EXEMPT"
        -- The returning players land by what this match did (an exempt match did nothing to any town), so the room keeps it for them.
        if applied then self._T.outcomes[operation.matchKey] = outcome end
        log("[VRF][FactionWarAttack] settle match=" .. operation.matchKey .. " status=" .. status .. " loser=" .. operation.loser .. " amount=" .. tostring(operation.amount) .. " flipped=" .. tostring(outcome.flipped) .. " owner=" .. outcome.owner)
        if operation.complete ~= nil then operation.complete(status, detail, outcome) end
        -- A repeat announces again on purpose: the sweep is idempotent and the first announcement may have been lost.
        if applied and outcome.flipped then _FactionWar:AnnounceFall(outcome.loser, outcome.owner) end
    end

    method any Combine(any first, any second)
        -- Both tickets of a human match carry their own stamp; the smaller count (the earlier reading) decides, and a ticket without one adds nothing.
        local home, away = nil, nil
        for _, pairing in pairs({ first = first, second = second }) do
            if type(pairing) == "table" and type(pairing.homeEpoch) == "number" and type(pairing.awayEpoch) == "number" then
                home = home == nil and pairing.homeEpoch or math.min(home, pairing.homeEpoch)
                away = away == nil and pairing.awayEpoch or math.min(away, pairing.awayEpoch)
            end
        end
        if home == nil then return nil end
        return { home = home, away = away }
    end

    method boolean ChangedSince(any snapshot, string homeTown, string awayTown, table towns)
        -- Either town of the match has changed hands since its pairing (taken back or not): a count only ever grows, so any difference means a flip.
        if type(snapshot) ~= "table" or type(snapshot.home) ~= "number" or type(snapshot.away) ~= "number" then return false end
        return _FactionWar:EpochOf(towns, homeTown) ~= snapshot.home or _FactionWar:EpochOf(towns, awayTown) ~= snapshot.away
    end

    method any Stamped(table matched, any snapshot)
        -- A copy of the pairing that also says how often its two towns had changed hands when it was made; the adapter's own table is never touched.
        if type(snapshot) ~= "table" then return matched end
        local copy = {}
        for key, value in pairs(matched) do copy[key] = value end
        copy.homeEpoch = snapshot.home
        copy.awayEpoch = snapshot.away
        return copy
    end

    @ExecSpace("ServerOnly")
    method any Snapshot(table matched)
        -- How often each of the pairing's two towns has changed hands right now; false for a lobby pairing or when the town table cannot be read.
        local home, away = matched.homeOrigin or "", matched.awayOrigin or ""
        if not _FactionWar:IsTown(home) or not _FactionWar:IsTown(away) then return false end
        local towns = self:Await(function(done) _FactionWar:ReadTowns(done) end)
        if towns == nil then
            log("[VRF][FactionWarAttack] stamp unreadable match=" .. tostring(matched.key) .. "; it is settled without a stamp")
            return false
        end
        local stamp = { home = _FactionWar:EpochOf(towns, home), away = _FactionWar:EpochOf(towns, away) }
        log("[VRF][FactionWarAttack] stamp match=" .. tostring(matched.key) .. " " .. home .. "=" .. tostring(stamp.home) .. " " .. away .. "=" .. tostring(stamp.away))
        return stamp
    end

    @ExecSpace("ServerOnly")
    method void Settle(string matchKey, string homeTown, string awayTown, string homeResult, string kind, any complete, any snapshot)
        -- Take the win deduction from the losing side's town exactly once; the match key makes a retry harmless.
        -- A guard match only ever costs the guarded town: the guard has no town of its own to win strength for.
        -- snapshot (optional) is the stamp the pairing carried; a match whose towns changed hands since then deducts nothing.
        local operation = { matchKey = matchKey, home = homeTown, away = awayTown, loser = "", amount = 0, attempts = 0, conflicts = 0, failures = 0, complete = complete, snapshot = snapshot }
        if matchKey == "" or not _FactionWar:IsTown(homeTown) or not _FactionWar:IsTown(awayTown) or homeTown == awayTown then
            self:Finish(operation, "SKIPPED", nil)
            return
        end
        if homeResult == "WIN" then
            operation.winner, operation.loser = homeTown, awayTown
        elseif homeResult == "LOSE" and kind ~= "GUARD" then
            operation.winner, operation.loser = awayTown, homeTown
        end
        if operation.winner ~= nil then operation.amount = self:Deduction(operation.loser, "WIN", kind) end
        if operation.amount == 0 then
            self:Finish(operation, "NO_CHANGE", nil)
            return
        end
        if self._T.settling[matchKey] then return end
        self._T.settling[matchKey] = true
        self:Attempt(operation)
    end

    @ExecSpace("ServerOnly")
    method void Retry(table operation, boolean conflict)
        -- A lost race (another settlement wrote first) reads again almost at once; a failure waits longer. Each has its own bound, and an exhausted settlement is reported failed.
        if operation.finished then return end
        local delay = self.SettleRetrySeconds
        if conflict then
            operation.conflicts = operation.conflicts + 1
            if operation.conflicts > self.SettleConflicts then self:Finish(operation, "FAILED", nil) return end
            delay = self.ConflictRetrySeconds
        else
            operation.failures = operation.failures + 1
            if operation.failures >= self.SettleAttempts then self:Finish(operation, "FAILED", nil) return end
        end
        log("[VRF][FactionWarAttack] settle retry match=" .. operation.matchKey .. " conflict=" .. tostring(conflict) .. " conflicts=" .. tostring(operation.conflicts) .. " failures=" .. tostring(operation.failures))
        local timer = 0
        timer = _TimerService:SetTimerOnce(function()
            self._T.timers[timer] = nil
            self:Attempt(operation)
        end, delay)
        self._T.timers[timer] = true
    end

    method string EntryKey(any entry)
        -- A settled entry is a bare match key (older documents) or a record that carries the key and what the match did.
        if type(entry) == "table" then return tostring(entry.k) end
        return tostring(entry)
    end

    @ExecSpace("ServerOnly")
    method void Attempt(table operation)
        -- Read the town document with its stored bytes, decide on that reading and swap the result in; a lost race goes back to the read.
        -- The settled list dedupes across attempts and rooms, and the swap lets only one of two overlapping settlements change the same bytes.
        if operation.finished then return end
        operation.attempts = operation.attempts + 1
        _FactionWar:ReadTownsRaw(function(towns, raw)
            if operation.finished then return end
            if towns == nil or (towns.settled ~= nil and type(towns.settled) ~= "table") then self:Retry(operation, false) return end
            for _, entry in ipairs(towns.settled or {}) do
                if self:EntryKey(entry) == operation.matchKey then
                    -- A repeat reports what the first delivery did, so a lost answer still reaches the landing and the sweep.
                    if type(entry) == "table" then
                        operation.strength = entry.s
                        operation.owner = entry.o
                        operation.flipped = entry.o ~= nil and entry.o ~= ""
                    end
                    self:Finish(operation, "DUPLICATE", nil)
                    return
                end
            end
            -- A match paired on an older board than this one touches no town: either of its towns has changed hands since (even if it was taken back).
            -- It keeps its win, loss or draw and its experience; only the town effect is gone, so no strength moves and nobody advances.
            if self:ChangedSince(operation.snapshot, operation.home, operation.away, towns) then
                operation.strength = towns[operation.loser].strength
                log("[VRF][FactionWarAttack] exempt match=" .. operation.matchKey .. " " .. operation.home .. "=" .. tostring(_FactionWar:EpochOf(towns, operation.home)) .. "/" .. tostring(operation.snapshot.home) .. " " .. operation.away .. "=" .. tostring(_FactionWar:EpochOf(towns, operation.away)) .. "/" .. tostring(operation.snapshot.away))
                self:Finish(operation, "EXEMPT", nil)
                return
            end
            -- A result with no stamp (an older ticket, or an unreadable board at pairing) is guarded by the owners alone.
            if towns[operation.winner].owner == towns[operation.loser].owner then self:Finish(operation, "SKIPPED", nil) return end
            local updated = { settled = {} }
            for _, id in ipairs(_FactionWar.TownOrder) do
                updated[id] = { owner = towns[id].owner, strength = towns[id].strength, e = towns[id].e }
            end
            for _, entry in ipairs(towns.settled or {}) do table.insert(updated.settled, entry) end
            -- Zero strength hands the town to the winner's side and refills it in the same write; a stored town never holds zero.
            local remaining = towns[operation.loser].strength - operation.amount
            local flipped = remaining <= 0
            if flipped then
                updated[operation.loser] = { owner = towns[operation.winner].owner, strength = self.FullStrength, e = (towns[operation.loser].e or 0) + 1 }
            else
                updated[operation.loser].strength = remaining
            end
            local record = { k = operation.matchKey, w = operation.winner, l = operation.loser, s = updated[operation.loser].strength, o = flipped and updated[operation.loser].owner or "" }
            table.insert(updated.settled, record)
            while #updated.settled > self.SettledHistory do table.remove(updated.settled, 1) end
            _FactionWar:SwapTowns(raw, updated, function(result)
                if operation.finished then return end
                if result == "OK" then
                    operation.strength = record.s
                    operation.owner = record.o
                    operation.flipped = flipped
                    self:Finish(operation, "SAVED", record.s)
                elseif result == "CONFLICT" then
                    -- Another settlement changed the document first; read it again and decide on what it left (it may have taken this town).
                    log("[VRF][FactionWarAttack] settle conflict match=" .. operation.matchKey .. " conflicts=" .. tostring(operation.conflicts + 1))
                    self:Retry(operation, true)
                else
                    self:Retry(operation, false)
                end
            end)
        end)
    end

    @ExecSpace("ServerOnly")
    method any Await(any start)
        -- Run a callback-style read and wait a bounded time for its answer; nil means it never answered (or answered nothing usable).
        local box = { done = false }
        start(function(value)
            box.value = value
            box.done = true
        end)
        local waited = 0
        while not box.done and waited < self.ReadWaitSeconds do
            wait(0.1)
            waited = waited + 0.1
        end
        return box.value
    end

    @ExecSpace("ServerOnly")
    method string LandingFor(string userId, any ticket)
        -- Where a war player stands after the match: the town they took, else the one they left while their faction still holds it, else their capital.
        local origin = ticket.data.origin or ""
        local matchKey = ticket.data.matchKey or ""
        local player = _UserService:GetUserEntityByUserId(userId)
        if origin == "" or not isvalid(player) then return origin end
        -- A fast return click can beat the settlement write; the landing must see the finished town table.
        local waited = 0
        while self._T.settling[matchKey] and waited < self.LandingWaitSeconds do
            wait(0.1)
            waited = waited + 0.1
        end
        local outcome = self._T.outcomes[matchKey]
        local preferred = origin
        if outcome ~= nil and outcome.flipped and outcome.winner == origin then preferred = outcome.loser end
        local profile = player.PlayerComponent.ProfileCode
        -- Every return reads the live board itself (a retried return sees the newest owner); a missing answer is read again before the departure town is trusted.
        local faction, towns = nil, nil
        for attempt = 1, self.LandingReadAttempts do
            faction = self:Await(function(done) _FactionWar:ReadFaction(profile, done) end)
            towns = self:Await(function(done) _FactionWar:ReadTowns(done) end)
            if faction ~= nil and towns ~= nil then break end
            log("[VRF][FactionWarAttack] landing read missing user=" .. userId .. " attempt=" .. tostring(attempt))
        end
        if faction == nil or faction == "" or towns == nil then
            log("[VRF][FactionWarAttack] landing unreadable user=" .. userId .. " origin=" .. origin .. "; keeps the departure town")
            return origin
        end
        local destination = _FactionWar:Landing(faction, preferred, towns)
        log("[VRF][FactionWarAttack] landing user=" .. userId .. " faction=" .. faction .. " origin=" .. origin .. " preferred=" .. preferred .. " destination=" .. destination .. " conqueror=" .. tostring(preferred ~= origin))
        return destination
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- Abandon pending retries without issuing shutdown writes.
        for timer, _ in pairs(self._T.timers or {}) do _TimerService:ClearTimer(timer) end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        self._T.reading[event.UserId] = nil
    end
end
