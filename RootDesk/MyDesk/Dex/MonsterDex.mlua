@Logic
script MonsterDex extends Logic

    -- Bound by UIBuilder (ui/MonsterDexGroup.ui and the lobby button in ui/FormationGroup.ui).
    property Entity book = "e022dc95-05c7-46b2-830f-1561b4267dbf"
    property ButtonComponent closeButton = "16cd671f-6e16-41b3-b974-94dcebe9800b"
    property ScrollLayoutGroupComponent listLayout = "db53d2f8-c948-41a7-b698-30d9f4d88689"
    property Entity rowTemplate = "a04d24d8-ec76-4418-9b59-84850c171b7b"
    property TextGUIRendererComponent statusText = "42a06858-b407-47fd-8a51-f26e0a35d853"
    property ButtonComponent lobbyButton = "415c41cd-970f-424e-946f-37c6a3a89489"
    property ScrollLayoutGroupComponent detailLayout = "34659be3-bdc5-4a22-8e8d-42723cdbc393"
    property Entity headerTemplate = "9608ae32-42e0-438d-b8a2-b8a56629e208"
    property Entity detailTemplate = "8304bc60-6f15-440d-9082-9e8939b2bbcb"
    property SpriteGUIRendererComponent stageSprite = "7ea08451-3f20-4d55-8c56-77a6d149b029"
    property ButtonComponent idleButton = "acf2c38e-3444-4d3e-8c7b-caabefc3ff78"
    property ButtonComponent moveButton = "4d0064ba-16d1-478f-8f06-96ffeef32ba2"
    property ButtonComponent attackButton = "b3d24340-87cd-4927-a97f-3bc930503b38"
    property ButtonComponent hurtButton = "56c8e073-419d-41d5-b9be-d3cd2b66104e"
    property ButtonComponent dieButton = "faee53ab-737c-4f86-a335-be3961cf6849"
    property TextGUIRendererComponent stageNotice = "8d4a31b5-500e-43ba-bdc0-7fcaabb171c5"
    property SpriteGUIRendererComponent attackEffectSprite = "f7b6fd4b-00ba-40a2-a81a-2103a3ea9f55"
    property SpriteGUIRendererComponent hitEffectSprite = "5e8fd714-47e4-4c60-8385-46a63b1267bd"
    property TextGUIRendererComponent scaleLabel = "52934094-7804-4cb6-bbcd-8fa05fc9a5d3"
    property SpriteGUIRendererComponent projectileSprite = "c3097106-255b-4ae7-9386-34c6dea7b5c0"
    property SpriteGUIRendererComponent hitMarkerSprite = "cc1e563f-caef-4930-9146-0275a20a81dc"

    property string LobbyMapName = "formationlobby"
    property number LoadTimeoutSeconds = 8
    property Color RowColor = Color(0.36, 0.29, 0.52, 0.35)
    property Color SelectedRowColor = Color(1, 0.86, 0.5, 1)
    property Color RowTextColor = Color(1, 1, 1, 1)
    property Color SelectedTextColor = Color(1, 1, 1, 1)
    property string UnsetText = "未設定"
    property Color DetailValueColor = Color(0.17, 0.13, 0.28, 1)
    property Color DetailUnsetColor = Color(0.55, 0.5, 0.62, 1)
    property Color TrialButtonColor = Color(0.36, 0.29, 0.52, 0.85)
    property Color TrialActiveColor = Color(1, 0.78, 0.3, 1)
    property Color TrialDisabledColor = Color(0.36, 0.29, 0.52, 0.3)
    property number SoundVolume = 1
    property number PixelsPerWorldUnit = 100
    property string StageUnavailableText = "舞台無法使用：讀不到戰鬥鏡頭設定"
    property number HitPointMargin = 24
    -- The dummy figure (a normal training dummy mob's stand clip) shown at the hit point as a position marker only.
    property string HitMarkerRuid = "c9c6022d09854016b0c7f8422441ba2a"
    property string ScaleLabelFormat = "舞台縮小 ×%.2f"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Start closed with an empty cache; the buttons are wired once the authored UI exists (see EnsureBound).
        self._T.open = false
        self._T.openedAt = 0
        self._T.loadState = "IDLE"
        self._T.rows = {}
        self._T.rowViews = {}
        self._T.selectedId = ""
        self._T.action = "IDLE"
        self._T.events = {}
        self._T.bindings = {}
        self._T.bound = false
        self._T.buildSerial = 0
        self._T.detailViews = {}
        self._T.detailsFor = nil
        self._T.entryShown = nil
        self._T.entryEnabled = nil
        self._T.battleZoom = nil
        self._T.stageFor = nil
        self._T.oneShot = false
        self._T.endHandler = nil
        self._T.effectHandlers = {}
        self._T.timers = {}
        self._T.trialSerial = 0
        self._T.stageFactor = 1
        self._T.shot = nil
        -- Authored starting state: the book, the stage image, its notice, the two effect sprites, the ball, the hit marker, the scale label and the three row templates are all hidden.
        for _, component in ipairs({ self.stageSprite, self.stageNotice, self.attackEffectSprite, self.hitEffectSprite, self.projectileSprite, self.hitMarkerSprite, self.scaleLabel }) do
            if isvalid(component) then component.Entity:SetEnable(false) end
        end
        for _, entity in ipairs({ self.book, self.rowTemplate, self.headerTemplate, self.detailTemplate }) do
            if isvalid(entity) then entity:SetEnable(false) end
        end
        log("[VRF][MonsterDex] ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Keep the lobby entry in step with the shared matchmaking lock; a match starting under an open book closes it.
        self:EnsureBound()
        self:AdvanceProjectile()
        if not isvalid(self.lobbyButton) then return end
        local canOpen = self:CanOpen()
        local shown = Environment:IsMakerPlay()
        if self._T.entryShown ~= shown then
            self._T.entryShown = shown
            self.lobbyButton.Entity:SetEnable(shown)
        end
        if self._T.entryEnabled ~= canOpen then
            self._T.entryEnabled = canOpen
            self.lobbyButton.Enable = canOpen
        end
        if self._T.open and not canOpen then
            log("[VRF][MonsterDex] closed because the lobby is no longer available")
            self:Close()
        end
        if self._T.open and self._T.loadState == "LOADING" and _UtilLogic.ElapsedSeconds - self._T.openedAt > self.LoadTimeoutSeconds then
            self._T.loadState = "FAILED"
            self:Render()
        end
    end

    @ExecSpace("ClientOnly")
    method void EnsureBound()
        -- The authored buttons only call the public interface below.
        if self._T.bound or not isvalid(self.lobbyButton) or not isvalid(self.closeButton) or not isvalid(self.stageSprite) then return end
        self._T.bound = true
        self:Bind(self.lobbyButton.Entity, function() self:Open() end)
        self:Bind(self.closeButton.Entity, function() self:Close() end)
        for _, trial in ipairs(self:TrialButtons()) do
            local action = trial.action
            self:Bind(trial.button.Entity, function() self:Play(action) end)
        end
        self._T.endHandler = self.stageSprite.Entity:ConnectEvent(SpriteGUIAnimPlayerEndEvent, function(event) self:OnAnimationEnd(event) end)
        for _, effect in ipairs({ self.attackEffectSprite, self.hitEffectSprite }) do
            if isvalid(effect) then
                -- A finished one-shot effect clip leaves the stage on its own end event.
                local entity = effect.Entity
                local callback = entity:ConnectEvent(SpriteGUIAnimPlayerEndEvent, function() entity:SetEnable(false) end)
                table.insert(self._T.effectHandlers, { entity = entity, callback = callback })
            end
        end
        log("[VRF][MonsterDex] connected lobby entry, close button, trial buttons, the stage end event and the effect end events")
    end

    @ExecSpace("ClientOnly")
    method void Bind(Entity entity, any action)
        -- Own each connection so teardown cannot leak across Play sessions.
        local callback = entity:ConnectEvent(ButtonClickEvent, action)
        table.insert(self._T.bindings, { entity = entity, callback = callback })
    end

    @ExecSpace("ClientOnly")
    method boolean CanOpen()
        -- Maker Play, the lobby map and the lobby's own matchmaking lock must all allow the book.
        if not Environment:IsMakerPlay() then return false end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMapName ~= self.LobbyMapName then return false end
        return _MatchFlowInput:AllowsFormationActions()
    end

    @ExecSpace("ClientOnly")
    method boolean Open()
        -- Show the book over the lobby and ask the server for the rows; returns whether the book is open afterwards.
        if not Environment:IsMakerPlay() then return false end
        if self._T.open then return true end
        if not self:CanOpen() then return false end
        self._T.open = true
        self._T.openedAt = _UtilLogic.ElapsedSeconds
        self:ResetPlayback()
        if #self._T.rows == 0 then self._T.loadState = "LOADING" end
        if isvalid(self.book) then self.book:SetEnable(true) end
        _MonsterDexService:RequestRows()
        self:Render()
        log("[VRF][MonsterDex] opened rows=" .. tostring(#self._T.rows) .. " selected=" .. self._T.selectedId)
        return true
    end

    @ExecSpace("ClientOnly")
    method void Close()
        -- Hide the book and drop any playback; nothing else in the lobby is touched.
        if not self._T.open then return end
        self._T.open = false
        self:ResetPlayback()
        if isvalid(self.book) then self.book:SetEnable(false) end
        log("[VRF][MonsterDex] closed")
    end

    @ExecSpace("ClientOnly")
    method boolean Select(string monsterId)
        -- Choosing a monster puts the stage back to idle; unknown ids and a closed book are ignored.
        if not self._T.open or self:RowFor(monsterId) == nil then return false end
        self._T.selectedId = monsterId
        self:ResetPlayback()
        self:Render()
        log("[VRF][MonsterDex] selected " .. monsterId)
        return true
    end

    @ExecSpace("ClientOnly")
    method void ResetPlayback()
        -- Back to a quiet idle stage: idle action, empty event log, nothing in flight (no pending or showing effect). A closed book or a missing row hides the stage.
        self:ClearEffects()
        self._T.action = "IDLE"
        self._T.events = {}
        self._T.oneShot = false
        self._T.stageFor = nil
        self:RenderStage()
    end

    @ExecSpace("ClientOnly")
    method table ActionSpecs()
        -- What each trial action plays: the dex row field of its animation, whether it loops, and the sound it plays at its start (no sound field = silent). Built once.
        if self._T.actionSpecs == nil then
            self._T.actionSpecs = {
                IDLE = { field = "standRuid", loop = true },
                MOVE = { field = "moveRuid", loop = true },
                ATTACK = { field = "attackRuid", loop = false, sound = "attackSoundRuid" },
                HURT = { field = "hurtRuid", loop = false, sound = "hurtSoundRuid" },
                DIE = { field = "dieRuid", loop = false, sound = "dieSoundRuid" },
            }
        end
        return self._T.actionSpecs
    end

    @ExecSpace("ClientOnly")
    method table TrialButtons()
        -- The five authored trial buttons with the action each one plays, in bar order; binding and highlighting both read this one list.
        return {
            { action = "IDLE", button = self.idleButton },
            { action = "MOVE", button = self.moveButton },
            { action = "ATTACK", button = self.attackButton },
            { action = "HURT", button = self.hurtButton },
            { action = "DIE", button = self.dieButton },
        }
    end

    @ExecSpace("ClientOnly")
    method void RecordEvent(string name, string action, string ruid)
        -- Append one trial event to the readable log.
        table.insert(self._T.events, { name = name, action = action, ruid = ruid, at = _UtilLogic.ElapsedSeconds })
    end

    @ExecSpace("ClientOnly")
    method boolean Play(string action)
        -- Trial one action of the selected monster from its start. Replaying the same action restarts it; another action aborts the one in progress.
        if not self._T.open or self._T.battleZoom == nil then return false end
        if self:GetSelectedRow() == nil or self:ActionSpecs()[action] == nil then return false end
        self._T.events = {}
        self:ClearEffects()
        self:StartClip(action, true)
        log("[VRF][MonsterDex] trial " .. action)
        return true
    end

    @ExecSpace("ClientOnly")
    method void StartClip(string action, boolean record)
        -- Put the action's animation on the stage: idle and move loop, the rest play once; attack, hurt and die also play their own sound (the attack sound at the start, as in battle). Only trial clips (record = true) are logged; the idle a freshly shown monster starts with is not a trial.
        local row = self:GetSelectedRow()
        local spec = self:ActionSpecs()[action]
        if row == nil or spec == nil or not isvalid(self.stageSprite) then return end
        local ruid = row[spec.field] or ""
        self._T.action = action
        self._T.oneShot = not spec.loop
        self.stageSprite.Entity:SetEnable(false)
        self.stageSprite.AnimClipPlayType = spec.loop and SpriteAnimClipPlayType.Loop or SpriteAnimClipPlayType.Onetime
        self.stageSprite.ImageRUID = DataRef(ruid)
        self.stageSprite.Entity:SetEnable(true)
        if record then self:RecordEvent("ANIMATION_START", action, ruid) end
        if record and spec.sound ~= nil then self:PlaySoundOnce(action, row[spec.sound] or "") end
        if record and action == "ATTACK" then
            self:ShowHitMarker(row)
            self:ArmAttackTrial(row)
        end
        self:RenderTrialButtons()
    end

    @ExecSpace("ClientOnly")
    method void ShowHitMarker(any row)
        -- Stand a dummy figure on the hit point (feet on the ground line, facing the attacker, at the stage art scale) from the start of an attack trial until the next clear. It only marks the position: no damage, no sound, no event, no timer.
        local marker = self.hitMarkerSprite
        if not isvalid(marker) then return end
        local geometry = self:StageGeometry(row)
        local scale = geometry.pixelsPerUnit / self.PixelsPerWorldUnit
        marker.Entity:SetEnable(false)
        marker.AnimClipPlayType = SpriteAnimClipPlayType.Loop
        marker.ImageRUID = DataRef(self.HitMarkerRuid)
        marker.PreserveSprite = PreserveSpriteType.NativeSize
        marker.Entity.UITransformComponent.anchoredPosition = Vector2(geometry.hitX, geometry.footY)
        marker.Entity.UITransformComponent.UIScale = Vector3(scale, scale, 1)
        marker.Entity:SetEnable(true)
    end

    @ExecSpace("ClientOnly")
    method void ArmAttackTrial(any row)
        -- The attack's effects follow the dex row's own delays, never recalculated: the attack effect after attackEffectDelay on the attacker (frame 1 is immediate), the hit effect after impactDelay at the hit point. A monster with a ball launches it at impactDelay instead and the hit effect waits for its arrival; every other attack is an instant hit. Blank effect fields are skipped; a cleared trial drops its pending timers.
        local serial = self._T.trialSerial
        local function arm(delay, action)
            if delay <= 0 then
                action()
                return
            end
            local id = _TimerService:SetTimerOnce(function()
                if serial == self._T.trialSerial then action() end
            end, delay)
            table.insert(self._T.timers, id)
        end
        local effectRuid = row.attackEffectRuid or ""
        if effectRuid ~= "" and isvalid(self.attackEffectSprite) then
            arm(row.attackEffectDelay or 0, function() self:ShowEffect("ATTACK_EFFECT", self.attackEffectSprite, effectRuid, row) end)
        end
        if self:UsesProjectile(row) then
            arm(row.impactDelay or 0, function() self:LaunchProjectile(row) end)
            return
        end
        local hitRuid = row.hitEffectRuid or ""
        if hitRuid ~= "" and isvalid(self.hitEffectSprite) then
            arm(row.impactDelay or 0, function() self:ShowEffect("HIT_EFFECT", self.hitEffectSprite, hitRuid, row) end)
        end
    end

    @ExecSpace("ClientOnly")
    method boolean UsesProjectile(any row)
        -- A ball needs both its clip and a positive speed; anything else is an instant hit, like the blank state of the details list.
        return (row.projectileRuid or "") ~= "" and (row.projectileSpeed or 0) > 0 and isvalid(self.projectileSprite)
    end

    @ExecSpace("ClientOnly")
    method table ProjectileFlight(any row)
        -- One ball's path in canvas pixels and its time in seconds. It leaves the attacker's body centre (bodyOffset behind and above the foot, scaled by the model) and flies level, as a combat ball does at a target of the same height, to the point one attack range ahead of the body centre (the hit point's x; the hit effect then plays on the ground line there, like a combat hit effect on its target's foot). The distance is the attack range in world units, so dividing it by the published world-unit speed gives a flight time that the stage shrink never changes.
        local geometry = self:StageGeometry(row)
        local bodyX = (row.bodyOffsetX or 0) * math.abs(row.scaleX)
        local bodyY = (row.bodyOffsetY or 0) * math.abs(row.scaleY)
        local startX = geometry.footX - bodyX * geometry.pixelsPerUnit
        local startY = geometry.footY + bodyY * geometry.pixelsPerUnit
        local distance = row.attackRange
        return {
            from = Vector2(startX, startY), to = Vector2(geometry.hitX, startY),
            seconds = distance / row.projectileSpeed, pixelsPerUnit = geometry.pixelsPerUnit,
        }
    end

    @ExecSpace("ClientOnly")
    method void LaunchProjectile(any row)
        -- Release the ball at the attacker's body centre and arm its arrival; the ball and the hit effect both belong to that one arrival moment. The art faces left like every monster art and the authored image is flipped once to fly right, so the facing never changes in flight.
        local ball = self.projectileSprite
        if not self:UsesProjectile(row) then return end
        local flight = self:ProjectileFlight(row)
        local scale = flight.pixelsPerUnit / self.PixelsPerWorldUnit
        ball.Entity:SetEnable(false)
        ball.AnimClipPlayType = SpriteAnimClipPlayType.Loop
        ball.ImageRUID = DataRef(row.projectileRuid)
        ball.PreserveSprite = PreserveSpriteType.NativeSize
        ball.Entity.UITransformComponent.anchoredPosition = flight.from
        ball.Entity.UITransformComponent.UIScale = Vector3(scale, scale, 1)
        ball.Entity:SetEnable(true)
        self._T.shot = { startedAt = _UtilLogic.ElapsedSeconds, seconds = flight.seconds, from = flight.from, to = flight.to }
        self:RecordEvent("PROJECTILE_START", "ATTACK", row.projectileRuid)
        local serial = self._T.trialSerial
        local id = _TimerService:SetTimerOnce(function()
            if serial == self._T.trialSerial then self:ArriveProjectile(row) end
        end, flight.seconds)
        table.insert(self._T.timers, id)
    end

    @ExecSpace("ClientOnly")
    method void AdvanceProjectile()
        -- Move the ball along its straight line by elapsed time; it holds the landing point until its arrival timer removes it.
        local shot = self._T.shot
        if shot == nil or not isvalid(self.projectileSprite) then return end
        local progress = math.min(1, math.max(0, (_UtilLogic.ElapsedSeconds - shot.startedAt) / shot.seconds))
        self.projectileSprite.Entity.UITransformComponent.anchoredPosition = Vector2(shot.from.x + (shot.to.x - shot.from.x) * progress, shot.from.y + (shot.to.y - shot.from.y) * progress)
    end

    @ExecSpace("ClientOnly")
    method void ArriveProjectile(any row)
        -- The ball reaches the hit point: it leaves the stage and the hit effect (if the row has one) plays right there.
        self._T.shot = nil
        if isvalid(self.projectileSprite) then self.projectileSprite.Entity:SetEnable(false) end
        self:RecordEvent("PROJECTILE_ARRIVE", "ATTACK", row.projectileRuid)
        self:ShowEffect("HIT_EFFECT", self.hitEffectSprite, row.hitEffectRuid or "", row)
    end

    @ExecSpace("ClientOnly")
    method void ShowEffect(string name, any effect, string ruid, any row)
        -- Play one effect clip once on the stage: the attack effect on the attacker at the attacker's own scale and facing, the hit effect at the hit point at the stage's art scale. A blank RUID is skipped silently.
        if ruid == "" or not isvalid(effect) then return end
        local geometry = self:StageGeometry(row)
        local isAttack = name == "ATTACK_EFFECT"
        local position = isAttack and Vector2(geometry.footX, geometry.footY) or Vector2(geometry.hitX, geometry.footY)
        local scale = isAttack and self.stageSprite.Entity.UITransformComponent.UIScale or Vector3(geometry.pixelsPerUnit / self.PixelsPerWorldUnit, geometry.pixelsPerUnit / self.PixelsPerWorldUnit, 1)
        effect.Entity:SetEnable(false)
        effect.AnimClipPlayType = SpriteAnimClipPlayType.Onetime
        effect.ImageRUID = DataRef(ruid)
        effect.PreserveSprite = PreserveSpriteType.NativeSize
        effect.Entity.UITransformComponent.anchoredPosition = position
        effect.Entity.UITransformComponent.UIScale = Vector3(scale.x, scale.y, 1)
        effect.Entity:SetEnable(true)
        self:RecordEvent(name, "ATTACK", ruid)
    end

    @ExecSpace("ClientOnly")
    method void ClearEffects()
        -- Drop every pending effect timer (the serial also voids a callback already queued), the ball in flight, the hit marker, and hide both effect sprites and the ball.
        self._T.trialSerial = (self._T.trialSerial or 0) + 1
        self._T.shot = nil
        if isvalid(self.projectileSprite) then self.projectileSprite.Entity:SetEnable(false) end
        if isvalid(self.hitMarkerSprite) then self.hitMarkerSprite.Entity:SetEnable(false) end
        for _, id in ipairs(self._T.timers or {}) do
            _TimerService:ClearTimer(id)
        end
        self._T.timers = {}
        for _, effect in ipairs({ self.attackEffectSprite, self.hitEffectSprite }) do
            if isvalid(effect) then effect.Entity:SetEnable(false) end
        end
    end

    @ExecSpace("ClientOnly")
    method void PlaySoundOnce(string action, string ruid)
        -- A blank sound field is skipped silently; nothing else depends on it.
        if ruid == "" then return end
        _SoundService:PlaySound(ruid, self.SoundVolume)
        self:RecordEvent("SOUND", action, ruid)
    end

    @ExecSpace("ClientOnly")
    method void OnAnimationEnd(any event)
        -- The end of a one-shot clip sends the stage back to idle; loops and stale ends are ignored.
        if not self._T.oneShot then return end
        self._T.oneShot = false
        self:RecordEvent("ANIMATION_END", self._T.action, "")
        self:StartClip("IDLE", true)
    end

    @ExecSpace("ClientOnly")
    method void ObserveBattleCamera(number zoomRatio)
        -- The battle camera's zoom, published by the server next to the rows; the stage scale follows it. Zero means the server could not read it: the list and details still work, only the stage is off.
        if zoomRatio > 0 then
            self._T.battleZoom = zoomRatio
        else
            self._T.battleZoom = nil
        end
    end

    @ExecSpace("ClientOnly")
    method number StagePixelsPerUnit()
        -- Canvas pixels that one world unit covers on the battle camera. Both widths come from the same full screen edges: canvas units from the native screen-to-UI conversion, world units from the screen-to-world one of the camera in use, rescaled to the battle camera's zoom.
        local screenWidth = _UILogic.ScreenWidth
        local canvasLeft = _UILogic:ScreenToUIPosition(Vector2(0, 0))
        local canvasRight = _UILogic:ScreenToUIPosition(Vector2(screenWidth, 0))
        local worldLeft = _UILogic:ScreenToWorldPosition(Vector2(0, 0))
        local worldRight = _UILogic:ScreenToWorldPosition(Vector2(screenWidth, 0))
        local currentZoom = _CameraService:GetCurrentCameraComponent().ZoomRatio
        local unitsAcrossBattleScreen = math.abs(worldRight.x - worldLeft.x) * currentZoom / self._T.battleZoom
        return math.abs(canvasRight.x - canvasLeft.x) / unitsAcrossBattleScreen
    end

    @ExecSpace("ClientOnly")
    method number HitReach(any row)
        -- World units from the attacker's foot to its hit point: one attack range in front of the body centre. The body centre sits bodyX behind the foot as in the combat rectangle, where bodyX is the hit box offset times the model scale.
        local bodyX = (row.bodyOffsetX or 0) * math.abs(row.scaleX)
        return row.attackRange - bodyX
    end

    @ExecSpace("ClientOnly")
    method number StageFactor(any row)
        -- 1 while the hit point fits on the stage; otherwise the whole stage shrinks so that the hit point lands HitPointMargin short of the stage's right edge.
        local foot = self.stageSprite.Entity.UITransformComponent.anchoredPosition
        local room = self.stageSprite.Entity.Parent.UITransformComponent.RectSize.x - foot.x - self.HitPointMargin
        local reach = self:HitReach(row) * self:StagePixelsPerUnit()
        if reach <= room then return 1 end
        return math.min(1, room / reach)
    end

    @ExecSpace("ClientOnly")
    method table StageGeometry(any row)
        -- Stage positions of one monster in canvas pixels: the attacker's foot (the authored actor position), the hit point on the ground line in front of it, and the pixels one world unit covers after any shrinking.
        local foot = self.stageSprite.Entity.UITransformComponent.anchoredPosition
        local pixelsPerUnit = self:StagePixelsPerUnit() * self:StageFactor(row)
        return { footX = foot.x, footY = foot.y, hitX = foot.x + self:HitReach(row) * pixelsPerUnit, pixelsPerUnit = pixelsPerUnit }
    end

    @ExecSpace("ClientOnly")
    method any StageLayout(any row)
        -- UI scale of the stage image for one monster: the battle view's pixels per world unit, times the stage factor, times the model's own scale. The art is drawn at its native pixels, 100 per world unit.
        if row == nil or self._T.battleZoom == nil then return nil end
        local factor = self:StageFactor(row)
        local artScale = self:StagePixelsPerUnit() * factor / self.PixelsPerWorldUnit
        return { x = artScale * row.scaleX, y = artScale * row.scaleY, factor = factor }
    end

    @ExecSpace("ClientOnly")
    method void RenderStage()
        -- Show the selected monster at battle scale and start it idling; an already shown monster keeps playing.
        if not isvalid(self.stageSprite) then return end
        local row = nil
        if self._T.open then row = self:GetSelectedRow() end
        self:RenderStageNotice(row ~= nil and self._T.battleZoom == nil)
        local layout = self:StageLayout(row)
        self:RenderScaleLabel(layout)
        if layout == nil then
            self._T.stageFor = nil
            self.stageSprite.Entity:SetEnable(false)
            self:RenderTrialButtons()
            return
        end
        if self._T.stageFor == self._T.selectedId then return end
        self._T.stageFor = self._T.selectedId
        self.stageSprite.PreserveSprite = PreserveSpriteType.NativeSize
        self.stageSprite.Entity.UITransformComponent.UIScale = Vector3(layout.x, layout.y, 1)
        self:StartClip("IDLE", false)
    end

    @ExecSpace("ClientOnly")
    method void RenderScaleLabel(any layout)
        -- Say how much the stage was shrunk to fit the hit point; hidden at full scale and with no stage.
        self._T.stageFactor = layout ~= nil and layout.factor or 1
        if not isvalid(self.scaleLabel) then return end
        local shrunk = self._T.stageFactor < 1
        if shrunk then self.scaleLabel.Text = string.format(self.ScaleLabelFormat, self._T.stageFactor) end
        self.scaleLabel.Entity:SetEnable(shrunk)
    end

    @ExecSpace("ClientOnly")
    method void RenderStageNotice(boolean unavailable)
        -- Say why the stage is empty when the battle camera is unknown; the list and the details are unaffected.
        if not isvalid(self.stageNotice) then return end
        self.stageNotice.Text = self.StageUnavailableText
        self.stageNotice.Entity:SetEnable(unavailable)
    end

    @ExecSpace("ClientOnly")
    method void RenderTrialButtons()
        -- The running action's button is highlighted; with no stage shown none is, and the buttons are disabled.
        local shown = self._T.stageFor ~= nil
        for _, trial in ipairs(self:TrialButtons()) do
            if isvalid(trial.button) then
                local active = shown and self._T.action == trial.action
                trial.button.Enable = shown
                trial.button.Entity.SpriteGUIRendererComponent.Color = active and self.TrialActiveColor or (shown and self.TrialButtonColor or self.TrialDisabledColor)
            end
        end
    end

    @ExecSpace("ClientOnly")
    method any RowFor(string monsterId)
        -- Find one published dex row by its MonsterId.
        for _, row in ipairs(self._T.rows) do
            if row.monsterId == monsterId then return row end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetSelectedRow()
        -- The full server-published row of the selected monster, or nil before the first reply.
        return self:RowFor(self._T.selectedId)
    end

    @ExecSpace("ClientOnly")
    method table GetSnapshot()
        -- A detached, readable copy of what the book currently shows; mutating it changes nothing.
        local selected = self:RowFor(self._T.selectedId)
        local rows = {}
        for _, row in ipairs(self._T.rows) do
            table.insert(rows, { monsterId = row.monsterId, monsterName = row.monsterName, selected = row.monsterId == self._T.selectedId })
        end
        local events = {}
        for _, event in ipairs(self._T.events) do table.insert(events, event) end
        return {
            open = self._T.open, loadState = self._T.loadState,
            selectedMonsterId = self._T.selectedId, selectedMonsterName = selected ~= nil and selected.monsterName or "",
            action = self._T.action, events = events, rows = rows, details = self:BuildDetails(selected),
            stageAvailable = self._T.battleZoom ~= nil, stageFactor = self._T.stageFactor or 1, projectileActive = self._T.shot ~= nil,
            hitMarkerShown = isvalid(self.hitMarkerSprite) and self.hitMarkerSprite.Entity.Enable or false,
        }
    end

    @ExecSpace("ClientOnly")
    method table DetailSpecs()
        -- The fixed detail list in display order: an action header (group, header) then its rows. A row clones into a "Detail_<key>" entity and is filled from one dex row field. Built once.
        if self._T.detailSpecs == nil then
            self._T.detailSpecs = {
                { group = "idle", header = "待機" },
                { key = "stand", label = "待機動畫", kind = "ruid", field = "standRuid" },
                { group = "move", header = "移動" },
                { key = "move", label = "移動動畫", kind = "ruid", field = "moveRuid" },
                { group = "attack", header = "攻擊" },
                { key = "attackAnimation", label = "攻擊動畫", kind = "ruid", field = "attackRuid" },
                { key = "attackEffect", label = "出手特效", kind = "ruid", field = "attackEffectRuid" },
                { key = "hitEffect", label = "命中特效", kind = "ruid", field = "hitEffectRuid" },
                { key = "projectile", label = "投射物", kind = "ruid", field = "projectileRuid" },
                { key = "attackSound", label = "出手音效", kind = "ruid", field = "attackSoundRuid" },
                { key = "attackEffectFrame", label = "出手特效影格", kind = "effectFrame" },
                { key = "hitFrame", label = "命中影格", kind = "hitFrame" },
                { key = "attackDuration", label = "攻擊動畫長度", kind = "duration" },
                { key = "projectileSpeed", label = "投射物速度", kind = "projectileSpeed" },
                { group = "hurt", header = "受傷" },
                { key = "hurtAnimation", label = "受傷動畫", kind = "ruid", field = "hurtRuid" },
                { key = "hurtSound", label = "受傷音效", kind = "ruid", field = "hurtSoundRuid" },
                { group = "die", header = "死亡" },
                { key = "dieAnimation", label = "死亡動畫", kind = "ruid", field = "dieRuid" },
                { key = "dieSound", label = "死亡音效", kind = "ruid", field = "dieSoundRuid" },
            }
        end
        return self._T.detailSpecs
    end

    @ExecSpace("ClientOnly")
    method table DetailText(any spec, any row)
        -- The text and set-state of one detail value for one published row. An effect frame without an effect and a speed without a projectile are unset, like any blank optional resource.
        local unset = { value = self.UnsetText, isSet = false }
        if spec.kind == "ruid" then
            local value = row[spec.field] or ""
            return value ~= "" and { value = value, isSet = true } or unset
        end
        if spec.kind == "effectFrame" then
            if (row.attackEffectRuid or "") == "" then return unset end
            return { value = string.format("第 %d 格 (%.2f 秒)", row.attackEffectFrame, row.attackEffectDelay), isSet = true }
        end
        if spec.kind == "hitFrame" then
            return { value = string.format("第 %d 格 (%.2f 秒)", row.attackDamageFrame, row.impactDelay), isSet = true }
        end
        if spec.kind == "duration" then
            return { value = string.format("%.2f 秒", row.attackDuration), isSet = true }
        end
        if (row.projectileRuid or "") == "" or (row.projectileSpeed or 0) <= 0 then return unset end
        return { value = string.format("%.2f 世界單位/秒", row.projectileSpeed), isSet = true }
    end

    @ExecSpace("ClientOnly")
    method table BuildDetails(any row)
        -- Pure text for every value row of one published dex row; no row yet leaves the texts empty.
        local details = {}
        for _, spec in ipairs(self:DetailSpecs()) do
            if spec.key ~= nil then
                local text = row ~= nil and self:DetailText(spec, row) or { value = "", isSet = false }
                table.insert(details, { key = spec.key, value = text.value, isSet = text.isSet })
            end
        end
        return details
    end

    @ExecSpace("ClientOnly")
    method void DestroyDetailRows()
        -- Remove the cloned header and value rows; the hidden templates stay.
        for _, entity in ipairs(self._T.detailViews or {}) do
            if isvalid(entity) then entity:Destroy() end
        end
        self._T.detailViews = {}
    end

    @ExecSpace("ClientOnly")
    method void BuildDetailRows()
        -- Clone the fixed 20-row list from the two templates, in DetailSpecs order. Rows are cloned at runtime (like the monster list) because a list of purely authored rows never measured its content, so it never scrolled.
        if not isvalid(self.headerTemplate) or not isvalid(self.detailTemplate) then return end
        self:DestroyDetailRows()
        for _, spec in ipairs(self:DetailSpecs()) do
            local entity = nil
            if spec.key == nil then
                entity = self.headerTemplate:Clone("Header_" .. spec.group)
                entity.TextGUIRendererComponent.Text = spec.header
            else
                entity = self.detailTemplate:Clone("Detail_" .. spec.key)
                entity:GetChildByName("Label", false).TextGUIRendererComponent.Text = spec.label
            end
            table.insert(self._T.detailViews, entity)
            entity:SetEnable(true)
        end
        self._T.detailsFor = nil
    end

    @ExecSpace("ClientOnly")
    method void RenderDetails()
        -- Write the selected monster's texts into the cloned rows; no row is ever added or removed here, only its text and colour change.
        if not isvalid(self.detailLayout) then return end
        local selectedId = self._T.selectedId
        if self._T.detailsFor ~= selectedId then
            self._T.detailsFor = selectedId
            self.detailLayout:ResetScrollPosition(UITransformAxis.Vertical)
        end
        for _, detail in ipairs(self:BuildDetails(self:GetSelectedRow())) do
            local row = self.detailLayout.Entity:GetChildByName("Detail_" .. detail.key, false)
            local value = isvalid(row) and row:GetChildByName("Value", false) or nil
            if isvalid(value) then
                value.TextGUIRendererComponent.Text = detail.value
                value.TextGUIRendererComponent.FontColor = detail.isSet and self.DetailValueColor or self.DetailUnsetColor
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Observe(table rows)
        -- Replace the list with the server's latest reply; the selection survives when that monster is still listed.
        local valid = {}
        for _, row in ipairs(rows) do
            if type(row.monsterId) == "string" and row.monsterId ~= "" then table.insert(valid, row) end
        end
        self._T.rows = valid
        self._T.loadState = #valid > 0 and "READY" or "EMPTY"
        if self:RowFor(self._T.selectedId) == nil then
            self._T.selectedId = #valid > 0 and valid[1].monsterId or ""
            self:ResetPlayback()
        end
        self:BuildRows()
        self:BuildDetailRows()
        self:Render()
        log("[VRF][MonsterDex] observed rows=" .. tostring(#valid) .. " selected=" .. self._T.selectedId)
    end

    @ExecSpace("ClientOnly")
    method void DestroyRows()
        -- Release every row's subscription before its entity goes away.
        for _, view in ipairs(self._T.rowViews or {}) do
            if isvalid(view.entity) then
                view.entity:DisconnectEvent(ButtonClickEvent, view.callback)
                view.entity:Destroy()
            end
        end
        self._T.rowViews = {}
    end

    @ExecSpace("ClientOnly")
    method void BuildRows()
        -- One cloned button per dex row, in table order; a newer rebuild abandons an older one that is still cloning.
        if not isvalid(self.rowTemplate) then return end
        self._T.buildSerial = self._T.buildSerial + 1
        local serial = self._T.buildSerial
        self:DestroyRows()
        for index, row in ipairs(self._T.rows) do
            local monsterId = row.monsterId
            local entity = self.rowTemplate:Clone("Row_" .. tostring(index))
            if serial ~= self._T.buildSerial then
                if isvalid(entity) then entity:Destroy() end
                return
            end
            entity.TextGUIRendererComponent.Text = row.monsterName
            local callback = entity:ConnectEvent(ButtonClickEvent, function() self:Select(monsterId) end)
            table.insert(self._T.rowViews, { entity = entity, callback = callback, monsterId = monsterId })
            entity:SetEnable(true)
        end
        if isvalid(self.listLayout) then self.listLayout:ResetScrollPosition(UITransformAxis.Vertical) end
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Highlight the selected row; while there is no list, say why instead.
        for _, view in ipairs(self._T.rowViews) do
            if isvalid(view.entity) then
                local selected = view.monsterId == self._T.selectedId
                view.entity.SpriteGUIRendererComponent.Color = selected and self.SelectedRowColor or self.RowColor
                view.entity.TextGUIRendererComponent.FontColor = selected and self.SelectedTextColor or self.RowTextColor
            end
        end
        self:RenderDetails()
        self:RenderStage()
        if not isvalid(self.statusText) then return end
        local messages = { LOADING = "讀取中…", EMPTY = "資料表沒有怪物", FAILED = "讀取逾時，請關閉後重新開啟" }
        local message = messages[self._T.loadState] or ""
        self.statusText.Text = message
        self.statusText.Entity:SetEnable(message ~= "")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release the authored button subscriptions at world session shutdown.
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.callback) end
        end
        if isvalid(self.stageSprite) and self._T.endHandler ~= nil then
            self.stageSprite.Entity:DisconnectEvent(SpriteGUIAnimPlayerEndEvent, self._T.endHandler)
            self._T.endHandler = nil
        end
        for _, binding in ipairs(self._T.effectHandlers or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(SpriteGUIAnimPlayerEndEvent, binding.callback) end
        end
        self._T.effectHandlers = {}
        self:ClearEffects()
        self:DestroyRows()
        self:DestroyDetailRows()
    end
end
