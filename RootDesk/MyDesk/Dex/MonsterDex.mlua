@Logic
script MonsterDex extends Logic

    -- Bound by UIBuilder (ui/MonsterDexGroup.ui and the lobby button in ui/FormationGroup.ui).
    property Entity book = "e022dc95-05c7-46b2-830f-1561b4267dbf"
    property ButtonComponent closeButton = "16cd671f-6e16-41b3-b974-94dcebe9800b"
    property ScrollLayoutGroupComponent listLayout = "db53d2f8-c948-41a7-b698-30d9f4d88689"
    property Entity rowTemplate = "a04d24d8-ec76-4418-9b59-84850c171b7b"
    property TextGUIRendererComponent statusText = "42a06858-b407-47fd-8a51-f26e0a35d853"
    property ButtonComponent lobbyButton = "415c41cd-970f-424e-946f-37c6a3a89489"
    property ScrollLayoutGroupComponent detailLayout = "34659be3-bdc5-4a22-8e8d-42723cdbc393"
    property Entity headerTemplate = "9608ae32-42e0-438d-b8a2-b8a56629e208"
    property Entity detailTemplate = "8304bc60-6f15-440d-9082-9e8939b2bbcb"

    property string LobbyMapName = "formationlobby"
    property number LoadTimeoutSeconds = 8
    property Color RowColor = Color(0.36, 0.29, 0.52, 0.35)
    property Color SelectedRowColor = Color(1, 0.86, 0.5, 1)
    property Color RowTextColor = Color(1, 1, 1, 1)
    property Color SelectedTextColor = Color(1, 1, 1, 1)
    property string UnsetText = "未設定"
    property Color DetailValueColor = Color(0.17, 0.13, 0.28, 1)
    property Color DetailUnsetColor = Color(0.55, 0.5, 0.62, 1)

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Start closed with an empty cache; the buttons are wired once the authored UI exists (see EnsureBound).
        self._T.open = false
        self._T.openedAt = 0
        self._T.loadState = "IDLE"
        self._T.rows = {}
        self._T.rowViews = {}
        self._T.selectedId = ""
        self._T.action = "IDLE"
        self._T.events = {}
        self._T.bindings = {}
        self._T.bound = false
        self._T.buildSerial = 0
        self._T.detailViews = {}
        self._T.detailsFor = nil
        self._T.entryShown = nil
        self._T.entryEnabled = nil
        if isvalid(self.book) then self.book:SetEnable(false) end
        if isvalid(self.rowTemplate) then self.rowTemplate:SetEnable(false) end
        if isvalid(self.headerTemplate) then self.headerTemplate:SetEnable(false) end
        if isvalid(self.detailTemplate) then self.detailTemplate:SetEnable(false) end
        log("[VRF][MonsterDex] ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Keep the lobby entry in step with the shared matchmaking lock; a match starting under an open book closes it.
        self:EnsureBound()
        if not isvalid(self.lobbyButton) then return end
        local canOpen = self:CanOpen()
        local shown = Environment:IsMakerPlay()
        if self._T.entryShown ~= shown then
            self._T.entryShown = shown
            self.lobbyButton.Entity:SetEnable(shown)
        end
        if self._T.entryEnabled ~= canOpen then
            self._T.entryEnabled = canOpen
            self.lobbyButton.Enable = canOpen
        end
        if self._T.open and not canOpen then
            log("[VRF][MonsterDex] closed because the lobby is no longer available")
            self:Close()
        end
        if self._T.open and self._T.loadState == "LOADING" and _UtilLogic.ElapsedSeconds - self._T.openedAt > self.LoadTimeoutSeconds then
            self._T.loadState = "FAILED"
            self:Render()
        end
    end

    @ExecSpace("ClientOnly")
    method void EnsureBound()
        -- The authored buttons only call the public interface below.
        if self._T.bound or not isvalid(self.lobbyButton) or not isvalid(self.closeButton) then return end
        self._T.bound = true
        self:Bind(self.lobbyButton.Entity, function() self:Open() end)
        self:Bind(self.closeButton.Entity, function() self:Close() end)
        log("[VRF][MonsterDex] connected lobby entry and close button")
    end

    @ExecSpace("ClientOnly")
    method void Bind(Entity entity, any action)
        -- Own each connection so teardown cannot leak across Play sessions.
        local callback = entity:ConnectEvent(ButtonClickEvent, action)
        table.insert(self._T.bindings, { entity = entity, callback = callback })
    end

    @ExecSpace("ClientOnly")
    method boolean CanOpen()
        -- Maker Play, the lobby map and the lobby's own matchmaking lock must all allow the book.
        if not Environment:IsMakerPlay() then return false end
        local player = _UserService.LocalPlayer
        if not isvalid(player) or player.CurrentMapName ~= self.LobbyMapName then return false end
        return _MatchFlowInput:AllowsFormationActions()
    end

    @ExecSpace("ClientOnly")
    method boolean Open()
        -- Show the book over the lobby and ask the server for the rows; returns whether the book is open afterwards.
        if not Environment:IsMakerPlay() then return false end
        if self._T.open then return true end
        if not self:CanOpen() then return false end
        self._T.open = true
        self._T.openedAt = _UtilLogic.ElapsedSeconds
        self:ResetPlayback()
        if #self._T.rows == 0 then self._T.loadState = "LOADING" end
        if isvalid(self.book) then self.book:SetEnable(true) end
        _MonsterDexService:RequestRows()
        self:Render()
        log("[VRF][MonsterDex] opened rows=" .. tostring(#self._T.rows) .. " selected=" .. self._T.selectedId)
        return true
    end

    @ExecSpace("ClientOnly")
    method void Close()
        -- Hide the book and drop any playback; nothing else in the lobby is touched.
        if not self._T.open then return end
        self._T.open = false
        self:ResetPlayback()
        if isvalid(self.book) then self.book:SetEnable(false) end
        log("[VRF][MonsterDex] closed")
    end

    @ExecSpace("ClientOnly")
    method boolean Select(string monsterId)
        -- Choosing a monster puts the stage back to idle; unknown ids and a closed book are ignored.
        if not self._T.open or self:RowFor(monsterId) == nil then return false end
        self._T.selectedId = monsterId
        self:ResetPlayback()
        self:Render()
        log("[VRF][MonsterDex] selected " .. monsterId)
        return true
    end

    @ExecSpace("ClientOnly")
    method void ResetPlayback()
        -- Later tickets clear the stage here as well: idle action, empty event log.
        self._T.action = "IDLE"
        self._T.events = {}
    end

    @ExecSpace("ClientOnly")
    method any RowFor(string monsterId)
        -- Find one published dex row by its MonsterId.
        for _, row in ipairs(self._T.rows) do
            if row.monsterId == monsterId then return row end
        end
        return nil
    end

    @ExecSpace("ClientOnly")
    method any GetSelectedRow()
        -- The full server-published row of the selected monster, or nil before the first reply.
        return self:RowFor(self._T.selectedId)
    end

    @ExecSpace("ClientOnly")
    method table GetSnapshot()
        -- A detached, readable copy of what the book currently shows; mutating it changes nothing.
        local selected = self:RowFor(self._T.selectedId)
        local rows = {}
        for _, row in ipairs(self._T.rows) do
            table.insert(rows, { monsterId = row.monsterId, monsterName = row.monsterName, selected = row.monsterId == self._T.selectedId })
        end
        local events = {}
        for _, event in ipairs(self._T.events) do table.insert(events, event) end
        return {
            open = self._T.open, loadState = self._T.loadState,
            selectedMonsterId = self._T.selectedId, selectedMonsterName = selected ~= nil and selected.monsterName or "",
            action = self._T.action, events = events, rows = rows, details = self:BuildDetails(selected),
        }
    end

    @ExecSpace("ClientOnly")
    method table DetailSpecs()
        -- The fixed detail list in display order: an action header (group, header) then its rows. A row clones into a "Detail_<key>" entity and is filled from one dex row field.
        return {
            { group = "idle", header = "待機" },
            { key = "stand", label = "待機動畫", kind = "ruid", field = "standRuid" },
            { group = "move", header = "移動" },
            { key = "move", label = "移動動畫", kind = "ruid", field = "moveRuid" },
            { group = "attack", header = "攻擊" },
            { key = "attackAnimation", label = "攻擊動畫", kind = "ruid", field = "attackRuid" },
            { key = "attackEffect", label = "出手特效", kind = "ruid", field = "attackEffectRuid" },
            { key = "hitEffect", label = "命中特效", kind = "ruid", field = "hitEffectRuid" },
            { key = "projectile", label = "投射物", kind = "ruid", field = "projectileRuid" },
            { key = "attackSound", label = "出手音效", kind = "ruid", field = "attackSoundRuid" },
            { key = "attackEffectFrame", label = "出手特效影格", kind = "effectFrame" },
            { key = "hitFrame", label = "命中影格", kind = "hitFrame" },
            { key = "attackDuration", label = "攻擊動畫長度", kind = "duration" },
            { key = "projectileSpeed", label = "投射物速度", kind = "projectileSpeed" },
            { group = "hurt", header = "受傷" },
            { key = "hurtAnimation", label = "受傷動畫", kind = "ruid", field = "hurtRuid" },
            { key = "hurtSound", label = "受傷音效", kind = "ruid", field = "hurtSoundRuid" },
            { group = "die", header = "死亡" },
            { key = "dieAnimation", label = "死亡動畫", kind = "ruid", field = "dieRuid" },
            { key = "dieSound", label = "死亡音效", kind = "ruid", field = "dieSoundRuid" },
        }
    end

    @ExecSpace("ClientOnly")
    method table BuildDetails(any row)
        -- Pure text for every value row of one published dex row. Blank optional resources, an effect frame without an effect and a speed without a projectile read as the unset text; no row yet leaves the texts empty.
        local details = {}
        for _, spec in ipairs(self:DetailSpecs()) do
            if spec.key ~= nil then
                local value = ""
                local isSet = false
                if row ~= nil then
                    if spec.kind == "ruid" then
                        value = row[spec.field] or ""
                        isSet = value ~= ""
                    elseif spec.kind == "effectFrame" then
                        isSet = (row.attackEffectRuid or "") ~= ""
                        if isSet then value = string.format("第 %d 格 (%.2f 秒)", row.attackEffectFrame, row.attackEffectDelay) end
                    elseif spec.kind == "hitFrame" then
                        isSet = true
                        value = string.format("第 %d 格 (%.2f 秒)", row.attackDamageFrame, row.impactDelay)
                    elseif spec.kind == "duration" then
                        isSet = true
                        value = string.format("%.2f 秒", row.attackDuration)
                    elseif spec.kind == "projectileSpeed" then
                        isSet = (row.projectileRuid or "") ~= "" and (row.projectileSpeed or 0) > 0
                        if isSet then value = string.format("%.2f 世界單位/秒", row.projectileSpeed) end
                    end
                    if not isSet then value = self.UnsetText end
                end
                table.insert(details, { key = spec.key, value = value, isSet = isSet })
            end
        end
        return details
    end

    @ExecSpace("ClientOnly")
    method void DestroyDetailRows()
        -- Remove the cloned header and value rows; the hidden templates stay.
        for _, entity in ipairs(self._T.detailViews or {}) do
            if isvalid(entity) then entity:Destroy() end
        end
        self._T.detailViews = {}
    end

    @ExecSpace("ClientOnly")
    method void BuildDetailRows()
        -- Clone the fixed 20-row list from the two templates, in DetailSpecs order. Rows are cloned at runtime (like the monster list) because a list of purely authored rows never measured its content, so it never scrolled.
        if not isvalid(self.headerTemplate) or not isvalid(self.detailTemplate) then return end
        self:DestroyDetailRows()
        for _, spec in ipairs(self:DetailSpecs()) do
            local entity = nil
            if spec.key == nil then
                entity = self.headerTemplate:Clone("Header_" .. spec.group)
                entity.TextGUIRendererComponent.Text = spec.header
            else
                entity = self.detailTemplate:Clone("Detail_" .. spec.key)
                entity:GetChildByName("Label", false).TextGUIRendererComponent.Text = spec.label
            end
            table.insert(self._T.detailViews, entity)
            entity:SetEnable(true)
        end
        self._T.detailsFor = nil
    end

    @ExecSpace("ClientOnly")
    method void RenderDetails()
        -- Write the selected monster's texts into the cloned rows; no row is ever added or removed here, only its text and colour change.
        if not isvalid(self.detailLayout) then return end
        local selectedId = self._T.selectedId
        if self._T.detailsFor ~= selectedId then
            self._T.detailsFor = selectedId
            self.detailLayout:ResetScrollPosition(UITransformAxis.Vertical)
        end
        for _, detail in ipairs(self:BuildDetails(self:GetSelectedRow())) do
            local row = self.detailLayout.Entity:GetChildByName("Detail_" .. detail.key, false)
            local value = isvalid(row) and row:GetChildByName("Value", false) or nil
            if isvalid(value) then
                value.TextGUIRendererComponent.Text = detail.value
                value.TextGUIRendererComponent.FontColor = detail.isSet and self.DetailValueColor or self.DetailUnsetColor
            end
        end
    end

    @ExecSpace("ClientOnly")
    method void Observe(table rows)
        -- Replace the list with the server's latest reply; the selection survives when that monster is still listed.
        local valid = {}
        for _, row in ipairs(rows) do
            if type(row.monsterId) == "string" and row.monsterId ~= "" then table.insert(valid, row) end
        end
        self._T.rows = valid
        self._T.loadState = #valid > 0 and "READY" or "EMPTY"
        if self:RowFor(self._T.selectedId) == nil then
            self._T.selectedId = #valid > 0 and valid[1].monsterId or ""
            self:ResetPlayback()
        end
        self:BuildRows()
        self:BuildDetailRows()
        self:Render()
        log("[VRF][MonsterDex] observed rows=" .. tostring(#valid) .. " selected=" .. self._T.selectedId)
    end

    @ExecSpace("ClientOnly")
    method void DestroyRows()
        -- Release every row's subscription before its entity goes away.
        for _, view in ipairs(self._T.rowViews or {}) do
            if isvalid(view.entity) then
                view.entity:DisconnectEvent(ButtonClickEvent, view.callback)
                view.entity:Destroy()
            end
        end
        self._T.rowViews = {}
    end

    @ExecSpace("ClientOnly")
    method void BuildRows()
        -- One cloned button per dex row, in table order; a newer rebuild abandons an older one that is still cloning.
        if not isvalid(self.rowTemplate) then return end
        self._T.buildSerial = self._T.buildSerial + 1
        local serial = self._T.buildSerial
        self:DestroyRows()
        for index, row in ipairs(self._T.rows) do
            local monsterId = row.monsterId
            local entity = self.rowTemplate:Clone("Row_" .. tostring(index))
            if serial ~= self._T.buildSerial then
                if isvalid(entity) then entity:Destroy() end
                return
            end
            entity.TextGUIRendererComponent.Text = row.monsterName
            local callback = entity:ConnectEvent(ButtonClickEvent, function() self:Select(monsterId) end)
            table.insert(self._T.rowViews, { entity = entity, callback = callback, monsterId = monsterId })
            entity:SetEnable(true)
        end
        if isvalid(self.listLayout) then self.listLayout:ResetScrollPosition(UITransformAxis.Vertical) end
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Highlight the selected row; while there is no list, say why instead.
        for _, view in ipairs(self._T.rowViews) do
            if isvalid(view.entity) then
                local selected = view.monsterId == self._T.selectedId
                view.entity.SpriteGUIRendererComponent.Color = selected and self.SelectedRowColor or self.RowColor
                view.entity.TextGUIRendererComponent.FontColor = selected and self.SelectedTextColor or self.RowTextColor
            end
        end
        self:RenderDetails()
        if not isvalid(self.statusText) then return end
        local messages = { LOADING = "讀取中…", EMPTY = "資料表沒有怪物", FAILED = "讀取逾時，請關閉後重新開啟" }
        local message = messages[self._T.loadState] or ""
        self.statusText.Text = message
        self.statusText.Entity:SetEnable(message ~= "")
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release the authored button subscriptions at world session shutdown.
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.callback) end
        end
        self:DestroyRows()
        self:DestroyDetailRows()
    end
end
