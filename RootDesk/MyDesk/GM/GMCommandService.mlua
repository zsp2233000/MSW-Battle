@Logic
script GMCommandService extends Logic

    @ExecSpace("ServerOnly")
    method boolean IsGM(string requesterProfile)
        -- The owner and the Maker test account both resolve to this ProfileCode (issue #84).
        return requesterProfile == "6Y9NGB"
    end

    @ExecSpace("ServerOnly")
    method void Execute(string requesterProfile, table command, any complete)
        -- All commands, including identity and unknown commands, fail closed before dispatch.
        if not self:IsGM(requesterProfile) then complete({ status = "FORBIDDEN" }) return end
        if command.kind == "IDENTITY" then complete({ status = "OK", profile = requesterProfile }) return end
        if command.kind == "LIST_ONLINE_PLAYERS" then _GMOnlinePlayers:Read(complete) return end
        local profile = command.profile == "" and requesterProfile or command.profile
        if type(profile) ~= "string" or #profile == 0 or #profile > 64 or not string.match(profile, "^[%w]+$") then
            complete({ status = "INVALID_PROFILE" })
            return
        end
        if command.kind == "LOAD_LEVELS" then self:Load(profile, _MonsterLevelStorage.StorageKey, complete) return end
        if command.kind == "LOAD_FORMATIONS" then self:Load(profile, _FormationService.StorageKey, complete) return end
        if command.kind == "LOAD_HANDOFF" then self:Load(profile, _FormationHandoff.StorageKey, complete) return end
        if command.kind == "LIST_AUDIT" then
            _FormationStorage:ListAudit(profile, function(code, records)
                if code ~= 0 then complete({ status = "STORAGE_ERROR", profile = profile, code = code }) return end
                complete({ status = "HISTORY_READY", profile = profile, records = records })
                log("[VRF][GM] history profile=" .. profile .. " records=" .. tostring(#records))
            end)
            return
        end
        local force = command.kind == "FORCE_SAVE_LEVELS"
        local action = command.kind
        if force then action = command.action end
        local key = type(action) == "string" and self:MutationKey(action) or nil
        if key ~= nil then
            self:Mutate(requesterProfile, profile, key, action, force, command, complete)
            return
        end
        complete({ status = "INVALID_COMMAND" })
    end

    @ExecSpace("ServerOnly")
    method string MutationKey(string action)
        if action == "SAVE_LEVELS" or action == "RESET_LEVELS" or action == "DELETE_LEVELS" or action == "RESTORE_LEVELS" then
            return _MonsterLevelStorage.StorageKey
        end
        if action == "SAVE_FORMATIONS" or action == "DELETE_FORMATIONS" or action == "RESTORE_FORMATIONS" then
            return _FormationService.StorageKey
        end
        if action == "DELETE_HANDOFF" then return _FormationHandoff.StorageKey end
        return nil
    end

    @ExecSpace("ServerOnly")
    method void Load(string profile, string key, any complete)
        local catalog = _FormationService:GetCatalog()
        if catalog == nil and key ~= _FormationHandoff.StorageKey then complete({ status = "UNAVAILABLE" }) return end
        self:ReadCurrent(profile, key, catalog, function(code, stored, document, exists)
            if code ~= 0 then complete({ status = "STORAGE_ERROR", code = code, profile = profile }) return end
            local response = self:Describe(profile, key, stored, document, exists, catalog)
            complete(response)
            log("[VRF][GM] load profile=" .. profile .. " key=" .. key .. " status=" .. response.status)
        end)
    end

    @ExecSpace("ServerOnly")
    method table Describe(string profile, string key, string stored, table document, boolean exists, any catalog)
        local response = { status = "READY", profile = profile, exists = exists, expected = stored }
        if key ~= _MonsterLevelStorage.StorageKey or document == nil then response.raw = stored end
        if document == nil then
            response.status = "CORRUPT"
            response.corrupt = true
        elseif key == _MonsterLevelStorage.StorageKey then
            response.rows = self:LevelRows(document, catalog)
        end
        return response
    end

    @ExecSpace("ServerOnly")
    method table LevelRows(table document, any catalog)
        local rows = {}
        for _, monster in ipairs(catalog:GetDeploymentOptions()) do
            local progress = document.monsters[monster.monsterId] or _MonsterProgression:DefaultProgress()
            table.insert(rows, { monsterId = monster.monsterId, monsterName = monster.monsterName,
                level = progress.level, experience = progress.experience })
        end
        return rows
    end

    @ExecSpace("ServerOnly")
    method void Mutate(string requesterProfile, string profile, string key, string action, boolean force, table command, any complete)
        local catalog = _FormationService:GetCatalog()
        if catalog == nil and key ~= _FormationHandoff.StorageKey then complete({ status = "UNAVAILABLE" }) return end
        -- A shared audit guard serializes the target's ring across all save items.
        _FormationStorage:BeginExclusive(profile, "GMAuditV1", function(code, auditGuard)
            if code ~= 0 then complete({ status = "BUSY", code = code, profile = profile }) return end
            _FormationStorage:BeginExclusive(profile, key, function(guardCode, guard)
                if guardCode ~= 0 then
                    _FormationStorage:EndExclusive(auditGuard)
                    complete({ status = "BUSY", code = guardCode, profile = profile })
                    return
                end
                local function finish(response, retainGuard, retainAuditGuard)
                    if not retainGuard then _FormationStorage:EndExclusive(guard) end
                    if not retainAuditGuard then _FormationStorage:EndExclusive(auditGuard) end
                    complete(response)
                end
                self:ReadCurrent(profile, key, catalog, function(readCode, stored, document, exists)
                    if readCode ~= 0 then finish({ status = "STORAGE_ERROR", code = readCode, profile = profile }, false, false) return end
                    if not force and (stored ~= command.expected or exists ~= command.expectedExists) then
                        local response = self:Describe(profile, key, stored, document, exists, catalog)
                        response.status = "CONFLICT"
                        finish(response, false, false)
                        return
                    end
                    self:Commit(requesterProfile, guard, auditGuard, action, command, stored, document, exists, catalog, finish)
                end)
            end)
        end)
    end

    @ExecSpace("ServerOnly")
    method void ReadCurrent(string profile, string key, any catalog, any complete)
        -- Distinguish absence, corruption and storage errors without repairing any of them.
        _FormationStorage:Read(profile, key, function(code, loadedKey, raw)
            local missing = code == 1000002 or (code == 0 and raw == nil)
            if not missing and code ~= 0 then complete(code, nil, nil, false) return end
            local stored = missing and "" or raw
            complete(0, stored, self:Decode(key, stored, not missing, catalog), not missing)
        end)
    end

    @ExecSpace("ServerOnly")
    method table Decode(string key, string raw, boolean exists, any catalog)
        if key == _MonsterLevelStorage.StorageKey then
            if not exists then return { monsters = {}, settled = {} } end
            return _MonsterLevelStorage:Decode(raw)
        end
        if not exists then return {} end
        if key == _FormationService.StorageKey then return _FormationSchema:DecodeDocument(raw, catalog) end
        local ok, document = pcall(function() return _HttpService:JSONDecode(raw) end)
        return ok and type(document) == "table" and document or nil
    end

    @ExecSpace("ServerOnly")
    method void Commit(string requesterProfile, table guard, table auditGuard, string action, table command, string stored,
        table document, boolean exists, any catalog, any finish)
        -- Audit the version about to be overwritten before any save mutation.
        local profile = guard.profile
        local key = guard.key
        local deleting = action == "DELETE_LEVELS" or action == "DELETE_FORMATIONS" or action == "DELETE_HANDOFF"
        local restoring = action == "RESTORE_LEVELS" or action == "RESTORE_FORMATIONS"
        local after = nil
        if action == "DELETE_LEVELS" and (not exists or document ~= nil) then
            finish({ status = "NOT_CORRUPT", profile = profile }, false, false)
            return
        end
        if deleting and not exists then finish({ status = "NO_SAVE", profile = profile }, false, false) return end
        if restoring then
            if type(command.recordId) ~= "string" or #command.recordId > 64 then
                finish({ status = "RECORD_UNAVAILABLE", profile = profile }, false, false)
                return
            end
            local snapshot = {}
            local code = _FormationStorage:ReadAuditBefore(guard, command.recordId, snapshot)
            if code ~= 0 then
                local status = code == 1000002 and "RECORD_UNAVAILABLE" or "STORAGE_ERROR"
                finish({ status = status, code = code, profile = profile }, false, false)
                return
            end
            deleting = not snapshot.exists
            after = snapshot.raw
        elseif deleting then
            after = ""
        elseif action == "SAVE_FORMATIONS" then
            local raw = command.raw
            if type(raw) == "string" and #raw <= 50000 and _FormationSchema:DecodeDocument(raw, catalog) ~= nil then
                after = raw
            end
        else
            after = self:Plan(command, action, document, catalog)
        end
        if after == nil then
            local status = action == "SAVE_FORMATIONS" and "INVALID_FORMATIONS" or "INVALID_PROGRESS"
            finish({ status = status, profile = profile }, false, false)
            return
        end
        local record = { gm = requesterProfile, timeMs = DateTime.UtcNow.Elapsed,
            target = profile, key = key, beforeExists = exists, afterExists = not deleting, outcome = "PENDING",
            action = action, restoredFrom = restoring and command.recordId or nil }
        _FormationStorage:AppendAudit(auditGuard, record, stored, after, function(auditCode, audit, pending, retainAuditGuard)
            if auditCode ~= 0 then finish({ status = "AUDIT_FAILED", code = auditCode, profile = profile }, false, retainAuditGuard) return end
            local function written(writeCode, retainWriteGuard)
                local status = writeCode == 0 and "SAVED" or (writeCode == 2000000 and "CONFLICT" or "STORAGE_ERROR")
                record.outcome = writeCode == 1000004 and "UNKNOWN" or (status == "STORAGE_ERROR" and "FAILED" or status)
                _FormationStorage:CompleteAudit(audit, pending, record, function(resultCode)
                    log("[VRF][GM] write profile=" .. profile .. " action=" .. action .. " status=" .. status .. " auditCode=" .. tostring(resultCode))
                    if resultCode ~= 0 then
                        finish({ status = "AUDIT_INCOMPLETE", code = resultCode, profile = profile }, retainWriteGuard, false)
                    elseif writeCode == 0 then
                        local saved = self:Decode(key, after, not deleting, catalog)
                        local response = self:Describe(profile, key, after, saved, not deleting, catalog)
                        response.status = status
                        finish(response, retainWriteGuard, false)
                    elseif status == "CONFLICT" then
                        self:ReadCurrent(profile, key, catalog, function(code, current, currentDocument, currentExists)
                            if code ~= 0 then finish({ status = "STORAGE_ERROR", code = code, profile = profile }, retainWriteGuard, false) return end
                            local response = self:Describe(profile, key, current, currentDocument, currentExists, catalog)
                            response.status = "CONFLICT"
                            finish(response, retainWriteGuard, false)
                        end)
                    else
                        finish({ status = status, code = writeCode, profile = profile }, retainWriteGuard, false)
                    end
                end)
            end
            if deleting then
                if exists then _FormationStorage:DeleteGuarded(guard, stored, written) else written(0, false) end
            else
                _FormationStorage:WriteGuarded(guard, exists, stored, after, written)
            end
        end)
    end

    @ExecSpace("ServerOnly")
    method string Plan(table command, string action, table source, any catalog)
        -- Merge rows or reset against the latest valid document, or validate an explicit repair.
        if action == "RESET_LEVELS" then
            if source == nil then return nil end
            source.monsters = {}
        elseif action ~= "SAVE_LEVELS" then
            return nil
        elseif command.raw ~= nil then
            if source ~= nil or command.rows ~= nil or type(command.raw) ~= "string" or #command.raw > 4000 then return nil end
            source = _MonsterLevelStorage:Decode(command.raw)
            if source == nil then return nil end
        else
            if source == nil then return nil end
            local count = _FormationSchema:ArrayCount(command.rows, 100)
            if count < 0 then return nil end
            local seen = {}
            for _, row in ipairs(command.rows) do
                if type(row) ~= "table" or type(row.monsterId) ~= "string" or catalog:GetProfile(row.monsterId) == nil
                    or seen[row.monsterId] or not _MonsterProgression:IsValidProgress(row.level, row.experience) then return nil end
                seen[row.monsterId] = true
                source.monsters[row.monsterId] = { level = row.level, experience = row.experience }
            end
        end
        local encoded = _MonsterLevelStorage:Encode(source)
        return #encoded <= 4000 and encoded or nil
    end
end
