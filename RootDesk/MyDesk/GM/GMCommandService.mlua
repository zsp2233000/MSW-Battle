@Logic
script GMCommandService extends Logic

    @ExecSpace("ServerOnly")
    method boolean IsGM(string requesterProfile)
        -- The owner and the Maker test account both resolve to this ProfileCode (issue #84).
        return requesterProfile == "6Y9NGB"
    end

    @ExecSpace("ServerOnly")
    method void Execute(string requesterProfile, table command, any complete)
        -- All commands, including identity and unknown commands, fail closed before dispatch.
        if not self:IsGM(requesterProfile) then complete({ status = "FORBIDDEN" }) return end
        if command.kind == "IDENTITY" then complete({ status = "OK", profile = requesterProfile }) return end
        local profile = command.profile == "" and requesterProfile or command.profile
        if type(profile) ~= "string" or #profile == 0 or #profile > 64 or not string.match(profile, "^[%w]+$") then
            complete({ status = "INVALID_PROFILE" })
            return
        end
        if command.kind == "LOAD_LEVELS" then self:Load(profile, complete) return end
        if command.kind == "SAVE_LEVELS" or command.kind == "FORCE_SAVE_LEVELS"
            or command.kind == "RESET_LEVELS" or command.kind == "DELETE_LEVELS" then
            self:Mutate(requesterProfile, profile, command, complete)
            return
        end
        complete({ status = "INVALID_COMMAND" })
    end

    @ExecSpace("ServerOnly")
    method void Load(string profile, any complete)
        -- Return exact bytes as the CAS expectation; reads never create or repair a save.
        local catalog = _FormationService:GetCatalog()
        if catalog == nil then complete({ status = "UNAVAILABLE" }) return end
        _FormationStorage:Read(profile, _MonsterLevelStorage.StorageKey, function(code, key, raw)
            local missing = code == 1000002 or (code == 0 and raw == nil)
            if not missing and code ~= 0 then complete({ status = "STORAGE_ERROR", code = code, profile = profile }) return end
            local stored = missing and "" or raw
            local document = missing and { monsters = {}, settled = {} } or _MonsterLevelStorage:Decode(raw)
            if document == nil then
                complete({ status = "CORRUPT", profile = profile, exists = true, expected = stored, raw = stored })
                log("[VRF][GM] load corrupt profile=" .. profile)
                return
            end
            complete(self:Ready(profile, not missing, stored, document, catalog))
            log("[VRF][GM] load profile=" .. profile .. " exists=" .. tostring(not missing))
        end)
    end

    @ExecSpace("ServerOnly")
    method table Ready(string profile, boolean exists, string expected, table document, any catalog)
        -- Keep absent progress at the shared default without inventing stored rows.
        local rows = {}
        for _, monster in ipairs(catalog:GetDeploymentOptions()) do
            local progress = document.monsters[monster.monsterId] or _MonsterProgression:DefaultProgress()
            table.insert(rows, { monsterId = monster.monsterId, monsterName = monster.monsterName,
                level = progress.level, experience = progress.experience })
        end
        return { status = "READY", profile = profile, exists = exists, expected = expected, rows = rows }
    end

    @ExecSpace("ServerOnly")
    method void Mutate(string requesterProfile, string profile, table command, any complete)
        -- One exclusive owner covers audit, CAS, force re-read and corrupt-save deletion.
        local key = _MonsterLevelStorage.StorageKey
        _FormationStorage:BeginExclusive(profile, key, function(code, guard)
            if code ~= 0 then complete({ status = "BUSY", code = code, profile = profile }) return end
            local function finish(response, retainGuard)
                if not retainGuard then _FormationStorage:EndExclusive(guard) end
                complete(response)
            end
            self:ReadCurrent(profile, key, function(readCode, stored, document, exists)
                if readCode ~= 0 then finish({ status = "STORAGE_ERROR", code = readCode, profile = profile }, false) return end
                if command.kind ~= "FORCE_SAVE_LEVELS" and (stored ~= command.expected or exists ~= command.expectedExists) then
                    finish(self:Conflict(profile, stored, document, exists), false)
                    return
                end
                self:Commit(requesterProfile, guard, command, stored, document, exists, finish)
            end)
        end)
    end

    @ExecSpace("ServerOnly")
    method void ReadCurrent(string profile, string key, any complete)
        -- Distinguish absence, corruption and storage errors without repairing any of them.
        _FormationStorage:Read(profile, key, function(code, loadedKey, raw)
            local missing = code == 1000002 or (code == 0 and raw == nil)
            if not missing and code ~= 0 then complete(code, nil, nil, false) return end
            local stored = missing and "" or raw
            complete(0, stored, missing and { monsters = {}, settled = {} } or _MonsterLevelStorage:Decode(raw), not missing)
        end)
    end

    @ExecSpace("ServerOnly")
    method table Conflict(string profile, string stored, table document, boolean exists)
        -- Return the current snapshot without changing the caller's original expectation.
        local catalog = _FormationService:GetCatalog()
        local reply = { profile = profile, exists = exists, expected = stored }
        if document == nil then
            reply.raw = stored
        elseif catalog ~= nil then
            reply = self:Ready(profile, exists, stored, document, catalog)
        end
        reply.status = "CONFLICT"
        return reply
    end

    @ExecSpace("ServerOnly")
    method void Commit(string requesterProfile, table guard, table command, string stored, table document, boolean exists, any finish)
        -- Audit the version about to be overwritten before any save mutation.
        local profile = guard.profile
        local action = command.kind == "FORCE_SAVE_LEVELS" and command.action or command.kind
        local deleting = action == "DELETE_LEVELS"
        local catalog = _FormationService:GetCatalog()
        if catalog == nil then finish({ status = "UNAVAILABLE", profile = profile }, false) return end
        if deleting and (not exists or document ~= nil) then
            finish({ status = "NOT_CORRUPT", profile = profile }, false)
            return
        end
        local after = deleting and "" or self:Plan(command, action, document, catalog)
        if after == nil then finish({ status = "INVALID_PROGRESS", profile = profile }, false) return end
        local record = { gm = requesterProfile, timeMs = DateTime.UtcNow.Elapsed,
            target = profile, key = guard.key, beforeExists = exists, afterExists = not deleting, outcome = "PENDING" }
        _FormationStorage:AppendAudit(guard, record, stored, after, function(auditCode, audit, pending, retainGuard)
            if auditCode ~= 0 then finish({ status = "AUDIT_FAILED", code = auditCode, profile = profile }, retainGuard) return end
            local function written(writeCode, retainWriteGuard)
                local status = writeCode == 0 and "SAVED" or (writeCode == 2000000 and "CONFLICT" or "STORAGE_ERROR")
                record.outcome = writeCode == 1000004 and "UNKNOWN" or (status == "STORAGE_ERROR" and "FAILED" or status)
                _FormationStorage:CompleteAudit(audit, pending, record, function(resultCode)
                    log("[VRF][GM] write profile=" .. profile .. " status=" .. status .. " auditCode=" .. tostring(resultCode))
                    if resultCode ~= 0 then
                        finish({ status = "AUDIT_INCOMPLETE", code = resultCode, profile = profile }, retainWriteGuard)
                    elseif writeCode == 0 then
                        local saved = deleting and { monsters = {}, settled = {} } or _MonsterLevelStorage:Decode(after)
                        local response = self:Ready(profile, not deleting, after, saved, catalog)
                        response.status = status
                        finish(response, retainWriteGuard)
                    elseif status == "CONFLICT" then
                        self:ReadCurrent(profile, guard.key, function(code, current, currentDocument, currentExists)
                            local response = code == 0 and self:Conflict(profile, current, currentDocument, currentExists)
                                or { status = "STORAGE_ERROR", code = code, profile = profile }
                            finish(response, retainWriteGuard)
                        end)
                    else
                        finish({ status = status, code = writeCode, profile = profile }, retainWriteGuard)
                    end
                end)
            end
            if deleting then
                _FormationStorage:DeleteGuarded(guard, stored, written)
            else
                _FormationStorage:WriteGuarded(guard, exists, stored, after, written)
            end
        end)
    end

    @ExecSpace("ServerOnly")
    method string Plan(table command, string action, table source, any catalog)
        -- Merge rows or reset against the latest valid document, or validate an explicit repair.
        if action == "RESET_LEVELS" then
            if source == nil then return nil end
            source.monsters = {}
        elseif action ~= "SAVE_LEVELS" then
            return nil
        elseif command.raw ~= nil then
            if source ~= nil or command.rows ~= nil or type(command.raw) ~= "string" or #command.raw > 4000 then return nil end
            source = _MonsterLevelStorage:Decode(command.raw)
            if source == nil then return nil end
        else
            if source == nil then return nil end
            local count = _FormationSchema:ArrayCount(command.rows, 100)
            if count < 0 then return nil end
            local seen = {}
            for _, row in ipairs(command.rows) do
                if type(row) ~= "table" or type(row.monsterId) ~= "string" or catalog:GetProfile(row.monsterId) == nil
                    or seen[row.monsterId] or not _MonsterProgression:IsValidProgress(row.level, row.experience) then return nil end
                seen[row.monsterId] = true
                source.monsters[row.monsterId] = { level = row.level, experience = row.experience }
            end
        end
        local encoded = _MonsterLevelStorage:Encode(source)
        return #encoded <= 4000 and encoded or nil
    end
end
