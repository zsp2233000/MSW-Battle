@Logic
script GMPanel extends Logic

    property Entity panel = "ce0fd29b-64ea-4364-b244-c10896174934"
    property ButtonComponent lobbyButton = "620d7621-27dd-4210-941d-ca3e29130ee8"
    property ButtonComponent closeButton = "ae519708-9aa6-4ed7-983c-a574cd69c0a9"
    property ButtonComponent loadButton = "38497918-2aef-4246-b302-557cd1f394b9"
    property ButtonComponent selfButton = "a8302ff8-c3d3-4392-a84a-e2965a9aa306"
    property TextGUIRendererInputComponent targetInput = "7d4ad329-6b5a-4485-85e7-2d9977fe72cb"
    property TextGUIRendererComponent statusText = "6d59564f-f39a-4686-83f7-a01e468ddefa"
    property Entity tableHeader = "54f1f67c-576b-49bb-ba6f-f8178e344b0b"
    property ScrollLayoutGroupComponent listLayout = "e7e709c1-4f5a-458d-8f30-67c4111c3bec"
    property Entity rowTemplate = "5009a317-30a9-4097-bc31-397cef2fffb3"
    property ScrollLayoutGroupComponent rawLayout = "6ead7083-1618-489e-82ab-b92dc5422142"
    property TextGUIRendererComponent rawText = "768a922b-912a-421a-ae1b-318270777da2"
    property number LoadTimeoutSeconds = 8
    property ButtonComponent saveButton = "dba499cd-f0c5-47e3-be33-79e230a9720a"
    property ButtonComponent resetButton = "16a22527-259d-412e-a666-f908c405640f"
    property ButtonComponent repairButton = "fcd6f9fc-f19b-4aaa-838e-226e822939d6"
    property ButtonComponent deleteButton = "9bae8b0c-bd3c-40e5-ad96-f0fd057a82c6"
    property ButtonComponent forceButton = "8cc8b4aa-1849-40da-9f7f-9e7596f1c3e0"
    property ButtonComponent reloadButton = "36de60f4-86dd-4166-8c0a-e2352e46d26c"
    property TextGUIRendererInputComponent rawInput = "76a52890-2094-4e22-89d0-63fb7a025cce"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Start closed and unauthorized; only a positive server identity reply reveals the entry.
        self._T.authorized = false
        self._T.open = false
        self._T.pending = false
        self._T.serial = 0
        self._T.identityRequest = 0
        self._T.activeRequest = 0
        self._T.expected = ""
        self._T.draft = nil
        self._T.loadRequest = 0
        self._T.identityFor = ""
        self._T.profile = ""
        self._T.status = "IDLE"
        self._T.rows = {}
        self._T.raw = ""
        self._T.rowViews = {}
        self._T.bindings = {}
        self._T.bound = false
        log("[VRF][GMPanel] ready")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Query identity once per lobby entry; map travel, identity changes and matchmaking close the panel.
        self:EnsureBound()
        local player = _UserService.LocalPlayer
        local inLobby = isvalid(player) and player.CurrentMapName == "formationlobby"
        local userId = inLobby and player.PlayerComponent.UserId or ""
        if self._T.identityFor ~= userId then
            self._T.identityFor = userId
            self._T.authorized = false
            self._T.identityRequest = 0
            self:Close()
            if userId ~= "" then self:RequestIdentity() end
        end
        if isvalid(self.lobbyButton) then
            self.lobbyButton.Entity:SetEnable(inLobby and self._T.authorized)
            self.lobbyButton.Enable = self:CanOpen()
        end
        if self._T.open and not self:CanOpen() then self:Close() end
        if self._T.pending and _UtilLogic.ElapsedSeconds - self._T.startedAt > self.LoadTimeoutSeconds then
            self._T.pending = false
            self._T.loadRequest = 0
            self._T.activeRequest = 0
            self._T.status = "TIMEOUT"
            self:Render()
        end
    end

    @ExecSpace("ClientOnly")
    method void EnsureBound()
        -- Own the connected native button events, including teardown at the end of Play.
        if self._T.bound or not isvalid(self.lobbyButton) or not isvalid(self.closeButton) then return end
        self._T.bound = true
        self.panel:SetEnable(false)
        self.rowTemplate:SetEnable(false)
        self:Bind(self.lobbyButton.Entity, function() self:Open() end)
        self:Bind(self.closeButton.Entity, function() self:Close() end)
        self:Bind(self.loadButton.Entity, function() self:Load(self.targetInput.Text) end)
        self:Bind(self.selfButton.Entity, function() self:Load("") end)
        self:Bind(self.saveButton.Entity, function() self:Save() end)
        self:Bind(self.resetButton.Entity, function() self:Reset() end)
        self:Bind(self.repairButton.Entity, function() self:Repair() end)
        self:Bind(self.deleteButton.Entity, function() self:Delete() end)
        self:Bind(self.forceButton.Entity, function() self:Force() end)
        self:Bind(self.reloadButton.Entity, function() self:Reload() end)
    end

    @ExecSpace("ClientOnly")
    method void Bind(Entity entity, any action)
        -- Keep each event connection until session teardown.
        local callback = entity:ConnectEvent(ButtonClickEvent, action)
        table.insert(self._T.bindings, { entity = entity, callback = callback })
    end

    @ExecSpace("ClientOnly")
    method integer RequestIdentity()
        -- Correlate identity replies independently from target-load replies.
        self._T.serial = self._T.serial + 1
        self._T.identityRequest = self._T.serial
        _GMPanelService:Request(self._T.identityRequest, "IDENTITY", "", "", {})
        return self._T.identityRequest
    end

    @ExecSpace("ClientOnly")
    method boolean CanOpen()
        -- Reuse the lobby's matchmaking lock; the server rechecks permission for every command.
        local player = _UserService.LocalPlayer
        return self._T.authorized and isvalid(player) and player.CurrentMapName == "formationlobby"
            and _MatchFlowInput:AllowsFormationActions()
    end

    @ExecSpace("ClientOnly")
    method void Open()
        -- Show the read-only panel and load the displayed target through the normal RPC path.
        if not self:CanOpen() or self._T.open then return end
        self._T.open = true
        self.panel:SetEnable(true)
        self:Load(self.targetInput.Text)
    end

    @ExecSpace("ClientOnly")
    method void Close()
        -- Invalidate outstanding loads so a late reply cannot repopulate a closed panel.
        self._T.open = false
        self._T.pending = false
        self._T.loadRequest = 0
        self._T.activeRequest = 0
        self._T.expected = ""
        self._T.draft = nil
        self._T.rows = {}
        self._T.raw = ""
        self:ClearRows()
        if isvalid(self.rawText) then self.rawText.Text = "" end
        if isvalid(self.panel) then self.panel:SetEnable(false) end
    end

    @ExecSpace("ClientOnly")
    method void Load(string profile)
        -- One click issues one read; retry is available after errors or an unconfirmed timeout.
        if not self._T.open or not self:CanOpen() or self._T.pending then return end
        local target = string.upper(string.match(profile, "^%s*(.-)%s*$"))
        self.targetInput.Text = target == "" and self._T.profile or target
        self._T.serial = self._T.serial + 1
        self._T.loadRequest = self._T.serial
        self._T.startedAt = _UtilLogic.ElapsedSeconds
        self._T.pending = true
        self._T.status = "LOADING"
        self._T.loaded = ""
        self._T.rows = {}
        self._T.raw = ""
        self:Render()
        _GMPanelService:Request(self._T.loadRequest, "LOAD_LEVELS", target, "", {})
    end


    @ExecSpace("ClientOnly")
    method void Save()
        -- Send only changed rows; the server merges them and keeps the settled match list.
        local edits = {}
        for _, row in ipairs(self._T.rows or {}) do
            local level = self:Integer(self:InputText(row, "LevelInput"))
            local experience = self:Integer(self:InputText(row, "ExperienceInput"))
            if level == nil or experience == nil then self._T.status = "INVALID_PROGRESS" self:Render() return end
            if level ~= row.level or experience ~= row.experience then
                table.insert(edits, { monsterId = row.monsterId, level = level, experience = experience })
            end
        end
        self._T.draft = { action = "SAVE_LEVELS", rows = edits }
        self:Submit("SAVE_LEVELS", self._T.draft)
    end

    @ExecSpace("ClientOnly")
    method void Repair()
        -- Replace a damaged document with one complete raw document, never mixed with row edits.
        self._T.draft = { action = "SAVE_LEVELS", raw = self.rawInput.Text }
        self:Submit("SAVE_LEVELS", self._T.draft)
    end

    @ExecSpace("ClientOnly")
    method void Force()
        -- Repeat the unchanged draft; the server re-reads and CAS-writes those fresh bytes.
        if self._T.draft == nil then return end
        self:Submit("FORCE_SAVE_LEVELS", self._T.draft)
    end

    @ExecSpace("ClientOnly")
    method void Reset()
        -- Ask the server to restore every catalog monster while retaining settled matches.
        self._T.draft = { action = "RESET_LEVELS" }
        self:Submit("RESET_LEVELS", self._T.draft)
    end

    @ExecSpace("ClientOnly")
    method void Delete()
        -- Ask the server to delete only a document it still cannot decode.
        self._T.draft = { action = "DELETE_LEVELS" }
        self:Submit("DELETE_LEVELS", self._T.draft)
    end

    @ExecSpace("ClientOnly")
    method void Reload()
        -- Re-read the loaded target; editing the input does not retarget a write.
        self._T.draft = nil
        self.targetInput.Text = self._T.loaded
        self:Load(self._T.loaded)
    end

    @ExecSpace("ClientOnly")
    method void Submit(string kind, table payload)
        -- One pending command owns the loaded expectation; late replies cannot apply another target.
        if not self._T.open or not self:CanOpen() or self._T.pending or self._T.status == "LOADING" or self._T.loaded == "" then return end
        self._T.serial = self._T.serial + 1
        self._T.activeRequest = self._T.serial
        self._T.startedAt = _UtilLogic.ElapsedSeconds
        self._T.pending = true
        self._T.status = "SAVING"
        self:Render()
        _GMPanelService:Request(self._T.activeRequest, kind, self._T.loaded, self._T.expected or "", payload)
        log("[VRF][GMPanel] submit kind=" .. kind)
    end

    @ExecSpace("ClientOnly")
    method string InputText(table row, string name)
        -- Read the visible clone; the template stays hidden and is never submitted.
        local view = self._T.rowViews[row.index]
        if not isvalid(view) then return "" end
        return view:GetChildByName(name).TextGUIRendererInputComponent.Text
    end

    @ExecSpace("ClientOnly")
    method integer Integer(string text)
        -- Accept only a complete non-negative integer; the server still validates progress.
        if text == nil or not string.match(text, "^%d+$") or #text > 2 then return nil end
        local value = 0
        for index = 1, #text do value = value * 10 + string.byte(text, index) - 48 end
        return value
    end

    @ExecSpace("ClientOnly")
    method void Observe(integer requestId, string kind, table response)
        -- Consume each reply once; outdated targets, closed panels and timed-out requests stay untouched.
        if kind == "IDENTITY" then
            if requestId ~= self._T.identityRequest or self._T.identityRequest == 0 then return end
            self._T.identityRequest = 0
            self._T.authorized = response.status == "OK"
            self._T.profile = response.profile or ""
            if not self._T.authorized then self:Close() end
            log("[VRF][GMPanel] authorized=" .. tostring(self._T.authorized))
            return
        end
        local current = kind == "LOAD_LEVELS" and requestId == self._T.loadRequest or requestId == self._T.activeRequest
        if not current or requestId == 0 or not self._T.pending or not self._T.open then return end
        self._T.loadRequest = 0
        self._T.activeRequest = 0
        self._T.pending = false
        self._T.status = response.status
        self._T.target = response.profile or self._T.target
        if kind == "LOAD_LEVELS" and (response.status == "READY" or response.status == "CORRUPT") then self._T.loaded = self._T.target end
        self._T.exists = response.exists
        self._T.errorCode = response.code
        if response.expected ~= nil then self._T.expected = response.expected end
        if response.rows ~= nil then self._T.rows = response.rows end
        if response.raw ~= nil then self._T.raw = response.raw end
        if response.status == "SAVED" then self._T.draft = nil self._T.raw = "" end
        if response.status == "FORBIDDEN" then self._T.authorized = false self:Close() return end
        self:Render()
        log("[VRF][GMPanel] shown status=" .. response.status .. " rows=" .. tostring(#self._T.rows))
    end

    @ExecSpace("ClientOnly")
    method void ClearRows()
        -- Destroy only the previous load's clones; keep the hidden authored template.
        for _, row in ipairs(self._T.rowViews or {}) do if isvalid(row) then row:Destroy() end end
        self._T.rowViews = {}
    end

    @ExecSpace("ClientOnly")
    method void Render()
        -- Show a complete table or literal damaged-save text, with explicit load and error states.
        self:ClearRows()
        local status = self._T.status
        local messages = { IDLE = "請輸入玩家代碼或選擇我自己", LOADING = "讀取中…", SAVING = "寫入中…",
            CORRUPT = "存檔損壞：可修復合法內容或刪除", CONFLICT = "存檔在你開啟後已變動",
            STORAGE_ERROR = "讀取失敗，請重試", AUDIT_FAILED = "操作紀錄失敗，存檔未改",
            AUDIT_INCOMPLETE = "操作紀錄未完成，請重新讀取", INVALID_PROGRESS = "等級或經驗無效，存檔未改",
            NOT_CORRUPT = "存檔可讀，不能刪除", BUSY = "存檔正在寫入，請重試",
            INVALID_PROFILE = "玩家代碼格式無效", UNAVAILABLE = "怪物資料尚未就緒，請重試",
            TIMEOUT = "讀取逾時，請重試", INVALID_COMMAND = "不支援的指令" }
        local message = messages[status] or status
        if status == "READY" or status == "SAVED" then
            local label = status == "SAVED" and " · 已儲存" or (self._T.exists and " · 怪物等級" or " · 尚無存檔，顯示 Lv1／經驗 0")
            message = "玩家代碼：" .. tostring(self._T.target) .. label
            status = "READY"
        elseif status == "STORAGE_ERROR" or status == "AUDIT_FAILED" or status == "BUSY" then
            message = message .. "（" .. tostring(self._T.errorCode) .. "）"
        end
        self.statusText.Text = message
        local ready = status == "READY"
        local corrupt = self._T.status == "CORRUPT" or (self._T.status == "CONFLICT" and self._T.raw ~= "")
        self.tableHeader:SetEnable(ready)
        self.listLayout.Entity:SetEnable(ready)
        self.rawLayout.Entity:SetEnable(corrupt)
        self.rawText.Text = self._T.raw
        if corrupt then
            local width = self.rawText.Entity.UITransformComponent.RectSize.x
            local height = self.rawText:GetPreferredHeight(self._T.raw, width)
            self.rawText.Entity.UITransformComponent.RectSize = Vector2(width, math.max(280, height + 24))
            self.rawLayout:ResetScrollPosition(UITransformAxis.Vertical)
        end
        for index, data in ipairs(ready and self._T.rows or {}) do
            data.index = index
            local row = self.rowTemplate:Clone("GMRow_" .. tostring(index))
            row:GetChildByName("Name").TextGUIRendererComponent.Text = data.monsterName .. "（" .. data.monsterId .. "）"
            local level = row:GetChildByName("LevelInput")
            local experience = row:GetChildByName("ExperienceInput")
            level.TextGUIRendererInputComponent.Text = tostring(data.level)
            experience.TextGUIRendererInputComponent.Text = tostring(data.experience)
            level:SetEnable(true)
            experience:SetEnable(true)
            row:GetChildByName("Level"):SetEnable(false)
            row:GetChildByName("Experience"):SetEnable(false)
            row:SetEnable(true)
            self._T.rowViews[index] = row
        end
        if ready then self.listLayout:ResetScrollPosition(UITransformAxis.Vertical) end
        local busy = self._T.pending
        self.loadButton.Enable = not busy
        self.selfButton.Enable = not busy
        self.targetInput.Enable = not busy
        self.saveButton.Enable = ready and not busy
        self.resetButton.Enable = ready and not busy
        self.repairButton.Enable = corrupt and not busy
        self.deleteButton.Enable = self._T.status == "CORRUPT" and not busy
        self.forceButton.Enable = self._T.status == "CONFLICT" and self._T.draft ~= nil and not busy
        self.reloadButton.Enable = self._T.status == "CONFLICT" and not busy
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Release every native button connection and every cloned row.
        self:Close()
        for _, binding in ipairs(self._T.bindings or {}) do
            if isvalid(binding.entity) then binding.entity:DisconnectEvent(ButtonClickEvent, binding.callback) end
        end
    end
end
