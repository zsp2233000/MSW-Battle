@Logic
script MatchFlow extends Logic

    property boolean Enabled = true
    property string TestProfileA = ""
    property string TestProfileB = ""
    property string LeaderboardId = ""
    property string QueueName = "battle-centered-v2"
    property number SaveDelaySeconds = 0
    property integer TransferLifetimeSeconds = 900
    property integer VacateAttempts = 6
    property number VacateRetrySeconds = 0.5

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Each room owns its own coordinator; native matchmaking supplies cross-instance identity.
        self._T.records = {}
        self._T.busy = {}
        self._T.rooms = {}
        self._T.pendingRecover = {}
        self._T.recoveryTimers = {}
        self._T.notifyTimers = {}
        self._T.queueTimers = {}
        self._T.guardTimers = {}
        self._T.presentationSequence = {}
        self._T.queueCommands = {}
        self._T.offline = {}
        self._T.arrival = {}
        self._T.moving = {}
        self._T.failures = {}
        self._T.arrivalTimers = {}
        self._T.progressTimers = {}
        self._T.closedMatches = {}
        self._T.ended = false
        -- Maker plays against an in-process FIFO; a published world uses the native matchmaking service.
        self._T.queue = Environment:IsMakerPlay() and _MatchQueueLocal or _MatchQueueNative
        self._T.transfer = _MatchTransfer
        log("[VRF][MatchFlow] ready enabled=" .. tostring(self.Enabled) .. " room=" .. _RoomService.RoomKey .. " adapter=" .. self._T.queue:Kind())
        -- Which world instance this room belongs to: a ticket carries it as its source, so a re-login in another instance can be told apart in the logs.
        log("[VRF][MatchFlow] world instance=" .. tostring(_WorldInstanceService.WorldInstanceId) .. " room=" .. _RoomService.RoomKey)
    end

    @ExecSpace("ServerOnly")
    method any QueueAdapter()
        -- The matching backend: enqueue, cancel, look up the pairing. Every environment difference lives behind it.
        return self._T.queue
    end

    @ExecSpace("ServerOnly")
    method any TransferAdapter()
        -- The room movement boundary used for entering a match and returning to the lobby.
        return self._T.transfer
    end

    @ExecSpace("ServerOnly")
    method void UseAdapters(any queue, any transfer)
        -- Replace either adapter without touching the flow; the flow never inspects what it was given.
        self._T.queue = queue
        self._T.transfer = transfer
    end

    @ExecSpace("ServerOnly")
    method any Player(string userId)
        -- Derive the connected player on the server and enforce optional published test-account restrictions.
        if not self.Enabled or self._T.ended or self._T.offline[userId] then return nil end
        if not Environment:IsMakerPlay() and not Environment:IsPublishedPlay() then return nil end
        local player = _UserService:GetUserEntityByUserId(userId)
        if not isvalid(player) then return nil end
        local profile = player.PlayerComponent.ProfileCode
        if not Environment:IsMakerPlay() and (self.TestProfileA ~= "" or self.TestProfileB ~= "") and profile ~= self.TestProfileA and profile ~= self.TestProfileB then return nil end
        return player
    end

    @ExecSpace("ServerOnly")
    method boolean IsOffline(string userId)
        -- A disconnected player's entity can stay in the world for a while; the war code leaves such a player alone and judges them when they come back.
        return self._T.offline[userId] == true
    end

    @ExecSpace("ServerOnly")
    method void Report(string userId, table event)
        -- Diagnostic details never participate in state or failure decisions.
        log("[VRF][MatchFlow] " .. event.code .. " " .. _HttpService:JSONEncode(event.details or {}))
        if self:Player(userId) == nil then return end
        local ticket = self._T.records[userId]
        local attempt = ticket ~= nil and ticket.data.attempt or ""
        self._T.failures[userId] = _MatchFlowState:Failure(self._T.failures[userId], event, attempt)
        self:PublishState(userId, event.code)
    end



    @ExecSpace("ServerOnly")
    method string StateForUser(string userId)
        -- Return the coordinator phase without payloads; battle presentation resolves IN_ROOM separately.
        local ticket = self._T.records[userId]
        -- A ticket is registered before its reservation fills data in; until then there is no phase to report.
        if ticket == nil or ticket.data == nil then return "IDLE" end
        if ticket.cancelling or ticket.data.state == "CANCELLED" then return "CANCELLING" end
        return ticket.data.state
    end

    @ExecSpace("ServerOnly")
    method any MatchMap()
        -- The map of the match this room runs, or nil in a room that has none (the static room).
        local map = _EntityService:GetEntityByPath("/maps/matchprobe")
        return isvalid(map) and map or nil
    end

    @ExecSpace("ServerOnly")
    method any Battle()
        -- The battle session of this room's match map, or nil when there is none.
        local map = self:MatchMap()
        return map ~= nil and map:GetComponent("script.BattleSession") or nil
    end

    @ExecSpace("ServerOnly")
    method void PublishState(string userId, string message)
        -- Publish private presentation state without exposing capsule contents or accepting client identities.
        if self:Player(userId) == nil then return end
        local ticket = self._T.records[userId]
        local state = self:StateForUser(userId)
        local started = ticket ~= nil and ticket.data.started or 0
        local inMatchRoom = ticket ~= nil and state == "IN_ROOM" and _RoomService:IsInstanceRoom() and _RoomService.RoomKey == ticket.data.matchKey
        local count = inMatchRoom and #_UserService.UserEntities.Values or 0
        local map = inMatchRoom and self:MatchMap() or nil
        local battle = inMatchRoom and self:Battle() or nil
        local flow = isvalid(map) and map:GetFirstChildComponentByTypeName("script.MatchedBattle", true) or nil
        local summary = ticket ~= nil and ticket.data.summary or ""
        local attempt = ticket ~= nil and ticket.data.attempt or ""
        local origin = ticket ~= nil and ticket.data.origin or ""
        local target = ticket ~= nil and ticket.data.target or ""
        local guardAt = ticket ~= nil and ticket.guardStarted ~= nil and ticket.guardStarted + _FactionWarGuard.WaitSeconds * 1000 or 0
        self._T.presentationSequence[userId] = (self._T.presentationSequence[userId] or 0) + 1
        local snapshot = _MatchFlowState:Resolve({ state = state, inMatchRoom = inMatchRoom,
            instanceRoom = _RoomService:IsInstanceRoom(), admissionFailed = isvalid(flow) and flow.AdmissionFailed,
            battlePhase = isvalid(battle) and battle.Phase or "",
            battleAuthorized = not isvalid(battle) or battle.MatchKey == "" or (battle.MatchKey == ticket.data.matchKey and (ticket.data.profile == battle.HomeProfile or ticket.data.profile == battle.AwayProfile)),
            result = isvalid(battle) and battle:ResultForProfile(ticket.data.profile) or "",
            failure = self._T.failures[userId], snapshot = { eventCode = message, reasonCode = message,
                started = started, players = count, sourceRoom = _RoomService.RoomKey,
                busy = self._T.busy[userId] == true, summary = summary, attempt = attempt, origin = origin, target = target, guardAt = guardAt, guard = self:IsGuard(ticket),
                sequenceKey = _WorldInstanceService.WorldInstanceId .. ":" .. _RoomService.RoomKey,
                sequence = self._T.presentationSequence[userId] } })
        self:ReceiveState(snapshot, userId)
    end

    @ExecSpace("Client")
    method void ReceiveState(table snapshot)
        -- Reject foreign room observations before they can clear client pending state.
        if snapshot.sourceRoom ~= _RoomService.RoomKey then return end
        local player = _UserService.LocalPlayer
        if isvalid(player) and (player.CurrentMapName == "matchprobe") ~= (snapshot.sourceRoom ~= "__main__") then return end
        _MatchFlowInput:Observe(snapshot)
    end

    @ExecSpace("ServerOnly")
    method boolean Belongs(table data, table matched)
        -- A stale successful notification cannot authorize another attempt or a cancelled ticket.
        local requestId = data.requestId or data.attempt
        local isHome = data.profile == matched.home and requestId == matched.homeAttempt
        local isAway = data.profile == matched.away and requestId == matched.awayAttempt
        if not isHome and not isAway then return false end
        -- A war ticket only joins a match whose other side stands in the town it attacks and attacks back.
        local origin = data.origin or ""
        if origin == "" then return true end
        local mine = isHome and matched.homeOrigin or matched.awayOrigin
        local theirs = isHome and matched.awayOrigin or matched.homeOrigin
        return mine == origin and theirs == data.target
    end

    @ExecSpace("Server")
    method void RequestQueue(string commandId)
        -- Freeze the valid saved active formation; the test never supplies client-authored opponents or stats.
        if #commandId ~= 32 or not string.match(commandId, "^%x+$") then return end
        local commands = self._T.queueCommands[senderUserId] or {}
        if commands[commandId] then self:PublishState(senderUserId, "DUPLICATE_START") return end
        commands[commandId] = true
        self._T.queueCommands[senderUserId] = commands
        self:QueueForUser(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method boolean IsFormationLocked(string userId)
        -- Preserve the caller API while all lock authority lives in FormationHandoff.
        return _FormationHandoff:IsLockedForUser(userId)
    end

    @ExecSpace("ServerOnly")
    method boolean Settled(string userId, table ticket)
        -- A landed candidate is adopted here. Unchanged bytes stay pending, so false must not start another write.
        local ok = ticket ~= nil and _FormationHandoff:Reconcile(userId, ticket) == true
        if not ok then log("[VRF][MatchFlow] pending unconfirmed") end
        return ok
    end

    @ExecSpace("ServerOnly")
    method boolean Finish(string userId, table ticket, string doneState, any attempt)
        -- Reconcile a previous candidate, then issue one intent. An explicit failure stays visible.
        if not self:Settled(userId, ticket) then return false end
        if ticket.data ~= nil and ticket.data.state == doneState then return true end
        return attempt()
    end

    @ExecSpace("ServerOnly")
    method void QueueForUser(string userId)
        -- Share the authenticated entry path with server-driven Maker verification.
        local player = self:Player(userId)
        if player == nil then self:Report(userId, { code = "DISABLED_OR_NOT_PUBLISHED" }) return end
        if player.CurrentMapName ~= "formationlobby" then self:Report(userId, { code = "LOBBY_ONLY" }) return end
        self:QueueTicket(userId, nil)
    end

    @ExecSpace("ServerOnly")
    method void QueueForWar(string userId, string origin, string target)
        -- A war queue starts from the player's own town and names the one enemy town it attacks.
        local player = self:Player(userId)
        if player == nil then self:Report(userId, { code = "DISABLED_OR_NOT_PUBLISHED" }) return end
        if origin == "" or target == "" or origin == target or player.CurrentMapName ~= origin then self:Report(userId, { code = "TOWN_ONLY" }) return end
        self:QueueTicket(userId, { origin = origin, target = target })
    end

    @ExecSpace("ServerOnly")
    method void QueueTicket(string userId, any war)
        -- Freeze the active formation and enter the queue; war carries the optional origin and target towns.
        local player = self:Player(userId)
        if player == nil then return end
        if not self:QueueAdapter():Configured(self.LeaderboardId) then self:Report(userId, { code = "MATCHMAKING_NOT_CONFIGURED" }) return end
        if _RoomService:IsInstanceRoom() or self._T.busy[userId] or self._T.records[userId] ~= nil then return end
        self._T.busy[userId] = true
        local ticket = _FormationHandoff:OpenForUser(userId)
        if ticket == nil or not self:Settled(userId, ticket) then
            self._T.busy[userId] = nil
            self:Report(userId, { code = ticket == nil and "NEED_LOADED_VALID_ACTIVE_FORMATION_AND_NO_PENDING_SAVE" or "RESERVATION_SAVE_FAILED" })
            return
        end
        if ticket.data ~= nil and ticket.data.state ~= "RETURNED" and ticket.data.state ~= "CANCELLED" then
            self._T.records[userId] = ticket
            self._T.busy[userId] = nil
            self:Recover(userId)
            self:Report(userId, { code = "EXISTING_TICKET_USE_STATUS_OR_CANCEL" })
            return
        end
        local request = { attempt = _UtilLogic:NewGuid(), requestId = _UtilLogic:NewGuid(), source = _WorldInstanceService.WorldInstanceId, adapter = self:QueueAdapter():Kind(),
            origin = war ~= nil and war.origin or "", target = war ~= nil and war.target or "" }
        self._T.records[userId] = ticket
        if not self:Finish(userId, ticket, "QUEUED", function() return _FormationHandoff:Reserve(userId, ticket, request) end) then
            if ticket.failure ~= "RESERVATION_SAVE_FAILED" then self._T.records[userId] = nil end
            self._T.busy[userId] = nil
            self:Report(userId, { code = ticket.failure or "RESERVATION_SAVE_FAILED" })
            return
        end
        if self._T.records[userId] ~= ticket or self:Player(userId) == nil or ticket.data.state ~= "QUEUED" then self._T.busy[userId] = nil return end
        self._T.busy[userId] = nil
        self:SubmitQueue(userId, ticket)
    end

    @ExecSpace("ServerOnly")
    method void SubmitQueue(string userId, table ticket)
        -- Own one registration until the adapter accepts it; map changes never submit a second request.
        if self._T.records[userId] ~= ticket or ticket.data.state ~= "QUEUED" or ticket.submitting then return end
        local requestId = ticket.data.requestId
        local request = { userId = userId, profile = ticket.data.profile, requestId = requestId, attempt = ticket.data.attempt,
            source = ticket.data.source, leaderboardId = self.LeaderboardId, queueName = self.QueueName,
            origin = ticket.data.origin or "", target = ticket.data.target or "",
            live = function()
                return self._T.records[userId] == ticket and ticket.data ~= nil and ticket.data.state == "QUEUED" and not ticket.guarding and self:Player(userId) ~= nil
            end }
        ticket.submitting = true
        self:Report(userId, { code = "SUBMITTING" })
        local submitted = self:QueueAdapter():Enqueue(request, function(outcome, code)
            self:QueueResult(userId, ticket, requestId, outcome, code)
        end)
        ticket.submitting = false
        if self._T.records[userId] ~= ticket or ticket.data.requestId ~= requestId or ticket.data.state ~= "QUEUED" then return end
        if not submitted.accepted then
            self:QueueResult(userId, ticket, requestId, submitted.outcome, submitted.code)
            return
        end
        self:StartGuardClock(userId, ticket)
        self:Report(userId, { code = submitted.report })
        -- An in-process adapter pairs here; a pushing adapter answers false and reports through its callback instead.
        if self:QueueAdapter():Poll() then self:AdvancePending() end
    end

    @ExecSpace("ServerOnly")
    method boolean IsGuard(any ticket)
        -- A ticket is a guard match from the moment the guard claims it, and for good once the pairing is stored.
        if ticket == nil then return false end
        if ticket.guardPairing ~= nil then return true end
        local pairing = ticket.data ~= nil and ticket.data.match or nil
        return type(pairing) == "table" and pairing.guard == true
    end

    @ExecSpace("ServerOnly")
    method any Pairing(table data)
        -- A guard pairing is stored in the ticket itself; every other pairing is the queue adapter's to confirm.
        if type(data.match) == "table" and data.match.guard == true then return data.match end
        return self:QueueAdapter():Lookup(data.profile)
    end

    @ExecSpace("ServerOnly")
    method void ClearGuardClock(string userId)
        -- A matched, cancelled or departed ticket no longer waits for the guard.
        local timer = self._T.guardTimers[userId]
        if timer ~= nil then _TimerService:ClearTimer(timer) self._T.guardTimers[userId] = nil end
    end

    @ExecSpace("ServerOnly")
    method void ScheduleGuard(string userId, table ticket, number seconds)
        -- One live timer per player; whatever the previous one waited for is replaced.
        self:ClearGuardClock(userId)
        self._T.guardTimers[userId] = _TimerService:SetTimerOnce(function()
            self._T.guardTimers[userId] = nil
            self:GuardFire(userId, ticket)
        end, seconds)
    end

    @ExecSpace("ServerOnly")
    method void StartGuardClock(string userId, table ticket)
        -- A war ticket waits for a human once; a renewed queue request keeps the original clock.
        if (ticket.data.origin or "") == "" or ticket.guardStarted ~= nil then return end
        ticket.guardStarted = DateTime.UtcNow.Elapsed
        self:ScheduleGuard(userId, ticket, _FactionWarGuard.WaitSeconds)
        log("[VRF][Guard] clock started target=" .. tostring(ticket.data.target))
    end

    @ExecSpace("ServerOnly")
    method void GuardFire(string userId, table ticket)
        -- The wait is over: a ticket that is still waiting for a human is taken out of the human pool, then fights the guard.
        if self._T.ended or self._T.records[userId] ~= ticket or ticket.data == nil or self:Player(userId) == nil then return end
        local state = ticket.data.state
        if (state ~= "QUEUED" and state ~= "RENEWING") or ticket.guarding or ticket.matchPending then return end
        if ticket.cancelling or ticket.submitting or self._T.busy[userId] or state == "RENEWING" then
            self:ScheduleGuard(userId, ticket, _FactionWarGuard.RetrySeconds)
            return
        end
        local origin, target = ticket.data.origin or "", ticket.data.target or ""
        if origin == "" or _FactionWarGuard.Rosters[target] == nil then
            log("[VRF][Guard] no guard for target=" .. target .. "; ticket keeps waiting")
            return
        end
        -- From here a human result is deferred; the adapter decides whether the ticket really left its pool.
        ticket.guarding = true
        self._T.busy[userId] = true
        local removed = self:CancelMatching(ticket.data.profile)
        self._T.busy[userId] = nil
        if self._T.ended or self._T.records[userId] ~= ticket or self:Player(userId) == nil then
            ticket.guarding = nil
            log("[VRF][Guard] claim dropped; ticket gone during withdrawal")
            return
        end
        -- A human result that already arrived, or a pairing the adapter still holds for this attempt, wins over the guard.
        local human = ticket.matchPending == true
        if removed and not human then
            local held = self:QueueAdapter():Lookup(ticket.data.profile)
            human = held ~= nil and self:Belongs(ticket.data, held)
        end
        if human then
            ticket.guarding = nil
            ticket.matchPending = nil
            log("[VRF][Guard] a human match stands; no guard fight")
            self:Matched(userId, ticket, nil)
            return
        end
        if not removed then
            -- The adapter could not confirm the withdrawal; the ticket keeps waiting and the guard tries again.
            log("[VRF][Guard] withdrawal unconfirmed; retry")
            ticket.guarding = nil
            self:ScheduleGuard(userId, ticket, _FactionWarGuard.RetrySeconds)
            return
        end
        local requestId = ticket.data.requestId
        local pairing = { key = "guard-" .. _UtilLogic:NewGuid(), home = ticket.data.profile, away = _FactionWarGuard:Profile(target),
            homeAttempt = requestId, awayAttempt = "guard", homeSource = ticket.data.source, awaySource = ticket.data.source,
            differentSources = false, homeOrigin = origin, awayOrigin = target, guard = true }
        ticket.guardPairing = pairing
        ticket.matchPending = nil
        log("[VRF][Guard] ticket claimed by the " .. target .. " guard match=" .. pairing.key)
        self:Matched(userId, ticket, pairing)
        ticket.guarding = nil
        if self._T.records[userId] == ticket and ticket.data ~= nil and ticket.data.state == "QUEUED" then
            -- The claim failed before the handoff left the queue; wait again instead of stranding the ticket.
            log("[VRF][Guard] claim failed before handoff; retry")
            ticket.guardPairing = nil
            self:ScheduleGuard(userId, ticket, _FactionWarGuard.RetrySeconds)
        end
    end

    @ExecSpace("ServerOnly")
    method void ResumeRenew(string userId, table ticket, string expiredRequestId)
        -- Reconcile first. A partial renew keeps its request id; only a still-expired queue mints one.
        if self._T.records[userId] ~= ticket or ticket.data == nil or self._T.busy[userId] then return end
        if ticket.data.state ~= "QUEUED" and ticket.data.state ~= "RENEWING" then return end
        self._T.busy[userId] = true
        self:PublishState(userId, "QUEUE_RENEWING")
        if not self:Settled(userId, ticket) or ticket.data == nil then
            self._T.busy[userId] = nil
            self:Report(userId, { code = "QUEUE_RENEW_SAVE_FAILED" })
            return
        end
        local requestId = ticket.renewRequestId or ticket.data.requestId
        if ticket.data.state == "QUEUED" and ((ticket.renewRequestId ~= nil and ticket.data.requestId == requestId) or (ticket.renewRequestId == nil and (expiredRequestId == "" or requestId ~= expiredRequestId))) then
            ticket.renewRequestId = nil
            self._T.busy[userId] = nil
            log("[VRF][Queue] renewed; original clock and fixed formation retained")
            self:SubmitQueue(userId, ticket)
            return
        end
        if ticket.renewRequestId == nil and (ticket.data.state ~= "RENEWING" or type(requestId) ~= "string" or requestId == "") then requestId = _UtilLogic:NewGuid() end
        ticket.renewRequestId = requestId
        local stored = _FormationHandoff:Renew(userId, ticket, requestId)
        if ticket.data ~= nil and ticket.data.requestId == requestId and ticket.data.state == "QUEUED" then stored = true end
        self._T.busy[userId] = nil
        if not stored then self:Report(userId, { code = "QUEUE_RENEW_SAVE_FAILED" }) return end
        ticket.renewRequestId = nil
        log("[VRF][Queue] renewed; original clock and fixed formation retained")
        self:SubmitQueue(userId, ticket)
    end

    @ExecSpace("ServerOnly")
    method void QueueResult(string userId, table ticket, string requestId, string outcome, string code)
        -- Ignore stale generations and duplicate completion; expiry renews the same frozen game attempt.
        if self._T.records[userId] ~= ticket or ticket.data.requestId ~= requestId or ticket.data.state ~= "QUEUED" then return end
        if outcome == "MATCHED" then
            self:Matched(userId, ticket, nil)
        elseif outcome == "REJECTED" then
            -- The adapter refused this ticket; close it so the player can start over, and say why.
            if self:Finish(userId, ticket, "CANCELLED", function() return _FormationHandoff:Close(userId, ticket, "CANCELLED") end) then self._T.records[userId] = nil end
            self:Report(userId, { code = code })
        elseif outcome == "EXPIRED" then
            self:Report(userId, { code = "QUEUE_RENEWING" })
            local expiredRequestId = requestId
            self._T.queueTimers[userId] = _TimerService:SetTimerOnce(function()
                self._T.queueTimers[userId] = nil
                if self._T.records[userId] ~= ticket or ticket.data == nil then return end
                ticket.renewPending = true
                while ticket.submitting or ticket.cancelling or self._T.busy[userId] do
                    wait(0.1)
                    if self._T.records[userId] ~= ticket or ticket.data == nil then ticket.renewPending = nil return end
                end
                ticket.renewPending = nil
                if ticket.data.state == "QUEUED" and ticket.data.requestId ~= expiredRequestId then return end
                if ticket.data.state ~= "QUEUED" and ticket.data.state ~= "RENEWING" then return end
                self:ResumeRenew(userId, ticket, expiredRequestId)
            end, 1)
        else
            self._T.busy[userId] = true
            self:Finish(userId, ticket, "QUEUE_ERROR", function() return _FormationHandoff:FailQueue(userId, ticket) end)
            self._T.busy[userId] = nil
            self:Report(userId, { code = "QUEUE_SERVICE_FAILED", details = { serviceCode = code } })
        end
    end

    @ExecSpace("ServerOnly")
    method void Matched(string userId, table ticket, any pairing)
        -- Seal the handoff with confirmed content only; matching never saves, and the queue-time roster stays fixed (#50).
        -- A guard match arrives as pairing; every human match reads its pairing from the queue adapter instead.
        if self._T.records[userId] ~= ticket or ticket.data == nil then return end
        if pairing == nil and ticket.guarding then
            ticket.matchPending = true
            log("[VRF][Guard] human result deferred until the guard claim settles")
            return
        end
        self:ClearGuardClock(userId)
        if ticket.data.state == "QUEUED" then
            if not self:Settled(userId, ticket) then self:Report(userId, { code = "HANDOFF_SAVE_FAILED" }) return end
            if not _FormationHandoff:BeginSave(userId, ticket, function()
                return self._T.records[userId] == ticket and self:Player(userId) ~= nil
            end) then return end
        elseif ticket.data.state ~= "SAVING" then
            return
        elseif not self:Settled(userId, ticket) then
            self:Report(userId, { code = "HANDOFF_SAVE_FAILED" })
            return
        end
        -- The pairing is looked up and the war board read first (BeginSave only flipped an in-memory state): every wait that follows, a cancellation that is still
        -- answering and the seal and commit writes, falls after the reading, so a town that changes hands during them is seen. A deferred match that resumes keeps its first reading.
        local matched = pairing or self:QueueAdapter():Lookup(ticket.data.profile)
        if matched ~= nil and ticket.snapshot == nil then ticket.snapshot = _FactionWarAttack:Snapshot(matched) end
        -- The reading yields, so the ticket may have been cancelled, replaced or left meanwhile.
        if self._T.records[userId] ~= ticket or ticket.data == nil or ticket.data.state ~= "SAVING" then return end
        if ticket.cancelling then
            ticket.matchPending = true
            log("[VRF][MatchCancel] matched response deferred until cancellation settles")
            return
        end
        self._T.failures[userId] = nil
        self:PublishState(userId, "MATCHED")
        -- The war board this pairing was made on travels in the sealed pairing, on a copy.
        if matched ~= nil then matched = _FactionWarAttack:Stamped(matched, ticket.snapshot) end
        if matched == nil or not self:Belongs(ticket.data, matched) then
            self._T.busy[userId] = true
            self:Finish(userId, ticket, "QUEUE_ERROR", function() return _FormationHandoff:FailQueue(userId, ticket) end)
            self._T.busy[userId] = nil
            self:Report(userId, { code = "QUEUE_RESULT_INVALID" })
            return
        end
        if self.SaveDelaySeconds > 0 then wait(math.min(120, self.SaveDelaySeconds)) end
        if ticket.data.state ~= "SAVING" then return end
        local sealed = _FormationHandoff:Seal(userId, ticket, function()
            return self._T.records[userId] == ticket and ticket.data ~= nil and ticket.data.state == "SAVING" and self:Player(userId) ~= nil
        end)
        -- Cancellation may yield while this match is sealing; its reply decides whether commit can proceed.
        if ticket.cancelling then log("[VRF][MatchCancel] commit waits for cancellation") end
        while ticket.cancelling and self._T.records[userId] == ticket and not self._T.ended do wait(0.1) end
        if self._T.records[userId] ~= ticket or ticket.data.state ~= "SAVING" then return end
        if not sealed then
            self._T.busy[userId] = true
            self:Finish(userId, ticket, "QUEUE_ERROR", function() return _FormationHandoff:FailQueue(userId, ticket) end)
            self._T.busy[userId] = nil
            self:Report(userId, { code = "CAPTURE_NOT_READY" })
            return
        end
        self._T.failures[userId] = nil
        -- Cancellation stops at this explicit commit boundary, before the first yielding write.
        self._T.busy[userId] = true
        self:PublishState(userId, "COMMITTING")
        local committed = self:Finish(userId, ticket, "TRANSFER", function()
            return _FormationHandoff:Commit(userId, ticket, matched, self.TransferLifetimeSeconds)
        end)
        self._T.busy[userId] = nil
        if not committed then self:Report(userId, { code = "HANDOFF_SAVE_FAILED" }) return end
        if self._T.records[userId] ~= ticket or self:Player(userId) == nil then return end
        self:Report(userId, { code = "SEALED", details = { matchKey = matched.key, differentSources = matched.differentSources } })
        self:NotifyReady(matched)
        self:Recover(userId)
    end

    @ExecSpace("ServerOnly")
    method void NotifyReady(table matched)
        -- Wake every other source coordinator once; readiness events are hints and admission revalidates stored authority.
        -- A guard match wakes nobody: the guard has no coordinator of its own.
        if matched.guard == true then return end
        for _, destination in ipairs(self:QueueAdapter():Destinations(matched)) do
            self:SendReady(matched.key, destination, 0)
        end
    end

    @ExecSpace("ServerOnly")
    method void SendReady(string matchKey, string destination, integer attempt)
        -- Retry failed native event delivery at most three times; the visible action can retry after that.
        if self._T.ended or self._T.closedMatches[matchKey] then return end
        local event = MatchTransferReadyEvent()
        event.MatchKey = matchKey
        _WorldInstanceService:RequestSendEventToWorldInstanceAsync(event, destination, function(code)
            if self._T.ended or self._T.closedMatches[matchKey] then return end
            if code == SendEventRequestResultCode.OK then return end
            if attempt < 2 then
                local timer = _TimerService:SetTimerOnce(function() self:SendReady(matchKey, destination, attempt + 1) end, 1 + attempt)
                table.insert(self._T.notifyTimers, timer)
            else
                for userId, ticket in pairs(self._T.records) do
                    if ticket.data.matchKey == matchKey and ticket.data.state == "TRANSFER" then self:Report(userId, { code = "READINESS_FAILED" }) end
                end
            end
        end)
    end

    @ExecSpace("ServerOnly")
    method void AdvancePending()
        -- Advance connected participants on readiness and arrival, without recurring storage polling.
        if _RoomService:IsInstanceRoom() then
            for _, user in ipairs(_UserService.UserEntities.Values) do self:PublishState(user.PlayerComponent.UserId, "ARRIVED") end
            return
        end
        local ids = {}
        for _, user in ipairs(_UserService.UserEntities.Values) do table.insert(ids, user.PlayerComponent.UserId) end
        for _, userId in ipairs(ids) do self:Recover(userId) end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "WorldInstanceService")
    handler HandleMatchTransferReadyEvent(MatchTransferReadyEvent event)
        -- Only an active matching ticket can turn an external readiness hint into a recovery read.
        for _, ticket in pairs(self._T.records) do
            if ticket.data.matchKey == event.MatchKey and ticket.data.state == "TRANSFER" then self:AdvancePending() return end
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserEnterEvent(UserEnterEvent event)
        -- Native world and room arrivals automatically resume admission or restore the returning session.
        self._T.offline[event.UserId] = nil
        local previous = self._T.arrivalTimers[event.UserId]
        if previous ~= nil then _TimerService:ClearTimer(previous) end
        self._T.arrivalTimers[event.UserId] = _TimerService:SetTimerOnce(function()
            self._T.arrivalTimers[event.UserId] = nil
            if self._T.ended or self:Player(event.UserId) == nil then return end
            self:Recover(event.UserId)
            self:AdvancePending()
            -- A login is judged once the ticket has had its say; a player a ticket still owns stays with it.
            self:PlaceAtLogin(event.UserId, "enter")
        end, 0.5)
    end

    @ExecSpace("ServerOnly")
    method void PlaceAtLogin(string userId, string cause)
        -- Hand a login to the war once the ticket has had its say: a player a ticket still owns (a queue, a match room, a return) is left to it.
        if _RoomService:IsInstanceRoom() then return end
        local settled = _FactionWarLanding:WaitWhile(function() return self._T.busy[userId] or self._T.pendingRecover[userId] end, _FactionWarLanding.LoginReadySeconds)
        if self._T.ended or self:Player(userId) == nil then
            log("[VRF][MatchFlow] login placement skipped user=" .. userId .. " cause=" .. cause .. "; the player is not available")
            return
        end
        -- A ticket, a hint left by the recovery, or a handoff that still locks the profile each mean the ticket has the player.
        local owned = self._T.records[userId] ~= nil or self._T.arrival[userId] == true or _FormationHandoff:IsLockedForUser(userId)
        if not settled then
            -- The recovery has not finished, so what it will say is not known: leave the player to it instead of judging on a half-read state.
            log("[VRF][MatchFlow] login placement user=" .. userId .. " cause=" .. cause .. "; the recovery is still running after " .. tostring(_FactionWarLanding.LoginReadySeconds) .. "s, treated as owned")
            owned = true
        end
        _FactionWarLanding:Judge(userId, { kind = "LOGIN", cause = cause, owned = owned })
    end

    @ExecSpace("Server")
    method void RequestCancel(string expectedAttempt)
        -- Only the observed attempt can request cancellation; CancelForUser owns the yielding confirmation.
        local ticket = self._T.records[senderUserId]
        if ticket == nil or ticket.data.attempt ~= expectedAttempt then return end
        self:CancelForUser(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method boolean CancelMatching(string profile)
        -- Share the adapter's cancellation confirmation between visible retries and disconnect cleanup.
        local confirmed = self:QueueAdapter():Cancel(profile)
        log("[VRF][MatchCancel] confirmed=" .. tostring(confirmed))
        return confirmed
    end

    @ExecSpace("ServerOnly")
    method void ResumeDeferredMatch(string userId, table ticket)
        -- A failed cancellation leaves the native match valid, so its deferred reply continues on the same ticket.
        if not ticket.matchPending or ticket.data == nil or ticket.data.state ~= "SAVING" then return end
        ticket.matchPending = nil
        log("[VRF][MatchCancel] resume pending match")
        -- A deferred guard claim resumes with its own pairing; a human match reads it from the adapter.
        self:Matched(userId, ticket, ticket.guardPairing)
    end

    @ExecSpace("ServerOnly")
    method void CancelForUser(string userId)
        -- Cancel the actual selected adapter while preserving the common attempt and tombstone guards.
        local player = self:Player(userId)
        if player == nil or self._T.busy[userId] then return end
        local ticket = self._T.records[userId]
        if ticket == nil then
            self._T.busy[userId] = true
            ticket = _FormationHandoff:OpenForUser(userId)
            self._T.busy[userId] = nil
        end
        if ticket == nil or ticket.data == nil then return end
        -- A reconnected player cannot join Depart's in-flight cancellation; that cleanup owns this ticket.
        if ticket.cancelling then log("[VRF][MatchCancel] cleanup owns cancellation") return end
        local state = ticket.data.state
        if not _FormationHandoff:CanCancel(ticket) then self:Report(userId, { code = "COMMITTED_USE_RETURN_OR_STATUS" }) return end
        log("[VRF][MatchCancel] requested state=" .. state)
        ticket.cancelling = true
        self._T.busy[userId] = true
        self._T.failures[userId] = nil
        self:PublishState(userId, "CANCELLING")
        while ticket.submitting do wait(0.1) end
        local cancelled = state == "CANCELLED" or self:CancelMatching(ticket.data.profile)
        -- A durable-only ticket has no live record; only a different live ticket supersedes this cancellation.
        local current = self._T.records[userId]
        if self._T.ended or (current ~= nil and current ~= ticket) then
            log("[VRF][MatchCancel] superseded by a newer ticket")
            self._T.busy[userId] = nil
            return
        end
        if not cancelled then
            ticket.cancelling = nil
            self._T.busy[userId] = nil
            self:Report(userId, { code = "CANCEL_FAILED" })
            if self:Player(userId) ~= nil then self:ResumeDeferredMatch(userId, ticket) end
            return
        end
        ticket.matchPending = nil
        self:ClearGuardClock(userId)
        local stored = self:Finish(userId, ticket, "CANCELLED", function() return _FormationHandoff:Close(userId, ticket, "CANCELLED") end)
        ticket.cancelling = nil
        self._T.busy[userId] = nil
        if stored or self:Player(userId) == nil then self._T.records[userId] = nil end
        self:Report(userId, { code = "CANCEL_OBSERVED", details = { stored = stored } })
        self:Report(userId, { code = stored and "CANCELLED" or "CANCEL_SAVE_FAILED" })
    end

    @ExecSpace("ServerOnly")
    method void Recover(string userId)
        -- Resolve server-persisted tickets after native warp, room entry, lobby reconnect and disconnect cleanup.
        local player = self:Player(userId)
        if player == nil then return end
        if self._T.busy[userId] then self._T.pendingRecover[userId] = true return end
        local current = self._T.records[userId]
        -- Disconnect cleanup recovers once its cancellation settles; reading now could replace its ticket.
        if current ~= nil and current.cancelling then log("[VRF][MatchCancel] recovery waits for cleanup") return end
        -- A reply deferred while offline continues now that its failed cancellation left the match valid.
        if current ~= nil and current.matchPending then self:ResumeDeferredMatch(userId, current) return end
        -- Until the guard match is stored, the claim owns the ticket; reading storage now would replace it mid-claim.
        if current ~= nil and current.guarding and (current.data.state == "QUEUED" or current.data.state == "SAVING") then return end
        -- A war ticket that was still waiting for an opponent when its owner left, and whose cleanup could not finish then, is not resumed:
        -- the player re-chooses their attack, and the guard countdown starts again with that choice.
        if current ~= nil and current.data ~= nil and current.departFailed and (current.data.origin or "") ~= "" and self:IsWaiting(current) and _FormationHandoff:CanCancel(current) then
            log("[VRF][MatchFlow] war ticket whose leave cleanup failed is cancelled again, not resumed user=" .. userId .. " state=" .. current.data.state)
            self:CancelForUser(userId)
            return
        end
        if current ~= nil and (current.data.state == "QUEUED" or current.data.state == "SAVING" or current.data.state == "RENEWING" or current.data.state == "QUEUE_ERROR") then
            if self:QueueAdapter():Reclaim(userId, current.data, true) == "HELD" then
                if (current.data.state == "RENEWING" or current.renewRequestId ~= nil) and not current.renewPending and self._T.queueTimers[userId] == nil then self:ResumeRenew(userId, current, "") end
                return
            end
            -- The adapter no longer holds this live ticket; reload storage and settle it from there.
        end
        self._T.busy[userId] = true
        local ticket = _FormationHandoff:OpenForUser(userId)
        if ticket ~= nil and ticket.data ~= nil and not self:Settled(userId, ticket) then
            self._T.records[userId] = ticket
            self._T.busy[userId] = nil
            self:Report(userId, { code = "HANDOFF_SAVE_FAILED" })
            return
        end
        if ticket ~= nil and ticket.data ~= nil then
            local data = ticket.data
            if data.state == "CANCELLED" or data.state == "RETURNED" then
                self._T.records[userId] = nil
                self._T.arrival[userId] = nil
                self._T.busy[userId] = nil
                self._T.pendingRecover[userId] = nil
                self:PublishState(userId, data.state)
                return
            end
            self._T.records[userId] = ticket
            -- A live ticket owns the arriving player (war or lobby alike): a login is placed in a town only when none does.
            self._T.arrival[userId] = true
            -- The adapter knows whether anything still stands behind a stored reservation or match.
            -- The adapter never held a guard match, so it has no opinion on one.
            local verdict = nil
            if not self:IsGuard(ticket) then verdict = self:QueueAdapter():Reclaim(userId, data, false) end
            if verdict == "RENEW" then
                self._T.busy[userId] = nil
                self:ResumeRenew(userId, ticket, "")
                return
            elseif verdict == "FAIL" then
                -- A restored reservation has no live callback owner; never present it as a healthy queue.
                if not self:Finish(userId, ticket, "QUEUE_ERROR", function() return _FormationHandoff:FailQueue(userId, ticket) end) then self._T.busy[userId] = nil self:Report(userId, { code = "QUEUE_SERVICE_FAILED" }) return end
                self:Report(userId, { code = "QUEUE_OWNER_LOST" })
            elseif verdict == "CANCEL" then
                -- The adapter's queue died with its session, so a stale queue reservation cannot resume.
                if self:Finish(userId, ticket, "CANCELLED", function() return _FormationHandoff:Close(userId, ticket, "CANCELLED") end) then
                    self._T.records[userId] = nil
                    self._T.arrival[userId] = nil
                    log("[VRF][MatchFlow] stale local queue cancelled=true")
                    self:Report(userId, { code = "CANCELLED" })
                else
                    self:Report(userId, { code = "STALE_QUEUE_CLEANUP_FAILED" })
                end
            elseif verdict == "RETURN" then
                -- The adapter lost the match this ticket was sealed for, so send the player back with their saved formation.
                if self:Finish(userId, ticket, "RETURNING", function() return _FormationHandoff:BeginReturn(userId, ticket) end) then
                    self:Report(userId, { code = "STALE_MATCH_RECOVERY" })
                    self:RestoreReturning(userId, ticket)
                else
                    self:Report(userId, { code = "STALE_MATCH_RECOVERY_SAVE_FAILED" })
                end
            elseif (data.state == "TRANSFER" or data.state == "COMMITTING") and data.expires <= DateTime.UtcNow.Elapsed and not _RoomService:IsInstanceRoom() then
                if self:Finish(userId, ticket, "RETURNING", function() return _FormationHandoff:BeginReturn(userId, ticket) end) then
                    self:Report(userId, { code = "TRANSFER_EXPIRED" })
                    self:RestoreReturning(userId, ticket)
                else
                    self:Report(userId, { code = "RETURN_SAVE_FAILED" })
                end
            elseif data.state == "COMMITTING" and data.expires > DateTime.UtcNow.Elapsed and not _RoomService:IsInstanceRoom() then
                local matched = self:Pairing(data)
                if matched ~= nil and self:Belongs(data, matched) and data.matchKey == matched.key then
                    if _FormationHandoff:Commit(userId, ticket, matched, self.TransferLifetimeSeconds) then
                        self:Rendezvous(userId, ticket, matched)
                    else
                        self:Report(userId, { code = "HANDOFF_SAVE_FAILED" })
                    end
                end
            elseif data.state == "TRANSFER" and data.expires > DateTime.UtcNow.Elapsed and not _RoomService:IsInstanceRoom() then
                local matched = self:Pairing(data)
                if matched ~= nil and self:Belongs(data, matched) and data.matchKey == matched.key then
                    self:Rendezvous(userId, ticket, matched)
                end
            elseif data.state == "IN_ROOM" and _RoomService.RoomKey == data.matchKey then
                -- Retain durable authority for battle admission and later lobby restoration.
                local count = #_UserService.UserEntities.Values
                self:Report(userId, { code = "ARRIVED", details = { matchKey = data.matchKey, players = count } })
            elseif data.state == "IN_ROOM" and not _RoomService:IsInstanceRoom() then
                -- The player's entity is gone (a real leave) but their match room may still run: go back into it, and let that room's own coordinator take over.
                if self:Rejoin(userId, data) then
                    self:Report(userId, { code = "REJOIN_MATCH", details = { matchKey = data.matchKey } })
                -- A prior Maker session or room exit left a durable ticket behind (or the room is gone); restore it in the lobby.
                elseif self:Finish(userId, ticket, "RETURNING", function() return _FormationHandoff:BeginReturn(userId, ticket) end) then
                    self:Report(userId, { code = "STALE_ROOM_RECOVERY" })
                    self:RestoreReturning(userId, ticket)
                else
                    self:Report(userId, { code = "STALE_ROOM_RECOVERY_SAVE_FAILED" })
                end
            elseif data.state == "IN_ROOM" then
                -- A visible retry can send a stale room ticket back to a safe lobby before restoring it.
                self:Report(userId, { code = "ROOM_MISMATCH" })
            elseif data.state == "RETURNING" and not _RoomService:IsInstanceRoom() then
                self:RestoreReturning(userId, ticket)
            end
        elseif ticket ~= nil then
            -- No stored ticket at all: nothing owns this player.
            self._T.arrival[userId] = nil
        end
        self._T.busy[userId] = nil
        self:PublishState(userId, "STATUS")
        if self._T.pendingRecover[userId] then
            self._T.pendingRecover[userId] = nil
            self._T.recoveryTimers[userId] = _TimerService:SetTimerOnce(function() self:Recover(userId) end, 0.1)
        end
    end

    @ExecSpace("ServerOnly")
    method boolean Rejoin(string userId, table data)
        -- A player whose entity is gone but whose match room still runs in this world instance goes back into it; the room's own coordinator takes over on their arrival.
        -- The static room cannot read another room's battle phase, so a finished battle is rejoined too: the room shows its result and judges origin ownership on return.
        if self._T.moving[userId] ~= nil then
            log("[VRF][MatchFlow] rejoin skipped match=" .. data.matchKey .. "; an admission is moving the player")
            return false
        end
        local room = self:TransferAdapter():FindRoom(data.matchKey)
        if room == nil then
            log("[VRF][MatchFlow] rejoin match=" .. data.matchKey .. " room=none")
            return false
        end
        local moved = self:TransferAdapter():MoveToMatch(room, userId)
        log("[VRF][MatchFlow] rejoin match=" .. data.matchKey .. " moved=" .. tostring(moved))
        return moved
    end

    @ExecSpace("ServerOnly")
    method void RestoreReturning(string userId, table ticket)
        -- Restore from cached authority with bounded retries while catalog or prior saves become ready.
        if self._T.ended or self._T.records[userId] ~= ticket or self:Player(userId) == nil or ticket.data.state ~= "RETURNING" then return end
        if _FormationHandoff:Restore(userId, ticket.id) then
            -- After closing the ticket, judge live ownership of the origin and use the match key to rebuild the arrival notice.
            local landing = { kind = "RESTORE", origin = ticket.data.origin or "", matchKey = ticket.data.matchKey or "" }
            local stored = self:Finish(userId, ticket, "RETURNED", function() return _FormationHandoff:Close(userId, ticket, "RETURNED") end)
            if self._T.records[userId] ~= ticket or self:Player(userId) == nil then return end
            if stored then
                self._T.records[userId] = nil
                self:QueueAdapter():Release(ticket.data.profile)
                self:Report(userId, { code = "RETURN_COMPLETED" })
                _FactionWarLanding:Judge(userId, landing)
                return
            end
        end
        ticket.restoreAttempts = (ticket.restoreAttempts or 0) + 1
        if ticket.restoreAttempts <= 10 then
            self._T.recoveryTimers[userId] = _TimerService:SetTimerOnce(function()
                if self._T.records[userId] ~= ticket or self:Player(userId) == nil then return end
                if self._T.busy[userId] then self._T.pendingRecover[userId] = true return end
                self._T.busy[userId] = true
                self:RestoreReturning(userId, ticket)
                self._T.busy[userId] = nil
                self:PublishState(userId, "RESTORE_PENDING")
            end, 1)
        else
            self:Report(userId, { code = "RESTORE_RETRY_REQUIRED" })
        end
    end

    @ExecSpace("ServerOnly")
    method void Rendezvous(string userId, table ticket, table matched)
        -- Both durable capsules must be ready before any native warp can remove either source session.
        if self:Player(userId) == nil or self._T.records[userId] ~= ticket or ticket.data.state ~= "TRANSFER" or self._T.closedMatches[matched.key] then return end
        -- A guard match has no peer capsule to wait for.
        if matched.guard == true then self:Admit(userId, ticket, matched) return end
        local otherProfile = ticket.data.profile == matched.home and matched.away or matched.home
        local peer = _FormationHandoff:Read(otherProfile)
        if peer == nil or peer.data == nil or not self:Belongs(peer.data, matched) or peer.data.matchKey ~= matched.key then return end
        if (peer.data.state ~= "TRANSFER" and peer.data.state ~= "IN_ROOM") or peer.data.expires <= DateTime.UtcNow.Elapsed then return end
        local peerHere = false
        for _, user in ipairs(_UserService.UserEntities.Values) do
            if isvalid(user) and user.PlayerComponent.ProfileCode == otherProfile then peerHere = true end
        end
        if peerHere or self._T.rooms[matched.key] ~= nil then
            self:Admit(userId, ticket, matched)
        elseif ticket.data.profile == matched.home then
            -- Persist the one-shot marker before dispatch; status never retries an ambiguous native warp.
            if not self:Settled(userId, ticket) then return end
            if ticket.data.warpIssued then self:Report(userId, { code = "WARP_ALREADY_ISSUED_WAIT_OR_RETURN" }) return end
            if not _FormationHandoff:MarkWarp(userId, ticket) then
                if ticket.data ~= nil and ticket.data.warpIssued then self:Report(userId, { code = "WARP_ALREADY_ISSUED_WAIT_OR_RETURN" }) end
                return
            end
            local code = self:QueueAdapter():Warp(ticket.data.profile)
            self:Report(userId, { code = "WARP", details = { serviceCode = code, matchKey = matched.key } })
            local timer = 0
            timer = _TimerService:SetTimerOnce(function()
                self._T.progressTimers[timer] = nil
                if not self._T.ended then self:AdvancePending() end
            end, 1)
            self._T.progressTimers[timer] = true
        else
            self:Report(userId, { code = "WAIT_HOME_STATUS" })
        end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserLeaveEvent(UserLeaveEvent event)
        -- Stop outstanding source callbacks on disconnect, preserving committed transfer capsules.
        self:Depart(event.UserId, tostring(event.LeaveReason))
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserDisconnectEvent(UserDisconnectEvent event)
        -- Retained disconnected entities must never count as online matchmaking participants.
        self:Depart(event.UserId, "Disconnect")
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "UserService")
    handler HandleUserReconnectEvent(UserReconnectEvent event)
        -- Restore availability. A lobby reconnect re-locks durable tickets and judges where the player stands; a reconnect in a match room recovers the ticket Depart dropped
        -- and sends the experience receipt again, but never re-admits anybody: the retained entity is already in the room.
        self._T.offline[event.UserId] = nil
        if _RoomService:IsInstanceRoom() then
            log("[VRF][MatchDisconnect] match room reconnect recovers ticket")
            self:RearmExperience(event.UserId)
            self:Recover(event.UserId)
            self:PublishState(event.UserId, "STATUS")
            return
        end
        log("[VRF][MatchDisconnect] lobby reconnect recovers ticket")
        self:Recover(event.UserId)
        self:PublishState(event.UserId, "STATUS")
        self:PlaceAtLogin(event.UserId, "reconnect")
    end

    @ExecSpace("ServerOnly")
    method void RearmExperience(string userId)
        -- A reconnected client starts with no receipt, so the one already sent to this entity goes out again (the battle sends each receipt once per entity).
        local battle = self:Battle()
        if isvalid(battle) then
            battle:RearmExperienceReceipt(userId)
        else
            log("[VRF][MatchFlow] experience receipt not re-armed user=" .. userId .. "; no battle in this room")
        end
    end

    @ExecSpace("ServerOnly")
    method void Depart(string userId, any reason)
        -- Invalidate callbacks before yielding, then settle queue cleanup; combat actors remain owned by BattleSession.
        -- reason is the leave reason for the log only: the leave handler passes the engine's, the disconnect handler "Disconnect", a probe "Probe" (older probes pass nothing).
        self._T.offline[userId] = true
        self._T.arrival[userId] = nil
        for _, timers in ipairs({ self._T.arrivalTimers, self._T.recoveryTimers, self._T.queueTimers, self._T.guardTimers }) do
            if timers[userId] ~= nil then _TimerService:ClearTimer(timers[userId]) timers[userId] = nil end
        end
        self._T.pendingRecover[userId] = nil
        self._T.failures[userId] = nil
        self:QueueAdapter():Withdraw(userId)
        self._T.queueCommands[userId] = nil
        local ticket = self._T.records[userId]
        if ticket == nil then
            log("[VRF][MatchDisconnect] user=" .. userId .. " no ticket reason=" .. tostring(reason or ""))
            return
        end
        if ticket.cancelling then return end
        if _FormationHandoff:CanCancel(ticket) then
            ticket.cancelling = true
            local cancelled = self:CancelMatching(ticket.data.profile)
            local stored = false
            if cancelled then stored = self:Finish(userId, ticket, "CANCELLED", function() return _FormationHandoff:Close(userId, ticket, "CANCELLED") end) end
            ticket.cancelling = nil
            log("[VRF][MatchFlow] leave cancel=" .. tostring(cancelled) .. " tombstone=" .. tostring(stored))
            if not cancelled or not stored then
                -- The native queue or an unconfirmed tombstone still owns this ticket; a war ticket in that state is cancelled again when its owner returns, not resumed.
                ticket.departFailed = true
                if self:Player(userId) ~= nil then
                    self:Report(userId, { code = stored and "CANCEL_FAILED" or "CANCEL_SAVE_FAILED" })
                    if not cancelled then self:ResumeDeferredMatch(userId, ticket) end
                end
                return
            end
        end
        if self._T.records[userId] == ticket then self._T.records[userId] = nil end
        local online = self:Player(userId) ~= nil
        log("[VRF][MatchDisconnect] match=" .. (ticket.data ~= nil and ticket.data.matchKey or "") .. " combatPreserved=true online=" .. tostring(online) .. " reason=" .. tostring(reason or ""))
        -- The player reconnected while cancellation yielded; resolve the durable outcome and refresh their client.
        if online and not _RoomService:IsInstanceRoom() then self:Recover(userId) end
    end

    @ExecSpace("ServerOnly")
    method void Admit(string userId, table ticket, table matched)
        -- Serialize room creation per match; move only the native-authorized connected participant.
        if self._T.closedMatches[matched.key] or self:Player(userId) == nil or self._T.records[userId] ~= ticket or ticket.data.state ~= "TRANSFER" or ticket.data.matchKey ~= matched.key or not self:Belongs(ticket.data, matched) or ticket.data.expires <= DateTime.UtcNow.Elapsed then return end
        local slot = self._T.rooms[matched.key]
        if slot == nil then
            slot = { creating = true, room = nil }
            self._T.rooms[matched.key] = slot
            slot.room = _RoomService:CreateInstanceRoom(matched.key, { "matchprobe" }, 120)
            slot.creating = false
        end
        while slot.creating do wait(0.05) end
        if slot.room == nil or not slot.room:IsValid() then
            self._T.closedMatches[matched.key] = true
            self._T.rooms[matched.key] = nil
            self:Report(userId, { code = "ROOM_CREATE_FAILED" })
            return
        end
        if self:Player(userId) == nil or self._T.records[userId] ~= ticket or ticket.data.state ~= "TRANSFER" then return end
        if not self:Finish(userId, ticket, "IN_ROOM", function() return _FormationHandoff:Admit(userId, ticket) end) then self:Report(userId, { code = "ADMISSION_SAVE_FAILED" }) return end
        if self:Player(userId) == nil or self._T.records[userId] ~= ticket then return end
        -- A recovery that runs while the move is in flight must not send the player back into the same room.
        self._T.moving[userId] = ticket
        -- The mark must not outlive the move, even when the native call raises: a stuck mark would stop every later Rejoin of this player.
        local ok, moved = pcall(function() return self:TransferAdapter():MoveToMatch(slot.room, userId) end)
        self._T.moving[userId] = nil
        if not ok then
            log_error("[VRF][MatchTransfer] match=" .. matched.key .. " move raised " .. tostring(moved))
            moved = false
        end
        log("[VRF][MatchTransfer] match=" .. matched.key .. " entry=" .. tostring(moved))
        if self._T.records[userId] ~= ticket then return end
        if not moved then self:Finish(userId, ticket, "TRANSFER", function() return _FormationHandoff:WithdrawAdmission(userId, ticket) end) end
        self:Report(userId, { code = moved and "ROOM_MOVE_OK" or "ROOM_MOVE_FAILED", details = { moved = moved } })
    end

    @ExecSpace("Server")
    method void RequestStatus()
        -- Map transitions and visible recovery actions resume work without ongoing storage polling.
        local userId = senderUserId
        local player = self:Player(userId)
        if player == nil then self:Report(userId, { code = "DISABLED_OR_NOT_PUBLISHED" }) return end
        self:Recover(userId)
        local ticket = self._T.records[userId]
        if ticket ~= nil and ticket.data.state == "TRANSFER" then
            local matched = self:Pairing(ticket.data)
            if matched ~= nil then self:NotifyReady(matched) end
        end
        local state = ticket ~= nil and ticket.data.state or "IDLE"
        local elapsed = ticket ~= nil and math.floor((DateTime.UtcNow.Elapsed - ticket.data.started) / 1000) or 0
        self:Report(userId, { code = "STATUS", details = { elapsed = elapsed } })
    end

    @ExecSpace("Server")
    method void RequestReturn(string expectedAttempt)
        -- Exit only the caller's authorized room and retain a retryable capsule until restore is confirmed.
        local ticket = self._T.records[senderUserId]
        if ticket ~= nil and ticket.data.attempt ~= expectedAttempt then return end
        self:ReturnForUser(senderUserId)
    end

    @ExecSpace("ServerOnly")
    method void ReturnForUser(string userId)
        -- Return is shared by the visible button and authenticated server recovery.
        local player = self:Player(userId)
        if player == nil or self._T.busy[userId] then return end
        self._T.failures[userId] = nil
        local ticket = self._T.records[userId]
        if _RoomService:IsInstanceRoom() then
            local battle = self:Battle()
            local profile = player.PlayerComponent.ProfileCode
            if isvalid(battle) and battle:IsBattleActive() and (profile == battle.HomeProfile or profile == battle.AwayProfile) then self:Report(userId, { code = "BATTLE_IN_PROGRESS" }) return end
            if ticket == nil or ticket.data.state == "CANCELLED" or ticket.data.state == "RETURNED" then
                local moved = self:MoveHome(userId, ticket)
                self:Report(userId, { code = moved and "RETURN_MOVE_OK" or "RETURN_MOVE_FAILED", details = { moved = moved } })
                return
            end
        end
        if ticket == nil then return end
        if not _RoomService:IsInstanceRoom() then
            if ticket.data.state == "RETURNING" then self:Recover(userId) return end
            if ticket.data.state == "COMMITTING" then
                self:Recover(userId)
                ticket = self._T.records[userId]
                if ticket == nil then return end
            end
            if ticket.data.state ~= "TRANSFER" and ticket.data.state ~= "COMMITTING" and ticket.data.state ~= "RETURNING" and ticket.data.state ~= "IN_ROOM" then return end
            self._T.busy[userId] = true
            local stored = self:Finish(userId, ticket, "RETURNING", function() return _FormationHandoff:BeginReturn(userId, ticket) end)
            self._T.busy[userId] = nil
            if stored then self:Recover(userId) end
            self:Report(userId, { code = "ABORT_TRANSFER", details = { stored = stored } })
            return
        end
        if ticket.data.state == "RETURNING" then
            -- A prior move may have failed after RETURNING was durably stored; keep the visible retry usable.
            self._T.busy[userId] = true
            local moved = self:MoveHome(userId, ticket)
            self._T.busy[userId] = nil
            self:Report(userId, { code = moved and "RETURN_RETRY_MOVE_OK" or "RETURN_RETRY_MOVE_FAILED", details = { moved = moved } })
            return
        end
        if ticket.data.state == "IN_ROOM" and _RoomService.RoomKey ~= ticket.data.matchKey then
            self._T.busy[userId] = true
            self:PublishState(userId, "ROOM_MISMATCH")
            if not self:Finish(userId, ticket, "RETURNING", function() return _FormationHandoff:BeginReturn(userId, ticket) end) then
                self._T.busy[userId] = nil
                self:Report(userId, { code = "ROOM_MISMATCH_SAVE_FAILED" })
                return
            end
            local moved = self:MoveHome(userId, ticket)
            self._T.busy[userId] = nil
            if not moved then
                self:Report(userId, { code = "ROOM_MISMATCH_RETURN_FAILED" })
            else
                self:Report(userId, { code = "ROOM_MISMATCH_RETURNING" })
            end
            return
        end
        if ticket.data.state ~= "IN_ROOM" or _RoomService.RoomKey ~= ticket.data.matchKey then return end
        self._T.busy[userId] = true
        self:PublishState(userId, "RETURNING")
        if not self:Finish(userId, ticket, "RETURNING", function() return _FormationHandoff:BeginReturn(userId, ticket) end) then
            self._T.busy[userId] = nil
            self:Report(userId, { code = "RETURN_SAVE_FAILED" })
            return
        end
        local moved = self:MoveHome(userId, ticket)
        self._T.busy[userId] = nil
        self:Report(userId, { code = moved and "RETURN_MOVE_OK" or "RETURN_MOVE_FAILED", details = { moved = moved } })
    end

    @ExecSpace("ServerOnly")
    method boolean MoveHome(string userId, any ticket)
        -- ADR 0016: return war players to their origin if still owned, otherwise to their capital; other players return to the lobby.
        local origin = ticket ~= nil and ticket.data ~= nil and ticket.data.origin or ""
        if _FactionWar:IsTown(origin) then
            return _FactionWarLanding:Judge(userId, { kind = "RETURN", origin = origin, matchKey = ticket.data.matchKey or "", move = function(town)
                if self:Player(userId) == nil then return false end
                return self:TransferAdapter():MoveToTown(userId, town)
            end })
        end
        return self:TransferAdapter():MoveToLobby(userId)
    end

    method boolean IsWaiting(table ticket)
        -- A ticket is still waiting for an opponent (or is already cancelled and only closing) until its pairing is recognised; SAVING and every state after it is a match.
        local state = ticket.data.state
        return state == "QUEUED" or state == "RENEWING" or state == "QUEUE_ERROR" or state == "CANCELLED"
    end

    @ExecSpace("ServerOnly")
    method boolean Vacate(string userId)
        -- A player who has to leave a fallen town: no ticket is free to go, a ticket still waiting for an opponent is cancelled first, and a matched ticket keeps its place
        -- (that fight is played out and the landing decides afterwards; this is stricter than the player's own cancel button, which CanCancel lets through until the seal).
        -- A ticket in a passing state (its reservation not filled in yet, a cancellation or a claim in flight, an unconfirmed cancel) is tried again a few times before giving up.
        for attempt = 1, self.VacateAttempts do
            local ticket = self._T.records[userId]
            if ticket == nil then return true end
            if ticket.data ~= nil and not self:IsWaiting(ticket) then
                log("[VRF][MatchFlow] vacate held state=" .. ticket.data.state)
                return false
            end
            if ticket.data ~= nil and not ticket.cancelling and not self._T.busy[userId] then
                self:CancelForUser(userId)
                if self._T.records[userId] == nil then
                    log("[VRF][MatchFlow] vacate cancelled=true attempt=" .. tostring(attempt))
                    return true
                end
            end
            log("[VRF][MatchFlow] vacate waits attempt=" .. tostring(attempt) .. " state=" .. (ticket.data ~= nil and ticket.data.state or "UNKNOWN"))
            if attempt < self.VacateAttempts then wait(self.VacateRetrySeconds) end
        end
        log("[VRF][MatchFlow] vacate gave up attempts=" .. tostring(self.VacateAttempts))
        return false
    end

    @ExecSpace("ServerOnly")
    @EventSender("Service", "RoomService")
    handler HandleRoomEndEvent(RoomEndEvent event)
        -- Discard stale room handles; the engine reclaims an instance room after its last user leaves.
        for key, slot in pairs(self._T.rooms) do
            if not slot.creating and (slot.room == nil or not slot.room:IsValid()) then self._T.closedMatches[key] = true self._T.rooms[key] = nil end
        end
    end

    @ExecSpace("ServerOnly")
    method any RoomBattleAdmission()
        -- Read cached server-loaded capsules only; room updates never poll persistent storage.
        if not _RoomService:IsInstanceRoom() then return nil end
        local byProfile = {}
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) and player.CurrentMapName == "matchprobe" then
                local userId = player.PlayerComponent.UserId
                local ticket = self._T.records[userId]
                if ticket == nil or self._T.busy[userId] or self:Player(userId) == nil then return nil end
                local data = ticket.data
                if data.state ~= "IN_ROOM" or data.matchKey ~= _RoomService.RoomKey
                    or data.profile ~= player.PlayerComponent.ProfileCode or data.expires <= DateTime.UtcNow.Elapsed then return nil end
                byProfile[data.profile] = { userId = userId, data = data }
            end
        end
        local home, away = nil, nil
        for _, entry in pairs(byProfile) do
            local matched = entry.data.match
            if type(matched) ~= "table" or matched.key ~= _RoomService.RoomKey
                or type(matched.home) ~= "string" or type(matched.away) ~= "string" or matched.home == matched.away
                or not self:Belongs(entry.data, matched) then return nil end
            home = byProfile[matched.home]
            if matched.guard == true then
                -- The guard is the away side; it has no capsule, so the lone player's own pairing is the whole authority.
                if home == nil or home.data.profile ~= matched.home or not self:Belongs(home.data, matched) then return nil end
                away = { data = { profile = matched.away, attempt = "" } }
            else
                away = byProfile[matched.away]
                if home == nil or away == nil then return nil end
                local peer = away.data.match
                local first = home.data.match
                if type(peer) ~= "table" or type(first) ~= "table" then return nil end
                for _, key in ipairs({ "key", "home", "away", "homeAttempt", "awayAttempt" }) do
                    if first[key] ~= matched[key] or peer[key] ~= matched[key] then return nil end
                end
                if not self:Belongs(home.data, matched) or not self:Belongs(away.data, matched) then return nil end
            end
        end
        if home == nil or away == nil then return nil end
        local pairing = home.data.match
        -- Each ticket brought the war board of its own pairing reading; the room hands the earlier one to the settlement.
        return { key = _RoomService.RoomKey, home = home.data.profile, away = away.data.profile, homeTicket = home.data.attempt, awayTicket = away.data.attempt,
            homeTown = pairing.homeOrigin or "", awayTown = pairing.awayOrigin or "", guard = pairing.guard == true,
            epochs = _FactionWarAttack:Combine(pairing, away.data.match) }
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- Retry timers belong to this room coordinator and cannot survive its teardown.
        self._T.ended = true
        for _, timer in pairs(self._T.arrivalTimers or {}) do _TimerService:ClearTimer(timer) end
        for _, timer in pairs(self._T.recoveryTimers or {}) do _TimerService:ClearTimer(timer) end
        for _, timer in ipairs(self._T.notifyTimers or {}) do _TimerService:ClearTimer(timer) end
        for _, timer in pairs(self._T.queueTimers or {}) do _TimerService:ClearTimer(timer) end
        for _, timer in pairs(self._T.guardTimers or {}) do _TimerService:ClearTimer(timer) end
        for timer, _ in pairs(self._T.progressTimers or {}) do _TimerService:ClearTimer(timer) end
        log("[VRF][MatchCleanup] room=" .. _RoomService.RoomKey .. " timers=0")
    end
end
