@Logic
script MatchFlowState extends Logic

    method any Failure(any previous, table event, string attempt)
        -- Keep failure ownership explicit and independent of diagnostic wording.
        local failures = { ADMISSION_SAVE_FAILED = true, CANCEL_FAILED = true, CANCEL_SAVE_FAILED = true, HANDOFF_SAVE_FAILED = true, HANDOFF_SEAL_FAILED = true, QUEUE_RENEW_SAVE_FAILED = true, QUEUE_SERVICE_FAILED = true, READINESS_FAILED = true, RESERVATION_SAVE_FAILED = true, RETURN_MOVE_FAILED = true, RETURN_RETRY_MOVE_FAILED = true, RETURN_SAVE_FAILED = true, ROOM_CREATE_FAILED = true, ROOM_MISMATCH_RETURN_FAILED = true, ROOM_MISMATCH_SAVE_FAILED = true, ROOM_MOVE_FAILED = true, STALE_MATCH_RECOVERY_SAVE_FAILED = true, STALE_QUEUE_CLEANUP_FAILED = true, STALE_ROOM_RECOVERY_SAVE_FAILED = true }
        local clears = { ROOM_MOVE_OK = true, RETURN_MOVE_OK = true, RETURN_RETRY_MOVE_OK = true, RETURN_COMPLETED = true, CANCELLED = true }
        if failures[event.code] then return { attempt = attempt, code = event.code } end
        if clears[event.code] then return nil end
        return previous
    end

    method table Resolve(table facts)
        -- Project observed room and battle facts without calling services or changing tickets.
        local state = facts.state
        if facts.instanceRoom and not facts.inMatchRoom and state ~= "RETURNING" then state = "ENTRY_FAILED" end
        if facts.inMatchRoom then
            if facts.admissionFailed then state = "ENTRY_FAILED"
            elseif facts.battlePhase ~= "" then
                state = facts.battlePhase
                if not facts.battleAuthorized then state = "ENTRY_FAILED" end
                if state == "RESULT" then state = "RESULT_" .. facts.result end
                if state == "CONFIG_ERROR" then state = "ENTRY_FAILED" end
            end
        end
        local snapshot = facts.snapshot
        snapshot.state = state
        local failure = facts.failure
        if failure ~= nil and failure.attempt == snapshot.attempt and state ~= "IDLE" and state ~= "BATTLE" then snapshot.reasonCode = failure.code end
        return snapshot
    end

    method boolean IsEntering(string state)
        -- These phases all own a pairing, even before the sealed handoff is saved.
        return state == "SAVING" or state == "COMMITTING" or state == "TRANSFER" or state == "IN_ROOM" or state == "WAITING"
    end

    method boolean EntryFailed(table snapshot, number now)
        -- Readiness/diagnostic errors alone do not end an otherwise live admission.
        if snapshot.entryFailed or snapshot.state == "ENTRY_FAILED" or snapshot.state == "ABORTED" or snapshot.state == "ROOM_MISMATCH" then return true end
        if not snapshot.opponentFound and not self:IsEntering(snapshot.state) then return false end
        local reason = snapshot.reasonCode
        if reason == "HANDOFF_SAVE_FAILED" or reason == "HANDOFF_SEAL_FAILED" or reason == "ROOM_CREATE_FAILED"
            or reason == "ADMISSION_SAVE_FAILED" or reason == "ROOM_MOVE_FAILED" then return true end
        return (snapshot.entryDeadline or 0) > 0 and now >= snapshot.entryDeadline
    end

    method table PresentMatch(table snapshot, table context)
        -- Shared pre-battle projection. Empty action means no button; clocks are injected in ms.
        local state = snapshot.state
        local enabled = not snapshot.busy and not context.pending
        if state == "RETURNING" then
            return { text = "正在返回…", label = enabled and "重試返回" or "返回中…", action = "RETURN", enabled = enabled }
        end
        if self:EntryFailed(snapshot, context.now) then
            local label = "停止入場"
            if context.inMatchRoom then
                label = (context.originName or "") ~= "" and ("返回 " .. context.originName) or "返回大廳"
            end
            return { text = "入場失敗", label = label, action = "RETURN", enabled = enabled }
        end
        if snapshot.opponentFound or self:IsEntering(state) then
            return { text = "配對成功，正在進入戰場", label = "", action = "", enabled = false }
        end
        local reason = snapshot.reasonCode
        local queueError = reason == "CANCEL_FAILED" or reason == "CANCEL_SAVE_FAILED" or reason == "QUEUE_SERVICE_FAILED"
            or reason == "RESERVATION_SAVE_FAILED" or reason == "QUEUE_RENEW_SAVE_FAILED" or reason == "STALE_QUEUE_CLEANUP_FAILED"
        if state == "CANCELLING" or (state == "CANCELLED" and snapshot.busy) or (context.pending and context.pendingAction == "CANCEL") then
            return { text = "正在取消配對…", label = "", action = "", enabled = false }
        end
        if state == "QUEUE_ERROR" or state == "CANCELLED" or queueError then
            return { text = "配對已停止，請取消後重新配對", label = "取消配對", action = "CANCEL", enabled = enabled }
        end
        if state == "QUEUED" or state == "RENEWING" then
            local deadline = snapshot.guardAt or 0
            if deadline > 0 and context.now >= deadline then
                return { text = "即將開戰…", label = "", action = "", enabled = false }
            end
            local started = snapshot.started or 0
            local elapsed = started > 0 and math.max(0, math.floor((context.now - started) / 1000)) or 0
            local clock = deadline > 0 and ("倒數 " .. tostring(math.ceil((deadline - context.now) / 1000))) or ("已等候 " .. tostring(elapsed))
            return { text = "配對中 · " .. clock .. " 秒", label = "取消配對", action = "CANCEL", enabled = enabled }
        end
        return { text = "", label = "", action = "", enabled = false }
    end

    method table Present(table snapshot, table context)
        -- The lobby owns idle and result/return controls; pre-battle states share the town's rule.
        local state = snapshot.state
        local blocked = snapshot.busy or context.pending or context.editBusy or context.unconfirmed or context.confirming
        local text, label, action = "", "", ""
        if state == "BATTLE" then
            text = "自動戰鬥中，戰鬥結束後可返回大廳"
        elseif state == "RETURNING" or string.sub(state, 1, 7) == "RESULT_" then
            text = state == "RETURNING" and "正在返回大廳並還原已儲存隊伍" or "可返回大廳繼續整備或再次配對"
            label = state == "RETURNING" and (snapshot.busy and "返回中…" or "重試返回") or "返回大廳"
            action = "RETURN"
            local reason = snapshot.reasonCode
            if reason == "RESTORE_RETRY_REQUIRED" then text = "隊伍尚未完成還原，請重試返回" end
            if reason == "RETURN_MOVE_FAILED" or reason == "RETURN_RETRY_MOVE_FAILED" or reason == "ROOM_MISMATCH_RETURN_FAILED" then
                text, label = "返回大廳失敗，已儲存隊伍仍保留；請重試返回", "重試返回"
            end
            if reason == "RETURN_SAVE_FAILED" or reason == "ROOM_MISMATCH_SAVE_FAILED" then
                text, label = "返回資料儲存失敗，請重試返回", "重試返回"
            end
            if context.pending then text, label = "正在返回大廳…", "返回中…" end
        elseif state == "IDLE" then
            text, label, action = "選好已儲存的出戰隊伍後，即可開始配對", "開始配對", "QUEUE"
            local reason = snapshot.reasonCode
            if reason == "NEED_LOADED_VALID_ACTIVE_FORMATION_AND_NO_PENDING_SAVE" then text = "請先儲存隊伍並設為出戰，儲存完成後再試。" end
            if reason == "MONSTER_LEVELS_READ_FAILED" then text = "讀取怪物等級失敗，請稍後重新配對。" end
            if reason == "MATCHMAKING_NOT_CONFIGURED" then text = "目前無法配對，請稍後再試。" end
            if reason == "DISABLED_OR_NOT_PUBLISHED" then text = "配對尚未開放，或此帳號未獲授權" end
            if reason == "DUPLICATE_PROFILE" then text = "同一帳號無法互相配對，請使用不同模擬玩家" end
            if reason == "RESERVATION_SAVE_FAILED" then text = "配對資料儲存未完成，請稍後再試" end
            if reason == "LOBBY_ONLY" then text = "請先完成編輯並返回大廳，再開始配對" end
            if reason == "RETURN_COMPLETED" or reason == "RETURNED" or reason == "CANCELLED" then text = "已返回或取消，可以重新開始配對" end
            if context.pending then text, label = "正在確認配對狀態…", "處理中…" end
            if not context.ready then
                text, label, blocked = "正在載入隊伍；若持續沒有回應，請按「重新讀取」。", "等待讀取", true
            elseif context.formation.pending then
                text, label, blocked = "正在儲存或設定出戰，請稍候。", "處理中…", true
            elseif not context.hasActive then
                text = "請先放置 1～6 個單位，儲存後設為出戰。"
                label = context.inLobby and "前往整備" or "請先儲存並設為出戰"
                action = "PREPARE"
                blocked = blocked or not context.inLobby
            end
        else
            local view = self:PresentMatch(snapshot, context)
            view.enabled = view.enabled and not blocked
            view.allowsFormationActions = false
            return view
        end
        return { text = text, label = label, action = action, enabled = action ~= "" and not blocked,
            allowsFormationActions = state == "IDLE" and not snapshot.busy and not context.pending }
    end
end
