@Logic
script MatchTransfer extends Logic

    @ExecSpace("ServerOnly")
    method boolean MoveToMatch(any room, string userId)
        -- Move an admitted player into the match room; false leaves the handoff retryable.
        return room:MoveUser(userId, "matchprobe")
    end

    @ExecSpace("ServerOnly")
    method any FindRoom(string matchKey)
        -- The match room that still runs in this world instance, or nil; a room of another world instance is not visible here.
        if matchKey == "" then return nil end
        local found, room = _RoomService.InstanceRooms:TryGetValue(matchKey)
        if found and room ~= nil and room:IsValid() then return room end
        return nil
    end

    @ExecSpace("ServerOnly")
    method boolean MoveToLobby(string userId)
        -- Preserve the return capsule until native movement and restoration both succeed.
        return _RoomService:MoveUserToStaticRoom(userId, "formationlobby")
    end

    @ExecSpace("ServerOnly")
    method boolean MoveToTown(string userId, string town)
        -- A war player leaves the match room for the town they attacked from; the handoff stays until restore is confirmed.
        return _RoomService:MoveUserToStaticRoom(userId, town)
    end
end
