@Component
script TankContactAttack extends AttackComponent
    property integer AttackDamage = 40
    property Vector2 ContactSize = Vector2(1.2, 1.2)

    @ExecSpace("ServerOnly")
    method void Configure(table profile, Component execution)
        -- Receive the native contact shape; composition owns per-defender cooldowns.
        self.AttackDamage = profile.AttackDamage
        self.ContactSize = Vector2(profile.ContactSizeX, profile.ContactSizeY)
        self._T.execution = execution
    end

    @ExecSpace("ServerOnly")
    method void ResetTarget()
        -- Native area contact keeps no locked target.
    end

    @ExecSpace("ServerOnly")
    method void ResolveContact()
        -- Query contact at the actor's current position without a selected-target gate.
        local transform = self.Entity.TransformComponent
        if not isvalid(transform) then return end
        local position = transform.WorldPosition
        self:AttackFrom(self.ContactSize, Vector2(position.x, position.y), "tank_contact", nil)
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- Supply configured damage through native HitEvent.
        return self.AttackDamage
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- Accept opposing live units with an elapsed independent contact cooldown.
        if not isvalid(self._T.execution) or not self._T.execution:IsCurrentAdapter(self) then return false end
        local attackerUnit = self.Entity:GetComponent("script.BattleUnit")
        local defenderUnit = nil
        if isvalid(defender) then defenderUnit = defender:GetComponent("script.BattleUnit") end
        if not isvalid(defenderUnit) or not defenderUnit:IsAlive() or attackerUnit.Faction == defenderUnit.Faction then return false end
        if not self._T.execution:CanContact(defender) then return false end
        return __base:IsAttackTarget(defender, attackInfo)
    end

    method void OnAttack(Entity defender)
        -- Report each successful defender for notification, cooldown, and queued knockback.
        if isvalid(self._T.execution) then self._T.execution:OnNativeHit(self, defender) end
    end
end
