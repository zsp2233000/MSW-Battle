@Component
script BattleAttackComposition extends Component

    @ExecSpace("ServerOnly")
    method boolean Configure(table profile, number openingDelay)
        -- Replace attack work atomically while preserving the actor's observation counters.
        self:Cancel()
        local previousType = self._T.adapterType
        local previousAdapter = nil
        if previousType ~= nil then previousAdapter = self.Entity:GetComponent(previousType) end
        self._T.configured = false
        self._T.adapter = nil
        self._T.profile = nil
        local adapterTypes = { ASSAULT = "script.SingleTargetAttack", SHOOTER = "script.SingleTargetAttack", TANK = "script.AreaAttack" }
        local adapterType = nil
        if profile ~= nil then adapterType = adapterTypes[profile.MonsterType] end
        if adapterType == nil then
            log_error("[M1][BattleAttackComposition] unsupported attack profile")
            return false
        end
        if previousType ~= adapterType and isvalid(previousAdapter) then
            if not self.Entity:RemoveComponent(previousType) then
                log_error("[M1][BattleAttackComposition] previous native attack adapter could not be removed")
                return false
            end
        end
        local adapter = self.Entity:GetComponent(adapterType)
        if not isvalid(adapter) then
            self.Entity:AddComponent(adapterType)
            adapter = self.Entity:GetComponent(adapterType)
        end
        if not isvalid(adapter) then
            log_error("[M1][BattleAttackComposition] attack adapter missing for " .. profile.MonsterType)
            return false
        end
        adapter:Configure(self)
        self._T.profile = {}
        for key, value in pairs(profile) do self._T.profile[key] = value end
        self._T.adapter = adapter
        self._T.adapterType = adapterType
        self._T.motion = self.Entity:GetComponent("script.BattleUnitMotion")
        self._T.openingDelay = openingDelay or 0
        self._T.openingDelayPending = self._T.openingDelay > 0
        local unit = self.Entity:GetComponent("script.BattleUnit")
        if isvalid(unit) then unit.UnitKind = profile.MonsterType end
        self._T.configured = true
        log("[M1][BattleAttackComposition] configured " .. profile.MonsterType .. ": " .. self.Entity.Name)
        return true
    end

    @ExecSpace("ServerOnly")
    method any GetActiveSession()
        -- Require a configured, living actor in the active map battle.
        if self._T.configured ~= true or not isvalid(self._T.adapter) then return nil end
        local unit = self.Entity:GetComponent("script.BattleUnit")
        local map = self.Entity.CurrentMap
        if not isvalid(unit) or not unit:IsAlive() or not isvalid(map) then return nil end
        local session = map:GetComponent("script.BattleSession")
        if not isvalid(session) or not session:IsBattleActive() then return nil end
        return session
    end

    @ExecSpace("ServerOnly")
    method boolean IsCurrentAdapter(Component adapter)
        -- Reject native hooks on an adapter left behind by reconfiguration.
        return self._T.adapter == adapter and isvalid(self:GetActiveSession())
    end

    @ExecSpace("ServerOnly")
    method void TryEngage(Entity target, boolean targetInRange)
        -- Accept a delayed strike through the same lifecycle for every monster type.
        if not isvalid(self:GetActiveSession()) then return end
        local profile = self._T.profile
        if targetInRange ~= true or not isvalid(target) then return end
        local unit = self.Entity:GetComponent("script.BattleUnit")
        if unit.AttackPoiseActive or self._T.pendingTarget ~= nil or (self._T.cooldownRemaining or 0) > 0 then return end
        local direction = self:GetTargetDirection(target)
        if not self:IsTargetInRange(target, direction) then return end
        if self._T.openingDelayPending == true then
            self._T.openingDelayPending = false
            self._T.cooldownRemaining = self._T.openingDelay
            return
        end
        self._T.adapter:ResetTarget()
        self._T.pendingTarget = target
        self._T.impactRemaining = profile.ImpactDelaySeconds
        self._T.cooldownRemaining = profile.AttackIntervalSeconds
        self:PublishAttackStart(target)
    end

    @ExecSpace("ServerOnly")
    method void Advance(number delta)
        -- Own the whole actor step: pursuit, impact and facing-lock expiry, in that order.
        if delta < 0 then
            log_warning("[M1][BattleAttackComposition] negative delta rejected")
            return
        end
        if not isvalid(self:GetActiveSession()) then
            self:Cancel()
            return
        end
        local unit = self.Entity:GetComponent("script.BattleUnit")
        self._T.poiseRemaining = math.max(0, (self._T.poiseRemaining or 0) - delta)
        if isvalid(self._T.motion) then self._T.motion:Advance(delta) end
        self._T.cooldownRemaining = math.max(0, (self._T.cooldownRemaining or 0) - delta)
        local effectPending = (self._T.effectRemaining or -1) >= 0
        if effectPending == true then
            self._T.effectRemaining = self._T.effectRemaining - delta
            if self._T.effectRemaining <= 0 then
                self._T.effectRemaining = -1
                self:DispatchAttackEffect()
            end
        end
        if self._T.pendingTarget ~= nil then
            self._T.impactRemaining = self._T.impactRemaining - delta
            if self._T.impactRemaining <= 0 then
                local target = self._T.pendingTarget
                self._T.pendingTarget = nil
                self._T.impactRemaining = -1
                -- A departed or dead target whiffs after committing the animation and interval.
                self._T.adapter:ResolveImpact(target)
                log("[VRF][BattleAttack] IMPACT owner=" .. self.Entity.Name)
            end
        end
        self:AdvanceProjectiles(delta)
        -- A long frame must resolve its impact before releasing the facing held for that strike.
        if unit.AttackPoiseActive and self._T.poiseRemaining <= 0 then
            unit.AttackPoiseActive = false
            log("[VRF][BattleAttack] ATTACK_POISE_END " .. self.Entity.Name)
        end
    end

    @ExecSpace("ServerOnly")
    method void Cancel()
        -- Discard unresolved work when the actor stops or is reconfigured; accepted damage batches survive.
        local unit = self.Entity:GetComponent("script.BattleUnit")
        if isvalid(unit) then unit.AttackPoiseActive = false end
        self._T.poiseRemaining = 0
        self._T.attackDirection = nil
        self._T.pendingTarget = nil
        self._T.impactRemaining = -1
        self._T.effectRemaining = -1
        self:ClearProjectiles()
        if isvalid(self._T.adapter) then self._T.adapter:ResetTarget() end
        self._T.cooldownRemaining = 0
    end

    @ExecSpace("ServerOnly")
    method boolean UsesProjectile()
        -- A projectile clip delays the strike's damage until the ball reaches its locked target.
        local profile = self._T.profile
        return profile ~= nil and profile.ProjectileRUID ~= nil and profile.ProjectileRUID ~= ""
    end

    @ExecSpace("ServerOnly")
    method Vector2 GetBodyCenter(Entity entity)
        -- Centre of the entity's hit box, matching the point GetAttackShape builds its rectangle from.
        local transform = entity.TransformComponent
        local position = transform.WorldPosition
        local scale = transform.Scale
        local offset = entity.HitComponent.ColliderOffset
        return Vector2(position.x + offset.x * scale.x, position.y + offset.y * scale.y)
    end

    @ExecSpace("ServerOnly")
    method void LaunchProjectile(Entity target)
        -- Start one ball at the shooter's body centre; it is owned by this actor and flies at the locked target.
        local profile = self._T.profile
        if profile == nil or not isvalid(target) then return end
        local start = self:GetBodyCenter(self.Entity)
        self._T.projectileSerial = (self._T.projectileSerial or 0) + 1
        local id = self.Entity.Name .. "#" .. tostring(self._T.projectileSerial)
        if self._T.projectiles == nil then self._T.projectiles = {} end
        table.insert(self._T.projectiles, { id = id, target = target, x = start.x, y = start.y, speed = profile.ProjectileSpeed })
        local presentation = self.Entity:GetComponent("script.BattleProjectilePresentation")
        if isvalid(presentation) then
            presentation:LaunchProjectile(id, profile.ProjectileRUID, target, start.x, start.y, profile.ProjectileSpeed)
        end
        log("[VRF][BattleProjectile] LAUNCH id=" .. id .. " target=" .. target.Name .. " speed=" .. tostring(profile.ProjectileSpeed))
    end

    @ExecSpace("ServerOnly")
    method void AdvanceProjectiles(number delta)
        -- Fly every ball toward its locked target; a ball strikes on arrival and vanishes if its target is gone.
        local flying = self._T.projectiles
        if flying == nil or #flying == 0 then return end
        local remaining = {}
        for _, shot in ipairs(flying) do
            local target = shot.target
            local targetUnit = isvalid(target) and target:GetComponent("script.BattleUnit") or nil
            if not isvalid(targetUnit) or not targetUnit:IsAlive() then
                self:EndProjectile(shot, "LOST")
            else
                local center = self:GetBodyCenter(target)
                local dx = center.x - shot.x
                local dy = center.y - shot.y
                local distance = math.sqrt(dx * dx + dy * dy)
                local step = shot.speed * delta
                if distance <= step or distance <= 0.0001 then
                    self:EndProjectile(shot, "ARRIVE")
                    if isvalid(self._T.adapter) then self._T.adapter:ResolveProjectileArrival(target) end
                else
                    shot.x = shot.x + dx / distance * step
                    shot.y = shot.y + dy / distance * step
                    table.insert(remaining, shot)
                end
            end
        end
        self._T.projectiles = remaining
    end

    @ExecSpace("ServerOnly")
    method void EndProjectile(table shot, string reason)
        -- Tell every client to remove the ball's visual and record why it ended.
        local presentation = self.Entity:GetComponent("script.BattleProjectilePresentation")
        if isvalid(presentation) then presentation:EndProjectile(shot.id) end
        log("[VRF][BattleProjectile] END id=" .. shot.id .. " reason=" .. reason)
    end

    @ExecSpace("ServerOnly")
    method void ClearProjectiles()
        -- Unresolved work dies with the actor: balls still in flight are discarded without damage.
        local flying = self._T.projectiles
        self._T.projectiles = {}
        if flying == nil then return end
        for _, shot in ipairs(flying) do self:EndProjectile(shot, "CANCEL") end
    end

    @ExecSpace("ServerOnly")
    method integer GetProjectileCount()
        -- Observation seam for probes: how many balls this actor currently has in flight.
        return #(self._T.projectiles or {})
    end

    @ExecSpace("ServerOnly")
    method void OnNativeHit(Component adapter, Entity defender)
        -- Publish hit semantics centrally while HitEvent owns damage enqueueing.
        if not self:IsCurrentAdapter(adapter) or not isvalid(defender) then return end
        local session = self:GetActiveSession()
        local policy = self:CaptureHitPolicy()
        if policy.knockbackDistance > 0 then
            session:QueueKnockback(self.Entity, defender, policy.knockbackDistance)
        end
    end

    @ExecSpace("ServerOnly")
    method table CaptureHitPolicy()
        -- Snapshot the attacker's rules now so accepted hits survive later reconfiguration.
        local unit = self.Entity:GetComponent("script.BattleUnit")
        local tank = self._T.profile ~= nil and self._T.profile.MonsterType == "TANK"
        return { allowHitStop = not tank, knockbackDistance = tank and self._T.profile.KnockbackDistance or 0,
            hitEffectRUID = isvalid(unit) and unit:GetHitEffectRUID() or "" }
    end

    @ExecSpace("ServerOnly")
    method integer RollDamage()
        -- Draw once per native defender, including both configured endpoints.
        return math.random(self._T.profile.AttackDamageMin, self._T.profile.AttackDamageMax)
    end

    @ExecSpace("ServerOnly")
    method number GetStrikeDirection()
        -- Keep impact geometry tied to the direction accepted at attack start.
        return self._T.attackDirection or self.Entity:GetComponent("script.BattleUnit"):GetFacing()
    end

    @ExecSpace("ServerOnly")
    method void PublishAttackStart(Entity target)
        -- Announce exactly one accepted strike regardless of the number of defenders.
        local unit = self.Entity:GetComponent("script.BattleUnit")
        local session = self:GetActiveSession()
        if not isvalid(unit) or not isvalid(session) then return end
        unit:FaceTarget(target)
        self._T.attackDirection = unit:GetFacing()
        self._T.poiseRemaining = unit.AttackAnimationDuration
        unit.AttackPoiseActive = self._T.poiseRemaining > 0
        log("[VRF][BattleAttack] ATTACK_START " .. self.Entity.Name
            .. ", duration=" .. tostring(self._T.poiseRemaining))
        unit.AttackSerial = unit.AttackSerial + 1
        unit:PlayCombatSound(self._T.profile.AttackSoundRUID)
        self:ArmAttackEffect()
        session:EmitPresentation("ATTACK_START", self.Entity, target, 0)
    end

    @ExecSpace("ServerOnly")
    method void ArmAttackEffect()
        -- Frame 1 is immediate. A later frame stays armed after impact so only Cancel drops it.
        self._T.effectRemaining = -1
        local profile = self._T.profile
        if profile == nil then return end
        local ruid = profile.AttackEffectRUID
        if ruid == nil or ruid == "" then return end
        local delay = profile.AttackEffectDelaySeconds or 0
        if delay > 0 then
            self._T.effectRemaining = delay
            return
        end
        self:DispatchAttackEffect()
    end

    @ExecSpace("ServerOnly")
    method void DispatchAttackEffect()
        self._T.effectRequests = (self._T.effectRequests or 0) + 1
        log("[VRF][BattleAttack] EFFECT_REQUEST owner=" .. self.Entity.Name)
        local presentation = self.Entity:GetComponent("script.BattleHitEffectPresentation")
        if isvalid(presentation) then presentation:PlayAttackEffect(self._T.profile.AttackEffectRUID) end
    end

    @ExecSpace("ServerOnly")
    method integer GetAttackEffectRequestCount()
        return self._T.effectRequests or 0
    end

    @ExecSpace("ServerOnly")
    method number GetTargetDirection(Entity target)
        -- Keep the previous facing when the target is almost exactly above or below.
        local direction = self.Entity:GetComponent("script.BattleUnit"):GetFacing()
        if isvalid(target) then
            local dx = target.TransformComponent.WorldPosition.x - self.Entity.TransformComponent.WorldPosition.x
            if math.abs(dx) > 0.0001 then direction = dx > 0 and 1 or -1 end
        end
        return direction
    end

    @ExecSpace("ServerOnly")
    method any GetAttackShape(number direction)
        -- Build the sole frontal rectangle from the actor's actual hit collider centre.
        local transform = self.Entity.TransformComponent
        local position = transform.WorldPosition
        local scale = transform.Scale
        local offset = self.Entity.HitComponent.ColliderOffset
        local profile = self._T.profile
        local rect = _AttackGeometry:Rectangle(position.x, position.y, offset.x * math.abs(scale.x), offset.y * scale.y,
            direction, profile.AttackRange, profile.AttackRangeY)
        return BoxShape(Vector2(rect.x, rect.y), Vector2(rect.w, rect.h), 0)
    end

    @ExecSpace("ServerOnly")
    method boolean IsTargetInRange(Entity target, number direction)
        -- Query the same native collider geometry used for impact, without causing a hit.
        if self._T.profile == nil then return false end
        return self:OverlapsHitBox(target, self:GetAttackShape(direction))
    end

    @ExecSpace("ServerOnly")
    method boolean IsTargetInReachColumn(Entity target, number direction)
        -- Same rectangle stretched across the arena's Y span: the target only needs vertical alignment.
        if self._T.profile == nil then return false end
        local session = self:GetActiveSession()
        if not isvalid(session) then return false end
        local shape = self:GetAttackShape(direction)
        shape.Size = Vector2(shape.Size.x, 2 * (session.ArenaMaxY - session.ArenaMinY))
        return self:OverlapsHitBox(target, shape)
    end

    @ExecSpace("ServerOnly")
    method boolean OverlapsHitBox(Entity target, any shape)
        -- Report whether the target's enabled hit box overlaps the shape.
        if not isvalid(target) then return false end
        local hit = target.HitComponent
        if not isvalid(hit) or not hit.EnableInHierarchy then return false end
        local simulator = _CollisionService:GetSimulator(self.Entity)
        for _, collider in ipairs(simulator:OverlapAll(hit.CollisionGroup, shape)) do
            if collider == hit then return true end
        end
        return false
    end

end
