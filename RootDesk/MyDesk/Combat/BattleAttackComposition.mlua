@Component
script BattleAttackComposition extends Component

    @ExecSpace("ServerOnly")
    method Component CreateAdapter(Entity owner, string unitKind)
        -- Compose the concrete attack adapter so BattleUnit only consumes the seam.
        if not isvalid(owner) then return nil end
        local adapterType = "script.AssaultAttack"
        if unitKind == "TANK" then
            adapterType = "script.TankContactAttack"
        end
        local adapter = owner:GetComponent(adapterType)
        if not isvalid(adapter) then
            owner:AddComponent(adapterType)
            adapter = owner:GetComponent(adapterType)
        end
        if not isvalid(adapter) then
            log_error("[M1][BattleAttackComposition] attack adapter missing for " .. unitKind)
            return nil
        end
        return adapter
    end

end
