@Component
script BattleUnit extends Component

    @Sync property string Faction = ""
    @Sync property string MonsterId = ""
    @Sync property string MonsterName = ""
    @Sync property string UnitKind = "ASSAULT"
    @Sync property string CombatState = "IDLE"
    @Sync property string DeathAnimationRUID = ""
    @Sync property string StandAnimationRUID = ""
    @Sync property string MoveAnimationRUID = ""
    @Sync property string AttackAnimationRUID = ""
    @Sync property string HitAnimationRUID = ""
    @Sync property string AttackSoundRUID = ""
    @Sync property string OnHitSoundRUID = ""
    @Sync property string DeathSoundRUID = ""
    @Sync property number AttackAnimationDuration = 0
    @Sync property number HitAnimationDuration = 0
    @Sync property string CurrentTargetName = ""
    @Sync property integer Hp = 0
    @Sync property integer MaxHp = 220
    @Sync property boolean IsDead = false
    @Sync property integer DamageTakenSerial = 0
    @Sync property integer OnHitSoundSerial = 0
    @Sync property integer AttackSerial = 0
    @Sync property integer HitEffectSerial = 0
    @Sync property string LastHitEffectRUID = ""
    @Sync property boolean KnockbackActive = false

    property number MoveSpeed = 2.0
    property integer AttackDamage = 35
    property number AttackInterval = 0.7
    property number AttackRange = 0.6
    property number RetargetInterval = 0.5
    property number ImpactDelay = 0.18
    property number HitStopDuration = 0.2
    property number KnockbackRecoveryDuration = 0.06

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Initialize a unit before the session supplies its faction and tuned combat values.
        self._T.currentTarget = nil
        self._T.attackFactory = nil
        self._T.attackAdapter = nil
        self._T.attackConfigured = false
        self._T.retargetRemaining = 0
        self._T.deathDurationPendingRUID = ""
        self._T.deathDurationFailedRUID = ""
        self._T.deathDurationRUID = ""
        self._T.deathDurationReady = false
        self._T.deathAnimationRequested = false
        self._T.deathAnimationStarted = false
        self._T.deathAnimationFinished = false
        self._T.deathAnimationPlayer = nil
        self._T.deathAnimationSawFinalFrame = false
        self._T.deathAnimationCycleCompleted = false
        self._T.deathAnimationFrameCount = 0
        self._T.deathAnimationCompletionSource = ""
        self._T.hitStopRemaining = 0
        self._T.knockbackRemaining = 0
        self._T.knockbackStepX = 0
        self._T.knockbackStepY = 0
        self.KnockbackActive = false
        self._T.hitEffectRUID = ""
        if self.Hp <= 0 then self.Hp = self.MaxHp end
        self.CombatState = "IDLE"
    end

    @ExecSpace("ServerOnly")
    method void SetMonsterIdentity(string monsterId, string monsterName, string hitEffectRUID)
        -- Bind the stable MonsterId, editable display name, and attacker-owned hit effect from MonsterData.
        self.MonsterId = monsterId
        self.MonsterName = monsterName
        self._T.hitEffectRUID = hitEffectRUID
    end

    @ExecSpace("ServerOnly")
    method void Configure(string faction, string displayName, string unitKind, integer maxHp, number speed, integer damage, number interval, number range, number retarget, number impact, string deathAnimationRUID, number openingDelay, number contactCooldown, Vector2 contactSize, number knockbackDistance, number hitStopDuration)
        -- Apply the unit profile and bind the only attack adapter used by this unit.
        self.Faction = faction
        self.MonsterName = displayName
        self.UnitKind = unitKind
        self.MaxHp = maxHp
        self.Hp = maxHp
        self.MoveSpeed = speed
        self.AttackDamage = damage
        self.AttackInterval = interval
        self.AttackRange = range
        self.RetargetInterval = retarget
        self.ImpactDelay = impact
        self.DeathAnimationRUID = deathAnimationRUID
        self.HitStopDuration = hitStopDuration
        self.IsDead = false
        self.CurrentTargetName = ""
        self.CombatState = "IDLE"
        self._T.displayName = displayName
        self._T.currentTarget = nil
        self._T.retargetRemaining = 0
        self._T.hitStopRemaining = 0
        self._T.knockbackRemaining = 0
        self._T.knockbackStepX = 0
        self._T.knockbackStepY = 0
        self.KnockbackActive = false
        self._T.attackAdapter = nil
        self._T.attackConfigured = false
        if not isvalid(self._T.attackFactory) then
            log_error("[M1][BattleUnit] attack composition missing for " .. unitKind)
            return
        end
        local adapter = self._T.attackFactory:CreateAdapter(self.Entity, unitKind)
        if not isvalid(adapter) then
            log_error("[M1][BattleUnit] attack adapter missing for " .. unitKind)
            return
        end
        self._T.attackAdapter = adapter
        if unitKind == "TANK" then
            adapter:Configure(damage, contactCooldown, contactSize, knockbackDistance)
        else
            adapter:Configure(damage, range, interval, impact, openingDelay)
        end
        self._T.attackConfigured = true
    end

    @ExecSpace("ServerOnly")
    method void BindAttackFactory(Component factory)
        -- Accept the composition dependency that owns concrete adapter creation.
        self._T.attackFactory = factory
    end

    method boolean HasAttackAdapter()
        -- Expose whether Configure successfully installed the unit's attack adapter.
        return self._T.attackConfigured == true and isvalid(self._T.attackAdapter)
    end

    method string GetHitEffectRUID()
        -- Return the attacker-owned dataset effect so the defender can render it on itself.
        return self._T.hitEffectRUID or ""
    end

    @ExecSpace("ServerOnly")
    method void DriveAttack(Entity target, boolean targetInRange)
        -- Drive the bound attack adapter without exposing its concrete type to the unit loop.
        if not self:HasAttackAdapter() then return end
        self._T.attackAdapter:TryEngage(target, targetInRange)
    end

    @ExecSpace("ServerOnly")
    method void AdvanceAttack(number delta)
        -- Advance the bound attack adapter through the same seam used by live and test loops.
        if not self:HasAttackAdapter() then return end
        self._T.attackAdapter:Advance(delta)
    end

    @ExecSpace("ServerOnly")
    method void CancelAttack()
        -- Cancel any pending attack work when the unit enters the terminal result state.
        if not self:HasAttackAdapter() then return end
        self._T.attackAdapter:Cancel()
    end

    method boolean IsAlive()
        -- Expose the only targetability predicate used by session and combat overrides.
        return self.IsDead == false and self.Hp > 0 and isvalid(self.Entity) and self.Entity.Enable ~= false
    end

    method Entity GetCurrentTarget()
        -- Return the current target only while the entity reference is still valid.
        if self._T.currentTarget ~= nil and isvalid(self._T.currentTarget) then return self._T.currentTarget end
        return nil
    end

    method any GetSession()
        -- Resolve the map-scoped session component from the unit's current map.
        local map = self.Entity.CurrentMap
        if not isvalid(map) then return nil end
        local session = map:GetComponent("script.BattleSession")
        if not isvalid(session) then return nil end
        return session
    end

    @ExecSpace("ServerOnly")
    method void Tick(number delta)
        -- Keep dead units inert on the server; clients own the visual death-animation completion.
        if self.IsDead then
            return
        end
        local session = self:GetSession()
        if not isvalid(session) or not session:IsBattleActive() then
            self:StopForResult()
            return
        end
        session:ConstrainUnitToArena(self.Entity)

        if self._T.hitStopRemaining > 0 then
            self._T.hitStopRemaining = math.max(0, self._T.hitStopRemaining - delta)
            local hitStopMovement = self.Entity:GetComponent("MovementComponent")
            if isvalid(hitStopMovement) then hitStopMovement:Stop() end
            if self._T.hitStopRemaining > 0 then
                self.CombatState = "ON_HIT"
                return
            end
        end

        self._T.retargetRemaining = self._T.retargetRemaining - delta
        local target = self:GetCurrentTarget()
        local targetUnit = nil
        if isvalid(target) then targetUnit = target:GetComponent("script.BattleUnit") end
        if target == nil or not isvalid(targetUnit) or not targetUnit:IsAlive() or self._T.retargetRemaining <= 0 then
            self._T.retargetRemaining = self.RetargetInterval
            target = session:FindNearestEnemy(self.Entity, target)
            self._T.currentTarget = target
            self.CurrentTargetName = ""
            if isvalid(target) then self.CurrentTargetName = target.Name end
        end
        if not isvalid(target) then
            self.CombatState = "IDLE"
            local idleMovement = self.Entity:GetComponent("MovementComponent")
            if isvalid(idleMovement) then idleMovement:Stop() end
            return
        end

        local transform = self.Entity:GetComponent("TransformComponent")
        local targetTransform = target:GetComponent("TransformComponent")
        if not isvalid(transform) or not isvalid(targetTransform) then return end
        local position = transform.WorldPosition
        local targetPosition = targetTransform.WorldPosition
        local dx = targetPosition.x - position.x
        local dy = targetPosition.y - position.y
        local distanceSquared = dx * dx + dy * dy
        if distanceSquared > self.AttackRange * self.AttackRange then
            local distance = math.sqrt(distanceSquared)
            local directionX = dx / distance
            local directionY = dy / distance
            local maximumStep = self.MoveSpeed * delta
            if position.x + directionX * maximumStep < session.ArenaMinX or position.x + directionX * maximumStep > session.ArenaMaxX then directionX = 0 end
            if position.y + directionY * maximumStep < session.ArenaMinY or position.y + directionY * maximumStep > session.ArenaMaxY then directionY = 0 end
            local directionLength = math.sqrt(directionX * directionX + directionY * directionY)
            local movement = self.Entity:GetComponent("MovementComponent")
            if isvalid(movement) then
                if directionLength > 0.0001 then
                    movement.InputSpeed = self.MoveSpeed * 1.2
                    movement:MoveToDirection(Vector2(directionX / directionLength, directionY / directionLength), delta)
                else
                    movement:Stop()
                end
            end
            self.CombatState = "MOVE"
            self:DriveAttack(target, false)
        else
            local movement = self.Entity:GetComponent("MovementComponent")
            if isvalid(movement) then movement:Stop() end
            if self.UnitKind == "TANK" then
                self.CombatState = "IDLE"
            else
                self.CombatState = "ATTACK"
            end
            self:DriveAttack(target, true)
        end
    end

    @ExecSpace("ServerOnly")
    method void ApplyResolvedDamage(integer amount, Entity attacker, boolean allowHitStop)
        -- Apply only coalesced HitEvent damage and transition to DEAD once at zero HP.
        if amount == nil or amount <= 0 or not self:IsAlive() then return end
        self.Hp = math.max(0, self.Hp - amount)
        self.DamageTakenSerial = self.DamageTakenSerial + 1
        if self.OnHitSoundRUID ~= nil and self.OnHitSoundRUID ~= "" then
            self.OnHitSoundSerial = self.OnHitSoundSerial + 1
        end
        local session = self:GetSession()
        if isvalid(session) then session:EmitPresentation("DAMAGE", attacker, self.Entity, amount) end
        if self.Hp > 0 then
            if allowHitStop then
                self._T.hitStopRemaining = self.HitStopDuration
                local hitStopMovement = self.Entity:GetComponent("MovementComponent")
                if isvalid(hitStopMovement) then hitStopMovement:Stop() end
                self.CombatState = "ON_HIT"
            end
            return
        end

        self.IsDead = true
        self.CombatState = "DEAD"
        self._T.hitStopRemaining = 0
        self._T.knockbackRemaining = 0
        self._T.knockbackStepX = 0
        self._T.knockbackStepY = 0
        self.KnockbackActive = false
        self._T.currentTarget = nil
        self.CurrentTargetName = ""
        local movement = self.Entity:GetComponent("MovementComponent")
        if isvalid(movement) then movement:Stop() end
        self:CancelAttack()
        local hit = self.Entity:GetComponent("HitComponent")
        if isvalid(hit) then hit.Enable = false end
        local body = self.Entity:GetComponent("KinematicbodyComponent")
        if isvalid(body) then body.Enable = false end
        local trigger = self.Entity:GetComponent("TriggerComponent")
        if isvalid(trigger) then trigger.Enable = false end
        local state = self.Entity:GetComponent("StateComponent")
        if isvalid(state) then state:ChangeState("DEAD") end
        if isvalid(session) then session:NotifyDeath(self.Entity) end
    end

    @ExecSpace("ServerOnly")
    method void ConfigurePresentation(table profile)
        -- Sync the exact MonsterData assets to every client, including late joiners.
        self.StandAnimationRUID = profile.StandAnimationRUID
        self.MoveAnimationRUID = profile.MoveAnimationRUID
        self.AttackAnimationRUID = profile.AttackAnimationRUID
        self.HitAnimationRUID = profile.HitAnimationRUID
        self.AttackSoundRUID = profile.AttackSoundRUID
        self.OnHitSoundRUID = profile.OnHitSoundRUID
        self.DeathSoundRUID = profile.DieSoundRUID
        self.AttackAnimationDuration = profile.AttackAnimationDurationSeconds
        self.HitAnimationDuration = profile.HitAnimationDurationSeconds
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Mirror combat presentation on the client; death keeps exclusive control of the sprite.
        self:PreloadDeathAnimationDuration()
        self:UpdatePresentation()
        if self.IsDead ~= true then return end
        if self._T.deathAnimationRequested == true then return end

        local sprite = self.Entity:GetComponent("SpriteRendererComponent")
        if not isvalid(sprite) then return end
        if self.DeathAnimationRUID == nil or self.DeathAnimationRUID == "" or self.DeathAnimationRUID == "TBD" or self.DeathAnimationRUID == "N/A" then
            return
        end
        self._T.deathAnimationRequested = true
        self._T.deathAnimationStarted = false
        self._T.deathAnimationFinished = false
        self._T.deathAnimationPlayer = nil
        self._T.deathAnimationSawFinalFrame = false
        self._T.deathAnimationCycleCompleted = false
        self._T.deathAnimationFrameCount = 0
        sprite.StartFrameIndex = 0
        sprite.EndFrameIndex = 2147483647
        sprite.PlayRate = 1
        sprite.SpriteRUID = self.DeathAnimationRUID
    end

    @ExecSpace("ClientOnly")
    method void UpdatePresentation()
        if self._T.presentationReady ~= true then
            self._T.presentationReady = true
            self._T.lastPresentationState = ""
            self._T.lastPresentationAttackSerial = 0
            self._T.lastPresentationDamageSerial = 0
            self._T.lastAnimationAttackSerial = 0
            self._T.lastAnimationDamageSerial = 0
            self._T.presentationDeathSoundPlayed = false
        end

        if self.AttackSerial ~= self._T.lastPresentationAttackSerial then
            self._T.lastPresentationAttackSerial = self.AttackSerial
            if self.IsDead ~= true then self:PlayPresentationSound(self.AttackSoundRUID) end
        end
        if self.OnHitSoundSerial ~= self._T.lastPresentationDamageSerial then
            self._T.lastPresentationDamageSerial = self.OnHitSoundSerial
            self:PlayPresentationSound(self.OnHitSoundRUID)
        end
        if self.IsDead == true then
            if self._T.presentationDeathSoundPlayed ~= true then
                self._T.presentationDeathSoundPlayed = true
                self:PlayPresentationSound(self.DeathSoundRUID)
            end
            return
        end

        -- Wait for the required profile fields to synchronize before consuming state or action serials.
        if self.StandAnimationRUID == nil or self.StandAnimationRUID == "" then return end
        local stateChanged = self.CombatState ~= self._T.lastPresentationState
        if stateChanged then self._T.lastPresentationState = self.CombatState end
        local damageChanged = self.DamageTakenSerial ~= self._T.lastAnimationDamageSerial
        local attackChanged = self.AttackSerial ~= self._T.lastAnimationAttackSerial
        self._T.lastAnimationDamageSerial = self.DamageTakenSerial
        self._T.lastAnimationAttackSerial = self.AttackSerial

        if damageChanged or (self.CombatState == "ON_HIT" and stateChanged) then
            self:PlayPresentationAnimation(self.HitAnimationRUID, "ON_HIT", damageChanged)
        elseif self._T.presentationAction == "ON_HIT" then
            -- Keep the hit clip visible while server movement continues during knockback.
            self._T.lastPresentationState = "ON_HIT"
        elseif self.CombatState == "MOVE" and stateChanged then
            self:PlayPresentationAnimation(self.MoveAnimationRUID, "MOVE", false)
        elseif self.CombatState == "ATTACK" and self.UnitKind ~= "TANK" and attackChanged then
            self:PlayPresentationAnimation(self.AttackAnimationRUID, "ATTACK", true)
        elseif stateChanged then
            self:PlayPresentationAnimation(self.StandAnimationRUID, "IDLE", false)
        end
        if self._T.presentationAction ~= nil and self._T.presentationAction ~= ""
            and self._T.presentationDeadline ~= nil and self._T.presentationDeadline > 0
            and _UtilLogic.ElapsedSeconds >= self._T.presentationDeadline then
            self:FinishPresentationAction()
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayPresentationAnimation(string animationRUID, string action, boolean restart)
        if animationRUID == nil or animationRUID == "" or animationRUID == "TBD" or animationRUID == "N/A" then return end
        local sprite = self.Entity:GetComponent("SpriteRendererComponent")
        if not isvalid(sprite) then return end
        self._T.presentationAction = ""
        self._T.presentationActionPlayer = nil
        self._T.presentationSawFinalFrame = false
        self._T.presentationFrameCount = 0
        self._T.presentationSingleFrameLastFrameSeen = false
        self._T.presentationDeadline = 0
        if action == "ATTACK" or action == "ON_HIT" then self._T.presentationAction = action end
        if action == "ATTACK" and self.AttackAnimationDuration > 0 then
            self._T.presentationDeadline = _UtilLogic.ElapsedSeconds + self.AttackAnimationDuration
        elseif action == "ON_HIT" and self.HitAnimationDuration > 0 then
            self._T.presentationDeadline = _UtilLogic.ElapsedSeconds + self.HitAnimationDuration
        end
        if restart == true and sprite.SpriteRUID == animationRUID and self.StandAnimationRUID ~= animationRUID then
            sprite.SpriteRUID = self.StandAnimationRUID
        end
        sprite.StartFrameIndex = 0
        sprite.EndFrameIndex = 2147483647
        sprite.PlayRate = 1
        sprite.SpriteRUID = animationRUID
        log("[M1][BattleUnit] ANIMATION " .. action .. ": " .. self.Entity.Name .. ", ruid=" .. animationRUID)
    end

    @ExecSpace("ClientOnly")
    method void FinishPresentationAction()
        local action = self._T.presentationAction
        if action == nil or action == "" or self.IsDead == true then return end
        if action == "ON_HIT" and self.KnockbackActive then return end
        local sprite = self.Entity:GetComponent("SpriteRendererComponent")
        if not isvalid(sprite) then return end
        local actionRUID = self.AttackAnimationRUID
        if action == "ON_HIT" then actionRUID = self.HitAnimationRUID end
        if sprite.SpriteRUID ~= actionRUID then return end
        self._T.presentationAction = ""
        self._T.presentationActionPlayer = nil
        log("[M1][BattleUnit] ANIMATION_FINISHED " .. action .. ": " .. self.Entity.Name)
        self:PlayPresentationAnimation(self.StandAnimationRUID, "IDLE", false)
    end

    @ExecSpace("ClientOnly")
    method void PlayPresentationSound(string soundRUID)
        if soundRUID == nil or soundRUID == "" or soundRUID == "TBD" or soundRUID == "N/A" then return end
        local transform = self.Entity:GetComponent("TransformComponent")
        if not isvalid(transform) then return end
        local listener = _UserService.LocalPlayer
        if isvalid(listener) then
            _SoundService:PlaySoundAtPos(soundRUID, transform.WorldPosition, listener, 1.0)
        else
            _SoundService:PlaySound(soundRUID, 1.0)
        end
        log("[M1][BattleUnit] SOUND " .. self.Entity.Name .. ", ruid=" .. soundRUID)
    end

    @ExecSpace("ClientOnly")
    method void PreloadDeathAnimationDuration()
        -- Cache the assigned die clip timing for diagnostics; playback events determine when it is complete.
        local ruid = self.DeathAnimationRUID
        if ruid == nil or ruid == "" or ruid == "TBD" or ruid == "N/A" then return end
        if self._T.deathDurationRUID == ruid and self._T.deathDurationReady == true then return end
        if self._T.deathDurationFailedRUID == ruid then return end
        if self._T.deathDurationPendingRUID ~= "" and self._T.deathDurationPendingRUID ~= ruid then
            self._T.deathDurationPendingRUID = ""
        end
        if self._T.deathDurationPendingRUID == ruid then return end

        self._T.deathDurationPendingRUID = ruid
        _ResourceService:PreloadAsync({ ruid }, function()
            if not isvalid(self.Entity) then return end
            if self.DeathAnimationRUID ~= ruid then
                if self._T.deathDurationPendingRUID == ruid then self._T.deathDurationPendingRUID = "" end
                return
            end

            local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
            if not isvalid(self.Entity) or self.DeathAnimationRUID ~= ruid then return end
            if self._T.deathDurationPendingRUID == ruid then self._T.deathDurationPendingRUID = "" end
            if not isvalid(clip) then
                self._T.deathDurationFailedRUID = ruid
                log_error("[M1][BattleUnit] death animation resource failed to load: " .. self.Entity.Name .. ", ruid=" .. ruid)
                return
            end
            local frames = clip.Frames:ToTable()
            if frames == nil or #frames == 0 then
                self._T.deathDurationFailedRUID = ruid
                log_error("[M1][BattleUnit] death animation has no frames: " .. self.Entity.Name .. ", ruid=" .. ruid)
                return
            end

            local frameDelaySum = 0
            for _, frame in ipairs(frames) do
                if frame == nil or frame.Delay == nil or not (frame.Delay >= 0) or not (frame.Delay < math.huge) then
                    self._T.deathDurationFailedRUID = ruid
                    log_error("[M1][BattleUnit] death animation has invalid frame timing: " .. self.Entity.Name .. ", ruid=" .. ruid)
                    return
                end
                frameDelaySum = frameDelaySum + frame.Delay
            end
            if not (frameDelaySum > 0) or not (frameDelaySum < math.huge) then
                self._T.deathDurationFailedRUID = ruid
                log_error("[M1][BattleUnit] death animation duration is not positive: " .. self.Entity.Name .. ", ruid=" .. ruid)
                return
            end

            self._T.deathDurationFrameDelaySum = frameDelaySum
            self._T.deathDurationFrameCount = #frames
            self._T.deathDurationRUID = ruid
            self._T.deathDurationReady = true
            self:ResolveDeathAnimationDuration()
        end)
    end

    @ExecSpace("ClientOnly")
    method void ResolveDeathAnimationDuration()
        -- Adjust the clip frame-delay sum by the actual playback rate reported at start.
        if self._T.deathDurationReady ~= true or self._T.deathAnimationStarted ~= true then return end
        if self._T.deathDurationRUID ~= self.DeathAnimationRUID then return end
        if self._T.deathAnimationPlayRate == nil
            or not (self._T.deathAnimationPlayRate > 0)
            or not (self._T.deathAnimationPlayRate < math.huge) then
            self._T.deathDurationReady = false
            self._T.deathDurationFailedRUID = self._T.deathDurationRUID
            log_error("[M1][BattleUnit] death animation playback rate must be positive: " .. self.Entity.Name)
            return
        end

        self._T.deathAnimationDuration = self._T.deathDurationFrameDelaySum / self._T.deathAnimationPlayRate
        if not (self._T.deathAnimationDuration > 0) or not (self._T.deathAnimationDuration < math.huge) then
            self._T.deathDurationReady = false
            self._T.deathDurationFailedRUID = self._T.deathDurationRUID
            log_error("[M1][BattleUnit] computed death animation duration is invalid: " .. self.Entity.Name)
            return
        end

        log("[M1][BattleUnit] DIE_DURATION_READY: " .. self.Entity.Name
            .. ", frameDelaySum=" .. tostring(self._T.deathDurationFrameDelaySum)
            .. ", playRate=" .. tostring(self._T.deathAnimationPlayRate)
            .. ", duration=" .. tostring(self._T.deathAnimationDuration))
        self:TryFinishDeathAnimation()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleSpriteAnimPlayerStartEvent(SpriteAnimPlayerStartEvent event)
        -- Begin measuring from the renderer's death-clip start event, including its actual play rate.
        if self.IsDead ~= true then
            local action = self._T.presentationAction
            if action ~= nil and action ~= "" then
                local actionRUID = self.AttackAnimationRUID
                if action == "ON_HIT" then actionRUID = self.HitAnimationRUID end
                local actionSprite = self.Entity:GetComponent("SpriteRendererComponent")
                if isvalid(actionSprite) and actionSprite.SpriteRUID == actionRUID then
                    self._T.presentationActionPlayer = event.AnimPlayer
                    log("[M1][BattleUnit] ANIMATION_STARTED " .. action .. ": " .. self.Entity.Name)
                end
            end
            return
        end
        if self.IsDead ~= true or self._T.deathAnimationRequested ~= true then return end
        local sprite = self.Entity:GetComponent("SpriteRendererComponent")
        if not isvalid(sprite) or sprite.SpriteRUID ~= self.DeathAnimationRUID then return end
        self._T.deathAnimationStarted = true
        self._T.deathAnimationPlayRate = event.ClipPlayRate
        self._T.deathAnimationPlayer = event.AnimPlayer
        self._T.deathAnimationSawFinalFrame = false
        self._T.deathAnimationCycleCompleted = false
        self._T.deathAnimationFrameCount = 0
        self._T.deathAnimationSingleFrameLastFrameSeen = false
        log("[M1][BattleUnit] death animation started: " .. self.Entity.Name
            .. ", playType=" .. tostring(event.ClipPlayType)
            .. ", playRate=" .. tostring(event.ClipPlayRate))
        self:ResolveDeathAnimationDuration()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleSpriteAnimPlayerChangeFrameEvent(SpriteAnimPlayerChangeFrameEvent event)
        -- Loop clips have no EndEvent; the first frame-zero wrap after the final frame marks one full playback.
        if self.IsDead ~= true then
            if self._T.presentationAction == nil or self._T.presentationAction == "" then return end
            if event.AnimPlayer ~= self._T.presentationActionPlayer then return end
            if event.ReversePlaying == true or event.TotalFrameCount < 2 then return end
            if self._T.presentationFrameCount == 0 then
                self._T.presentationFrameCount = event.TotalFrameCount
            elseif self._T.presentationFrameCount ~= event.TotalFrameCount then
                return
            end
            if event.FrameIndex == event.TotalFrameCount - 1 then
                self._T.presentationSawFinalFrame = true
                return
            end
            if event.FrameIndex == 0 and self._T.presentationSawFinalFrame == true then
                self:FinishPresentationAction()
            end
            return
        end
        if self.IsDead ~= true or self._T.deathAnimationStarted ~= true then return end
        if self._T.deathAnimationCycleCompleted == true then return end
        if event.AnimPlayer ~= self._T.deathAnimationPlayer then return end
        if event.ReversePlaying == true or event.TotalFrameCount < 2 then return end

        if self._T.deathAnimationFrameCount == 0 then
            self._T.deathAnimationFrameCount = event.TotalFrameCount
        elseif self._T.deathAnimationFrameCount ~= event.TotalFrameCount then
            return
        end

        if event.FrameIndex == event.TotalFrameCount - 1 then
            self._T.deathAnimationSawFinalFrame = true
            return
        end
        if event.FrameIndex ~= 0 or self._T.deathAnimationSawFinalFrame ~= true then return end

        self._T.deathAnimationCycleCompleted = true
        self._T.deathAnimationCompletionSource = "SpriteAnimPlayerChangeFrameEvent(loop-wrap)"
        log("[M1][BattleUnit] death animation playback cycle completed: " .. self.Entity.Name
            .. ", frameCount=" .. tostring(event.TotalFrameCount)
            .. ", boundary=loop-wrap")
        self:TryFinishDeathAnimation()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleSpriteAnimPlayerEndFrameEvent(SpriteAnimPlayerEndFrameEvent event)
        -- A one-frame Loop never changes frames; two last-frame entries prove one complete cycle.
        if self.IsDead ~= true then
            if self._T.presentationAction == nil or self._T.presentationAction == "" then return end
            if event.AnimPlayer ~= self._T.presentationActionPlayer or event.ReversePlaying == true then return end
            if event.TotalFrameCount ~= 1 then return end
            if self._T.presentationSingleFrameLastFrameSeen ~= true then
                self._T.presentationSingleFrameLastFrameSeen = true
            else
                self:FinishPresentationAction()
            end
            return
        end
        if self.IsDead ~= true or self._T.deathAnimationStarted ~= true then return end
        if self._T.deathAnimationCycleCompleted == true then return end
        if event.AnimPlayer ~= self._T.deathAnimationPlayer or event.ReversePlaying == true then return end
        if event.TotalFrameCount > 1 and self._T.deathDurationFrameCount ~= 1 then return end

        if self._T.deathAnimationSingleFrameLastFrameSeen ~= true then
            self._T.deathAnimationSingleFrameLastFrameSeen = true
            return
        end
        self._T.deathAnimationCycleCompleted = true
        self._T.deathAnimationCompletionSource = "SpriteAnimPlayerEndFrameEvent(single-frame-repeat)"
        log("[M1][BattleUnit] death animation playback cycle completed: " .. self.Entity.Name
            .. ", frameCount=1, boundary=single-frame-repeat")
        self:TryFinishDeathAnimation()
    end

    @ExecSpace("ClientOnly")
    @EventSender("Self")
    handler HandleSpriteAnimPlayerEndEvent(SpriteAnimPlayerEndEvent event)
        -- Support clips configured for one-time playback if the asset is changed from its current Loop mode.
        if self.IsDead ~= true then
            if self._T.presentationAction ~= nil and self._T.presentationAction ~= ""
                and event.AnimPlayer == self._T.presentationActionPlayer then
                self:FinishPresentationAction()
            end
            return
        end
        if self.IsDead ~= true or self._T.deathAnimationStarted ~= true then return end
        if self._T.deathAnimationCycleCompleted == true then return end
        if event.AnimPlayer ~= self._T.deathAnimationPlayer then return end

        self._T.deathAnimationCycleCompleted = true
        self._T.deathAnimationCompletionSource = "SpriteAnimPlayerEndEvent"
        log("[M1][BattleUnit] death animation playback cycle completed: " .. self.Entity.Name
            .. ", boundary=end-event")
        self:TryFinishDeathAnimation()
    end

    @ExecSpace("ClientOnly")
    method void TryFinishDeathAnimation()
        -- Hide as soon as the assigned animation player proves a full playback has completed.
        if self._T.deathAnimationFinished == true then return end
        if self._T.deathAnimationCycleCompleted ~= true then return end
        if not isvalid(self.Entity) then return end
        local sprite = self.Entity:GetComponent("SpriteRendererComponent")
        if not isvalid(sprite) or sprite.SpriteRUID ~= self.DeathAnimationRUID then return end

        self._T.deathAnimationFinished = true
        self.Entity:SetVisible(false, false, false)
        log("[M1][BattleUnit] death animation finished; hidden locally: " .. self.Entity.Name
            .. ", duration=" .. tostring(self._T.deathAnimationDuration or "unavailable")
            .. ", source=" .. tostring(self._T.deathAnimationCompletionSource))
    end

    @ExecSpace("ServerOnly")
    method void StopForResult()
        -- Stop all unit-side target, movement, and attack work after RESULT is entered.
        self.CombatState = "RESULT_STOP"
        self._T.hitStopRemaining = 0
        self._T.knockbackRemaining = 0
        self._T.knockbackStepX = 0
        self._T.knockbackStepY = 0
        self.KnockbackActive = false
        self._T.currentTarget = nil
        self.CurrentTargetName = ""
        local movement = self.Entity:GetComponent("MovementComponent")
        if isvalid(movement) then movement:Stop() end
        self:CancelAttack()
    end

    @ExecSpace("ServerOnly")
    method void ApplyKnockback(Vector2 position)
        -- Travel toward the already validated destination while normal AI keeps running.
        if position == nil or self.IsDead then return end
        local transform = self.Entity:GetComponent("TransformComponent")
        local kinematic = self.Entity:GetComponent("KinematicbodyComponent")
        if not isvalid(transform) or not isvalid(kinematic) then return end
        local current = transform.WorldPosition
        if math.abs(position.x - current.x) + math.abs(position.y - current.y) <= 0.0001 then return end
        self._T.knockbackStepX = position.x - current.x
        self._T.knockbackStepY = position.y - current.y
        self._T.knockbackRemaining = self.KnockbackRecoveryDuration
        self.KnockbackActive = true
    end

    @ExecSpace("ServerOnly")
    method void AdvanceKnockback(number delta)
        if self.IsDead or self._T.knockbackRemaining <= 0 or delta <= 0 then return end
        local kinematic = self.Entity:GetComponent("KinematicbodyComponent")
        local transform = self.Entity:GetComponent("TransformComponent")
        if not isvalid(kinematic) or not isvalid(transform) then return end
        local fraction = math.min(1, delta / self._T.knockbackRemaining)
        local stepX = self._T.knockbackStepX * fraction
        local stepY = self._T.knockbackStepY * fraction
        local current = transform.WorldPosition
        local session = self:GetSession()
        if isvalid(session) then
            local nextX = session:Clamp(current.x + stepX, session.ArenaMinX, session.ArenaMaxX)
            local nextY = session:Clamp(current.y + stepY, session.ArenaMinY, session.ArenaMaxY)
            local safe = session:GetSafeKnockbackPosition(
                session:GetRectTileMapComponent(), current.x, current.y, nextX, nextY)
            kinematic:SetWorldPosition(safe)
            if math.abs(safe.x - nextX) + math.abs(safe.y - nextY) > 0.0001 then
                -- The AI may have moved since the original route was checked.
                self._T.knockbackStepX = 0
                self._T.knockbackStepY = 0
                self._T.knockbackRemaining = 0
                self.KnockbackActive = false
                return
            end
        end
        self._T.knockbackStepX = self._T.knockbackStepX - stepX
        self._T.knockbackStepY = self._T.knockbackStepY - stepY
        self._T.knockbackRemaining = math.max(0, self._T.knockbackRemaining - delta)
        if self._T.knockbackRemaining == 0 then self.KnockbackActive = false end
    end

    @ExecSpace("ServerOnly")
    @EventSender("Self")
    handler HandleHitEvent(HitEvent event)
        -- Forward native HitEvent damage to the map session; never mutate HP in the handler.
        local session = self:GetSession()
        if not isvalid(session) or not session:IsBattleActive() or self.IsDead then return end
        local hitEffectRUID = ""
        if isvalid(event.AttackerEntity) then
            local attackerUnit = event.AttackerEntity:GetComponent("script.BattleUnit")
            if isvalid(attackerUnit) then hitEffectRUID = attackerUnit:GetHitEffectRUID() end
        end
        if hitEffectRUID ~= nil and hitEffectRUID ~= "" then
            self.LastHitEffectRUID = hitEffectRUID
            self.HitEffectSerial = self.HitEffectSerial + 1
        end
        session:EmitPresentation("TARGET_HIT", event.AttackerEntity, self.Entity, event.TotalDamage)
        session:QueueDamage(self.Entity, event.TotalDamage, event.AttackerEntity)
    end

end
