@Component
script ShooterPresentation extends Component

    property string AttackSoundRUID = "TBD"
    property string OnHitSoundRUID = "TBD"
    property string DeathSoundRUID = "TBD"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Start the client-side cursors used to consume synced combat events once.
        self._T.lastAttackSerial = 0
        self._T.lastDamageSerial = 0
        self._T.deathSoundPlayed = false
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Consume the same semantic serials as TankPresentation without touching server combat.
        local unit = self.Entity:GetComponent("script.BattleUnit")
        if not isvalid(unit) then return end
        if unit.AttackSerial ~= self._T.lastAttackSerial then
            self._T.lastAttackSerial = unit.AttackSerial
            self:PlayAtEntity(self.AttackSoundRUID)
        end
        if unit.DamageTakenSerial ~= self._T.lastDamageSerial then
            self._T.lastDamageSerial = unit.DamageTakenSerial
            self:PlayAtEntity(self.OnHitSoundRUID)
        end
        if unit.IsDead == true and self._T.deathSoundPlayed ~= true then
            self._T.deathSoundPlayed = true
            self:PlayAtEntity(self.DeathSoundRUID)
        end
    end

    @ExecSpace("ClientOnly")
    method void PlayAtEntity(string soundRUID)
        -- Play a configured Shooter attack/onhit/die sound at the unit's world position.
        if soundRUID == nil or soundRUID == "" or soundRUID == "TBD" or soundRUID == "N/A" then return end
        local transform = self.Entity:GetComponent("TransformComponent")
        if not isvalid(transform) then return end
        local listener = _UserService.LocalPlayer
        if isvalid(listener) then
            _SoundService:PlaySoundAtPos(soundRUID, transform.WorldPosition, listener, 1.0)
        else
            _SoundService:PlaySound(soundRUID, 1.0)
        end
    end

end
