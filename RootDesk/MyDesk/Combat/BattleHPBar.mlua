@Component
script BattleHPBar extends Component
	-- Match BarWidth to the full bar width configured in Maker.
	property number BarWidth = 0.96
	property number FillWidthRatio = 0.90625

	@ExecSpace("ClientOnly")
	method void OnUpdate(number delta)
		-- Follow the owning unit's synced health without changing the fixed bar art.
		local battleUnit = self.Entity:GetComponent("script.BattleUnit")
		local fillEntity = self.Entity:GetChildByName("HPBarFill")
		if not isvalid(battleUnit) or not isvalid(fillEntity) then
			return
		end

		local ratio = 0
		if battleUnit.MaxHp > 0 then
			ratio = battleUnit.Hp / battleUnit.MaxHp
		end
		ratio = math.max(0, math.min(1, ratio))

		if self._T.lastRatio == ratio then
			return
		end

		local fillTransform = fillEntity.TransformComponent
		local fillScale = fillTransform.Scale
		local fillPosition = fillTransform.Position
		if self._T.fillFullScaleX == nil then
			self._T.fillFullScaleX = fillScale.x
			self._T.fillStartX = fillPosition.x
		end

		fillScale.x = self._T.fillFullScaleX * ratio
		fillTransform.Scale = fillScale

		-- Anchor the left edge so damage drains the visible fill from right to left.
		fillPosition.x = self._T.fillStartX - self.BarWidth * self.FillWidthRatio * (1 - ratio) * 0.5
		fillTransform.Position = fillPosition
		self._T.lastRatio = ratio
		log("[M1][BattleHPBar] FILL " .. self.Entity.Name .. ", hp=" .. tostring(battleUnit.Hp)
			.. "/" .. tostring(battleUnit.MaxHp) .. ", ratio=" .. tostring(ratio))
	end
end
