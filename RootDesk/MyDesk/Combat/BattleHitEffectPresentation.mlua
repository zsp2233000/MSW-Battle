@Component
script BattleHitEffectPresentation extends Component

    @ExecSpace("Multicast")
    method void PlayHitEffect(string effectRUID)
        -- Deliver every successful non-tank hit with its attacker's exact effect RUID.
        self:PlayAtTarget(effectRUID)
    end

    @ExecSpace("ClientOnly")
    method void PlayAtTarget(string effectRUID)
        -- Attach the hit effect to the defender, never to the attacking entity.
        if effectRUID == nil or effectRUID == "" or effectRUID == "TBD" or effectRUID == "N/A" then return end
        if not isvalid(self.Entity) then return end
        _EffectService:PlayEffectAttached(effectRUID, self.Entity, Vector3(0, 0, 0), 0, Vector3(1, 1, 1), false)
        log("[M1][BattleHitEffectPresentation] EFFECT " .. self.Entity.Name .. ", ruid=" .. effectRUID)
    end

end
