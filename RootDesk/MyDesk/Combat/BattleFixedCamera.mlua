@Component
script BattleFixedCamera extends Component

    property Entity CameraAnchor = ""

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Preserve a camera already selected by the entry router before this map begins playback.
        self._T.cameraConfigured = self._T.cameraConfigured == true
        self._T.switching = false
        self._T.anchor = nil
        self._T.anchorReady = nil
        self._T.cameraReady = nil
        self:WatchCameraAnchor()
        self:TryConfigureCamera()
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Recover late player/anchor creation; normal travel is handled synchronously by events.
        self:WatchCameraAnchor()
        local player = _UserService.LocalPlayer
        local map = self.Entity.CurrentMap
        if not isvalid(map) then map = self.Entity end
        if not isvalid(player) or player.CurrentMap ~= map then
            self:RestoreCamera()
            return
        end
        self:TryConfigureCamera()
    end

    @ExecSpace("ClientOnly")
    method void WatchCameraAnchor()
        -- Switch in the activation event: map-change notification can precede the anchor becoming usable.
        local map = self.Entity.CurrentMap
        if not isvalid(map) then map = self.Entity end
        local anchor = self.CameraAnchor
        if not isvalid(anchor) or anchor.CurrentMap ~= map then anchor = map:GetChildByName("BattleCameraAnchor", false) end
        if self._T.anchor == anchor then return end
        if isvalid(self._T.anchor) then
            if self._T.anchorReady ~= nil then self._T.anchor:DisconnectEvent(EntityEnabledInHierarchyChangedEvent, self._T.anchorReady) end
            if self._T.cameraReady ~= nil then self._T.anchor:DisconnectEvent(ComponentEnabledInHierarchyChangedEvent, self._T.cameraReady) end
        end
        self._T.anchor = anchor
        self._T.anchorReady = nil
        self._T.cameraReady = nil
        if isvalid(anchor) then
            self._T.anchorReady = anchor:ConnectEvent(EntityEnabledInHierarchyChangedEvent, function() self:TryConfigureCamera() end)
            self._T.cameraReady = anchor:ConnectEvent(ComponentEnabledInHierarchyChangedEvent, function() self:TryConfigureCamera() end)
        end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Restore on map departure; a stopping play session is already tearing its cameras down.
        if isvalid(self._T.anchor) then
            if self._T.anchorReady ~= nil then self._T.anchor:DisconnectEvent(EntityEnabledInHierarchyChangedEvent, self._T.anchorReady) end
            if self._T.cameraReady ~= nil then self._T.anchor:DisconnectEvent(ComponentEnabledInHierarchyChangedEvent, self._T.cameraReady) end
        end
        self._T.anchor = nil
        self._T.anchorReady = nil
        self._T.cameraReady = nil
        local player = _UserService.LocalPlayer
        local map = self.Entity.CurrentMap
        if not isvalid(map) then map = self.Entity end
        if isvalid(player) and isvalid(player.CurrentMap) and player.CurrentMap ~= map then
            self:RestoreCamera()
        end
        self._T.cameraConfigured = false
        self._T.camera = nil
        self._T.previousCamera = nil
    end

    @ExecSpace("ClientOnly")
    method void TryConfigureCamera()
        -- Activate this map's camera using its saved Transform and CameraComponent settings.
        if self._T.switching then return end
        if self._T.cameraConfigured == true and isvalid(self._T.camera)
            and _CameraService:GetCurrentCameraComponent() == self._T.camera then return end
        local player = _UserService.LocalPlayer
        if not isvalid(player) then return end
        local map = self.Entity.CurrentMap
        if not isvalid(map) then map = self.Entity end
        if player.CurrentMap ~= map then return end

        local anchor = self.CameraAnchor
        if not isvalid(anchor) or anchor.CurrentMap ~= map then
            anchor = map:GetChildByName("BattleCameraAnchor", false)
        end
        if not isvalid(anchor) then return end
        local camera = anchor.CameraComponent
        if not isvalid(camera) or not camera.EnableInHierarchy then return end

        if self._T.cameraConfigured ~= true then
            local previousCamera = _CameraService:GetCurrentCameraComponent()
            if not isvalid(previousCamera) or previousCamera == camera then
                previousCamera = player.CameraComponent
            end
            self._T.previousCamera = previousCamera
        end
        self._T.camera = camera
        self._T.switching = true
        -- Apply after the native camera is ready, and retain through the render update.
        _CameraService.TransitionBlendType = CameraBlendType.Cut
        _CameraService.TransitionBlendTime = 0
        _CameraService:SwitchCameraTo(camera)
        self._T.switching = false
        self._T.cameraConfigured = true
        log("[VRF][BattleCamera] manual anchor=" .. anchor.Name .. " zoom=" .. tostring(camera.ZoomRatio)
            .. " offset=" .. tostring(camera.CameraOffset.x) .. "," .. tostring(camera.CameraOffset.y))
    end

    @ExecSpace("ClientOnly")
    method void RestoreCamera()
        -- Restore only while this map owns the view; another map may already have switched cameras.
        if self._T.cameraConfigured ~= true then return end
        local currentCamera = _CameraService:GetCurrentCameraComponent()
        local player = _UserService.LocalPlayer
        local destination = isvalid(player) and player.CurrentMap or nil
        local nextControl = isvalid(destination) and destination:GetComponent("script.BattleFixedCamera") or nil
        if isvalid(nextControl) and nextControl ~= self and nextControl.Enable then
            nextControl:TryConfigureCamera()
        elseif not isvalid(currentCamera) or currentCamera == self._T.camera then
            ---@type CameraComponent
            local previousCamera = self._T.previousCamera
            if isvalid(player) then
                if not isvalid(previousCamera) or previousCamera.Entity.CurrentMap ~= player.CurrentMap then
                    previousCamera = player.CameraComponent
                end
            end
            if isvalid(previousCamera) and previousCamera.EnableInHierarchy then
                _CameraService:SwitchCameraTo(previousCamera)
                log("[VRF][BattleCamera] manual camera restored")
            end
        end
        self._T.cameraConfigured = false
        self._T.camera = nil
        self._T.previousCamera = nil
    end

end
