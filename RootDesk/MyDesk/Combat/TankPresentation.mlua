@Component
script TankPresentation extends Component

    property string StandAnimationRUID = "a95cfed2c8fe4d2cb64cbb62db051f92"
    property string MoveAnimationRUID = "8257566e41aa4234929e81c6c2dab2e4"
    property string OnHitAnimationRUID = "5ebbdaf503964f3e87de155d16650805"
    property string AttackSoundRUID = "TBD"
    property string OnHitSoundRUID = "6eb2ef8a783c4393bd7ee6a2c199bda7"
    property string DeathSoundRUID = "c49646f7299e4c6e81e953c96e20b294"

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Initialize the tank's visual state and sound serial cursors on the client.
        self._T.lastCombatState = ""
        self._T.lastAttackSerial = 0
        self._T.lastDamageSerial = 0
        self._T.deathSoundPlayed = false
        self:ApplyAnimation("IDLE")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Mirror synced combat state and play attack/onhit/die sounds exactly once per event.
        local unit = self.Entity:GetComponent("script.BattleUnit")
        if not isvalid(unit) then return end
        if unit.IsDead ~= true and unit.CombatState ~= self._T.lastCombatState then
            self._T.lastCombatState = unit.CombatState
            self:ApplyAnimation(unit.CombatState)
        end
        if unit.AttackSerial ~= self._T.lastAttackSerial then
            self._T.lastAttackSerial = unit.AttackSerial
            self:PlayAtEntity(self.AttackSoundRUID)
        end
        if unit.DamageTakenSerial ~= self._T.lastDamageSerial then
            self._T.lastDamageSerial = unit.DamageTakenSerial
            self:PlayAtEntity(self.OnHitSoundRUID)
        end
        if unit.IsDead == true and self._T.deathSoundPlayed ~= true then
            self._T.deathSoundPlayed = true
            self:PlayAtEntity(self.DeathSoundRUID)
        end
    end

    @ExecSpace("ClientOnly")
    method void ApplyAnimation(string combatState)
        -- Assign the supplied animation clip directly to the tank SpriteRendererComponent.
        local sprite = self.Entity:GetComponent("SpriteRendererComponent")
        if not isvalid(sprite) then return end
        local animationRUID = self.StandAnimationRUID
        if combatState == "MOVE" then
            animationRUID = self.MoveAnimationRUID
        elseif combatState == "ON_HIT" then
            animationRUID = self.OnHitAnimationRUID
        end
        sprite.SpriteRUID = animationRUID
        sprite.StartFrameIndex = 0
        sprite.EndFrameIndex = 2147483647
        sprite.PlayRate = 1
    end

    @ExecSpace("ClientOnly")
    method void PlayAtEntity(string soundRUID)
        -- Play a configured Tank attack/onhit/die sound at the unit's world position.
        if soundRUID == nil or soundRUID == "" or soundRUID == "TBD" or soundRUID == "N/A" then return end
        local transform = self.Entity:GetComponent("TransformComponent")
        if not isvalid(transform) then return end
        local listener = _UserService.LocalPlayer
        if isvalid(listener) then
            _SoundService:PlaySoundAtPos(soundRUID, transform.WorldPosition, listener, 1.0)
        else
            _SoundService:PlaySound(soundRUID, 1.0)
        end
    end

end
