@Component
script BattleSession extends Component

    @Sync property string Phase = "DEPLOYMENT"
    @Sync property string Result = ""
    @Sync property integer PlayerAlive = 0
    @Sync property integer EnemyAlive = 0
    @Sync property integer InitialPlayerAlive = 0
    @Sync property integer InitialEnemyAlive = 0
    @Sync property string Snapshot = ""
    @Sync property string UnitSnapshots = ""
    @Sync property integer SnapshotSerial = 0
    @Sync property string LastEvent = ""
    @Sync property integer EventSerial = 0
    @Sync property string EventHistory = ""
    @Sync property string LastEventSourceName = ""
    @Sync property string LastEventTargetName = ""
    @Sync property integer LastEventAmount = 0
    @Sync property string ConfigurationError = ""

    property string MonsterDataSetName = "MonsterData"
    property number EnemyOpeningDelay = 0.12 -- Deterministic M1 lead; DRAW remains for same-batch edge cases.
    property number ArenaMinX = -5.5
    property number ArenaMaxX = 3.5
    property number ArenaMinY = -3.5
    property number ArenaMaxY = 1.5
    property number DeploymentMinX = -5
    property number DeploymentMaxX = -2
    property number DeploymentMinY = -3
    property number DeploymentMaxY = 1
    property number DeploymentMinDistance = 0.6
    property number DeploymentRemoveRadius = 0.5
    property integer DeploymentMaxUnits = 6

    @ExecSpace("ServerOnly")
    method void OnBeginPlay()
        -- Load MonsterData, validate map placements, then create the configured battle roster.
        self._T.units = {}
        self._T.pendingDamage = {}
        self._T.pendingKnockbacks = {}
        self._T.monstersById = {}
        self._T.placedRoster = {}
        self._T.nextPlayerUnitNumber = 0
        self._T.eventHistory = {}
        self._T.dataReady = false
        self._T.initialized = true
        self._T.resultEntered = false
        self.Phase = "DEPLOYMENT"
        self.Result = ""
        self.ConfigurationError = ""
        self.PlayerAlive = 0
        self.EnemyAlive = 0
        self.InitialPlayerAlive = 0
        self.InitialEnemyAlive = 0
        self.UnitSnapshots = ""
        self.SnapshotSerial = 0
        self.EventSerial = 0
        self.EventHistory = ""
        self.LastEvent = ""
        self.LastEventSourceName = ""
        self.LastEventTargetName = ""
        self.LastEventAmount = 0
        self:DisableDefaultPlayer()

        if self:LoadMonsterData() == false then
            self:RefreshSnapshot()
            return
        end

        self._T.placedRoster = self:BuildPlacedRoster()
        if self.ConfigurationError ~= "" then
            self:RefreshSnapshot()
            return
        end
        if self:SpawnPlacedRoster(self._T.placedRoster) == false then
            self:ClearUnits()
            self.PlayerAlive = 0
            self.EnemyAlive = 0
            self:FailConfiguration("map placement roster spawn failed")
            self:RefreshSnapshot()
            return
        end

        self.InitialPlayerAlive = self.PlayerAlive
        self.InitialEnemyAlive = self.EnemyAlive
        for _, entry in ipairs(self._T.placedRoster) do
            if isvalid(entry.source) then entry.source:Destroy() end
        end
        self:EmitPresentation("DEPLOYMENT_START", nil, nil, 0)
        self:RefreshSnapshot()
        log("[M1][BattleSession] DEPLOYMENT ready: map playerUnits=" .. tostring(self.PlayerAlive) .. " enemyUnits=" .. tostring(self.EnemyAlive))
    end

    @ExecSpace("ServerOnly")
    method void OnUpdate(number delta)
        -- Advance the live server simulation without bypassing native movement or hit resolution.
        if self._T.initialized ~= true then return end
        self:StepSimulation(delta, false)
    end

    @ExecSpace("ServerOnly")
    method void OnEndPlay()
        -- Release session-only references when the map instance ends.
        self:ClearUnits()
        self._T.pendingDamage = {}
        self._T.pendingKnockbacks = {}
        self._T.monstersById = {}
        self._T.placedRoster = {}
        self._T.dataReady = false
        self._T.initialized = false
    end

    @ExecSpace("ServerOnly")
    method void ClearUnits()
        -- Destroy any partially-created or completed roster so configuration failures leave no live units behind.
        if self._T.units == nil then
            self._T.units = {}
            return
        end
        for _, record in ipairs(self._T.units) do
            if isvalid(record.entity) then record.entity:Destroy() end
        end
        self._T.units = {}
    end

    @ExecSpace("ServerOnly")
    method void AdvanceForTest(number elapsed)
        -- Provide a high-level elapsed-time seam for external behavior tests.
        if elapsed == nil or elapsed <= 0 then return end
        local remaining = elapsed
        while remaining > 0 do
            local step = math.min(1 / 60, remaining)
            self:StepSimulation(step, true)
            remaining = remaining - step
        end
        self:RefreshSnapshot()
        log("[M1][BattleSession] AdvanceForTest snapshot=" .. self.Snapshot)
    end

    method string GetDebugSnapshot()
        -- Return only observable session state for a test or presentation adapter.
        return self.Snapshot
    end

    method string GetUnitSnapshots()
        -- Return per-unit HP, position, alive, state, faction, kind, and target observations.
        return self.UnitSnapshots
    end

    method boolean IsBattleActive()
        -- Gate every target, attack, and damage path on the single battle phase boundary.
        return self.Phase == "BATTLE" and self.Result == ""
    end

    method Entity GetMapEntity()
        -- Resolve the owning map root for both map-scoped and child-scoped execution.
        local map = self.Entity.CurrentMap
        if not isvalid(map) then map = self.Entity end
        return map
    end

    method boolean IsBlank(any value)
        -- Treat missing and empty dataset cells as invalid rather than silently selecting a script default.
        return value == nil or value == ""
    end

    method boolean FailConfiguration(string message)
        -- Stop the session at the configuration boundary and expose the explicit failure reason.
        self.ConfigurationError = message
        self.Phase = "RESULT"
        self.Result = ""
        self._T.resultEntered = true
        self:EmitPresentation("CONFIG_ERROR", nil, nil, 0)
        log_error("[M1][BattleSession] CONFIG_ERROR: " .. message)
        return false
    end

    method number ReadNumber(any raw, string fieldName, string monsterId, number minimum)
        -- Parse one required numeric cell and reject missing, malformed, or out-of-range values.
        if self:IsBlank(raw) then
            self:FailConfiguration("invalid numeric value " .. fieldName .. " for " .. monsterId)
            return 0
        end
        local parsed = tonumber(raw)
        if parsed == nil or parsed ~= parsed or parsed == math.huge or parsed == -math.huge or parsed < minimum then
            self:FailConfiguration("invalid numeric value " .. fieldName .. " for " .. monsterId)
            return 0
        end
        return parsed
    end

    method integer ReadInteger(any raw, string fieldName, string monsterId, integer minimum)
        -- Parse one required integer cell without accepting fractional or negative values.
        local parsed = self:ReadNumber(raw, fieldName, monsterId, minimum)
        if self.ConfigurationError ~= "" then return 0 end
        if parsed % 1 ~= 0 then
            self:FailConfiguration("invalid numeric value " .. fieldName .. " for " .. monsterId)
            return 0
        end
        return math.floor(parsed)
    end

    method any ReadPresentationClip(string ruid, string monsterId, string fieldName)
        local clip = _ResourceService:LoadAnimationClipAndWait(ruid)
        if not isvalid(clip) or clip.IsLoadComplete ~= true then
            self:FailConfiguration(fieldName .. " failed to load for " .. monsterId)
            return nil
        end
        local frames = clip.Frames:ToTable()
        if frames == nil or #frames == 0 then
            self:FailConfiguration(fieldName .. " has no frames for " .. monsterId)
            return nil
        end
        if clip.PlayRate == nil or not (clip.PlayRate > 0) or not (clip.PlayRate < math.huge) then
            self:FailConfiguration(fieldName .. " has invalid PlayRate for " .. monsterId)
            return nil
        end
        local total = 0
        for _, frame in ipairs(frames) do
            local delay = frame and frame.Delay or nil
            if delay == nil or not (delay >= 0) or not (delay < math.huge) then
                self:FailConfiguration(fieldName .. " has invalid frame timing for " .. monsterId)
                return nil
            end
            total = total + delay
        end
        if not (total > 0) or not (total < math.huge) then
            self:FailConfiguration(fieldName .. " has no positive duration for " .. monsterId)
            return nil
        end
        return { frames = frames, playRate = clip.PlayRate, duration = total / clip.PlayRate }
    end

    method any ParseMonsterRow(any row, integer rowIndex)
        -- Convert and validate one MonsterData row into the profile consumed by BattleUnit.
        if row == nil then
            self:FailConfiguration("MonsterData row missing at index " .. tostring(rowIndex))
            return nil
        end
        local monsterId = row:GetItem("MonsterId")
        if self:IsBlank(monsterId) then
            self:FailConfiguration("MonsterData row " .. tostring(rowIndex) .. " missing MonsterId")
            return nil
        end
        if self._T.monstersById[monsterId] ~= nil then
            self:FailConfiguration("duplicate MonsterId " .. monsterId)
            return nil
        end

        local monsterName = row:GetItem("MonsterName")
        local monsterType = row:GetItem("MonsterType")
        local modelId = row:GetItem("ModelId")
        if self:IsBlank(monsterName) or self:IsBlank(modelId) then
            self:FailConfiguration("MonsterData row " .. monsterId .. " missing name or ModelId")
            return nil
        end
        if monsterType ~= "TANK" and monsterType ~= "ASSAULT" and monsterType ~= "SHOOTER" then
            self:FailConfiguration("invalid MonsterType " .. tostring(monsterType) .. " for " .. monsterId)
            return nil
        end

        local profile = {
            MonsterId = monsterId,
            MonsterName = monsterName,
            MonsterType = monsterType,
            ModelId = modelId,
        }
        profile.MaxHp = self:ReadInteger(row:GetItem("MaxHp"), "MaxHp", monsterId, 1)
        profile.MoveSpeed = self:ReadNumber(row:GetItem("MoveSpeed"), "MoveSpeed", monsterId, 0.0001)
        profile.AttackDamage = self:ReadInteger(row:GetItem("AttackDamage"), "AttackDamage", monsterId, 1)
        profile.AttackIntervalSeconds = self:ReadNumber(row:GetItem("AttackIntervalSeconds"), "AttackIntervalSeconds", monsterId, 0.0001)
        profile.AttackRange = self:ReadNumber(row:GetItem("AttackRange"), "AttackRange", monsterId, 0.0001)
        local attackImpactFrame = row:GetItem("AttackImpactFrame")
        if monsterType == "TANK" and self:IsBlank(attackImpactFrame) then
            profile.AttackImpactFrame = 0
        elseif monsterType ~= "TANK" and self:IsBlank(attackImpactFrame) then
            profile.AttackImpactFrame = 1
        else
            profile.AttackImpactFrame = self:ReadInteger(attackImpactFrame, "AttackImpactFrame", monsterId, 0)
        end
        profile.RetargetIntervalSeconds = self:ReadNumber(row:GetItem("RetargetIntervalSeconds"), "RetargetIntervalSeconds", monsterId, 0.0001)
        profile.HitStopDurationSeconds = self:ReadNumber(row:GetItem("HitStopDurationSeconds"), "HitStopDurationSeconds", monsterId, 0)
        if self.ConfigurationError ~= "" then return nil end
        local contactMinimum = 0
        if monsterType == "TANK" then contactMinimum = 0.0001 end
        profile.ContactCooldownSeconds = self:ReadNumber(row:GetItem("ContactCooldownSeconds"), "ContactCooldownSeconds", monsterId, contactMinimum)
        profile.ContactSizeX = self:ReadNumber(row:GetItem("ContactSizeX"), "ContactSizeX", monsterId, contactMinimum)
        profile.ContactSizeY = self:ReadNumber(row:GetItem("ContactSizeY"), "ContactSizeY", monsterId, contactMinimum)
        profile.KnockbackDistance = self:ReadNumber(row:GetItem("KnockbackDistance"), "KnockbackDistance", monsterId, contactMinimum)
        if monsterType ~= "TANK" and profile.AttackImpactFrame <= 0 then
            self:FailConfiguration("invalid numeric value AttackImpactFrame for " .. monsterId)
            return nil
        end
        if self.ConfigurationError ~= "" then return nil end

        local assetFields = {
            "StandAnimationRUID",
            "MoveAnimationRUID",
            "AttackAnimationRUID",
            "HitAnimationRUID",
            "DieAnimationRUID",
            "HitEffectRUID",
            "AttackSoundRUID",
            "OnHitSoundRUID",
            "DieSoundRUID",
        }
        local optionalAssetFields = {
            AttackAnimationRUID = monsterType == "TANK",
            HitEffectRUID = true,
            AttackSoundRUID = true,
            OnHitSoundRUID = true,
            DieSoundRUID = true,
        }
        for _, fieldName in ipairs(assetFields) do
            local assetRUID = row:GetItem(fieldName)
            if optionalAssetFields[fieldName] ~= true and self:IsBlank(assetRUID) then
                self:FailConfiguration("MonsterData row " .. monsterId .. " missing " .. fieldName)
                return nil
            end
            -- Normalize optional nil cells to an empty string for typed consumers and skip guards.
            profile[fieldName] = assetRUID or ""
        end
        local hitClip = self:ReadPresentationClip(profile.HitAnimationRUID, monsterId, "HitAnimationRUID")
        if hitClip == nil then return nil end
        profile.HitAnimationDurationSeconds = hitClip.duration
        profile.ImpactDelaySeconds = 0
        profile.AttackAnimationDurationSeconds = 0
        if monsterType ~= "TANK" then
            local attackClip = self:ReadPresentationClip(profile.AttackAnimationRUID, monsterId, "AttackAnimationRUID")
            if attackClip == nil then return nil end
            if profile.AttackImpactFrame > #attackClip.frames then
                self:FailConfiguration("AttackImpactFrame exceeds attack clip for " .. monsterId)
                return nil
            end
            profile.AttackAnimationDurationSeconds = attackClip.duration
            for frameIndex = 1, profile.AttackImpactFrame - 1 do
                profile.ImpactDelaySeconds = profile.ImpactDelaySeconds + attackClip.frames[frameIndex].Delay
            end
            profile.ImpactDelaySeconds = profile.ImpactDelaySeconds / attackClip.playRate
            log("[M1][BattleSession] IMPACT_DELAY monsterId=" .. monsterId .. ", frame=" .. tostring(profile.AttackImpactFrame) .. ", seconds=" .. tostring(profile.ImpactDelaySeconds))
        end
        return profile
    end

    method boolean LoadMonsterData()
        -- Load and strictly validate the single authoritative MonsterData UserDataSet before spawning.
        local dataset = _DataService:GetTable(self.MonsterDataSetName)
        if dataset == nil then return self:FailConfiguration("MonsterData table unavailable") end
        local requiredColumns = {
            "MonsterId", "MonsterName", "MonsterType", "ModelId", "MaxHp", "MoveSpeed", "AttackDamage",
            "AttackIntervalSeconds", "AttackRange", "AttackImpactFrame",
            "RetargetIntervalSeconds", "HitStopDurationSeconds", "ContactCooldownSeconds",
            "ContactSizeX", "ContactSizeY", "KnockbackDistance", "StandAnimationRUID", "MoveAnimationRUID",
            "AttackAnimationRUID", "HitAnimationRUID", "DieAnimationRUID", "HitEffectRUID", "AttackSoundRUID",
            "OnHitSoundRUID", "DieSoundRUID",
        }
        for _, columnName in ipairs(requiredColumns) do
            if dataset:GetColumn(columnName) == nil then
                return self:FailConfiguration("MonsterData missing column " .. columnName)
            end
        end
        local rowCount = dataset:GetRowCount()
        if rowCount == nil or rowCount <= 0 then return self:FailConfiguration("MonsterData has no rows") end
        for rowIndex = 1, rowCount do
            local profile = self:ParseMonsterRow(dataset:GetRow(rowIndex), rowIndex)
            if profile == nil then return false end
            self._T.monstersById[profile.MonsterId] = profile
        end
        self._T.dataReady = true
        log("[M1][BattleSession] MonsterData loaded rows=" .. tostring(rowCount))
        return true
    end

    method any GetMonsterProfile(string monsterId)
        -- Return the validated profile for a stable MonsterId without introducing script fallbacks.
        if self._T.monstersById == nil then return nil end
        return self._T.monstersById[monsterId]
    end

    method string FindMonsterIdByType(string monsterType)
        -- Resolve legacy test calls by type while production rosters always use explicit MonsterIds.
        if self._T.monstersById == nil then return "" end
        for monsterId, profile in pairs(self._T.monstersById) do
            if profile.MonsterType == monsterType then return monsterId end
        end
        return ""
    end

    method table BuildPlacedRoster()
        -- Read every Maker-placed unit before spawning, so a bad placement cannot create a partial roster.
        local roster = {}
        local map = self:GetMapEntity()
        if not isvalid(map) then
            self:FailConfiguration("map unavailable for battle placements")
            return roster
        end
        local tileMap = self:GetRectTileMapComponent()
        if not isvalid(tileMap) then
            self:FailConfiguration("RectTileMap unavailable for battle placements")
            return roster
        end
        local placements = map:GetChildComponentsByTypeName("script.BattlePlacement", true)
        local playerCount = 0
        local enemyCount = 0
        for _, placement in ipairs(placements or {}) do
            local source = placement.Entity
            local transform = isvalid(source) and source:GetComponent("TransformComponent") or nil
            local monsterId = placement.MonsterId
            local faction = placement.Faction
            local sourceName = isvalid(source) and source.Name or "unknown"
            if not isvalid(transform) then
                self:FailConfiguration("battle placement missing TransformComponent: " .. sourceName)
                return roster
            end
            if self:IsBlank(monsterId) or self:GetMonsterProfile(monsterId) == nil then
                self:FailConfiguration("battle placement has unknown MonsterId: " .. sourceName .. " (" .. tostring(monsterId) .. ")")
                return roster
            end
            if faction ~= "PLAYER" and faction ~= "ENEMY" then
                self:FailConfiguration("battle placement has invalid Faction: " .. sourceName .. " (" .. tostring(faction) .. ")")
                return roster
            end
            local position = transform.WorldPosition
            if position == nil or position.x ~= position.x or position.y ~= position.y or position.x < self.ArenaMinX or position.x > self.ArenaMaxX or position.y < self.ArenaMinY or position.y > self.ArenaMaxY then
                self:FailConfiguration("battle placement outside arena: " .. sourceName)
                return roster
            end
            if self:IsRectTilePositionBlocked(tileMap, position) then
                self:FailConfiguration("battle placement on blocked tile: " .. sourceName)
                return roster
            end
            local minimumSquared = self.DeploymentMinDistance * self.DeploymentMinDistance
            for _, prior in ipairs(roster) do
                local dx = position.x - prior.position.x
                local dy = position.y - prior.position.y
                if dx * dx + dy * dy + 0.000001 < minimumSquared then
                    self:FailConfiguration("battle placements too close: " .. prior.name .. " and " .. sourceName)
                    return roster
                end
            end
            if faction == "PLAYER" then playerCount = playerCount + 1 else enemyCount = enemyCount + 1 end
            table.insert(roster, { source = source, monsterId = monsterId, faction = faction, position = position, name = sourceName })
        end
        if enemyCount == 0 then
            self:FailConfiguration("map has no ENEMY battle placements")
            return roster
        end
        if playerCount > self.DeploymentMaxUnits then
            self:FailConfiguration("map PLAYER placements exceed deployment limit")
            return roster
        end
        log("[M1][BattleSession] battle placements validated: player=" .. tostring(playerCount) .. " enemy=" .. tostring(enemyCount))
        return roster
    end

    @ExecSpace("Server")
    method void RequestMonsterOptions()
        -- Return only card fields to a player currently on this session's map.
        if not self:IsSenderInMap(senderUserId) or self._T.dataReady ~= true or self.Phase ~= "DEPLOYMENT" then return end
        local options = {}
        for _, profile in pairs(self._T.monstersById) do
            table.insert(options, { profile.MonsterId, profile.MonsterName, profile.StandAnimationRUID })
        end
        table.sort(options, function(left, right) return left[1] < right[1] end)
        self:ReceiveMonsterOptions(options, senderUserId)
    end

    @ExecSpace("Client")
    method void ReceiveMonsterOptions(table options)
        -- Forward the server's limited card data to the client input adapter.
        local adapter = self.Entity:GetComponent("script.BattleDeploymentInput")
        if isvalid(adapter) then adapter:ShowMonsterOptions(options) end
    end

    @ExecSpace("ServerOnly")
    method boolean IsSenderInMap(string userId)
        -- Reject calls from clients without a player entity in this map.
        if userId == nil or _UserService.UserEntities == nil then return false end
        local map = self:GetMapEntity()
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) and player.CurrentMap == map then
                local component = player:GetComponent("PlayerComponent")
                if isvalid(component) and component.UserId == userId then return true end
            end
        end
        return false
    end

    @ExecSpace("Server")
    method void RequestBattlefieldClick(string monsterId, Vector3 position)
        -- A left-click can deploy the selected MonsterId but never removes a deployed unit.
        if not self:IsSenderInMap(senderUserId) or self.Phase ~= "DEPLOYMENT" then return end
        if position == nil or position.x ~= position.x or position.y ~= position.y then return end
        self:TryDeployMonster(monsterId, position)
    end

    @ExecSpace("Server")
    method void RequestRemoveDeployedUnit(Vector3 position)
        -- A right-click removes the nearest deployed player unit and never deploys.
        if not self:IsSenderInMap(senderUserId) or self.Phase ~= "DEPLOYMENT" then return end
        if position == nil or position.x ~= position.x or position.y ~= position.y then return end
        local removeRadiusSquared = self.DeploymentRemoveRadius * self.DeploymentRemoveRadius
        local nearestIndex = nil
        local nearestDistanceSquared = removeRadiusSquared
        for index, record in ipairs(self._T.units) do
            if record.faction == "PLAYER" and record.removable == true and isvalid(record.entity) then
                local transform = record.entity:GetComponent("TransformComponent")
                if isvalid(transform) then
                    local current = transform.WorldPosition
                    local dx = position.x - current.x
                    local dy = position.y - current.y
                    local distanceSquared = dx * dx + dy * dy
                    if distanceSquared <= nearestDistanceSquared then
                        nearestIndex = index
                        nearestDistanceSquared = distanceSquared
                    end
                end
            end
        end
        if nearestIndex ~= nil then
            self:RemoveDeployedUnit(nearestIndex)
        end
    end

    @ExecSpace("ServerOnly")
    method boolean TryDeployMonster(string monsterId, Vector3 position)
        -- Check the phase, authoritative profile, capacity, bounds, and spacing before spawning.
        if self.Phase ~= "DEPLOYMENT" or self._T.dataReady ~= true then return false end
        if position == nil or position.x ~= position.x or position.y ~= position.y then return false end
        local profile = self:GetMonsterProfile(monsterId)
        if profile == nil or self.PlayerAlive >= self.DeploymentMaxUnits then return false end
        if position.x < self.DeploymentMinX or position.x > self.DeploymentMaxX or position.y < self.DeploymentMinY or position.y > self.DeploymentMaxY then return false end
        local minimumSquared = self.DeploymentMinDistance * self.DeploymentMinDistance
        for _, record in ipairs(self._T.units) do
            if isvalid(record.entity) then
                local transform = record.entity:GetComponent("TransformComponent")
                if isvalid(transform) then
                    local current = transform.WorldPosition
                    local dx = position.x - current.x
                    local dy = position.y - current.y
                    -- Vector3 stores positions as float32; 0.6 can round slightly below the boundary.
                    if dx * dx + dy * dy + 0.000001 < minimumSquared then return false end
                end
            end
        end
        self._T.nextPlayerUnitNumber = self._T.nextPlayerUnitNumber + 1
        local entity = self:SpawnMonster(monsterId, "M1_Player_" .. tostring(self._T.nextPlayerUnitNumber), "PLAYER", Vector3(position.x, position.y, 0))
        if not isvalid(entity) then return false end
        self._T.units[#self._T.units].removable = true
        self.PlayerAlive = self.PlayerAlive + 1
        self:EmitPresentation("DEPLOY", entity, nil, 0)
        self:RefreshSnapshot()
        log("[M1][BattleSession] DEPLOY monsterId=" .. monsterId .. " playerUnits=" .. tostring(self.PlayerAlive))
        return true
    end

    @ExecSpace("ServerOnly")
    method void RemoveDeployedUnit(integer index)
        -- Remove only an existing player roster record during deployment.
        if self.Phase ~= "DEPLOYMENT" then return end
        local record = self._T.units[index]
        if record == nil or record.faction ~= "PLAYER" or record.removable ~= true then return end
        table.remove(self._T.units, index)
        if isvalid(record.entity) then record.entity:Destroy() end
        self.PlayerAlive = math.max(0, self.PlayerAlive - 1)
        self:EmitPresentation("REMOVE", nil, nil, 0)
        self:RefreshSnapshot()
        log("[M1][BattleSession] REMOVE monsterId=" .. record.monsterId .. " playerUnits=" .. tostring(self.PlayerAlive))
    end

    @ExecSpace("Server")
    method void RequestStartBattle()
        -- Start once when the combined preplaced and manually deployed player roster is valid.
        if not self:IsSenderInMap(senderUserId) then return end
        self:TryStartBattle()
    end

    @ExecSpace("ServerOnly")
    method boolean CanStartBattleWithPlayerCount(integer playerCount)
        -- Keep the accepted roster range explicit and independently verifiable.
        return self.Phase == "DEPLOYMENT" and playerCount >= 1 and playerCount <= self.DeploymentMaxUnits
    end

    @ExecSpace("ServerOnly")
    method boolean TryStartBattle()
        -- Keep the phase gate available to both the player RPC and Maker probes.
        if not self:CanStartBattleWithPlayerCount(self.PlayerAlive) then return false end
        self.InitialPlayerAlive = self.PlayerAlive
        self.InitialEnemyAlive = self.EnemyAlive
        self.Phase = "BATTLE"
        self:EmitPresentation("SESSION_START", nil, nil, 0)
        self:RefreshSnapshot()
        log("[M1][BattleSession] BATTLE started: playerUnits=" .. tostring(self.PlayerAlive) .. " enemyUnits=" .. tostring(self.EnemyAlive))
        return true
    end

    method boolean SpawnPlacedRoster(table roster)
        -- Create every validated map unit, preserving each placement's faction and world position.
        for index, entry in ipairs(roster) do
            local entity = self:SpawnMonster(entry.monsterId, entry.name .. "_Unit_" .. tostring(index), entry.faction, entry.position)
            if not isvalid(entity) then return false end
            if entry.faction == "PLAYER" then
                self.PlayerAlive = self.PlayerAlive + 1
            else
                self.EnemyAlive = self.EnemyAlive + 1
            end
            log("[M1][BattleSession] MAP_UNIT name=" .. entry.name .. " monsterId=" .. entry.monsterId .. " faction=" .. entry.faction)
        end
        return true
    end

    method Entity SpawnMonster(string monsterId, string name, string faction, Vector3 position)
        -- Spawn a unit from one validated MonsterData row and never from hard-coded combat numbers.
        if self._T.dataReady ~= true then return nil end
        local profile = self:GetMonsterProfile(monsterId)
        if profile == nil then
            log_error("[M1][BattleSession] configured MonsterId missing: " .. tostring(monsterId))
            return nil
        end
        return self:SpawnConfiguredUnit(profile.ModelId, name, faction, profile, position)
    end

    method Entity SpawnUnit(string modelId, string name, string faction, string monsterKey, Vector3 position)
        -- Preserve the existing high-level test seam while resolving its key through MonsterData.
        local profile = self:GetMonsterProfile(monsterKey)
        if profile == nil then
            local legacyMonsterId = self:FindMonsterIdByType(monsterKey)
            profile = self:GetMonsterProfile(legacyMonsterId)
        end
        if profile == nil then
            log_error("[M1][BattleSession] MonsterData profile missing for " .. tostring(monsterKey))
            return nil
        end
        return self:SpawnConfiguredUnit(profile.ModelId, name, faction, profile, position)
    end

    method Entity SpawnConfiguredUnit(string modelId, string name, string faction, table profile, Vector3 position)
        -- Create, validate, configure, and register one unit atomically before it enters the roster.
        local map = self:GetMapEntity()
        if not isvalid(map) then return nil end
        local entity = _SpawnService:SpawnByModelId(modelId, name, position, map)
        if not isvalid(entity) then
            log_error("[M1][BattleSession] SpawnByModelId returned nil for " .. modelId)
            return nil
        end

        entity:AddComponent("script.BattleUnit")
        entity:AddComponent("script.BattleHPBar")
        entity:AddComponent("script.BattleHitEffectPresentation")
        entity:AddComponent("script.BattleAttackComposition")
        local unit = entity:GetComponent("script.BattleUnit")
        local attackFactory = entity:GetComponent("script.BattleAttackComposition")
        if not isvalid(unit) or not isvalid(attackFactory) then
            log_error("[M1][BattleSession] required combat component missing on " .. name)
            entity:Destroy()
            return nil
        end

        local openingDelay = 0
        if faction == "ENEMY" then openingDelay = self.EnemyOpeningDelay end
        unit:BindAttackFactory(attackFactory)
        unit:SetMonsterIdentity(profile.MonsterId, profile.MonsterName, profile.HitEffectRUID)
        unit:Configure(faction, profile.MonsterName, profile.MonsterType, profile.MaxHp, profile.MoveSpeed, profile.AttackDamage, profile.AttackIntervalSeconds, profile.AttackRange, profile.RetargetIntervalSeconds, profile.ImpactDelaySeconds, profile.DieAnimationRUID, openingDelay, profile.ContactCooldownSeconds, Vector2(profile.ContactSizeX, profile.ContactSizeY), profile.KnockbackDistance, profile.HitStopDurationSeconds)
        if not unit:HasAttackAdapter() then
            log_error("[M1][BattleSession] attack adapter missing on " .. name)
            entity:Destroy()
            return nil
        end
        unit:ConfigurePresentation(profile)
        local record = { entity = entity, unit = unit, faction = faction, monsterId = profile.MonsterId, monsterName = profile.MonsterName, unitKind = profile.MonsterType, dead = false }
        table.insert(self._T.units, record)
        return entity
    end

    method Entity FindNearestEnemy(Entity source, Entity preferred)
        -- Pick the nearest alive opposing unit, preserving a valid equal-distance target.
        if not isvalid(source) then return nil end
        local sourceUnit = source:GetComponent("script.BattleUnit")
        local sourceTransform = source:GetComponent("TransformComponent")
        if not isvalid(sourceUnit) or not isvalid(sourceTransform) then return nil end
        if sourceUnit.IsDead then return nil end
        local sourcePosition = sourceTransform.WorldPosition
        local best = nil
        local bestDistance = 0
        for _, record in ipairs(self._T.units) do
            local candidate = record.entity
            local unit = record.unit
            if isvalid(candidate) and isvalid(unit) and candidate ~= source and unit.Faction ~= sourceUnit.Faction and unit:IsAlive() then
                local transform = candidate:GetComponent("TransformComponent")
                if isvalid(transform) then
                    local position = transform.WorldPosition
                    local dx = position.x - sourcePosition.x
                    local dy = position.y - sourcePosition.y
                    local distance = dx * dx + dy * dy
                    if best == nil or distance < bestDistance or (distance == bestDistance and candidate == preferred) then
                        best = candidate
                        bestDistance = distance
                    end
                end
            end
        end
        return best
    end

    method void QueueDamage(Entity target, integer amount, Entity attacker)
        -- Queue HitEvent damage for deterministic batch resolution at the session boundary.
        if not self:IsBattleActive() or amount == nil or amount <= 0 or not isvalid(target) then return end
        local targetUnit = target:GetComponent("script.BattleUnit")
        if not isvalid(targetUnit) or not targetUnit:IsAlive() then return end
        table.insert(self._T.pendingDamage, { target = target, amount = amount, attacker = attacker })
    end

    method void QueueKnockback(Entity attacker, Entity defender, number distance)
        -- Queue an adapter-requested knockback so movement cannot overwrite it in the same frame.
        if not self:IsBattleActive() or not isvalid(attacker) or not isvalid(defender) or distance == nil or distance <= 0 then return end
        local attackerUnit = attacker:GetComponent("script.BattleUnit")
        local defenderUnit = defender:GetComponent("script.BattleUnit")
        if not isvalid(attackerUnit) or not isvalid(defenderUnit) or attackerUnit.UnitKind ~= "TANK" then return end
        if not defenderUnit:IsAlive() or attackerUnit.Faction == defenderUnit.Faction then return end
        table.insert(self._T.pendingKnockbacks, { attacker = attacker, defender = defender, distance = distance })
    end

    method number Clamp(number value, number minimum, number maximum)
        -- Keep every knockback destination inside the playable RectTile boundary.
        return math.max(minimum, math.min(maximum, value))
    end

    @ExecSpace("ServerOnly")
    method void ConstrainUnitToArena(Entity entity)
        -- Correct any physics movement that carried a battle unit beyond the arena limits.
        if not isvalid(entity) then return end
        local transform = entity:GetComponent("TransformComponent")
        local kinematic = entity:GetComponent("KinematicbodyComponent")
        if not isvalid(transform) or not isvalid(kinematic) then return end
        local position = transform.WorldPosition
        local nextX = self:Clamp(position.x, self.ArenaMinX, self.ArenaMaxX)
        local nextY = self:Clamp(position.y, self.ArenaMinY, self.ArenaMaxY)
        if nextX == position.x and nextY == position.y then return end
        local movement = entity:GetComponent("MovementComponent")
        if isvalid(movement) then movement:Stop() end
        kinematic:SetWorldPosition(Vector2(nextX, nextY))
    end

    method any GetRectTileMapComponent()
        -- Resolve the current map's RectTileMap so knockback can respect blocking tiles.
        local map = self:GetMapEntity()
        if not isvalid(map) then return nil end
        local tileMapEntity = map:GetChildByName("RectTileMap", true)
        if not isvalid(tileMapEntity) then return nil end
        return tileMapEntity:GetComponent("RectTileMapComponent")
    end

    method boolean IsRectTilePositionBlocked(any tileMap, Vector3 position)
        -- RectTileInfo.IsCollidable marks tiles that units cannot pass through.
        if not isvalid(tileMap) or position == nil then return false end
        local cellPosition = tileMap:ToCellPosition(position)
        if cellPosition == nil then return false end
        local tileInfo = tileMap:GetTile(cellPosition)
        return tileInfo ~= nil and tileInfo.IsCollidable == true
    end

    method Vector2 GetSafeKnockbackPosition(any tileMap, number fromX, number fromY, number toX, number toY)
        -- Stop at the last free point before the knockback path enters a collidable tile.
        if not isvalid(tileMap) then return Vector2(toX, toY) end
        local deltaX = toX - fromX
        local deltaY = toY - fromY
        local distance = math.sqrt(deltaX * deltaX + deltaY * deltaY)
        local stepCount = math.max(1, math.ceil(distance / 0.05))
        local safeX = fromX
        local safeY = fromY
        for step = 1, stepCount do
            local progress = step / stepCount
            local candidateX = fromX + deltaX * progress
            local candidateY = fromY + deltaY * progress
            if self:IsRectTilePositionBlocked(tileMap, Vector3(candidateX, candidateY, 0)) then break end
            safeX = candidateX
            safeY = candidateY
        end
        return Vector2(safeX, safeY)
    end

    method void ApplyPendingKnockbacks()
        -- Apply queued displacement to the enemy Kinematicbody without changing the tank position.
        if self._T.pendingKnockbacks == nil or #self._T.pendingKnockbacks == 0 then return end
        local pending = self._T.pendingKnockbacks
        self._T.pendingKnockbacks = {}
        local tileMap = self:GetRectTileMapComponent()
        for _, item in ipairs(pending) do
            if isvalid(item.attacker) and isvalid(item.defender) then
                local attackerUnit = item.attacker:GetComponent("script.BattleUnit")
                local defenderUnit = item.defender:GetComponent("script.BattleUnit")
                local attackerTransform = item.attacker:GetComponent("TransformComponent")
                local defenderTransform = item.defender:GetComponent("TransformComponent")
                local kinematic = item.defender:GetComponent("KinematicbodyComponent")
                if isvalid(attackerUnit) and isvalid(defenderUnit) and isvalid(attackerTransform) and isvalid(defenderTransform) and isvalid(kinematic) and attackerUnit.UnitKind == "TANK" and defenderUnit:IsAlive() and attackerUnit.Faction ~= defenderUnit.Faction then
                    local attackerPosition = attackerTransform.WorldPosition
                    local defenderPosition = defenderTransform.WorldPosition
                    local dx = defenderPosition.x - attackerPosition.x
                    local dy = defenderPosition.y - attackerPosition.y
                    local length = math.sqrt(dx * dx + dy * dy)
                    if length < 0.001 then
                        if attackerUnit.Faction == "PLAYER" then dx = 1 else dx = -1 end
                        dy = 0
                        length = 1
                    end
                    local distance = item.distance
                    if distance ~= nil and distance > 0 then
                        local nextX = self:Clamp(defenderPosition.x + dx / length * distance, self.ArenaMinX, self.ArenaMaxX)
                        local nextY = self:Clamp(defenderPosition.y + dy / length * distance, self.ArenaMinY, self.ArenaMaxY)
                        local safePosition = self:GetSafeKnockbackPosition(tileMap, defenderPosition.x, defenderPosition.y, nextX, nextY)
                        if math.abs(safePosition.x - nextX) > 0.0001 or math.abs(safePosition.y - nextY) > 0.0001 then
                            log("[M1][BattleSession] KNOCKBACK blocked by RectTile collision")
                        end
                        defenderUnit:ApplyKnockback(safePosition)
                        self:EmitPresentation("KNOCKBACK", item.attacker, item.defender, 0)
                    end
                end
            end
        end
    end

    method void StepSimulation(number delta, boolean advanceAttacks)
        -- Tick units, advance test timers, apply contact displacement, then resolve queued hits.
        self:DisableDefaultPlayer()
        if self.Phase == "BATTLE" then
            for _, record in ipairs(self._T.units) do
                if isvalid(record.unit) then
                    record.unit:Tick(delta)
                    record.unit:AdvanceKnockback(delta)
                end
            end
            if advanceAttacks == true then
                for _, record in ipairs(self._T.units) do
                    if isvalid(record.unit) then record.unit:AdvanceAttack(delta) end
                end
            end
            self:ApplyPendingKnockbacks()
            self:ResolveDamageBatch()
            self:EvaluateResult()
        elseif self.Phase == "RESULT" then
            for _, record in ipairs(self._T.units) do
                if isvalid(record.unit) then record.unit:Tick(delta) end
            end
        end
        self:RefreshSnapshot()
    end

    method void ResolveDamageBatch()
        -- Resolve each HitEvent separately; EvaluateResult runs after the full batch.
        if self._T.pendingDamage == nil or #self._T.pendingDamage == 0 then return end
        local pending = self._T.pendingDamage
        self._T.pendingDamage = {}
        for _, hit in ipairs(pending) do
            local attackerUnit = nil
            if isvalid(hit.attacker) then attackerUnit = hit.attacker:GetComponent("script.BattleUnit") end
            local isTankContact = isvalid(attackerUnit) and attackerUnit.UnitKind == "TANK"
            if isvalid(hit.target) then
                local unit = hit.target:GetComponent("script.BattleUnit")
                if isvalid(unit) then unit:ApplyResolvedDamage(hit.amount, hit.attacker, not isTankContact) end
            end
        end
    end

    method void NotifyDeath(Entity entity)
        -- Update faction alive count once while leaving result evaluation to the batch boundary.
        for _, record in ipairs(self._T.units) do
            if record.entity == entity and record.dead ~= true then
                record.dead = true
                if record.faction == "PLAYER" then
                    self.PlayerAlive = math.max(0, self.PlayerAlive - 1)
                else
                    self.EnemyAlive = math.max(0, self.EnemyAlive - 1)
                end
                self:EmitPresentation("DEAD", entity, nil, 0)
                return
            end
        end
    end

    method string DetermineResult(integer playerAlive, integer enemyAlive)
        -- Classify the completed damage batch independently so high-level tests can observe all three outcomes.
        if playerAlive <= 0 and enemyAlive <= 0 then return "DRAW" end
        if enemyAlive <= 0 then return "WIN" end
        if playerAlive <= 0 then return "LOSE" end
        return ""
    end

    method void EvaluateResult()
        -- Enter RESULT once after all same-frame damage has been applied.
        if self.Phase ~= "BATTLE" or self._T.resultEntered == true then return end
        local result = self:DetermineResult(self.PlayerAlive, self.EnemyAlive)
        if result ~= "" then self:EnterResult(result) end
    end

    method void EnterResult(string result)
        -- Stop all movement, targeting, attack, contact, and damage paths at the terminal boundary.
        if self._T.resultEntered == true then return end
        self._T.resultEntered = true
        self.Phase = "RESULT"
        self.Result = result
        self._T.pendingKnockbacks = {}
        for _, record in ipairs(self._T.units) do
            if isvalid(record.unit) then record.unit:StopForResult() end
        end
        self:EmitPresentation("RESULT", nil, nil, 0)
        self:RefreshSnapshot()
        log("[M1][BattleSession] RESULT=" .. result)
    end

    method void EmitPresentation(string eventName, Entity source, Entity target, integer amount)
        -- Publish a compact event stream consumed by presentation or test observers.
        self.LastEvent = eventName
        self.EventSerial = self.EventSerial + 1
        self.LastEventAmount = amount or 0
        self.LastEventSourceName = ""
        self.LastEventTargetName = ""
        if isvalid(source) then self.LastEventSourceName = source.Name end
        if isvalid(target) then self.LastEventTargetName = target.Name end
        if self._T.eventHistory == nil then self._T.eventHistory = {} end
        table.insert(self._T.eventHistory, eventName .. ":" .. self.LastEventSourceName .. ":" .. self.LastEventTargetName .. ":" .. tostring(self.LastEventAmount))
        while #self._T.eventHistory > 24 do table.remove(self._T.eventHistory, 1) end
        self.EventHistory = table.concat(self._T.eventHistory, ";")
    end

    method void RefreshSnapshot()
        -- Serialize externally observable phase, unit HP/position/alive state, result, and last event.
        local unitParts = {}
        for _, record in ipairs(self._T.units) do
            local unit = record.unit
            local entity = record.entity
            local positionText = "x=0,y=0"
            if isvalid(entity) then
                local transform = entity:GetComponent("TransformComponent")
                if isvalid(transform) then
                    local position = transform.WorldPosition
                    positionText = "x=" .. tostring(position.x) .. ",y=" .. tostring(position.y)
                end
            end
            if isvalid(unit) and isvalid(entity) then
                table.insert(unitParts, record.faction .. ":" .. entity.Name .. ",monsterId=" .. record.monsterId .. ",name=" .. record.monsterName .. ",kind=" .. record.unitKind .. ",hp=" .. tostring(unit.Hp) .. ",alive=" .. tostring(unit:IsAlive()) .. ",state=" .. unit.CombatState .. ",target=" .. unit.CurrentTargetName .. "," .. positionText)
            end
        end
        self.UnitSnapshots = table.concat(unitParts, ";")
        self.Snapshot = "phase=" .. self.Phase .. "|result=" .. self.Result .. "|playerAlive=" .. tostring(self.PlayerAlive) .. "|enemyAlive=" .. tostring(self.EnemyAlive) .. "|units=" .. self.UnitSnapshots .. "|event=" .. self.LastEvent .. "|eventSerial=" .. tostring(self.EventSerial) .. "|source=" .. self.LastEventSourceName .. "|target=" .. self.LastEventTargetName .. "|amount=" .. tostring(self.LastEventAmount) .. "|events=" .. self.EventHistory
        self.SnapshotSerial = self.SnapshotSerial + 1
    end

    @ExecSpace("ServerOnly")
    method void DisableDefaultPlayer()
        -- Keep DefaultPlayer visible while removing control and collision.
        local map = self:GetMapEntity()
        if not isvalid(map) or _UserService.UserEntities == nil then return end
        for _, player in ipairs(_UserService.UserEntities.Values) do
            if isvalid(player) and player.CurrentMap == map then
                local controller = player:GetComponent("PlayerControllerComponent")
                if isvalid(controller) then controller.Enable = false end
                local movement = player:GetComponent("MovementComponent")
                if isvalid(movement) then movement:Stop() end
                local kinematic = player:GetComponent("KinematicbodyComponent")
                if isvalid(kinematic) then kinematic.Enable = false end
                local rigidbody = player:GetComponent("RigidbodyComponent")
                if isvalid(rigidbody) then rigidbody.Enable = false end
                local physicsCollider = player:GetComponent("PhysicsColliderComponent")
                if isvalid(physicsCollider) then physicsCollider.Enable = false end
                local trigger = player:GetComponent("TriggerComponent")
                if isvalid(trigger) then trigger.Enable = false end
                local childTriggers = player:GetChildComponentsByTypeName("TriggerComponent", true)
                if childTriggers ~= nil then
                    for _, childTrigger in ipairs(childTriggers) do
                        if isvalid(childTrigger) then childTrigger.Enable = false end
                    end
                end
                local playerHit = player:GetComponent("script.PlayerHit")
                if isvalid(playerHit) then playerHit.Enable = false end
                local hit = player:GetComponent("HitComponent")
                if isvalid(hit) then hit.Enable = false end
            end
        end
    end

end
