@Component
script ShooterAttack extends AttackComponent
    property integer AttackDamage = 30
    property number AttackRange = 4.0

    @ExecSpace("ServerOnly")
    method void Configure(table profile, Component execution)
        -- Receive the native hitscan policy without keeping attack timers.
        self.AttackDamage = profile.AttackDamage
        self.AttackRange = profile.AttackRange
        self._T.execution = execution
        self:ResetTarget()
    end

    @ExecSpace("ServerOnly")
    method void ResetTarget()
        -- Clear the native lock on cancellation, reconfiguration, and a new shot.
        self._T.impactTarget = nil
    end

    @ExecSpace("ServerOnly")
    method boolean CanContinue(Entity target)
        -- Cancel as soon as a live defender leaves the strict firing range.
        if not isvalid(target) then return false end
        local unit = target:GetComponent("script.BattleUnit")
        local sourceTransform = self.Entity.TransformComponent
        local targetTransform = target.TransformComponent
        if not isvalid(unit) or not unit:IsAlive() or not isvalid(sourceTransform) or not isvalid(targetTransform) then return false end
        local sourcePosition = sourceTransform.WorldPosition
        local targetPosition = targetTransform.WorldPosition
        local dx = targetPosition.x - sourcePosition.x
        local dy = targetPosition.y - sourcePosition.y
        return dx * dx + dy * dy <= self.AttackRange * self.AttackRange
    end

    @ExecSpace("ServerOnly")
    method void ResolveImpact(Entity target)
        -- Hit only the locked defender at its current native body position.
        if not self:CanContinue(target) then return end
        self._T.impactTarget = target
        local position = target.TransformComponent.WorldPosition
        self:AttackFrom(Vector2(0.2, 0.2), Vector2(position.x, position.y), "shooter", nil)
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- Supply configured damage to the native Attack to Hit pipeline.
        return self.AttackDamage
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- Filter opposing live defenders to the exact locked hitscan target.
        if not isvalid(self._T.execution) or not self._T.execution:IsCurrentAdapter(self) then return false end
        local attackerUnit = self.Entity:GetComponent("script.BattleUnit")
        local defenderUnit = nil
        if isvalid(defender) then defenderUnit = defender:GetComponent("script.BattleUnit") end
        if not isvalid(defenderUnit) or not defenderUnit:IsAlive() or attackerUnit.Faction == defenderUnit.Faction then return false end
        if defender ~= self._T.impactTarget then return false end
        return __base:IsAttackTarget(defender, attackInfo)
    end

    method void OnAttack(Entity defender)
        -- Forward native hits to the common notification path.
        if isvalid(self._T.execution) then self._T.execution:OnNativeHit(self, defender) end
    end
end
