@Component
script BattleDeploymentInput extends Component

    property any session = nil
    property any optionTemplate = nil
    property any optionContainer = nil
    property any startButton = nil
    property any startButtonAction = nil
    property any resultWin = nil
    property any resultLose = nil
    property any resultDraw = nil
    property any buttonBindings = nil
    property any optionCards = nil
    property any optionData = nil
    property any screenTouchHandler = nil
    property any keyDownHandler = nil
    property string selectedMonsterId = ""
    property string displayedResult = ""
    property string observedPhase = "__UNINITIALIZED__"
    property boolean optionsReady = false
    property number optionsRetryCountdown = 0

    @ExecSpace("ClientOnly")
    method void OnBeginPlay()
        -- Bind the delivered UI and request the server's limited card catalog.
        self.session = self.Entity:GetComponent("script.BattleSession")
        self.buttonBindings = {}
        self.optionCards = {}
        self.optionData = {}
        self.optionContainer = self:FindNamedUiEntity("MonsterOptionContainer")
        self.optionTemplate = self:FindNamedUiEntity("MonsterOptionTemplate")
        self.startButton = self:FindNamedUiEntity("BtnStart")
        self.resultWin = self:FindNamedUiEntity("ResultWin")
        self.resultLose = self:FindNamedUiEntity("ResultLose")
        self.resultDraw = self:FindNamedUiEntity("ResultDraw")
        self:SetResultEntities("")
        self.observedPhase = "__UNINITIALIZED__"
        self:SyncDeploymentControls()
        if isvalid(self.optionTemplate) then self.optionTemplate:SetEnable(false) end
        if isvalid(self.startButton) and isvalid(self.startButton:GetComponent("ButtonComponent")) then
            self.startButtonAction = function() self:HandleStartButton() end
            local callback = self.startButton:ConnectEvent(ButtonClickEvent, self.startButtonAction)
            table.insert(self.buttonBindings, { entity = self.startButton, eventCallback = callback })
        end
        self.screenTouchHandler = _InputService:ConnectEvent(ScreenTouchEvent, self.HandleScreenTouch)
        self.keyDownHandler = _InputService:ConnectEvent(KeyDownEvent, self.HandleRightClick)
        self.optionsRetryCountdown = 0
        log("[M1][DeploymentUI] initialized")
    end

    @ExecSpace("ClientOnly")
    method void OnUpdate(number delta)
        -- Retry the catalog request until server initialization completes and follow the synced result.
        if not isvalid(self.session) then return end
        self:SyncDeploymentControls()
        if not self.optionsReady and self.session.Phase == "DEPLOYMENT" then
            self.optionsRetryCountdown = self.optionsRetryCountdown - delta
            if self.optionsRetryCountdown <= 0 then
                self.optionsRetryCountdown = 0.5
                self.session:RequestMonsterOptions()
            end
        end
        local result = ""
        if self.session.Phase == "RESULT" then result = self.session.Result end
        if result ~= self.displayedResult then self:SetResultEntities(result) end
    end

    @ExecSpace("ClientOnly")
    method void OnEndPlay()
        -- Disconnect input and release every cloned card when the map ends.
        if self.screenTouchHandler ~= nil then
            _InputService:DisconnectEvent(ScreenTouchEvent, self.screenTouchHandler)
            self.screenTouchHandler = nil
        end
        if self.keyDownHandler ~= nil then
            _InputService:DisconnectEvent(KeyDownEvent, self.keyDownHandler)
            self.keyDownHandler = nil
        end
        for _, binding in ipairs(self.buttonBindings or {}) do
            if isvalid(binding.entity) and binding.eventCallback ~= nil then
                binding.entity:DisconnectEvent(ButtonClickEvent, binding.eventCallback)
            end
        end
        self.buttonBindings = {}
        for _, card in ipairs(self.optionCards or {}) do
            if isvalid(card.entity) then card.entity:Destroy() end
        end
        self.optionCards = {}
        self.optionData = {}
        self.startButtonAction = nil
        self.session = nil
    end

    @ExecSpace("ClientOnly")
    method Entity FindNamedUiEntity(string entityName)
        -- Resolve a delivered UI entity without editing its layout or appearance.
        local root = _EntityService:GetEntityByPath("/ui")
        if not isvalid(root) then return nil end
        return root:GetChildByName(entityName, true)
    end

    @ExecSpace("ClientOnly")
    method void ShowMonsterOptions(table options)
        -- Clone one card per validated MonsterData row and bind its stable ID.
        if self.optionsReady or not isvalid(self.session) or self.session.Phase ~= "DEPLOYMENT" or not isvalid(self.optionTemplate) or not isvalid(self.optionContainer) then return end
        self.optionData = options
        local containerTransform = self.optionContainer:GetComponent("UITransformComponent")
        local templateTransform = self.optionTemplate:GetComponent("UITransformComponent")
        if not isvalid(containerTransform) or not isvalid(templateTransform) then return end
        local cardWidth = templateTransform.RectSize.x
        local cardHeight = templateTransform.RectSize.y
        local columns = math.max(1, math.floor(containerTransform.RectSize.x / cardWidth))
        local origin = templateTransform.anchoredPosition
        local rows = math.ceil(#options / columns)
        if rows > 1 then
            local extraHeight = (rows - 1) * cardHeight
            local containerPosition = containerTransform.anchoredPosition
            local containerSize = containerTransform.RectSize
            containerTransform.RectSize = Vector2(containerSize.x, containerSize.y + extraHeight)
            containerTransform.anchoredPosition = Vector2(containerPosition.x, containerPosition.y + extraHeight / 2)
            origin = Vector2(origin.x, origin.y + extraHeight / 2)
        end
        for index, option in ipairs(options) do
            local monsterId = option[1]
            local monsterName = option[2]
            local standRUID = option[3]
            local card = self.optionTemplate:Clone("MonsterOption_" .. tostring(index))
            if isvalid(card) then
                card:SetEnable(true)
                local cardTransform = card:GetComponent("UITransformComponent")
                if isvalid(cardTransform) then
                    cardTransform.anchoredPosition = Vector2(origin.x + ((index - 1) % columns) * cardWidth, origin.y - math.floor((index - 1) / columns) * cardHeight)
                end
                local nameEntity = card:GetChildByName("MonsterName", true)
                local portraitEntity = card:GetChildByName("Portrait", true)
                local glowEntity = card:GetChildByName("SelectedGlow", true)
                if isvalid(nameEntity) then
                    local label = nameEntity:GetComponent("TextGUIRendererComponent")
                    if isvalid(label) then label.Text = monsterName end
                    local nameImage = nameEntity:GetComponent("SpriteGUIRendererComponent")
                    if isvalid(nameImage) then nameImage.RaycastTarget = false end
                end
                if isvalid(portraitEntity) then
                    local portrait = portraitEntity:GetComponent("SpriteGUIRendererComponent")
                    if isvalid(portrait) then
                        portrait.ImageRUID = DataRef(standRUID)
                        portrait.RaycastTarget = false
                    end
                end
                if isvalid(glowEntity) then
                    glowEntity:SetEnable(false)
                    local glow = glowEntity:GetComponent("SpriteGUIRendererComponent")
                    if isvalid(glow) then glow.RaycastTarget = false end
                end
                local clickAction = function() self:SelectMonsterCard(monsterId, glowEntity) end
                local callback = card:ConnectEvent(ButtonClickEvent, clickAction)
                table.insert(self.buttonBindings, { entity = card, eventCallback = callback })
                table.insert(self.optionCards, { entity = card, monsterId = monsterId, glow = glowEntity, clickAction = clickAction })
            end
        end
        self.optionsReady = true
        log("[M1][DeploymentUI] cards=" .. tostring(#self.optionCards))
    end

    @ExecSpace("ClientOnly")
    method void SelectMonsterCard(string monsterId, Entity glowEntity)
        -- Move the persistent selection glow to the card carrying this MonsterId.
        if not isvalid(self.session) or self.session.Phase ~= "DEPLOYMENT" then return end
        self.selectedMonsterId = monsterId
        for _, card in ipairs(self.optionCards) do
            if isvalid(card.glow) then card.glow:SetEnable(card.glow == glowEntity) end
        end
        log("[M1][DeploymentUI] selected MonsterId=" .. monsterId)
    end

    @ExecSpace("ClientOnly")
    method void HandleStartButton()
        -- Ask the server to start only while deployment is open.
        if isvalid(self.session) and self.session.Phase == "DEPLOYMENT" then self.session:RequestStartBattle() end
    end

    @ExecSpace("ClientOnly")
    method void SyncDeploymentControls()
        -- Hide selection and start controls as soon as the synchronized phase leaves deployment.
        if not isvalid(self.session) then return end
        local phase = self.session.Phase
        if phase == self.observedPhase then return end
        self.observedPhase = phase
        local enabled = phase == "DEPLOYMENT"
        if isvalid(self.optionContainer) then self.optionContainer:SetEnable(enabled) end
        if isvalid(self.startButton) then self.startButton:SetEnable(enabled) end
        log("[M1][DeploymentUI] deployment controls=" .. tostring(enabled) .. " phase=" .. tostring(phase))
    end

    @ExecSpace("ClientOnly")
    method void HandleScreenTouch(ScreenTouchEvent event)
        -- Keep left-clicks dedicated to deploying the selected monster.
        if event == nil or event.TouchId ~= 1 or not isvalid(self.session) or self.session.Phase ~= "DEPLOYMENT" then return end
        if _InputService:IsPointerOverUI(event.TouchId) then return end
        local world = _UILogic:ScreenToWorldPosition(event.TouchPoint)
        self:HandleBattlefieldClick(Vector3(world.x, world.y, 0))
    end

    @ExecSpace("ClientOnly")
    method void HandleRightClick(KeyDownEvent event)
        -- Use Mouse1 and the cursor location to request removal only on right-click.
        if event == nil or event.key ~= KeyboardKey.Mouse1 or not isvalid(self.session) or self.session.Phase ~= "DEPLOYMENT" then return end
        if _InputService:IsPointerOverUI() then return end
        local cursor = _InputService:GetCursorPosition()
        local world = _UILogic:ScreenToWorldPosition(cursor)
        self:HandleBattlefieldRemovalClick(Vector3(world.x, world.y, 0))
    end

    @ExecSpace("ClientOnly")
    method void HandleBattlefieldClick(Vector3 position)
        -- Send a left-click deployment request to the authoritative map session.
        if position == nil or not isvalid(self.session) or self.session.Phase ~= "DEPLOYMENT" then return end
        self.session:RequestBattlefieldClick(self.selectedMonsterId, position)
    end

    @ExecSpace("ClientOnly")
    method void HandleBattlefieldRemovalClick(Vector3 position)
        -- Send a right-click removal request to the authoritative map session.
        if position == nil or not isvalid(self.session) or self.session.Phase ~= "DEPLOYMENT" then return end
        self.session:RequestRemoveDeployedUnit(position)
    end

    @ExecSpace("ClientOnly")
    method void SetResultEntities(string result)
        -- Keep exactly the matching delivered result entity enabled.
        if isvalid(self.resultWin) then self.resultWin:SetEnable(result == "WIN") end
        if isvalid(self.resultLose) then self.resultLose:SetEnable(result == "LOSE") end
        if isvalid(self.resultDraw) then self.resultDraw:SetEnable(result == "DRAW") end
        self.displayedResult = result
        if result ~= "" then log("[M1][DeploymentUI] result=" .. result) end
    end

end
