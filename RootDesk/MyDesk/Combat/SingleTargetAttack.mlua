@Component
script SingleTargetAttack extends AttackComponent
    @ExecSpace("ServerOnly")
    method void Configure(Component execution)
        -- Receive the native strike policy without keeping attack timers.
        self._T.execution = execution
        self:ResetTarget()
    end

    @ExecSpace("ServerOnly")
    method void ResetTarget()
        -- Clear the native lock on cancellation, reconfiguration, and a new strike.
        self._T.impactTarget = nil
    end

    @ExecSpace("ServerOnly")
    method void ResolveImpact(Entity target)
        -- Hit only the locked defender, using the facing held throughout the animation.
        if not isvalid(target) then return end
        local targetUnit = target:GetComponent("script.BattleUnit")
        if not isvalid(targetUnit) or not targetUnit:IsAlive() then return end
        local direction = self._T.execution:GetStrikeDirection()
        if not self._T.execution:IsTargetInRange(target, direction) then return end
        if self._T.execution:UsesProjectile() then
            -- Release the ball at the configured attack-effect frame; damage waits for arrival.
            self._T.execution:LaunchProjectile(target)
            return
        end
        self._T.impactTarget = target
        self:Attack(self._T.execution:GetAttackShape(direction), "single", nil)
    end

    @ExecSpace("ServerOnly")
    method void ResolveProjectileArrival(Entity target)
        -- The ball reached its locked defender: strike a small box on its body through the native Attack to Hit pipeline.
        if not isvalid(target) then return end
        local targetUnit = target:GetComponent("script.BattleUnit")
        if not isvalid(targetUnit) or not targetUnit:IsAlive() then return end
        self._T.impactTarget = target
        local center = self._T.execution:GetBodyCenter(target)
        self:Attack(BoxShape(center, Vector2(0.1, 0.1), 0), "projectile", nil)
    end

    method integer CalcDamage(Entity attacker, Entity defender, string attackInfo)
        -- Supply configured damage to the native Attack to Hit pipeline.
        return self._T.execution:RollDamage()
    end

    method boolean IsAttackTarget(Entity defender, string attackInfo)
        -- Filter opposing live defenders to the exact locked target.
        if not isvalid(self._T.execution) or not self._T.execution:IsCurrentAdapter(self) then return false end
        local attackerUnit = self.Entity:GetComponent("script.BattleUnit")
        local defenderUnit = nil
        if isvalid(defender) then defenderUnit = defender:GetComponent("script.BattleUnit") end
        if not isvalid(defenderUnit) or not defenderUnit:IsAlive() or attackerUnit.Faction == defenderUnit.Faction then return false end
        if defender ~= self._T.impactTarget then return false end
        return __base:IsAttackTarget(defender, attackInfo)
    end

    method void OnAttack(Entity defender)
        -- Forward native hits to the common notification path.
        if isvalid(self._T.execution) then self._T.execution:OnNativeHit(self, defender) end
    end
end
